<script> 
function wrapChildren(grandparentSelector, parentSelector, wrapperClass, startChildIndex, endChildIndex) {
    // Select the grandparent element
    const grandparentElement = document.querySelector(grandparentSelector);
    
    if (!grandparentElement) {
        console.error(`Grandparent element not found for selector: ${grandparentSelector}`);
        return;
    }

    // Select the parent element within the grandparent
    const parentElement = grandparentElement.querySelector(parentSelector);

    if (!parentElement) {
        console.error(`Parent element not found for selector: ${parentSelector}`);
        return;
    }

    // Create a new wrapper div
    const wrapperDiv = document.createElement('div');
    wrapperDiv.className = wrapperClass; // Use the provided wrapper class

    // Collect the specified children into the wrapper div
    for (let i = startChildIndex; i <= endChildIndex; i++) {
        const child = parentElement.children[startChildIndex]; // Always grab the startChildIndex
        if (child) {
            wrapperDiv.appendChild(child);
        }
    }

    // Insert the wrapper div back into the parent element at the correct position
    parentElement.insertBefore(wrapperDiv, parentElement.children[startChildIndex]);
}



wrapChildren('#shopify-section-as-seen-in-ringer-offer', '.adding_new-div', 'wrapper_childs', 2, 6); // Wraps children 3 to 7
