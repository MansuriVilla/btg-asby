<script>
  // Function to change image source for mobile view
function changeImageSrcForMobile() {
    const image = document.querySelector('.new_overlaping-section #shopify-section-as-seen-in-gps-speaker-offer .wrapper_childs .theme-block:nth-child(2) .single-img img');

    // Check if the image exists
    if (image) {
        // Set the new source for mobile view
        const mobileSrc = 'https://cdn.shopify.com/s/files/1/0057/8958/1381/files/player-plus-icon-set-new-mobile_ca14f5c5-911f-46db-98e2-6012a1b812ff.png?v=1730441640'; // Replace with your mobile image path

        // Change image source if in mobile view
        if (window.innerWidth <= 768) { // Adjust the width as needed for your breakpoint
            image.src = mobileSrc;
        } else {
            // Optionally, reset the image source for larger screens
            const desktopSrc = 'https://cdn.shopify.com/s/files/1/0057/8958/1381/files/player-plus-icon-set-new_png.png?v=1730441416'; // Replace with your desktop image path
            image.src = desktopSrc;
        }
    }
}

// Run the function on page load
changeImageSrcForMobile();

// Also, run the function on window resize to handle dynamic changes
window.addEventListener('resize', changeImageSrcForMobile);

</script>