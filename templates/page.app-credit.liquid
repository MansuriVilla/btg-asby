    .gameapp-popup .btn{font-size: 14px;}
    .input-field input{font-size: 14px !important;margin-bottom: 20px;}
    }

   @media only screen and (min-width:220px) and (max-width:374px) {
    .free_divottols_game_bg .free_game_left span{font-size: 14px;letter-spacing: 7.96px;}
