<style>
      .paige_below-the-fold {
        display: none;
      }

      #SiteHeader:not( .site-header.site-header--megamenu-active, #SiteHeader.site-header.fixed ) {
        background: transparent;
      }
      #SiteHeader.site_header__border:not(.site-header.site-header--megamenu-active) {
        opacity: 0;
      }
      #SiteHeader {
        position: fixed;
        width: 100%;
      }

      #SiteHeader .site_header__border {
        opacity: 0;
      }
      #SiteHeader.site-header.site-header--megamenu-active .site_header__border {
        opacity: 1;
      }
      @media only screen and (min-width:992px){

      .flip-clock-divider.seconds .flip-clock-label{right: -88px;}
      .flip-clock-divider.minutes .flip-clock-label {right: -85px;}
      .flip-clock-divider.days .flip-clock-label { right: -73px; }
      .flip-clock-divider.hours .flip-clock-label { right: -79px; }
      .flip-clock-wrapper ul{ width: 40px;}


      }


      @media only screen and (min-width: 769px) {

        .countdown-timer{padding-bottom:1em;}



        .new_bug {
          display: inline-flex;
          justify-content: center;
          align-items: center;
          text-transform: uppercase;
          background: red;
          border-radius: 4px;
          font-size: 12px;
          color: #000;
          padding: 5px 12px;
          font-weight: 600;
        }
        .new_bug.new_bugGreen {
          background: #00d400;
          color: #000;
        }
      }

      .site_flex {
        display: flex;
      }
      .flex_column {
        flex-direction: column;
      }
      .flex-gap {
        gap: 16px;
      }

      .input_hero {
        display: flex;
        position: relative;
        width: 100%;
        justify-content: center;
        border-radius: 50px;
        overflow: hidden;
        background: #fff;
        max-width: clamp(280px, 28vw, 400px);
      }
      .input_hero input {
        background: #ffffff;
        font-size: clamp(14px, 1.2vw, 16px);
        color: #808080;
        padding: clamp(10px, 1.2vw, 16px) 5px clamp(10px, 1.2vw, 16px)
          clamp(15px, 1.2vw, 20px);
        outline: 0;
        border: 0;
        width: 100%;
      }
      .input_hero input:focus {
        outline: 0;
        border: 0;
      }
      .input_hero button {
        border-radius: 50px;
        background: #0457f3;
        color: #fff;
        padding: clamp(15px, 1.2vw, 20px) clamp(20px, 4vw, 40px);
        font-size: clamp(12px, 1vw, 14px);
        font-weight: 900;
        line-height: 1;
        letter-spacing: 2.4px;
        transition: 0.2s ease all;
        vertical-align: middle;
        display: inline;
        max-width: fit-content;
        width: 100%;
      }
      .input_hero button:hover {
        color: #fff !important;
      }
      /* .input_hero button:hover { background: #fff; color: #0457F3; } */

      /*----------------------------
        Page Common Styles
        -----------------
      */

      .paige_page-inner {
        background: #000;
      }
      .paige_page-inner p {
        padding-top: 0px;
        align-items: center;
        gap: 5px;
