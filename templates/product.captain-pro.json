      }
    },
    "new_faq_section_NXWWQq": {
      "type": "new-faq-section",
      "blocks": {
        "faq_item_i8gi4G": {
          "type": "faq_item",
          "settings": {
            "question": "Is Captain Pro tournament legal?",
            "answer": "<p>Yes. Captain Pro is tournament compliant when Slope is turned off.<br/>To disable slope:</p><ul><li>Press and hold the LED Action Button for 3 seconds</li></ul><p>This instantly switches the device into tournament mode.</p>"
          }
        },
        "faq_item_EtDwMp": {
          "type": "faq_item",
          "settings": {
            "question": "How do I see True Distance™ yardages in my rangefinder?",
            "answer": "<p>True Distance™ yardages are controlled through the app and need to be turned on before they appear in the device’s reticle.<br/>To enable it:</p><ol><li>Start a round in the GAME App</li><li>Open the menu (top corner / hamburger menu)</li><li>Toggle True Distance™ on</li></ol><p>Once enabled, your rangefinder will display adjusted yardages directly in the reticle when you’re ranging targets.<br/>If you don’t see adjusted distances, it usually means the toggle is off — not that the feature isn’t working.</p>"
          }
        },
        "faq_item_H8cUL7": {
          "type": "faq_item",
          "settings": {
            "question": "What happens if I lose it on the course?",
            "answer": "<p>Captain Pro includes “Find My Rangefinder” via Bluetooth.<br/>Open the GAME App to view its last known location and recover it quickly</p>"
          }
        },
        "faq_item_xcL4eb": {
          "type": "faq_item",
          "settings": {
            "question": "What if I don’t want all the connected or AI features?",
            "answer": "<p>You can use Captain Pro as a pure laser rangefinder with zero setup.<br/>All advanced features — app sync, tracking, AI — are optional enhancements.</p>"
          }
        },
        "faq_item_cgyLVt": {
          "type": "faq_item",
          "settings": {
            "question": "Are the numbers shown in photos exactly what I’ll see through the viewfinder?",
            "answer": "<p>In-use product images are designed to reflect the red display color customers see through the device. Some marketing images use enlarged graphic numbers to make distances and key data easier to read online.</p>"
          }
        },
        "faq_item_HYjXRt": {
          "type": "faq_item",
          "settings": {
            "question": "What does the IP67 rating actually mean?",
            "answer": "<p>IP67 means full protection against dust and water immersion.<br/>In real-world terms: </p><ul><li>Heavy rain? No problem</li><li>Wet cart paths or puddles? Safe</li><li>Early mornings, winter rounds, or humid climates? Covered</li></ul><p>It’s built for golfers who play in all conditions, not just perfect ones.</p>"
          }
        },
        "faq_item_C4Yedh": {
          "type": "faq_item",
          "settings": {
            "question": "What’s the difference between OLED and a standard LCD display?",
            "answer": "<p>OLED offers deeper contrast, sharper clarity, and better visibility in changing light.<br/>Compared to standard displays:</p><ul><li>Blacks are truly black</li><li>Colors and numbers pop more</li><li>Visibility improves in shadows and bright conditions</li></ul><p>The result is a cleaner, faster read with less eye strain.</p>"
          }
        },
        "faq_item_gNpKpa": {
          "type": "faq_item",
          "settings": {
            "question": "How do I customize the LED Action Button?",
            "answer": "<p>The LED Action Button can be configured through the GAME App.<br/>You can assign it to:</p><ul><li>Slope toggle</li><li>Brightness control</li><li>Quick access functions</li></ul><p>It’s designed so your most-used feature is always one press away.</p>"
          }
        },
        "faq_item_XtyNQY": {
          "type": "faq_item",
          "settings": {
            "question": "How does the flag-locking technology work?",
            "answer": "<p>Captain Pro uses advanced targeting paired with Pulse Vibration feedback.<br/>When the laser locks onto the flag:</p><ul><li>You feel a quick vibration</li><li>You know it’s the pin, not the background</li></ul><p>It’s fast, reliable, and especially useful when zoomed in or under pressure.</p>"
          }
        },
        "faq_item_UQeXKw": {
          "type": "faq_item",
          "settings": {
            "question": "How do Club Recommendations work?",
            "answer": "<p>Out of the box, the system starts with baseline distances.<br/>Then it evolves:</p><ul><li>You input your actual club ranges</li><li>The GAME ecosystem tracks your shots</li><li>Rainmaker data can further refine accuracy</li></ul><p>Over time, it becomes a fully personalized caddie system.</p>"
          }
        },
        "faq_item_XC9Qxi": {
          "type": "faq_item",
          "settings": {
            "question": "What’s the difference between Captain Pro and Captain Air?",
            "answer": "<p>Captain Air is designed to give you everything you need — and then some — in a simple, accessible package.<br/><br/>If you want:</p><ul><li>Stronger optics</li><li>Sharper display clarity</li><li>More customization</li></ul><p><strong>Then Captain Pro is the upgrade.</strong></p><p>Air keeps it clean and capable. Pro takes it to the next level.</p>"
          }
        }
      },
