{"sections":{"main":{"type":"main-page","disabled":true,"settings":{}},"16534035385205f3ef":{"type":"background-image-text","settings":{"subtitle":"","title":"TRADE UP","text":"","button_label":"","button_link":"","image":"shopify:\/\/shop_images\/download_2.jpg","focal_point":"center","layout":"left","height":550,"framed":true,"parallax":false}},"16534170969eb15bf3":{"type":"rich-text","blocks":{"16534170960728ccda-0":{"type":"heading","settings":{"title":"WELCOME TO THE FAMILY."}},"16534170960728ccda-1":{"type":"text","settings":{"enlarge_text":true,"text":"<p>At Blue Tees, innovation and design is everything to us. That's why we are always developing the next generation rangefinder behind the scenes. We want the best on our bags, and we want the same for our customers. When you purchase a Series 1 Sport, Series 2 or Series 2 Pro rangefinder from blueteesgolf.com, you're automatically signed up for our lifetime 30% off TradeUp program for all future rangefinder launches.<\/p>"}}},"block_order":["16534170960728ccda-0","16534170960728ccda-1"],"settings":{"align_text":"center","narrow_column":true,"divider":false}},"1653417124fb4bc068":{"type":"rich-text","blocks":{"1653417124ae90dea2-0":{"type":"heading","settings":{"title":"WANT 30% OFF THE NEXT  GENERATION RANGEFINDER FOR LIFE?"}}},"block_order":["1653417124ae90dea2-0"],"settings":{"align_text":"center","narrow_column":true,"divider":true}},"16534183287a727b2c":{"type":"icon-with-text","blocks":{"1653418328717a2e07-0":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/2089181.png","image_width":100,"title":"","text":"<p>Email us at <\/p><p>support@blueteesgolf.com<\/p>","button_label":"","button_link":""}},"1653418328717a2e07-1":{"type":"text_block","settings":{"enable_image":true,"image":"shopify:\/\/shop_images\/25643.png","image_width":100,"title":"","text":"<p>We will need your contact info and previous confirmation number.<\/p>","button_label":"","button_link":""}},"1653418