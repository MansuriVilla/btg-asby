<div class="max3-product-page palyer-speaker-page">
  {%- section 'main-product-golf-speaker' -%}

  <div class="gps-pro-video">
    <div class="video_box">
      {%- section 'player-speaker-video' -%}
    </div>
  </div>

   <div class="as-seen-in series-3-max-golf-rangefinder-with-slope">
    {%- section 'as-seen-in-player-speaker' -%}
    <div class="speakers-image">
      <img class="desktop" src="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/player-speakerimg.png" alt="player-speakerimg">
      <img class="mobile" src="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/mobile-player-speakerimg.png" alt="mobile-player-speakerimg">
    </div>
    {%- section 'change-the-way-player-speaker' -%}
  </div>
  <div class="productinfo-list">
    <div class="productlist row">
        <div class="col-6 item">
            <div class="product-block">
                <div class="product-info">
                    <img src="{{'super-sound-iocn.png' | asset_url}}" alt="super-sound">
                    <p>The Player brings big sound to the course. Packed with two high fidelity speakers and two deep tremble passive radiator subs brings an immersive four-way sound experience to any round</p>
                </div>
                <img src="{{'super-sound-img.png' | asset_url}}" alt="super-sound">
            </div>
        </div>
        <div class="col-6 item">
            <div class="product-block">
                <div class="product-info">
                    <img class="desktop" src="{{'player-mag-strip-icon.png' | asset_url}}" alt="player-mag-strip">
                    <img class="mobile" src="{{'m-player-mag-strip-icon.png' | asset_url}}" alt="player-mag-strip">
                    <p>The Player comes with the strongest magnet we could put in a speaker. Imagine the simplicity of clipping your speaker to the golf cart, always in reach when you’re ready to bump</p>
                </div>
                <img src="{{'player-mag-speakerimg.png' | asset_url}}" alt="player-mag-speakerimg">
            </div>
        </div>
    </div>
    <div class="productlist productlist2 row">
        <div class="col-4 item">
            <div class="product-block">
                <div class="product-info">
                    <img src="{{'dual-pair-icon.png' | asset_url}}" alt="dual-pair">
                    <p>Pair your speakers together to deliver twice the power<br>Not Compatible With Player+</p>
                </div>
                <img src="{{'dual-pairimg.png' | asset_url}}" alt="dual-pair">
            </div>
        </div>
        <div class="col-4 item">
            <div class="product-block">
                <div class="product-info">
                    <img src="{{'water-proo-icon.png' | asset_url}}" alt="water-proof">
                    <p>100% waterproof, so no matter the conditions on or off the course, you’ll never have to worry</p>
                </div>
                <img src="{{'water-proofimg.png' | asset_url}}" alt="water-proof">
            </div>
        </div>
        <div class="col-4 item">
            <div class="product-block">
               <div class="product-info">
                    <img src="{{'power-bank-icon.png' | asset_url}}" alt="power-bank">
                    <p>Built-in power bank to power items like mobile phones and more</p>
                </div>
                <img src="{{'power-bankimg.png' | asset_url}}" alt="power-bank">
            </div>
        </div>
    </div>
    <div class="theme-block">
      <div class="rte">
            <a href="https://blueteesgolf.com/products/magnetic-golf-speaker" class="btn">ADD TO CART</a>
      </div>
    </div>
</div>
  
  {%- section 'max2-text-with-bg' -%}

  <div class="review-section">
    <h2>REVIEWS</h2>
    <div id="looxReviews" data-product-id="{{product.id}}"></div>
  </div>

  {% comment %}{%- section 'product-recommendations' -%}{% endcomment %}
  {%- section 'featured-collection' -%}
</div>

<style>
  #shopify-section-main-product-golf-speaker{background: var(--new-black);}
  #shopify-section-main-product-golf-speaker .bottom-buttons ul{display: flex;justify-content: center;margin-top: 17px;list-style: none;}
  #shopify-section-main-product-golf-speaker .bottom-buttons li{margin: 0 8px;}
  #shopify-section-main-product-golf-speaker .bottom-buttons li a{font-weight: 700;font-size: 12px;line-height: 22px;letter-spacing: 2px;list-style: none;border-radius: 6.29032px;padding: 10px 8px 10px 32px;color: #FFF;width: 136px;text-align: center;float: left;}
  #shopify-section-main-product-golf-speaker .bottom-buttons li:hover a{color: var(--new-black);}
  #shopify-section-main-product-golf-speaker .bottom-buttons li.photo a {background: url('https://blueteesgolf.com/cdn/shop/t/84/assets/photo-icon.png') 24px center no-repeat #313131;}
  #shopify-section-main-product-golf-speaker .bottom-buttons li.photo a:hover{background: url('https://blueteesgolf.com/cdn/shop/t/84/assets/photo-icon-h.png') 24px center no-repeat #fff;}
  #shopify-section-main-product-golf-speaker .bottom-buttons li.commercial a{background: url('https://blueteesgolf.com/cdn/shop/t/84/assets/commercial-icon.png') 10px center no-repeat #313131;}
  #shopify-section-main-product-golf-speaker .bottom-buttons li.commercial a:hover{background: url('https://blueteesgolf.com/cdn/shop/t/84/assets/commercial-icon-h.png') 10px center no-repeat #fff;}
  #shopify-section-main-product-golf-speaker .bottom-buttons li.review a{background: url('https://blueteesgolf.com/cdn/shop/t/84/assets/commercial-icon.png') 22px center no-repeat #313131;}
  #shopify-section-main-product-golf-speaker .bottom-buttons li.review a:hover {background: url('https://blueteesgolf.com/cdn/shop/t/84/assets/commercial-icon-h.png') 22px center no-repeat #fff;}
  #shopify-section-main-product-golf-speaker .product__thumb-arrow--next{background: url('https://blueteesgolf.com/cdn/shop/t/84/assets/bottom-aro.png') bottom center no-repeat;background-size: auto;background-size: 30px;width: 30px;height: 30px;position: absolute;left: 28px;bottom: -40px;}
  #shopify-section-main-product-golf-speaker .product__thumb-arrow--next .icon,
  #shopify-section-main-product-golf-speaker .product__thumb-arrow--prev .icon{display: none;}
  #shopify-section-main-product-golf-speaker .product__thumb-arrow--prev{background: url('https://blueteesgolf.com/cdn/shop/t/84/assets/top-aro.png') top center no-repeat;background-size: 30px;width: 30px;height: 30px;position: absolute;top: -40px;left: 28px;}
  .gps-pro-video .video-parent-section{margin: 0px;border: none;box-shadow: none;border-radius: 0;width: 100%;height: 650px;}
  
  #shopify-section-as-seen-in-player-speaker .enlarge-text p{padding: 0px !important;font-weight: 900;max-width: 100% !important;letter-spacing: 0.5em !important;}
  #shopify-section-as-seen-in-player-speaker .theme-block:last-child .single-img img{padding-top: 0px;}
  #shopify-section-change-the-way-player-speaker .theme-block:nth-child(2){padding-top: 0px;}
  #shopify-section-change-the-way-player-speaker .enlarge-text p{padding: 30px 0px;}
  .speakers-image{text-align: center;padding-top: 20px;}
  .speakers-image .mobile{display: none;}
  .palyer-speaker-page .theme-block .rte .btn{background: var(--new-blue);border-radius: 5px;font-weight: 900;font-size: 16px;line-height: 19px;letter-spacing: 0.2em;width: 270px;}
  .sale-on .palyer-speaker-page .theme-block .rte .btn{background: var(--new-red);}
  #shopify-section-change-the-way-player-speaker .btn:hover, .productinfo-list .theme-block .rte .btn:hover{background: #fff !important;color: var(--new-black);border-color: #fff;}
  .productinfo-list{background: var(--new-black);padding: 0px 50px 60px 50px;}
  .productinfo-list .row{display: flex;flex-wrap: wrap;margin-right: -15px;margin-left: -15px;margin-bottom: 40px;}
  .productinfo-list .productlist2{padding: 0px 15px;}
  .productinfo-list .row .col-6{width: 50%;padding: 0px 20px;}
  .productinfo-list .row .col-4{width: 33.333%;padding: 0px 10px;}
  .productinfo-list .row .item .product-info + img{width: 100%;height: auto;}
  .productinfo-list .product-info .mobile{display: none;}
  .productinfo-list .product-info{padding: 30px 10px;text-align: center;margin: 0;}
  .productinfo-list .product-info img{max-height: 91px;}
  .productinfo-list .product-info p{color: #fff;line-height: 19px;max-width: 300px;margin: 0 auto;font-size: 16px;}
  .productlist2 .product-info p{font-size: 14px;min-height: 75px;}
  .productlist2 .product-info img{max-height: 80px;}
  .productinfo-list .product-block{background:var(--new-black) url('https://cdn.shopify.com/s/files/1/0057/8958/1381/files/product-bgimg1.png');background-size: cover;border: 3px solid #fff;line-height: 0;border-radius: 13px;box-shadow: 0px 0px 12px 0px #FFF, 0px 2px 12px 2px rgba(255, 255, 255, 0.25);overflow: hidden;}
  .productinfo-list .theme-block{text-align: center;}
   


  
  /*  =====================================================

    Video-modal

    =====================================================  */

  @keyframes modal-video
  {
  from {
    opacity:0
  }
  to {
    opacity:1
  }
  }
  @keyframes modal-video-inner
  {
  from {
    transform:translate(0, 100px)
  }
  to {
  transform:translate(0, 0)
  }
  }
  .modal-video
  { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); z-index: 1000000;
  cursor: pointer; opacity: 1; animation-timing-function: ease-out; animation-duration: .3s; animation-name: modal-video;
  -webkit-transition: opacity .3s ease-out;
  -moz-transition: opacity .3s ease-out;
  -ms-transition: opacity .3s ease-out;
  -o-transition: opacity .3s ease-out;
  transition: opacity .3s ease-out
  }
  .modal-video-close
  { opacity: 0
  }
  .modal-video-close .modal-video-movie-wrap
  { -webkit-transform: translate(0, 100px); -moz-transform: translate(0, 100px); -ms-transform: translate(0, 100px);
  -o-transform: translate(0, 100px);  transform: translate(0, 100px)
  }
  .modal-video-body
  { max-width: 940px; width: 100%; height: 100%; margin: 0 auto; display: table
  }

    @media (max-width:1080px){
  .productinfo-list{padding: 0px 30px 50px 30px;}
      
  }
  
  @media (max-width:1024px)
  {
  .modal-video-close-btn
  { right: 0px !important;
  }
  }

  @media (max-width:991px){
  #shopify-section-main-product-golf-speaker .bottom-buttons li a{letter-spacing: normal;font-size: 10px;width: 107px;padding: 8px 8px 8px 32px;}
  #shopify-section-main-product-golf-speaker .bottom-buttons li{margin: 0 4px;width: auto;}
  #shopify-section-main-product-golf-speaker .product__thumb-arrow--next,
  #shopify-section-main-product-golf-speaker .product__thumb-arrow--prev{left: 24px;}
  }
  
  @media (max-width:860px){
  .productinfo-list{padding: 0px 30px 40px 30px;}
  #shopify-section-main-product-golf-speaker .bottom-buttons ul{margin-left: 45px;}
  .productlist2 .product-info{padding: 30px 15px;}
  .productlist2 .product-info p{min-height: 92px;}
  }

  @media (max-width: 834px)
  {
  .modal-video-body
  { max-width: 520px;
  }
  }
  
  @media (max-width:768px){
  #shopify-section-main-product-golf-speaker .grid__item .product__photos--beside{flex-wrap: wrap;}
  #shopify-section-main-product-golf-speaker .grid__item .small--hide{display: inline-block !important;flex: auto;max-width: 100%;margin-left: 0;width: 100%;margin-top: 80px;}
  #shopify-section-main-product-golf-speaker .grid__item .product__thumbs--beside .product__thumb-item{min-width: 90px;margin-bottom: 0;background: #313131;border-radius: 9.5px;display: flex;align-items: center;justify-content: center;flex-wrap: wrap;margin-right: 15px;overflow: hidden;}
  #shopify-section-main-product-golf-speaker .grid__item .product__thumbs--beside .product__thumbs--scroller{width: 100%;overflow-x: scroll;overflow-y: hidden;display: flex;top: auto;}
  #shopify-section-main-product-golf-speaker .product-slideshow .is-selected .product__photo-zoom{display: none;}
  #shopify-section-main-product-golf-speaker .product-single__meta{text-align: left;}
  #shopify-section-main-product-golf-speaker .product-block.product-block--price{justify-content: start;}
  #shopify-section-main-product-golf-speaker .product__thumb-arrow--prev,
  #shopify-section-main-product-golf-speaker .product__thumb-arrow--next{display: none;}
    
 .productinfo-list .row{margin-bottom: 0px;}
 .productinfo-list{padding: 0px 20px 40px 20px;}
 .productinfo-list .row .col-6,
 .productinfo-list .row .col-4{width: 100%;}
 .productinfo-list .product-block{max-width: 535px;margin: 0 auto 40px;}
 .productlist2 .product-info p{min-height: auto;}
 .productinfo-list .product-info .mobile{display: inline-block;max-height: 65px;}
 .productinfo-list .product-info .desktop{display: none;}
  #shopify-section-as-seen-in-player-speaker .enlarge-text p{letter-spacing: 0.3em !important;}
  .speakers-image .desktop{display: none;}
  .speakers-image .mobile{display: block;}
  .series-3-max-golf-rangefinder-with-slope .single-img{line-height: 0;}
  .series-3-max-golf-rangefinder-with-slope .single-img img{margin-bottom: 0px;}
  
  }
  @media (max-width:767px)
  {
  .modal-video-body
  { width: 90%;
  }
  }
  .modal-video-inner
  { display: table-cell; vertical-align: middle; width: 100%; height: 100%
  }
  .modal-video-movie-wrap
  { width: 100%; height: 0; position: relative; padding-bottom: 56.25%; background-color: #333; animation-timing-function: ease-out;
  animation-duration: .3s; animation-name: modal-video-inner; -webkit-transform: translate(0, 0); -moz-transform: translate(0, 0);
  -ms-transform: translate(0, 0); -o-transform: translate(0, 0);  transform: translate(0, 0);
  -webkit-transition: -webkit-transform .3s ease-out;
  -moz-transition: -moz-transform .3s ease-out;
  -ms-transition: -ms-transform .3s ease-out;
  -o-transition: -o-transform .3s ease-out;
  transition: transform .3s ease-out
  }
  .modal-video-movie-wrap iframe
  { position: absolute; top: 0; left: 0; width: 100%; height: 100%
  }
  .modal-video-close-btn
  { position: absolute; z-index: 2; top: -35px; right: -35px; display: inline-block; width: 35px; height: 35px;

  overflow: hidden; border: none; background: transparent
  }
  .modal-video-close-btn:before
  { transform: rotate(45deg)
  }
  .modal-video-close-btn:after
  { transform: rotate(-45deg)
  }
  .modal-video-close-btn:before, .modal-video-close-btn:after
  { content: ''; position: absolute; height: 2px; width: 100%; top: 50%; left: 0; background: #fff;
  border-radius: 5px; margin-top: -6px
  }

  @media (max-width:520px){
  .productinfo-list .product-info,
  .productlist2 .product-info{padding: 20px 15px;}
  #shopify-section-main-product-golf-speaker .bottom-buttons ul{ margin-left:0;}
  }

  @media (max-width:480px)
  {
  .modal-video-close-btn
  { right: 0px;
  }
  }
</style>



