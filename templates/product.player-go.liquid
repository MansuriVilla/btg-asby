    {%- section 'change-the-way-player-go' -%}
  </div>

  {%- section 'next-level-feature-player-go' -%}
  {%- section 'player-go-html' -%}
  {%- section 'max3-text-with-bg' -%}

  <div class="review-section">
    <h2>REVIEWS</h2>
