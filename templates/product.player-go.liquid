#shopify-section-next-level-feature-player-go{background: var(--new-black);padding: 30px 0px 60px;}
.before-after-view{display: flex;flex-wrap: wrap;justify-content: space-between;}
#shopify-section-next-level-feature-player-go .before-new{background-color: transparent;}
.scroller, .scroller-new{display: none;}
.single-box-before{background: linear-gradient(180deg, #000000 0%, #363636 100%);position: relative;}
.single-box-before .diamond-icon{position: absolute;right: 10px;top: 10px;}
.image-main{border-top: 2px solid #fff;border-radius: 8px;top: 51%;}
.bottom-before-after, .image-main{height: 300px;}
.content-image{max-width: 100%;object-fit: cover;border-radius: 12px;}
#shopify-section-next-level-feature-player-go .owl-theme .owl-dots{display: none;}
#shopify-section-next-level-feature-player-go #product-gallary .owl-prev{background: url({{'left-ic.png' | asset_url}}) left center no-repeat;background-size: auto;background-size: 52px;width: 52px;height: 52px;position: absolute;left: -65px;top: 45%;}
#shopify-section-next-level-feature-player-go #product-gallary .owl-next{background: url({{'right-ic.png' | asset_url}}) left center no-repeat;background-size: auto;background-size: 52px;width: 52px;height: 52px;position: absolute;right: -65px;top: 45%;}
#shopify-section-next-level-feature-player-go .owl-prev span,
#shopify-section-next-level-feature-player-go .owl-next span{display: none;}
.single-box-before .text{max-width: 335px;padding: 12px 10px;}
#product-gallary .item .bottom_product_img{height: 220px;}
.max3-product-page .product-block button.btn.btn--full.add-to-cart{background: var(--new-red);}
#product-gallary .owl-item{padding: 0px 10px !important;}
.max3-product-page .product-single__meta .tab-content p small,
.product-single__meta .collapsible-content .collapsible-content__inner p small{font-size: 10px;line-height: 12px;max-width: 420px;}
  .single-box-before .top-icon{line-height: 0px;}
#product-gallary .top-icon img, .single-box-before .top-icon img{max-height: 50px; width: 100%; }
#product-gallary .top-icon + h3, .single-box-before .top-icon h3{ display: block; line-height: 16px; font-size: 20px; color: #fff; margin-top:5px; font-weight: bold;}

/* popup */
.offermodal-popup .offer-price{padding-left: 35px;margin-bottom: 20px;color: #fff;}
.offermodal-popup .offer-price span:first-child{width: 150px;text-align: left;}
.offermodal-popup .checkbox-title{margin-bottom: 0px;}
  
.max3-product-page .pop-upbox .popup-box{top: 50%;}
.pop-upbox{ background: rgba(0, 0, 0, .65); bottom: 0; display:none; left: 0; position: fixed; right: 0; top: 0; z-index: 999999999; overflow:hidden;}
.pop-upbox .popup-box{  left: 0;  margin:0 auto;  max-width:100%;  position: absolute;  right: 0; top:40px;  width: 100%;  z-index: 99999;  border-radius: 50px;
     top: 50%; max-width:1030px; padding:0px 20px;
   -webkit-transform: translateY(-50%);
      -ms-transform: translateY(-50%);
      transform: translateY(-50%);
      background: transparent;
  }
.pop-upbox .popup-box .pop-close{ position:absolute; width:24px; float:right; text-align:center; right:10px; top:20px; line-height: 0;}
.pop-upbox .popup-box .pop-close a{font-size: 30px;color: #fff;font-weight: 700;}














