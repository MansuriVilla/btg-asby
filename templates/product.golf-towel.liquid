<script>


// ADDING CUSTOM IMGS TO THE LABEL COLOR SWATCHS
const imageMapping = {
    'palm-navy': 'https://cdn.shopify.com/s/files/1/0057/8958/1381/files/plamnavy-icon-towel.png?v=1739174796',
    'steel-leaf': 'https://cdn.shopify.com/s/files/1/0057/8958/1381/files/steel_feal--towel.png?v=1739175232',
    'party-edition': 'https://cdn.shopify.com/s/files/1/0057/8958/1381/files/party_edition--towel.png?v=1739175295',
    'aztec-sand': 'https://cdn.shopify.com/s/files/1/0057/8958/1381/files/Aztec_Sand--towel.png?v=1739175310',
    'palm-dark': 'https://cdn.shopify.com/s/files/1/0057/8958/1381/files/plam_dark--towel.png?v=1739175351',
    
};


function updateImageSrc() {
    
    const labels = document.querySelectorAll('.variant__button-label');
    
    labels.forEach(label => {
        
        const labelClass = label.classList[0];

        
        const img = label.querySelector('img');
        
        
        if (img && imageMapping[labelClass]) {
            
            img.setAttribute('src', imageMapping[labelClass]);
        }
    });
}


window.addEventListener('DOMContentLoaded', () => {
    updateImageSrc();
});

</script>


