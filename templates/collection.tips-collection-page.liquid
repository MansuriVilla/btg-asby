{% section 'tips-header' %}
  {% if collection.metafields.custom.seo_title_h1 != blank %}
    <h1 class="section-header__title" style="display:none;">{{ collection.metafields.custom.seo_title_h1 }}</h1>
  {% endif %}

<div class="tips_collection--main">
  <div class="tips_collection--inner">
    <div class="tips_collection-banner tips_container">
      <picture>
        <source srcset="{{ 'tips-banner-collection.png' | asset_url }}" media="(min-width:769px)" >
        <source srcset="{{ 'tips-banner-collection-mobile.png' | asset_url }}" media="(max-width:768px)" >
        <img src="{{ 'tips-banner-collection.png' | asset_url }}" alt="" />
      </picture>
    </div>
    <div class="tips_collection--products tips_flex tips_container " >
      <div class="tips_collection-left">
        <div class="tips_collection-left-inner tips_flex">
          <div class="tips_collection-left-image">
            <img src="{{ 'tips-collection-logo.png' | asset_url }}" alt="" />
          </div>
          <div class="tips_collection-left-desc">
            <p class="tips_caption">Designed to work together or stand alone, the TIPS Transit Line is built for modern movement—whether you’re commuting, exploring a new city, or jetting off for the weekend. Each piece is built to pack better, travel easier, and stay ready for whatever’s next. </p>
          </div>
        </div>
      </div>
      <div class="tips_collection-right">
        <div class="tips_collection-right-inner">
          <div class="tips_grid">
            {% for product in collection.products %}
              
                <a class="tips_gird--item" href="{{ product.url }}">
                  <div class="tips_grid--top">
                    <img src="{{ product.featured_image | img_url: 'master' }}" alt="{{ product.title }}">
                  </div>
                  <div class="tips_grid--center">
                    <h3>{{ product.title }}</h3>

                    {% assign short_desc = product.description | strip_html | truncate: 50 %}
      
                    <p class="tips_caption"> {{ short_desc }} </p>
                  </div>
                  
                 
                  <div class="tips_grid--bottom">
                     <p>{{ product.price | money }}</p>
                  </div>
                </a>
            
            {% endfor %}
            
          </div>
        </div>
      </div>
    </div>
    <div class="tips_collection--personal">
      <div class="personal_inner tips_flex tips_container">
        <div class="personal_left">
          <div class="personal_left-top">
            <h3>make it personal.</h3>
            <p class="tips_caption">Our gear, personalized with your branding. Perfect for corporate gifts, team travel kits, and standout partnerships.</p>
          </div>
          <div class="personal_left-bottom">
            <a class="tips_cta-primary"> <span class="staggered-item"> <span> Learn About Custom Gear </span> </span> </a>
          </div>
        </div>
        <div class="personal_right">
           <picture>
            <source srcset="{{ 'personal-section-img.png' | asset_url }}" media="(min-width:769px)" >
            <source srcset="{{ 'personal-section-img.png' | asset_url }}" media="(max-width:768px)" >
            <img src="{{ 'personal-section-img.png' | asset_url }}" alt="" />
          </picture>
        </div>
      </div>
    </div>
  </div>
</div>

{% section 'tips-footer' %}



<style>


  .tips_collection--main :is(img, picture,video){ display:flex; }
  .tips_collection--main h1{ font-size:clamp(42px,6vw,80px); letter-spacing:-4%; font-family: Switzer-Bold !important; }
  .tips_collection--main h3{ font-size:20px; font-family: Switzer-Bold !important;  font-weight: normal; color: #242424; line-height: 90%; }
  

  .tips_caption { font-size:var(--tips-font-small); padding-top:0px; line-height:160%; font-family: "Roboto Mono", monospace; color:#4E4A4B; }
  .tips_grid { display:grid; grid-template-columns: repeat( auto-fill, minmax(clamp(270px, 40vw, 340px), 1fr) ); gap:calc( var(--tips-card-gap) + 2px ); }
  .tips_flex { display:flex; }


  
.tips_container {   padding-left: clamp(15px, 4vw, 60px); padding-right: clamp(15px, 4vw, 60px);     max-width: 1920px; margin: 0 auto;}
.tips_collection--main{
  background: var(--tips-primary-clr);
}

.tips_collection-left-inner, .tips_collection-right {
  padding-top: clamp(22px, 6vw, 58px);
}

  .tips_collection-left-image img {
    max-width: clamp(70px, 16vw, 120px);
}
.tips_collection--products{ gap:calc(var(--tips-card-gap) * 1.5); padding-bottom: clamp(20px,8vw, 100px); }

.tips_collection-left-inner {
  gap: calc(var(--tips-card-gap) + 4px );
  flex-direction: column;
  position:sticky;
  top:0;
}

.tips_collection-left {
  flex: 20%;
}

.tips_collection-left-desc {
  max-width: 295px;
}
  
.tips_collection-right {
  flex: 80%;
}


.tips_gird--item {
  background-color: var(--tips-card-clr);
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  row-gap: var(--tips-card-gap);
  justify-content: center;
  align-items: center;
  border-radius: var(--tips-radius);
  padding: 22px 30px 40px;
}

.tips_grid--top {
  display: flex;
  justify-content: center;
  height: 100%;
  width: 100%;
  border-radius: calc(var(--tips-radius) + 1px);
  overflow: hidden;
}


.tips_grid--top img {
object-fit: scale-down;
  aspect-ratio: 0.9 / 1;
  object-position: bottom;
}
  

.tips_grid--center {
  text-align: center;
  display: flex;
  flex-direction: column;
  row-gap: 10px;
  justify-content: center;
  align-items: center;
}
  
.tips_grid--center p {
  max-width: 240px;
}

.tips_grid--bottom p {
  padding: 0;
  font-family: Switzer-Bold !important;
}

.tips_cta-primary .staggered-item:hover {background-color: #231F20;}
.tips_cta-primary .staggered-item {
  display: inline-flex;
background:#FFFFFF;
  padding:16px 32px;
  
  font-size: 16px;
  border-radius:50px;
  transition:.2s all linear;
  transition-delay:.2s;
}

.tips_cta-primary .hover-text {
  color: #949591;
  } 

.tips_collection--personal{background:#949591;}
.personal_inner{ padding-top:clamp(40px, 5vw, 100px); padding-bottom:clamp(30px, 4vw, 50px);}
.personal_left {
  flex: 50%;
  display: flex;
  flex-direction: column;
  row-gap: 30px;
}

  .personal_left-top h3 {
  font-size: clamp(24px, 4vw, 38px);
    margin-bottom: 12px;
}
  .personal_left-top p {
  padding: 0;
    max-width: 380px;
  color: var(--new-black);
  font-size: 16px;
}
  .personal_right {
  flex: 80%;
}



  .tips_content-container h3 {
  margin-bottom: 10px;
}
  
.site-footer:not(.tips-footer.site-footer), #SiteHeader, .mobile-top-bar, .toolbar{display:none;}





  @media only screen and (max-width:768px){
    .personal_inner{flex-wrap:wrap;         row-gap: 30px;}
    .tips_collection-left-desc {
    max-width: 100%;
}
    .tips_collection--products{flex-wrap:wrap;}
      .personal_left-top, .personal_left-bottom, .personal_left-bottom .tips_cta-primary .staggered-item  { width:100%; }
 .tips_collection-right{padding:0px;}
    .personal_left-top h3{font-size: 42px;}
    .tips_collection-banner img {
    width: 100%;
}
  }

  
</style>