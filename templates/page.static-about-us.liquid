}

.about_us-page-content :is(picture, img, video, svg) { display: flex; }
.about_us-page-content :is(picture, img) { height: auto; width: 100%; }
:is(h1, .font-large) { --font-large: clamp(24px, 4.4vw, 48px); font-size: var(--font-large); line-height: var(--font-large); text-transform: uppercase; }
:is(h2:not(.font-large), .font-heading) { --font-heading: clamp(22px, 3.2vw, 32px); font-size: var(--font-heading); line-height: var(--font-heading); text-transform: none; }
:is(h3, .font-title) { --font-title: 20px; font-size: var(--font-title); line-height: calc(var(--font-title) + clamp(4px, 0.5vw, 10px)); text-transform: none; }
:is(h4, .font-subtitle) { --font-subtitle: clamp(16px, 1.4vw, 18px); font-size: var(--font-subtitle); line-height: calc(var(--font-subtitle) + clamp(4px, 0.5vw, 8px)); text-transform: none; }
:is(h5, .font-paragraph) { --font-paragraph: 16px; font-size: var(--font-paragraph); line-height: var(--font-paragraph); text-transform: none; }
:is(p) { font-size: 14px; padding: 0px; }
.about_us-page-content { display: flex; flex-direction: column; row-gap: clamp(38px, 8vw, 125px); }


