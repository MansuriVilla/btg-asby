    "new_faq_section_FPTrA9": {
      "type": "new-faq-section",
      "blocks": {
        "faq_item_JVyPkY": {
          "type": "faq_item",
          "settings": {
            "question": "How loud is the 360° audio compared to the Player+?",
            "answer": "<p>Player Pro uses a redesigned acoustic chamber that pushes sound evenly in all directions, not just forward. It gets significantly louder without distorting, and golfers can hear crisp vocals and bass even when the speaker is mounted on the cart, bag, or behind them on the tee box.</p>"
          }
        },
        "faq_item_3JKyLH": {
          "type": "faq_item",
          "settings": {
            "question": "Does the 360° audio actually help during a round?",
            "answer": "<p>Yes — because it doesn’t “beam” sound at one direction like a traditional speaker. Everyone around the cart hears the same balanced audio without having to constantly rotate the device or fight dead spots.</p>"
          }
        },
        "faq_item_EqLqCa": {
          "type": "faq_item",
          "settings": {
            "question": "How responsive is the touchscreen outdoors?",
            "answer": "<p>The full-color touchscreen is specifically tuned for sunlit environments. It resists glare, registers taps through light moisture (rain, sweat), and remains responsive even with golf gloves on.</p>"
          }
        },
        "faq_item_8hCyQg": {
          "type": "faq_item",
          "settings": {
            "question": "Can I keep score on the device without using the app?",
            "answer": "<p>Yes. On-device scoring works 100% standalone. Whether you’re tracking a solo round or filling in a friend's score, the Player Pro saves everything locally and syncs automatically when connected to the GAME ecosystem.</p>"
          }
        },
        "faq_item_GxHW8Y": {
          "type": "faq_item",
          "settings": {
            "question": "What does “unlimited pairing via Auracast” actually mean?",
            "answer": "<p>Auracast lets you link as many Player Pro speakers as you want in real time.<br/>Attach them to different carts, or spread them around a short-game area — they all play in perfect sync with zero Bluetooth lag. It’s ideal for tournaments, outings, or range sessions where multiple speakers enhance the environment.</p>"
          }
        },
        "faq_item_ehHaxe": {
          "type": "faq_item",
          "settings": {
            "question": "How accurate are the AI club recommendations?",
            "answer": "<p>SCOUT AI analyzes your distances, tendencies, and previous shot patterns to suggest the right club. It gets smarter the more you play — it’s not generic “club range advice,” but adaptive recommendations based on you.</p>"
          }
        },
        "faq_item_kqeffP": {
          "type": "faq_item",
          "settings": {
            "question": "Can I turn off the AI audible callouts if I prefer silence?",
            "answer": "<p>Yes. You can customize what’s spoken aloud:</p><ul><li>Yardages only</li><li>Hazard warnings only</li><li>Club recommendations</li><li>Timer updates</li><li>Or fully silent mode</li></ul><p>You stay in full control of how much (or how little) the device talks.</p>"
          }
        },
        "faq_item_qQDpgJ": {
          "type": "faq_item",
          "settings": {
            "question": "Does the IP67 waterproof rating matter in real golf conditions?",
            "answer": "<p>Absolutely. IP67 means Player Pro can withstand heavy rain, wet carts, splashes from water bottles, or sandy bunker conditions. Even if you accidentally drop it into a puddle, it stays fully functional.</p>"
          }
        },
        "faq_item_7g8YDq": {
          "type": "faq_item",
          "settings": {
            "question": "Will the magnet hold on fast-moving carts or rough terrain?",
            "answer": "<p>Yes — the heavy-duty magnet is upgraded to withstand cart vibration, rough cart paths, and off-road conditions. It’s strong enough that the device feels “locked in” with no rattling.</p>"
          }
        },
        "faq_item_9bHjD3": {
          "type": "faq_item",
          "settings": {
            "question": "What’s the upgraded mesh for promo printing used for?",
            "answer": "<p>The new mesh is designed so courses, brands, or tournaments can print high-quality, long-lasting logos without dulling the acoustics. It’s ideal for corporate gifting or custom-event runs.</p>"
          }
        },
        "faq_item_kM7U8r": {
          "type": "faq_item",
          "settings": {
            "question": "Are the FCB distances and hazard distances reliable on every course?",
            "answer": "<p>Yes — Player Pro uses the same Blue Tees course database with over 42K mapped courses globally. Front/center/back distances refresh automatically as you move, with hazard distances clearly shown for smarter shot planning.</p>"
          }
        },
        "faq_item_7eFLim": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use Player Pro just as a standalone GPS without music?",
            "answer": "<p>Absolutely. Many golfers use it purely for yardages and scoring. Music is totally optional.</p>"
          }
        },
        "faq_item_MKFcfy": {
          "type": "faq_item",
          "settings": {
            "question": "How accurate is the Driving Distance function?",
            "answer": "<p>The device uses real GPS tracking to measure the exact distance from your tee shot to your ball location. It’s not an estimate — it’s true ground tracking based on movement.</p>"
          }
        },
        "faq_item_HpNWhW": {
          "type": "faq_item",
          "settings": {
            "question": "Is the Round Timer useful?",
            "answer": "<p>Surprisingly useful. It helps keep pace of play, and many golfers use it to track practice intervals (e.g., 30-minute range sessions). It’s simple, but once you try it, it sticks.</p>"
          }
        },
        "faq_item_FLbHBx": {
          "type": "faq_item",
          "settings": {
            "question": "Is Player Pro too advanced for casual golfers?",
            "answer": "<p>Not at all. It’s incredibly intuitive out of the box.<br/><br/>You get the basics instantly:</p><ul><li>Yardages</li><li>Music</li><li>Scoring</li><li>Time/date</li></ul><p>And more advanced players unlock:</p><ul><li>AI club picks</li><li>Hazard planning</li><li>Detailed tracking</li><li>Multidevice audio</li><li>SCOUT AI callouts</li></ul><p>It grows with the golfer.</p>"
          }
        },
        "faq_item_nDy9fJ": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need my phone to use or control Player Pro?",
            "answer": "<p>No. Player Pro is fully functional on its own.<br/><br/>You can:</p><ul><li>View GPS distances</li><li>Track scores</li><li>Control music</li><li>Access core features</li></ul><p>—all directly from the touchscreen.<br/><br/>Pairing with your phone simply unlocks additional features like advanced analytics, AI recommendations, and app syncing. It enhances the experience, but it’s never required.</p>"
          }
        },
        "faq_item_aaBnWB": {
          "type": "faq_item",
          "settings": {
            "question": "Is audio pairing backward compatible with standard Bluetooth devices?",
            "answer": "<p>Auracast™ for next-generation, unlimited multi-device pairing<br/>Standard Bluetooth for traditional one-to-one connections<br/><br/>This means you can still connect to your phone, headphones, or older speakers just like any normal Bluetooth device—while also unlocking Auracast for larger group setups.</p>"
          }
        },
        "faq_item_H7YXMb": {
          "type": "faq_item",
          "settings": {
            "question": "How do Club Recommendations work?",
            "answer": "<p>When you first connect Player Pro to the GAME App, it starts with baseline club distances.<br/><br/>From there, it evolves:</p><ul><li>You can manually input your real distances</li><li>The system tracks your rounds over time</li><li>If you use other Blue Tees products like Rainmaker, it pulls in even richer data</li></ul><p>Over time, recommendations become personalized to your actual game, not generic averages.</p>"
          }
        },
        "faq_item_nDhnmt": {
          "type": "faq_item",
          "settings": {
            "question": "How can I access Personalized Advanced Analytics?",
            "answer": "<p>Pairing Player Pro with a GAME Membership unlocks a full analytics dashboard.<br/><br/>You’ll be able to:</p><ul><li>Track performance trends over time</li><li>Review shot dispersion and consistency</li><li>Analyze club distances and tendencies</li><li>Visualize your rounds with detailed data</li></ul><p>It turns your rounds into actionable insights, not just numbers.</p>"
          }
        },
        "faq_item_iPyNYH": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need to be on a golf course to use Player Pro?",
            "answer": "<p>Player Pro works as a premium Bluetooth speaker anywhere:</p><ul><li>Backyard hangouts</li><li>Beach days</li><li>Travel</li><li>Garage sessions</li><li>Parties</li></ul><p>Golf features are always there when you need them—but off the course, it’s just a high-quality, everyday speaker.</p>"
          }
        }
      },
