  <script>
    function videoControling(){
    
  document.getElementById('video_block-icon').addEventListener('click', function () {
    var video = document.getElementById('video_block-video');
    var icon = document.getElementById('video_block-icon');
   var text = document.querySelector('.video_overlay-content p');
  
    // When the icon is clicked, play the video, hide the icon, and unmute the video
    if (video.paused) {
      video.play();
      video.muted = false; // Unmute the video
      icon.style.display = 'none'; // Hide the pause icon when the video starts
      text.style.display = 'none';
    }
    
  });
  
  // Add event listener for the video itself to pause it when clicked
  document.getElementById('video_block-video').addEventListener('click', function () {
    var video = document.getElementById('video_block-video');
    var icon = document.getElementById('video_block-icon');
    var text = document.querySelector('.video_overlay-content p');
  
    // Pause the video, mute it, and show the pause icon when the video is clicked
    if (!video.paused) {
      video.pause();
      video.muted = true; // Mute the video
      icon.style.display = 'block'; // Show the pause icon when the video is paused
      text.style.display = 'block'; // Show the pause icon when the video is paused
    }
  });
  
  // Add event listener for when the video ends
  document.getElementById('video_block-video').addEventListener('ended', function () {
    var video = document.getElementById('video_block-video');
    var icon = document.getElementById('video_block-icon');
   var text = document.querySelector('.video_overlay-content p');
    
  
    // Show the pause icon, reset the video to the start, and mute it when the video ends
    icon.style.display = 'block';
    text.style.display = 'block';
    video.currentTime = 0;
    video.muted = true; // Mute the video when it ends
  });
  
  
    
  }
  videoControling();
  
  
    // CHANGEING VALUE ON SCROLL
  function valueUpdate(){
  
  function scrollToSection(event) {
    event.preventDefault();
    const sectionId = event.target.value;     
    const section = document.getElementById(sectionId);
   
    if (section) {
      section.scrollIntoView({
        behavior: 'smooth',
        block: 'center'
      });
    
      setTimeout(() => {
        document.getElementById('sectionDropdown').value = sectionId;
      }, 500);
    }
  }
  
  const dropdown = document.getElementById('sectionDropdown');
  dropdown.addEventListener('change', scrollToSection);
  
  window.addEventListener('scroll', function() {
    const sections = document.querySelectorAll('div[id^="section"]');
    let currentSection = "";
    sections.forEach(section => {
      const rect = section.getBoundingClientRect();
      const sectionCenter = rect.top + rect.height / 2;
      if (sectionCenter >= 0 && sectionCenter <= window.innerHeight) {
        currentSection = section.id;
      }
    });
    const dropdown = document.getElementById('sectionDropdown');
    if (currentSection && dropdown.value !== currentSection) {
      dropdown.value = currentSection;
    }
  });
  }
  
  valueUpdate();



  
  </script>


