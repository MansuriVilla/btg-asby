    {% comment %}
    function stickingTop() {
      // Ensure GSAP and ScrollToPlugin are registered
      if (!gsap || !ScrollTrigger || !gsap.plugins.scrollTo) {
        console.error("GSAP, ScrollTrigger, or ScrollToPlugin is not loaded.");
        return;
      }

      const isMobileTitle = window.innerWidth <= 768;

      // const triggerStart = isMobileTitle ? "top top " : "top top";
      const triggerEnd = isMobileTitle ? "top 18%" : "top 35%";

      // Pinning the slider_area (slides), stopping when .measure_area top reaches viewport top
      gsap.to(".slider_area", {
        scrollTrigger: {
          trigger: ".play_area-top",
          start: "top top",
          endTrigger: ".measure_area",
          end: triggerEnd,
          pin: true,
          pinSpacing: false,
          markers: true,
        },
      });

      // Sync titles with scroll and handle title scrolling
      const areas = [
        { element: document.querySelector(".play_area"), titleIndex: 0 },
        { element: document.querySelector(".track_area"), titleIndex: 1 },
        { element: document.querySelector(".measure_area"), titleIndex: 2 },
      ];
      const sliderTitles = document.querySelectorAll(".slider-title");
      const titleContainer = document.querySelector(".slider-titles");

      // Check if required elements exist
      if (!titleContainer || sliderTitles.length === 0) {
        console.error("Title container or titles not found.");
        return;
      }

      // Dynamically set the width of the title container based on device width
      function updateTitleContainerWidth() {
        const isMobile = window.matchMedia("(max-width: 768px)").matches;
        if (isMobile) {
          titleContainer.style.width = `${window.innerWidth}px`;
        }
        console.log("Dynamic Width Set:", titleContainer.style.width);
      }

      // Update width on load and resize
      updateTitleContainerWidth();
      window.addEventListener("resize", updateTitleContainerWidth);

      // Function to scroll to active title ensuring full visibility
      function scrollToActiveTitle() {
        const activeTitle = Array.from(sliderTitles).find((title) =>
          title.classList.contains("section_in-view")
        );
        if (activeTitle && titleContainer) {
          const containerRect = titleContainer.getBoundingClientRect();
          const titleRect = activeTitle.getBoundingClientRect();
          const ContainerScrollLeft = titleContainer.scrollLeft;
          const scrollX = activeTitle.offsetLeft;
          const titleWidth = activeTitle.offsetWidth;
          const containerWidth = containerRect.width;
          const containerScrollWidth = titleContainer.scrollWidth;
          let adjustedScrollX = scrollX;

          // Adjust scroll to bring the active title fully into view
          // Scroll to the left edge of the title, pushing others out
          adjustedScrollX = scrollX;

          // Ensure the scroll stays within bounds
          adjustedScrollX = Math.max(
            0,
            Math.min(adjustedScrollX, containerScrollWidth - containerWidth)
          );

          gsap.to(titleContainer, {
            scrollTo: {
              x: adjustedScrollX,
              autoKill: false,
            },
            duration: 0.5,
            ease: "power2.out",
            onComplete: () =>
              console.log(
                "Scroll animation completed, new ScrollLeft:",
                titleContainer.scrollLeft
              ),
          });
        }
      }

      // Check if the device is mobile (screen width <= 768px)
      const isMobile = window.matchMedia("(max-width: 768px)").matches;

      areas.forEach((area, index) => {
