        onComplete: () =>
          console.log(
            "Scroll animation completed, new ScrollLeft:",
            titleContainer.scrollLeft
          ),
      });
    }
  }

  // Check if the device is mobile (screen width <= 768px)
  const isMobile = window.matchMedia("(max-width: 768px)").matches;

  areas.forEach((area, index) => {
    if (!area.element) {
      console.warn(`Area element at index ${index} not found.`);
      return;
    }

    const isUltraDesktop = window.innerWidth <= 1921;
    const triggerStart = isUltraDesktop ? "top 55%" : "20% 45%";
    const triggerEnd = isUltraDesktop ? "bottom bottom" : "bottom bottom";

    ScrollTrigger.create({
      trigger: area.element,
      start: triggerStart,
      end: triggerEnd,
      markers: false,
      invalidateOnRefresh: true, // Recalculate on resize
      onEnter: () => {
        sliderTitles.forEach((title, titleIndex) => {
          title.classList.toggle(
            "section_in-view",
            titleIndex === area.titleIndex
          );
        });
        if (isMobile) {
          scrollToActiveTitle();
        }
      },
      onEnterBack: () => {
        sliderTitles.forEach((title, titleIndex) => {
          title.classList.toggle(
            "section_in-view",
            titleIndex === area.titleIndex
          );
        });
        if (isMobile) {
          scrollToActiveTitle();
        }
      },
    });
  });

  // Add mutation observer to detect class changes and scroll dynamically
  const observer = new MutationObserver((mutations) => {
    if (isMobile) {
      scrollToActiveTitle();
    }
  });
  sliderTitles.forEach((title) => {
    observer.observe(title, {
      attributes: true,
      attributeFilter: ["class"],
    });
  });
}

// Initialize after DOM is loaded and layout is stable
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => {
    // Small delay to ensure layout is calculated
    requestAnimationFrame(() => {
      stickingTop();
    });
  });
} else {
  requestAnimationFrame(() => {
    stickingTop();
  });
}

</script>
