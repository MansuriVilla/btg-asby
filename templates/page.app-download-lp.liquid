    function slideInView() {
      const container = document.querySelector(
        ".slide_in-view__container"
      );
      const rowContainer = document.querySelector(
        ".slide_in-view__container .slide_in-view__row"
      );
      const imagesContainer = document.querySelector(".slide_in-view__images");
      const images = imagesContainer ? imagesContainer.querySelectorAll(".slide_in-view__image") : [];

      if (!container || !rowContainer || !imagesContainer || images.length === 0) {
        console.warn("Slide-in view elements not found");
        return;
      }
      let originalImagesWidth = 0;
      images.forEach((img) => {
        const style = window.getComputedStyle(img);
        const marginLeft = parseFloat(style.marginLeft);
        const marginRight = parseFloat(style.marginRight);
        originalImagesWidth += img.offsetWidth + marginLeft + marginRight;
      });

      // Clone images
      images.forEach((img) => {
        const clone = img.cloneNode(true);
        imagesContainer.appendChild(clone);
      });

      let initSlides = false;
      let marqueeTween = null;
      let isPlaying = true;

      ScrollTrigger.create({
        trigger: rowContainer,
        start: "top 95%",
        markers: false,
        onEnter: () => {
          if (initSlides) return;
          initSlides = true;

          gsap.set(".slide_in-view__images .slide_in-view__image", {
            opacity: 0,
            x: "100%",
          });

          gsap.to(".slide_in-view__images .slide_in-view__image", {
            opacity: 1,
            x: "0%",
            duration: 1.6,
            stagger: 0.1,
            ease: "power4.out",
          });

          marqueeTween = gsap.to(imagesContainer, {
            x: -originalImagesWidth,
            ease: "none",
            duration: 80,
            repeat: -1,
          });

          if (!isPlaying) {
            marqueeTween.pause();
          }
        },
      });

      // Pause on hover over the slider row specifically
      rowContainer.addEventListener("mouseenter", () => {
        if (marqueeTween && isPlaying) {
          marqueeTween.pause();
        }
      });
      rowContainer.addEventListener("mouseleave", () => {
        if (marqueeTween && isPlaying) {
          marqueeTween.play();
        }
      });

      const controlBtn = document.querySelector('.slide_in-view__container #carousel-control-btn');
      if (controlBtn) {
        function toggleSlider() {
          if (!marqueeTween) return;
          const pauseIcon = controlBtn.querySelector('.pause-icon');
          const playIcon = controlBtn.querySelector('.play-icon');

          if (isPlaying) {
            marqueeTween.pause();
            isPlaying = false;
            controlBtn.setAttribute('aria-pressed', 'true');
            controlBtn.setAttribute('aria-label', 'Play reviews carousel');
            if (pauseIcon) pauseIcon.style.display = 'none';
            if (playIcon) playIcon.style.display = 'inline';
          } else {
            marqueeTween.play();
            isPlaying = true;
            controlBtn.setAttribute('aria-pressed', 'false');
            controlBtn.setAttribute('aria-label', 'Pause reviews carousel');
            if (pauseIcon) pauseIcon.style.display = 'inline';
            if (playIcon) playIcon.style.display = 'none';
          }
        }

        controlBtn.addEventListener('click', toggleSlider);
        controlBtn.addEventListener('keydown', (e) => {
          if (e.key === ' ' || e.key === 'Enter') {
            e.preventDefault();
            toggleSlider();
          }
        });
      }

      ScrollTrigger.refresh();
    }
