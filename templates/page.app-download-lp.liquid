    function featuresItemsFn(){

      const featureItems = document.querySelectorAll(".features_item");
      const featureMockups = document.querySelectorAll(".feature__mockup");
      let autoplayInterval = null;
      const AUTOPLAY_INTERVAL = 5000; // 5 seconds
      let progressBar = null;
      let isCarouselActive = false;
    
      const isMobile = () => window.matchMedia("(max-width: 991px)").matches;
    
      function createProgressBar() {
        const progressBarContainer = document.createElement("div");
        progressBarContainer.className = "carousel-progress-container";
        const progressBar = document.createElement("div");
        progressBar.className = "carousel-progress-bar";
        progressBarContainer.appendChild(progressBar);
        const featuresItems = document.querySelector(".top-features__items");
        featuresItems.parentElement.insertBefore(
          progressBarContainer,
          featuresItems.nextSibling
        );
        return progressBar;
    }
  
    function resetProgressBar() {
      if (progressBar) {
        progressBar.style.animation = "none";
        progressBar.offsetHeight; // Trigger reflow
        progressBar.style.animation = "progress 5s linear forwards";
      }
    }
  
    function centerActiveItem() {
      if (isMobile()) {
        const activeItem = document.querySelector(".features_item.active");
        if (activeItem) {
          const container = document.querySelector(".top-features__items");
          const containerWidth = container.offsetWidth;
          const itemWidth = activeItem.offsetWidth;
          const itemOffset = activeItem.offsetLeft;
          const scrollPosition = itemOffset - containerWidth / 2 + itemWidth / 2;
          container.scrollTo({
            left: scrollPosition,
            behavior: "smooth",
          });
        }
      }
    }
  
    function setActiveFeature(index) {
      // Remove active classes
      featureItems.forEach((i) => i.classList.remove("active"));
      featureMockups.forEach((m) => m.classList.remove("active"));
  
      // Set new active item
      const newItem = featureItems[index];
      newItem.classList.add("active");
  
      // Set corresponding mockup
      const featureId = newItem.getAttribute("data-feature");
      const correspondingMockup = document.querySelector(
        `.feature__mockup[data-feature="${featureId}"]`
      );
      if (correspondingMockup) {
        correspondingMockup.classList.add("active");
      }
  
      // Update progress bar and centering for mobile
      if (isMobile()) {
        resetProgressBar();
        centerActiveItem();
      }
    }
  
    function switchToNextFeature(currentIndex) {
      const nextIndex = (currentIndex + 1) % featureItems.length;
      setActiveFeature(nextIndex);
      return nextIndex;
    }
  
    function stopAutoplay() {
      if (autoplayInterval) {
        clearInterval(autoplayInterval);
        autoplayInterval = null;
      }
      if (progressBar) {
        progressBar.style.animationPlayState = "paused";
      }
    }

    function startAutoplay() {
      if (autoplayInterval) {
        clearInterval(autoplayInterval);
      }
      if (progressBar) {
        progressBar.style.animationPlayState = "running";
      }
      let currentIndex =
        Array.from(featureItems).findIndex((item) =>
          item.classList.contains("active")
        ) || 0;
      autoplayInterval = setInterval(() => {
        currentIndex = switchToNextFeature(currentIndex);
      }, AUTOPLAY_INTERVAL);
    }
  
    function initializeCarousel() {
      isCarouselActive = isMobile();
      if (isCarouselActive && !progressBar) {
        progressBar = createProgressBar();
        resetProgressBar();
        centerActiveItem();
      } else if (!isCarouselActive && progressBar) {
        progressBar.parentElement.style.display = "none";
      }
  
      // Set up click handlers
      featureItems.forEach((item, index) => {
        item.addEventListener("click", () => {
          setActiveFeature(index);
          startAutoplay(); // Restart autoplay immediately on click
        });
      });

      // Pause on hover over top features section
      const topFeaturesSection = document.querySelector(".top-features__section");
      if (topFeaturesSection) {
        topFeaturesSection.addEventListener("mouseenter", () => {
          stopAutoplay();
        });
        topFeaturesSection.addEventListener("mouseleave", () => {
          startAutoplay();
        });
      }
  
      // Start autoplay
      startAutoplay();
  
      // Handle window resize
      window.addEventListener("resize", () => {
        const nowMobile = isMobile();
        if (nowMobile && !isCarouselActive) {
          isCarouselActive = true;
          if (!progressBar) {
            progressBar = createProgressBar();
          }
          progressBar.parentElement.style.display = "block";
          resetProgressBar();
          centerActiveItem();
          startAutoplay();
        } else if (!nowMobile && isCarouselActive) {
          isCarouselActive = false;
          if (autoplayInterval) {
            clearInterval(autoplayInterval);
          }
          if (progressBar) {
            progressBar.parentElement.style.display = "none";
          }
          startAutoplay(); // Restart for desktop behavior
        }
      });
    }
  
    initializeCarousel();
  }
  featuresItemsFn();
