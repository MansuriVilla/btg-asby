        );

        gsap.to(titleContainer, {
          scrollTo: {
            x: adjustedScrollX,
            autoKill: false,
          },
          duration: 0.5,
          ease: "power2.out",
          onComplete: () =>
            console.log(
              "Scroll animation completed, new ScrollLeft:",
              titleContainer.scrollLeft
            ),
        });
      }
    }

    // Check if the device is mobile (screen width <= 768px)
    const isMobile = window.matchMedia("(max-width: 768px)").matches;

    areas.forEach((area, index) => {
      if (!area.element) {
        console.warn(`Area element at index ${index} not found.`);
        return;
      }

      const isUltraDesktop = window.innerWidth <= 1921;
      const triggerStart = isUltraDesktop ? "top 55%" : "20% 45%";
      const triggerEnd = isUltraDesktop ? "bottom bottom" : "bottom bottom";

      ScrollTrigger.create({
