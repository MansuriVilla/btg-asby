  }

  // Initialize after DOM is loaded and layout is stable
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      // Small delay to ensure layout is calculated
      requestAnimationFrame(() => {
        stickingTop();
      });
    });
  } else {
    requestAnimationFrame(() => {
      stickingTop();
    });
