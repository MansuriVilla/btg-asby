<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
{%- render 'cart-drawer' -%}

<div class="site_page_header">
  <div class="site_page_headerInner page-width">
    <div class="site_page_headerLeft">
      <a href="/"> <img src="{{ 'blueTees-header-logoss.png' | asset_url }}" alt="Blue Tees Golf Logo"></a>
      <span><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="1.41174" y="0.000976562" width="19.2564" height="1.99609" transform="rotate(45 1.41174 0.000976562)"
            fill="white" />
          <rect x="15.032" y="1.41016" width="19.2564" height="1.99609" transform="rotate(135 15.032 1.41016)"
            fill="white" />
        </svg>
      </span>
      <a href="https://upperdeckgolfing.com/"> <img src="{{ 'upperdeck-logo.png' | asset_url }}"
          alt="UPPER DECK GOLF LOGO"></a>
    </div>
    <div class="site_page_headerRight cartArea_page">
      <a href="{{ routes.cart_url }}" class="cart_custom site-nav__link site-nav__link--icon js-drawer-open-cart" aria-controls="CartDrawer" data-icon="{{ settings.cart_icon }}">
        <span class="cart-link">
          {%- if settings.cart_icon == 'cart' -%}
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-cart" viewBox="0 0 64 64"><path fill="none" d="M14 17.44h46.79l-7.94 25.61H20.96l-9.65-35.1H3"/><circle cx="27" cy="53" r="2"/><circle cx="47" cy="53" r="2"/></svg>
          {%- elsif settings.cart_icon == 'bag-minimal' -%}
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-bag-minimal" viewBox="0 0 64 64"><path stroke="null" id="svg_4" fill-opacity="null" stroke-opacity="null" fill="null" d="M11.375 17.863h41.25v36.75h-41.25z"/><path stroke="null" id="svg_2" d="M22.25 18c0-7.105 4.35-9 9.75-9s9.75 1.895 9.75 9"/></svg>
          {%- else -%}
            <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-bag" viewBox="0 0 64 64"><g fill="none" stroke="var(--new-black)" stroke-width="2"><path d="M25 26c0-15.79 3.57-20 8-20s8 4.21 8 20"/><path d="M14.74 18h36.51l3.59 36.73h-43.7z"/></g></svg>
          {%- endif -%}
          <span class="icon__fallback-text">{{ 'layout.cart.title' | t }}</span>
          <span class="cart-link__bubble{% if cart.item_count > 0 %} cart-link__bubble--visible{% endif %}"></span>
        </span>
      </a>
    </div>
  </div>
</div>


