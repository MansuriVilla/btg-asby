<script>
  document.addEventListener("DOMContentLoaded", function () {

    function velocitySlider() {
      const sliders = document.querySelectorAll(".siteVelocity__slider");
      const baseSpeed = 0.5; // Base speed in pixels per frame when no scroll is applied.
      // Change this to set the default movement speed.

      sliders.forEach(slider => {
        let images = Array.from(slider.children);
        const imgWidth = images[0].offsetWidth + 20;
        const totalWidth = imgWidth * images.length;

        // Clone images until the slider’s content is wide enough for a seamless loop.
        while (slider.offsetWidth < window.innerWidth + totalWidth) {
          images.forEach(img => {
            let clone = img.cloneNode(true);
            slider.appendChild(clone);
          });
          images = Array.from(slider.children);
        }

        let position = 0;
        let extraSpeed = 0; // Additional speed added on top of baseSpeed due to scrolling.
        let speed = baseSpeed; // Actual speed = baseSpeed + extraSpeed.

        function animate() {
          // Update speed based on current extraSpeed.
          speed = baseSpeed + extraSpeed;
          position += speed;

          // Wrap the position seamlessly.
          if (position >= totalWidth) {
            position -= totalWidth;
          } else if (position <= -totalWidth) {
            position += totalWidth;
          }

          slider.style.transform = "translateX(" + (-position) + "px)";

          // Gradually decay extraSpeed toward 0 (simulate friction).
          // Adjust the decay factor (0.95) to control how fast it returns to baseSpeed.
          extraSpeed *= 0.95;

          requestAnimationFrame(animate);
        }

        // Listen for wheel events to adjust extraSpeed.
        window.addEventListener("wheel", function (event) {
          // Get the scroll delta (positive for down, negative for up).
          let delta = event.deltaY || -event.wheelDelta;
          // Determine scroll direction: scrolling down adds positive speed; scrolling up subtracts.
          let direction = delta > 0 ? 1 : -1;

          // Adjust the acceleration factor here.
          // The multiplier (0.01) controls how much extraSpeed is added per scroll event.
          // Increase this value (e.g., 0.02) for a more sensitive response.
          // The Math.min() clamp (0.5) controls the maximum acceleration added per event.
          let acceleration = Math.min(Math.abs(delta) * 0.01, 0.5);
          extraSpeed += direction * acceleration;

          // Clamp extraSpeed to avoid runaway speeds.
          if (extraSpeed > 5) extraSpeed = 5;
          if (extraSpeed < -5) extraSpeed = -5;
        });

        animate();
      });
    }

    velocitySlider();





    function videoPlayOnHover() {
      const videos = document.querySelectorAll(".videoPlays__Hover"); // Select all matching elements

      if (!videos.length) return;

      videos.forEach(video => {
        video.setAttribute("playsinline", "true");
        video.setAttribute("webkit-playsinline", "true");

        if (/Mobi|Android|iPhone|iPad/i.test(navigator.userAgent)) {
          video.setAttribute("autoplay", "true");
          video.setAttribute("muted", "true");
          video.play();
        } else {
          // For desktop: play on hover and pause when not hovered
          video.addEventListener("mouseenter", () => video.play());
          video.addEventListener("mouseleave", () => video.pause());
        }
      });
    }

    videoPlayOnHover();
{% comment %} 
    function splittingEffect() {
      const targets = document.querySelectorAll('.has_splitting--effect');

      if (!targets.length) {
        console.warn('No elements found with class .has_splitting--effect');
        return;
      }

      targets.forEach((target, index) => {
        try {
          const originalText = target.textContent.trim();


          const words = originalText
            .split(/\s+/)
            .filter(word => word.length > 0);

          target.innerHTML = '';

          const wrapper = document.createElement('div');
          wrapper.className = 'splitting-words-wrapper';


          words.forEach(word => {
            const wordWrapper = document.createElement('span');
            wordWrapper.className = 'has-splitting-word';
            wordWrapper.textContent = word + ' ';
            wrapper.appendChild(wordWrapper);
          });

          target.appendChild(wrapper);


          gsap.set(target.querySelectorAll('.has-splitting-word'), {
            opacity: 0,
            y: 50
          });


          gsap.to(target.querySelectorAll('.has-splitting-word'), {
            opacity: 1,
            y: 0,
            duration: .9,
            stagger: 0.06,
            ease: "linear",
            scrollTrigger: {
              trigger: target,
              start: 'top bottom',
              toggleActions: 'play none none reverse',
            }
          });
        } catch (error) {
          console.error(`Error processing splitting effect for element ${index}:`, error);
        }
      });
    }
    splittingEffect(); {% endcomment %}

    function scalingImageEffect() {
      const images = document.querySelectorAll('.scaling_image-img');

      if (!images.length) {
        console.warn('No elements found with class .scaling_image-img');
        return;
      }

      images.forEach((image) => {
        gsap.fromTo(
          image,
          { scale: 1.5 },
          {
            scale: 1,
            duration: 1,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: image,
              start: 'top bottom',
              end: 'bottom top',
              scrub: true,
            }
          }
        );
      });
    }
    scalingImageEffect();

  });
</script>

<script>
$(document).on('click', '.playMakerPlus_cta', function (e) {
    e.preventDefault();
    var $button = $(this);
    $button.addClass('btn--loading');

    var productId = 44502565191877;
    var formParams = {
        id: productId
    };

    // Always add product to cart (without checking if it already exists)
    $.ajax({
        url: '/cart/add.js',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(formParams),
        success: function() {
            applyDiscount();
        },
        error: function(err) {
            console.error('Error adding product:', err);
            $button.removeClass('btn--loading');
        }
    });

    return false;
});

// Function to apply the discount code by redirecting to checkout
function applyDiscount() {
    window.location.href = "/checkout?discount=UPPERDECK40"; // Replace with your actual discount code
}
</script>


