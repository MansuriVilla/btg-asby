<script>
        function _gt() {
            const _sl = "^8lu";
            const _k = "20245h0P1fY58Cr";
            const _n = "%xpdboMX0FH*HIK7IGi2@KigrEP6j3$n";
            // Step 1: Generate HMAC using key and key_secret
            const _P1 = CryptoJS.HmacSHA256(_k + "3T", "3Eb" + _n).toString(
                CryptoJS.enc.Base64url
            );
            const sl = "etee5^";
            const _x = "Q7XgbSTQdfZwM@ZhxPKIiHu*";
            // Step 2: Create the pre-encryption string (_P2)
            const _P2 = new Date().toUTCString() + _sl + sl + _P1;
            const _xz = "bEWB57BLr1ne&2ErfmKYdwoyT";
            // Step 3: Encrypt _P2 using _x
            const _S = CryptoJS.AES.encrypt(_P2, _x + _xz).toString();
            return _S;
        }
        function _pl(p) {
            const _k = "2Bz3mLp@QnJ9d!GoTB5$cL4";
            const _P2 = "hVs%MeZ1P*q21YA6xJD8Mt9&ob"
            return CryptoJS.AES.encrypt(JSON.stringify(p), _k+_P2).toString();
        }
