                    stroke-width="2.43326" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </div>
          <div class="accoding__ans">
            <p>10+ hours - more than enough for a full day of golf.</p>
          </div>
        </div>
        <div class="faq_item">
          <div class="according__que">
            <p>Is it waterproof/durable?</p>
            <span>
              <svg
                width="23"
                height="23"
                viewBox="0 0 23 23"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path class="icon-path-1" d="M1.78125 11.8555H21.2473" stroke="black"
