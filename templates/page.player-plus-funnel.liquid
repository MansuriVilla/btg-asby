</style>

<script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollToPlugin.min.js" defer="defer"></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    function ticker() {
      gsap.registerEffect({
        name: 'ticker',
        effect(targets, config) {
          buildTickers({
            targets: targets,
            clone:
              config.clone ||
              ((el) => {
                let clone = el.children[0].cloneNode(true);
                el.insertBefore(clone, el.children[0]);
                return clone;
              }),
          });
          function buildTickers(config, originals) {
            let tickers;
            if (originals && originals.clones) {
              originals.clones.forEach((el) => el && el.parentNode && el.parentNode.removeChild(el));
              originals.forEach((el, i) =>
                originals.inlineWidths[i]
                  ? (el.style.width = originals.inlineWidths[i])
                  : el.style.removeProperty('width')
              );
              tickers = originals;
            } else {
              tickers = config.targets;
            }
            const clones = (tickers.clones = []),
              inlineWidths = (tickers.inlineWidths = []);
            tickers.forEach((el, index) => {
              inlineWidths[index] = el.style.width;
              el.style.width = '10000px';
              el.children[0].style.display = 'inline-block';
              let width = el.children[0].offsetWidth,
                cloneCount = Math.ceil(window.innerWidth / width),
                right = el.dataset.direction === 'right',
                i;
              el.style.width = width * (cloneCount + 1) + 'px';
              for (i = 0; i < cloneCount; i++) {
                clones.push(config.clone(el));
              }
              gsap.fromTo(
                el,
                {
                  x: right ? -width : 0,
                },
                {
                  x: right ? 0 : -width,
                  duration: width / 100 / parseFloat(el.dataset.speed || 1),
                  repeat: -1,
                  overwrite: 'auto',
                  ease: 'none',
                }
              );
            });
            originals || window.addEventListener('resize', () => buildTickers(config, tickers));
          }
        },
      });

      gsap.effects.ticker('.hero__ticker-init');
    }
    ticker();

    function animateStaggeredSections() {
      // Select all elements with the data-stagger-container attribute
      const containers = document.querySelectorAll('[data-stagger-container]');
      // Determine offset based on window width
      const startisMobile = window.innerWidth < 768;
      const start = startisMobile ? 'top 85%' : 'top 80%';
      // Loop through each container to create an independent animation for each
      containers.forEach((container) => {
        gsap.from(container.children, {
          opacity: 0,
          y: 20,
          stagger: 0.08,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: container,
            start: start,
            toggleActions: 'play none none none',
          },
        });
      });
    }
    animateStaggeredSections();

    function imageRevealinti() {
      const sections = document.querySelectorAll('.limited-time__mockup, .ready_play-right');

      sections.forEach((section) => {
        const images = section.querySelectorAll('.image_reveal-init');

        if (images.length > 0) {
          images.forEach((image) => {
            gsap.set(image, {
              clipPath: 'inset(0 0 100% 0)',
              webkitClipPath: 'inset(0 0 100% 0)',
              opacity: 0,
            });

            const animate = () => {
              gsap.to(image, {
                clipPath: 'inset(0 0 100% 0)',
                webkitClipPath: 'inset(0 0 100% 0)',
                opacity: 1,
                duration: 2,
                ease: 'power2.inOut',
                delay: Math.random() * 0.2,
                onStart: () => image.classList.add('reveal-active'),
              });
            };

            if (image.complete) {
            } else {
              image.onload = animate;
            }
          });

          ScrollTrigger.create({
            trigger: section,

            start: '0% 85%',

            once: true,
            onEnter: () => {
              images.forEach((image) => {
                gsap.to(image, {
                  clipPath: 'inset(0 0 0% 0)',
                  webkitClipPath: 'inset(0 0 0% 0)',
                  opacity: 1,
                  duration: 0.5,
                  ease: 'power2.inOut',
                  delay: Math.random() * 0.2,
                  onStart: () => image.classList.add('reveal-active'),
                });
              });
            },
          });
        }
      });
    }
    imageRevealinti();

    function faq() {
      document.querySelectorAll('.according__que').forEach((title) => {
        title.addEventListener('click', () => {
          const desc = title.nextElementSibling;
          const isOpen = desc.style.height === '0px' || desc.style.height === '';

          if (isOpen) {
            desc.style.height = 'auto';
            const height = desc.scrollHeight + 'px';
            desc.style.height = '0px';
            gsap.to(desc, {
              height: height,
              duration: 0.5,
              ease: 'power2.out',
              onComplete: () => {
                desc.style.height = 'auto';
              },
            });

            title.classList.add('active');
          } else {
            gsap.to(desc, {
              height: '0px',
              duration: 0.5,
              ease: 'power2.out',
              onComplete: () => {
                desc.style.height = '';
              },
            });

            title.classList.remove('active');
          }
        });
      });
    }
    faq();

    function anchorLink() {
      gsap.registerPlugin(ScrollToPlugin);
      document.querySelectorAll('.get_fifty').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          // Determine offset based on window width
          const isMobile = window.innerWidth < 768;
          const offsetY = isMobile ? 50 : 150;
          gsap.to(window, {
            duration: 0.5,
            scrollTo: {
              y: '#get_fifty',
              offsetY: offsetY,
            },
            ease: 'linear',
          });
        });
      });
    }
    anchorLink();
  });

  function tabSlider() {
    let currentIndex = 0;
    const images = document.querySelectorAll('.am-slider_img--item');
    const headings = document.querySelectorAll('.am-slider_text--item');
    const descriptions = document.querySelectorAll('.am-slider_discription--item');
    const headingsContainer = document.querySelector('.am-slider_text-heading--flex--flex-center');
    let interval;

    // Check if required elements exist
    if (!images.length || !headings.length || !descriptions.length || !headingsContainer) {
      console.error('Slider elements are missing or incomplete.');
      return;
    }

    function showSlide(index) {
      // Normalize index to prevent out-of-bounds
      currentIndex = ((index % images.length) + images.length) % images.length;

      // Update active states for all elements
      images.forEach((img, i) => {
        img.classList.toggle('active', i === currentIndex);
      });

      headings.forEach((heading, i) => {
        heading.classList.toggle('active', i === currentIndex);
      });

      descriptions.forEach((desc, i) => {
        desc.classList.toggle('active', i === currentIndex);
      });

      // Center the active heading
      centerActiveHeading();
    }

    function centerActiveHeading() {
      const activeHeading = headings[currentIndex];
      if (activeHeading && headingsContainer) {
        const containerWidth = headingsContainer.offsetWidth;
        const headingWidth = activeHeading.offsetWidth;
        const headingOffsetLeft = activeHeading.offsetLeft;

        // Calculate scroll position to center the active heading
        const scrollLeft = headingOffsetLeft - containerWidth / 2 + headingWidth / 2;

        // Smooth scroll the container horizontally
        headingsContainer.scrollTo({
          left: scrollLeft,
          behavior: 'smooth',
        });
      }
    }

    function nextSlide() {
      showSlide(currentIndex + 1);
    }

    function prevSlide() {
      showSlide(currentIndex - 1);
    }

    function startAutoSlide() {
      stopAutoSlide(); // Ensure no duplicate intervals
      interval = setInterval(nextSlide, 5000);
    }

    function stopAutoSlide() {
      if (interval) {
        clearInterval(interval);
        interval = null;
      }
    }

    // Click event on headings to change slides
    headingsContainer.addEventListener(
      'click',
      (e) => {
        const clickedHeading = e.target.closest('.am-slider_text--item');
        if (clickedHeading) {
          const index = parseInt(clickedHeading.getAttribute('data-index'), 10);
          if (!isNaN(index) && index >= 0 && index < images.length) {
            stopAutoSlide();
            showSlide(index);
            startAutoSlide();
          }
        }
      },
      { passive: true }
    );

    // Navigation button event listeners
    const prevButton = document.querySelector('.am-slider_nav--prev');
    const nextButton = document.querySelector('.am-slider_nav--next');

    if (prevButton) {
      prevButton.addEventListener(
        'click',
        () => {
          stopAutoSlide();
          prevSlide();
          startAutoSlide();
        },
        { passive: true }
      );
    }

    if (nextButton) {
      nextButton.addEventListener(
        'click',
        () => {
          stopAutoSlide();
          nextSlide();
          startAutoSlide();
        },
        { passive: true }
      );
    }

    // Initialize the slider
    showSlide(0);
    startAutoSlide();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', tabSlider);
  } else {
    tabSlider();
  }

  document.addEventListener('DOMContentLoaded', () => {
    if (window.innerWidth < 860) {
      const grid = document.querySelector('.key-feature_grid');
      const gridItems = document.querySelectorAll('.feature-grid__item');
      const visibleItem = document.querySelector('.feature-grid__item--visible');

      // Set initial height to match the visible item
      if (visibleItem) {
        grid.style.height = `${visibleItem.offsetHeight + 0}px`; // 40px for padding
      }

      gridItems.forEach((item) => {
        item.addEventListener('click', () => {
          const isActive = item.classList.contains('feature-grid__item--active');

          if (isActive) {
            // Collapse the grid if the active item is clicked again
            gridItems.forEach((otherItem) => {
              otherItem.classList.remove('feature-grid__item--active');
              otherItem.classList.remove('feature-grid__item--revealed');
              otherItem.classList.add('feature-grid__item--hidden');
            });
            grid.classList.remove('key-feature_grid--expanded');
            grid.style.height = `${visibleItem.offsetHeight + 0}px`; // Reset to initial height
          } else {
            // Expand the grid and set new active item
            gridItems.forEach((otherItem) => {
              otherItem.classList.remove('feature-grid__item--active');
              otherItem.classList.remove('feature-grid__item--hidden');
              otherItem.classList.add('feature-grid__item--revealed');
            });
            item.classList.add('feature-grid__item--active');
            grid.classList.add('key-feature_grid--expanded');
            grid.style.height = 'auto';
          }
        });
      });
    }
  });
</script>
