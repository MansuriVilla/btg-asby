<script>
  function calculateCountdown() {
    const startDate = new Date('2025-01-12T00:00:00');
    const currentDate = new Date();
    const timeDifference = currentDate - startDate;
    const hoursElapsed = Math.floor(timeDifference / (1000 * 60 * 60));
    const nextCountdownHour = Math.floor(hoursElapsed / 24) * 24 + 24; // Next multiple of 24 hours

    const nextCountdownDate = new Date(startDate.getTime() + nextCountdownHour * 60 * 60 * 1000);
    const remainingTime = nextCountdownDate - currentDate;

    const remainingHours = Math.floor(remainingTime / (1000 * 60 * 60));
    const remainingMinutes = Math.floor((remainingTime % (1000 * 60 * 60)) / (1000 * 60));
    const remainingSeconds = Math.floor((remainingTime % (1000 * 60)) / 1000);

    // Function to ensure two-digit format
    const formatTime = (time) => String(time).padStart(2, '0');

    // Update all divs with the class "ringer_funnel_timer"
    const timers = document.querySelectorAll('.ringer_funnel_timer');
    const countdownText = `${formatTime(remainingHours)}:${formatTime(remainingMinutes)}:${formatTime(
      remainingSeconds
    )}`;

    timers.forEach((timer) => {
      timer.innerHTML = countdownText;
    });
  }

  setInterval(calculateCountdown, 1000);
</script>

