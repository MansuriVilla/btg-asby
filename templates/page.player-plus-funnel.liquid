                    stroke-width="2.43326" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </div>
          <div class="accoding__ans">
            <p>42,000+ courses worldwide, powered by the GAME app. If your course isn’t covered, we’ll add it.</p>
          </div>
        </div>
        <div class="faq_item">
          <div class="according__que">
            <p>How long does the battery last?</p>
            <span>
              <svg
                width="23"
                height="23"
                viewBox="0 0 23 23"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
