<script type="text/javascript">
	$('.poptrigger').click( function(){
		popID = $(this).attr('data-rel');
		$('#' + popID).fadeIn();
        $('#' + popID).find('#video1').play();
        $('#' + popID).find('#video2').play();
        $('#' + popID).find('#video3').play();
		var popMargTop = ($('#' + popID).height()) / 2;
		var popMargLeft = ($('#' + popID).width()) / 2;		
		return false;
	});
	
	$(document).on("click",".closePop, #fade", function(){      	
    	$('.pop-upbox').fadeOut( function(){
    	});
        var video1 = $('#video1').get(0);
        var video2 = $('#video2').get(0);
        var video3 = $('#video3').get(0);
        video1.pause();
        video2.pause();
        video3.pause();
    	return false;
	});
	
	$(document).on('click', function(event) {
    	if ($(event.target).has('.popup-box').length) {    			
    		$('.pop-upbox').fadeOut( function(){    			
    		});

        var video1 = $('#video1').get(0);
        var video2 = $('#video2').get(0);
        var video3 = $('#video3').get(0);
        video1.pause();
        video2.pause();
        video3.pause();
        
    	}
	});	
</script>


