  document.addEventListener('DOMContentLoaded', function () {
    // scroll base slider changing it's diraction and incress it's speed
    function velocitySlider() {
      const sliders = document.querySelectorAll('.siteVelocity__slider');
      const baseSpeed = 0.5; // Base speed in pixels per frame when no scroll is applied.
      // Change this to set the default movement speed.

      sliders.forEach((slider) => {
        let images = Array.from(slider.children);
        const imgWidth = images[0].offsetWidth + 20;
        const totalWidth = imgWidth * images.length;

        // Clone images until the slider’s content is wide enough for a seamless loop.
        while (slider.offsetWidth < window.innerWidth + totalWidth) {
          images.forEach((img) => {
            let clone = img.cloneNode(true);
            slider.appendChild(clone);
          });
          images = Array.from(slider.children);
        }

        let position = 0;
        let extraSpeed = 0; // Additional speed added on top of baseSpeed due to scrolling.
        let speed = baseSpeed; // Actual speed = baseSpeed + extraSpeed.

        function animate() {
          // Update speed based on current extraSpeed.
          speed = baseSpeed + extraSpeed;
          position += speed;

          // Wrap the position seamlessly.
          if (position >= totalWidth) {
            position -= totalWidth;
          } else if (position <= -totalWidth) {
            position += totalWidth;
          }

          slider.style.transform = 'translateX(' + -position + 'px)';

          // Gradually decay extraSpeed toward 0 (simulate friction).
          // Adjust the decay factor (0.95) to control how fast it returns to baseSpeed.
          extraSpeed *= 0.95;

          requestAnimationFrame(animate);
        }

        // Listen for wheel events to adjust extraSpeed.
        window.addEventListener('wheel', function (event) {
          // Get the scroll delta (positive for down, negative for up).
          let delta = event.deltaY || -event.wheelDelta;
          // Determine scroll direction: scrolling down adds positive speed; scrolling up subtracts.
          let direction = delta > 0 ? 1 : -1;

          // Adjust the acceleration factor here.
          // The multiplier (0.01) controls how much extraSpeed is added per scroll event.
          // Increase this value (e.g., 0.02) for a more sensitive response.
          // The Math.min() clamp (0.5) controls the maximum acceleration added per event.
          let acceleration = Math.min(Math.abs(delta) * 0.01, 0.5);
          extraSpeed += direction * acceleration;

          // Clamp extraSpeed to avoid runaway speeds.
          if (extraSpeed > 5) extraSpeed = 5;
          if (extraSpeed < -5) extraSpeed = -5;
        });

        animate();
      });
    }

    velocitySlider();

    // Highlighting the sub-header links based on the current section
    function activeCurrentSection() {
      const sections = document.querySelectorAll('.has_section, .bg_white');
      const navLinks = document.querySelectorAll('.playmaker_link');
      const menuSelect = document.getElementById('menuSelect');
      const header = document.querySelector('.playmaker_header-custom');

      menuSelect.addEventListener('change', function () {
        const targetSection = document.querySelector(this.value);
        if (targetSection) {
          window.scrollTo({
            top: targetSection.offsetTop - 50,
            behavior: 'smooth',
          });
        }
      });

      let currentActiveId = null;
      let lastActiveSection = null;

      const observer = new IntersectionObserver(
        (entries) => {
          // console.log("Intersection Observer entries:");
          entries.forEach((entry) => {
            // console.log(
            //   `${entry.target.id}: isIntersecting=${entry.isIntersecting}, ` +
            //     `intersectionRatio=${entry.intersectionRatio.toFixed(2)}, ` +
            //     `boundingTop=${entry.boundingClientRect.top}`
            // );
          });

          const visibleEntries = entries.filter((entry) => entry.isIntersecting);

          if (visibleEntries.length > 0) {
            const bestEntry = visibleEntries.reduce((prev, curr) =>
              prev.boundingClientRect.top < curr.boundingClientRect.top ? prev : curr
            );
            const id = bestEntry.target.getAttribute('id');
            // console.log("Active candidate section:", id);

            if (id !== currentActiveId || lastActiveSection !== id) {
              currentActiveId = id;

              navLinks.forEach((link) => {
                link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
              });

              if (window.innerWidth <= 820) {
                menuSelect.value = `#${id}`;
              }

              if (bestEntry.target.classList.contains('bg_white')) {
                header.classList.add('section_IsWhite');
              } else {
                header.classList.remove('section_IsWhite');
              }

              lastActiveSection = id;
            }
          } else {
            if (lastActiveSection && !currentActiveId) {
              currentActiveId = lastActiveSection;
              navLinks.forEach((link) => {
                link.classList.toggle('active', link.getAttribute('href') === `#${currentActiveId}`);
              });
            }
          }
        },
        {
          threshold: 0.1,
          rootMargin: '0px 0px -20% 0px',
        }
      );

      sections.forEach((section) => {
        // console.log("Observing section:", section.getAttribute("id"));
        observer.observe(section);
      });

      window.addEventListener('resize', function () {
        // console.log("Window resized");
      });
    }

    activeCurrentSection();

    // animating the text on canvas
    function textOnCanvas() {
      const textScenes = [
        {
          selector: '#textBlock1',
          fadeInDuration: 1,
          holdDuration: 1,
          fadeOutDuration: 1,
          yOffset: 30,
        },
        {
