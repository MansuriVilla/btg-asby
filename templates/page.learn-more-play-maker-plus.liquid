          fadeOutDuration: 1,
          yOffset: 30,
        },
        {
          selector: '#textBlock3',
          fadeInDuration: 1,
          holdDuration: 1,
          fadeOutDuration: 1,
          yOffset: 30,
        },
        {
          selector: '#textBlock4',
          fadeInDuration: 1,
          holdDuration: 1,
          fadeOutDuration: 1,
          yOffset: 30,
        },
      ];

      const textTimeline = gsap.timeline({
        scrollTrigger: {
          trigger: '.sticky__elements--section4',
          start: 'top top',
          end: '+=' + window.innerHeight * 5,
          scrub: 0.2,
          markers: false,
        },
      });

      textScenes.forEach((scene, index) => {
        textTimeline
          .fromTo(
            scene.selector,
            { opacity: 0, y: scene.yOffset },
            { opacity: 1, y: 0, duration: scene.fadeInDuration }
          )
          .to(scene.selector, { opacity: 0, duration: scene.fadeOutDuration }, '+=' + scene.holdDuration);
      });
    }

    textOnCanvas();
