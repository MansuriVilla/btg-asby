<script>
         
function setDynamicLink() {
    const ctaLink = document.getElementById('cta-link');
    if (!ctaLink) {
        console.error("Element with id 'cta-link' not found.");
        return;
    }
    const userAgent = navigator.userAgent.toLowerCase();
    const appStoreUrl = 'https://apps.apple.com/us/app/blue-tees-game/id6448720121';
    const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.bluetees';

    if (userAgent.includes('mac') || userAgent.includes('iphone') || userAgent.includes('ipad')) {
        ctaLink.href = appStoreUrl;
    } else if (userAgent.includes('android') || userAgent.includes('windows')) {
        ctaLink.href = playStoreUrl;
    } else {
        ctaLink.href = appStoreUrl;
    }
}

setDynamicLink();
  
</script>

