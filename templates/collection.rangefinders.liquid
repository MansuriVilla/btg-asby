            .main-table-section .table-inner .specs-section-main .specs-inner .specs-row { height: 135px; padding:0px; }
            .main-table-section .table-inner .specs-section-main .specs-inner .specs-row:last-child { padding:15px 0px; }
            .main-table-section .table-inner .specs-section-main .specs-inner .specs-row .specs-col img { max-height: 45px; scale: 1; }
            .specs-row .specs-col:nth-child(2) { height: 70px !important; }
            .main-table-section .table-inner .specs-section-main .specs-inner .specs-row .specs-col.text img { max-width: 80px; width: 100%; }
            .specs-row .specs-col:nth-child(2)::before { top:23px; width:180px; }
            #main-table .main-table-section .learn_more_button a { width:160px; font-size: 12px; padding: 9px 0px; }
            .main-table-section .price_box .price_text .money-two { font-size: 24px; margin:15px 0px; line-height: 24px; }
              .main-table-section .table-inner .specs-section-main .specs-inner .specs-row .specs-col .color-collection{max-width: 54px;}
