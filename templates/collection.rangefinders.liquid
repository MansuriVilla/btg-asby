    <style>
            .new_home_section_bg .col-6.col_new-6 .logo img {
        aspect-ratio: 16/11;
        width: 100%;
        height: 100%;
        display: flex;
        object-fit: contain;
        object-position: center center;
      }
      .new_home_section_bg .col-6.col_new-6 {
        width: 50%;
      }
                .divider-main picture {
                display: flex;
                justify-content: center;
                align-items: center;
                position: relative;
                z-index: 1;
                padding: 30px 0px;
            }

            .main-table-section { padding: 0px 15%; background-color: #000; }
            .main-table-section .table-inner .table-top .table-top-inner .top-text-section { max-width: 550px; width: 100%; margin: 0 auto; padding: 30px 0px; }
            .main-table-section .table-inner .table-top .table-top-inner .table-top-product-section { display: flex; justify-content: space-between; margin-bottom: 15px; flex-direction: row-reverse; }
            .main-table-section .table-inner .table-top .table-top-inner .table-top-product-section .top-inner-left,
            .main-table-section .table-inner .table-top .table-top-inner .table-top-product-section .top-inner-right { text-align: center; width: 33.33%; display: flex; flex-direction: column; justify-content: space-between; }
            .main-table-section .table-inner .table-top .table-top-inner .table-top-product-section .top-inner-left img,
                 .main-table-section .table-inner .table-top .table-top-inner .table-top-product-section .top-inner-right img{ max-width: 332px; width: 100%; margin: 0 auto; }
            {% comment %} /* .main-table-section .table-inner .table-top .table-top-inner .table-top-product-section .top-inner-right img { max-height: 332px; height: auto; object-fit: contain; } */ {% endcomment %}
            .main-table-section .table-inner .table-top .table-top-inner .table-top-product-section .price-section { text-align: center; margin: 0 auto; display: block; color: #fff; width: 100%; }
            .main-table-section .table-inner .table-top .table-top-inner .table-top-product-section .price-section p { font-size: 30px; }
            .main-table-section .table-inner .specs-section-main .specs-inner .specs-row { display: flex; justify-content: flex-end; color: #fff; align-items: center; height: 192px; /* padding: 20px 0px; */ flex-direction: row-reverse; }
            .main-table-section .table-inner .specs-section-main .specs-inner .specs-row .specs-col { width: 33.33%; display: flex; align-items: flex-end; justify-content: center; height: 100%; padding: 10px 0px 20px; }
            .main-table-section .table-inner .specs-section-main .specs-inner .specs-row .specs-col p { font-size: 26px; font-weight: 900; margin: 0px; padding: 0px; text-transform: uppercase; letter-spacing: 3px; text-wrap: nowrap; text-align: center; }
            .main-table-section .table-inner .specs-section-main .specs-inner .specs-row .specs-col.color { align-items: flex-start; }
            .main-table-section .table-inner .specs-section-main .specs-inner .specs-row .specs-col img { max-height: 55px; scale: 1.30; /* height: 100%; */ }
            .main-table-section .table-inner .specs-section-main .specs-inner .specs-row .specs-col .color-collection { max-width: 64px; width: 100%; margin-top:30px; }
            .main-table-section .table-inner .specs-section-main .specs-inner .specs-row .specs-col.text img { max-width: 97px; width: 100%; }
            .specs-row .specs-col:nth-child(2) { position: absolute; {% comment %} /* background: #3737374f; */ {% endcomment %}
                width: 100% !important; height: 152px !important; left: 0; }
            .specs-row .specs-col:nth-child(2)::before { content: ''; display: block; position: absolute; height: 1px; width: 410px; background: #fff; top: 48px; }
            .main-table-section .table-inner .specs-section-main .specs-inner .specs-row.colors .specs-col:not(.specs-col.color) {align-items: center; }
            .divider-main .offer-logo {
                max-width: clamp(80px,12vw,120px);
                width: 100%;
            }


            @media only screen and (min-width:1921px) and (min-width:220px){
               #main-table .main-table-section .table-inner {width: 100%; max-width: 1500px; margin: 0 auto; }
             }
            @media only screen and (max-width:1440px) and (min-width:220px) {
             .main-table-section .table-inner .specs-section-main .specs-inner .specs-row .specs-col p { font-size: 25px; }
            .main-table-section { padding:0px 3%; }
            .main-table-section .price_box .price_text .old { font-size:14px; }
            .main-table-section .price_box .price_text .money-two { font-size:28px; }
            .main-table-section .learn_more_button a { font-size:14px; }
            .main-table-section .price_box .price_text .old::after { width:55px; right:-2px; }
             }
            @media only screen and (max-width:1080px) and (min-width:220px) {
             .main-table-section { padding: 0px 2%; }
            .specs-row .specs-col:nth-child(2)::before { width: 370px; }
            .main-table-section .table-inner .specs-section-main .specs-inner .specs-row .specs-col p { font-size: 22px; }
            .main-table-section .table-inner .specs-section-main .specs-inner .specs-row .specs-col img { max-height: 70px; }
             }
            @media only screen and (max-width:991px) and (min-width:220px) {
             .main-table-section { padding: 0px 5%; }
            .main-table-section .table-inner .specs-section-main .specs-inner .specs-row .specs-col p { font-size: 22px; }
            .main-table-section .table-inner .specs-section-main .specs-inner .specs-row .specs-col img { max-height: 60px;}
            .specs-row .specs-col:nth-child(2)::before { width: 300px; }
             }
            @media only screen and (max-width:860px) and (min-width:220px){
              .main-table-section .table-inner .specs-section-main .specs-inner .specs-row{padding:20px 0px;}
                .main-table-section .table-inner .specs-section-main .specs-inner .specs-row .specs-col img { max-height: 55px; }
              .specs-row .specs-col:nth-child(2)::before{top: 33px;}
            }
            @media only screen and (max-width:768px) and (min-width:220px) {
