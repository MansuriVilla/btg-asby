    { transform: rotate(45deg)
    }
    .modal-video-close-btn:after, .closePop:after
    { transform: rotate(-45deg)
    }
    .modal-video-close-btn:before, .modal-video-close-btn:after, .closePop:before, .closePop:after
    { content: ''; position: absolute; height: 2px; width: 100%; top: 50%; left: 0; background: #fff;
    border-radius: 5px; margin-top: -6px
    }

