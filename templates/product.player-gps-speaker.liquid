  <div class="as-seen-in series-3-max-golf-rangefinder-with-slope">
    {%- section 'as-seen-in-gps-speaker' -%}
    {%- section 'change-the-way-gps-speaker' -%}
  </div>

  {%- section 'player-gps-speaker-html' -%}

