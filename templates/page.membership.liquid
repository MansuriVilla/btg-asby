<script>
          document.addEventListener('DOMContentLoaded', function() {
            const addToCartBtn = document.querySelector('#one-year-purchase');
        
            addToCartBtn.addEventListener('click', function(event) {
                event.preventDefault();
                const button = this;
                button.classList.add('btn--loading');
        
                const variantId = button.getAttribute('data-id');
                const limitProductId = 42402135900357;  // The product that has the limit
        
                // Fetch the current cart contents
                fetch('/cart.js')
                    .then(response => response.json())
                    .then(cart => {
                        // Check if the limit product is already in the cart
                        const existingItem = cart.items.find(item => item.id === limitProductId);
                        if (existingItem && existingItem.quantity >= 1) {
                            // If the product is already in the cart, show an alert
                            
                            button.classList.remove('btn--loading');
                            
                        } else {
                            // Proceed to add the item to the cart
                            return fetch('/cart/add.js', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                },
                                body: JSON.stringify({
                                    id:42402135900357,
                                    selling_plan:2885255365,
                                    quantity: 1
                                })
                            });
                        }
                    })
                    .then(response => {
                        if (response) {
                            return response.json();
                        }
                    })
                    .then(data => {
                        if (data) {
                            button.classList.remove('btn--loading');
                            document.dispatchEvent(new CustomEvent('ajaxProduct:added', {
                                detail: { product: data }
                            }));
                        }
                    })
                    .catch(error => {
                        button.classList.remove('btn--loading');
                        console.error('Error adding product to cart:', error);
                        alert('There was an issue adding the product to the cart.');
                    });
            });
        });


</script>



