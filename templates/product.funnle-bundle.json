    "custom_faq_block_Tcqbdm": {
      "type": "custom-faq-block",
      "blocks": {
        "content_htyYXn": {
          "type": "content",
          "settings": {
            "faq_que": "What makes the Player+ different than other GPS devices?",
            "faq_ans": "Most golf GPS devices only do one thing — give you yardages. Player+ goes further by combining tour-level GPS data, a premium studio quality Bluetooth speaker, a built-in power bank, and other functions into one sleek device. Instead of carrying multiple gadgets, you get accurate distances, immersive sound, and a way to charge your phone — all in one. It’s designed to simplify your round while making it more fun."
          }
        },
        "content_Dk6AAz": {
          "type": "content",
          "settings": {
            "faq_que": "Do I need a subscription?",
            "faq_ans": "No. Yardages, hazards, and 42,000+ courses are included. Membership is optional for advanced analytics."
          }
        },
        "content_cRthfx": {
          "type": "content",
          "settings": {
            "faq_que": "How accurate is it compared to a Rangefinder?",
            "faq_ans": "Lasers are exact to the pin. The Player+ gives front, center, back, and hazard distances for smarter              course management. They’re perfect together."
          }
        },
        "content_kLrWTn": {
          "type": "content",
          "settings": {
            "faq_que": "Does it work worldwide?",
            "faq_ans": "42,000+ courses worldwide, powered by the GAME app. If your course isn’t covered, we’ll add it."
          }
        },
        "content_4VMF3G": {
          "type": "content",
          "settings": {
            "faq_que": "How long does the battery last?",
            "faq_ans": "10+ hours - more than enough for a full day of golf."
          }
        },
        "content_hDwn3F": {
          "type": "content",
          "settings": {
            "faq_que": "Is it waterproof/durable?",
            "faq_ans": "Yes. IPX7 waterproof and rugged enough for cart, bag, and everyday use."
          }
        },
        "content_TWLB84": {
          "type": "content",
          "settings": {
            "faq_que": "Why not just use a phone app?",
            "faq_ans": "Phone apps drain battery, distract you with notifications, and rely on less accurate GPS. Player+ is              purpose-built for golf: it delivers precise yardages, lasts a full round, and automatically tracks your              stats with the GAME app—plus it doubles as a premium speaker, so you get music and performance in one              device."
          }
        },
