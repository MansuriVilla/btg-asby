<script>
  // Clear any existing intervals to avoid duplicates
  if (window.countdownInterval) {
    clearInterval(window.countdownInterval);
  }

  function calculateCountdown() {
    const baseEndDate = new Date('2025-11-28T23:59:59-07:00').getTime();
    const cycleDuration = 25 * 24 * 60 * 60 * 1000; // 25 days
    const now = new Date().getTime();

    // Find next cycle end
    let nextEndDate = baseEndDate;
    while (nextEndDate <= now) {
      nextEndDate += cycleDuration;
    }

    let timeDifference = nextEndDate - now;
    if (timeDifference <= 0) timeDifference = cycleDuration;

    // Calculate
    const days = Math.floor(timeDifference / (1000 * 60 * 60 * 24));
    const hours = Math.floor((timeDifference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((timeDifference % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((timeDifference % (1000 * 60)) / 1000);

    const pad = (n) => String(n).padStart(2, '0');
    const countdownText = `${days}:${hours}:${minutes}:${seconds}`;

    // UPDATE ALL TIMER ELEMENTS — NO STYLING
    document
      .querySelectorAll('.ringer_funnel_timer, .counter, [class*="timer"], [class*="countdown"]')
      .forEach((timer) => {
        timer.innerHTML = countdownText;
      });
  }

  // Run immediately
  calculateCountdown();

  // Update every 500ms to override other scripts
  window.countdownInterval = setInterval(calculateCountdown, 500);
</script>
