    "video_with_content_gPx6rc": {
      "type": "video-with-content",
      "name": "Video With Content",
      "settings": {
        "heading": "",
        "content_one": "<p>At Blue Tees, we’re golfers, innovators, and builders who believe the game deserves better. We design products that challenge the stale, overbuild, over complicated norms that have defined golf tech for too long- and we do it with speed, precision, and attitude.</p>",
        "content_two": "<p><em><strong>Play Different</strong></em> isn't just a line on our products. It's our mindset. It's how we collaborate, how we think, and how we show up to solve problems. We chase new ideas, push boundaries, and build the kind of golf experiences we always wished existed. If you're worried for momentum, creativity, and impact - welcome home. </p>",
        "content_color": "",
        "background_color": "",
        "video_src": "shopify://files/videos/dad4792dbc5a4dd19d0cf765707f97d3.HD-1080p-2.mp4",
        "video_src_text": "",
