    "our_values_tNpPbP": {
      "type": "our-values",
      "blocks": {
        "our_values_qW4xbf": {
          "type": "our_values",
          "settings": {
            "item_heading": "Put players first",
            "item_body_text": "We design from the golfer’s perspective. Every decision starts with one question: does this make playing better?"
          }
        },
        "our_values_przUWb": {
          "type": "our_values",
          "settings": {
            "item_heading": "Sweat the details",
            "item_body_text": "Precision matters across everything we do. The real difference is in the last 2%."
          }
        },
        "our_values_4VPxdT": {
          "type": "our_values",
          "settings": {
            "item_heading": "Aim for simplicity",
            "item_body_text": "Golf is complex enough. We turn advanced tech into intuitive experiences anyone can pick up and enjoy."
          }
        },
        "our_values_qy8AUp": {
          "type": "our_values",
          "settings": {
            "item_heading": "Own the outcome",
            "item_body_text": "We hire builders who take initiative and finish strong. No passengers. Everyone drives results."
          }
        },
        "our_values_LHapeB": {
          "type": "our_values",
          "settings": {
            "item_heading": "Chase what's next",
            "item_body_text": "We test, learn, and push forward. Every version should be better than the last."
          }
        },
        "our_values_8MDJQM": {
          "type": "our_values",
          "settings": {
            "item_heading": "Keep it fun",
            "item_body_text": "We take the work seriously. Not ourselves."
          }
        }
