  <script>
        // Logo slider start

        const list = document.querySelector("#list");
        const listContent = Array.from(list.children);

        listContent.forEach((item) => {
          const duplicatedItem = item.cloneNode(true);
          duplicatedItem.setAttribute("aria-hidden", true);
          list.appendChild(duplicatedItem);
        });

        // Logo slider end

        // Video play and pause start
    {% comment %}
        function videoControling() {
          document
            .getElementById("videoControlIcon")
            .addEventListener("click", function () {
              var video = document.getElementById("myVideo");
              var icon = document.getElementById("videoControlIcon");

              // When the icon is clicked, play the video, hide the icon, and unmute the video
              if (video.paused) {
                video.play();
                video.muted = false; // Unmute the video
                icon.style.display = "none"; // Hide the pause icon when the video starts
              }
            });

          // Add event listener for the video itself to pause it when clicked
          document.getElementById("myVideo").addEventListener("click", function () {
            var video = document.getElementById("myVideo");
            var icon = document.getElementById("videoControlIcon");

            // Pause the video, mute it, and show the pause icon when the video is clicked
            if (!video.paused) {
              video.pause();
              video.muted = true; // Mute the video
              icon.style.display = "block"; // Show the pause icon when the video is paused
            }
          });

          // Add event listener for when the video ends
          document.getElementById("myVideo").addEventListener("ended", function () {
            var video = document.getElementById("myVideo");
            var icon = document.getElementById("videoControlIcon");

            // Show the pause icon, reset the video to the start, and mute it when the video ends
            icon.style.display = "block";
            video.currentTime = 0;
            video.muted = true; // Mute the video when it ends
          });
        }
        videoControling(); {% endcomment %}

        // Video play and pause end

        $(".exclusive-item-slider").owlCarousel({
          loop: true,
          dots: true,
          margin: 10,
          nav: false,
          mouseDrag: true,
          items: 1,
        });

        $(".review-slider").owlCarousel({
          loop: true,
          autoplay: true,
          margin: 20,
          nav: true,
          dots: true,
          navText: [
            "<img src='{{'left-ic.png' | asset_url}}'>",
            "<img src='{{'right-ic.png' | asset_url}}'>",
          ],
          mouseDrag: true,
          responsive: {
            0: {
              items: 1,
            },
            576: {
              items: 2,
            },
            768: {
              items: 3,
            },
            992: {
              items: 4,
            },
          },
        });
        var lastActiveElement = null;
        $(".poptrigger").click(function () {
          lastActiveElement = this;
          popID = $(this).attr("data-rel");
          $("#" + popID).fadeIn(function() {
            $(this).find(".closePop").focus();
          });
          $("#" + popID)
            .find("#video1")
            .play();
          $("#" + popID)
            .find("#video2")
            .play();
          $("#" + popID)
            .find("#video3")
            .play();
          var popMargTop = $("#" + popID).height() / 2;
          var popMargLeft = $("#" + popID).width() / 2;
          return false;
        });

        $(document).on("click", ".closePop, #fade", function () {
          $(".pop-upbox").fadeOut(function () {
            if (lastActiveElement) {
              lastActiveElement.focus();
              lastActiveElement = null;
            }
          });
          var video1 = $("#video1").get(0);
          var video2 = $("#video2").get(0);
          var video3 = $("#video3").get(0);
          video1.pause();
          video2.pause();
          video3.pause();
          return false;
        });

        $(document).on("click", function (event) {
          if ($(event.target).has(".popup-box").length) {
            $(".pop-upbox").fadeOut(function () {
              if (lastActiveElement) {
                lastActiveElement.focus();
                lastActiveElement = null;
              }
            });

            var video1 = $("#video1").get(0);
            var video2 = $("#video2").get(0);
            var video3 = $("#video3").get(0);
            video1.pause();
            video2.pause();
            video3.pause();
          }
        });

        $(document).on("keydown", function (e) {
          if (e.key === "Escape" || e.keyCode === 27) {
            if ($(".pop-upbox:visible").length > 0) {
              $(".closePop:visible").click();
            }
          }
        });
  </script>
