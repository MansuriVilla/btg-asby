      <script>
        (function() {
          const container = document.querySelector('.featured-section_slider #container');
          if (!container) return;
          const list = container.querySelector('#list');
          if (list) {
            const listContent = Array.from(list.children);
            listContent.forEach((item) => {
              const duplicatedItem = item.cloneNode(true);
              duplicatedItem.setAttribute('aria-hidden', true);
              list.appendChild(duplicatedItem);
            });
          }

          const controlBtn = container.querySelector('#carousel-control-btn');
          if (controlBtn && container) {
            controlBtn.addEventListener('click', function() {
              const isPaused = container.classList.toggle('paused');
              controlBtn.setAttribute('aria-pressed', isPaused);

              const pauseIcon = controlBtn.querySelector('.pause-icon');
              const playIcon = controlBtn.querySelector('.play-icon');

              if (isPaused) {
                controlBtn.setAttribute('aria-label', 'Play logo carousel');
                pauseIcon.style.display = 'none';
                playIcon.style.display = 'block';
              } else {
                controlBtn.setAttribute('aria-label', 'Pause logo carousel');
                pauseIcon.style.display = 'block';
                playIcon.style.display = 'none';
              }
            });
          }
        })();
      </script>
