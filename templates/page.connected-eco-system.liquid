</div>
    </div>
  </div>
</section>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollToPlugin.min.js"></script>

<script>
 document.addEventListener('DOMContentLoaded', () => {
  gsap.registerPlugin(ScrollToPlugin);

  // Helper function – makes both anchors behave the same
  function scrollToSection(targetId, offset = 0) {   // ← tune offset here
    gsap.to(window, {
      duration: 2,
      scrollTo: {
        y: targetId,
        offsetY: offset,     // negative = leave space for fixed header
        autoKill: false      // ← crucial for reliability on first click
      },
      ease: 'power2.out'
    });
  }

  document.querySelectorAll('[data-anchor]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      scrollToSection('#stepsEcoSys', 0);   // adjust -80 to your header height in px
    });
  });
});

  document.addEventListener('DOMContentLoaded', () => {
    horizonSlider({
      '.step-one__slider': {
        loop: true,
       margin: 32,
        
        nav: true,
        autoplay: false,
        showTracker: false,
        drag: false,
        responsive: {
          0: { items: 1.2, drag: true,  },
          992: { items: 2.5, },
          1280: { items: 3.1,  },
        },
      },
    });
  });
  document.addEventListener('DOMContentLoaded', () => {
    const faqItems = document.querySelectorAll('.faq-item-new');
    const desktopImage = document.getElementById('faq-desktop-image');

    // Initialize: Set desktop image to the active item's image
    const activeItem = document.querySelector('.faq-item-new.active');
    if (activeItem && desktopImage) {
      desktopImage.src = activeItem.getAttribute('data-img');
    }

    faqItems.forEach((item) => {
      const header = item.querySelector('.faq-header');

      header.addEventListener('click', () => {
        // Check if already active
        const isActive = item.classList.contains('active');

        // Close all
        faqItems.forEach((otherItem) => {
          otherItem.classList.remove('active');
        });

        // If it wasn't active, make it active
        if (!isActive) {
          item.classList.add('active');

          // Update Desktop Image with fade effect
          const newImgSrc = item.getAttribute('data-img');
          if (desktopImage) {
            desktopImage.classList.add('fade-out');
            setTimeout(() => {
              desktopImage.src = newImgSrc;
              desktopImage.classList.remove('fade-out');
            }, 400); // sync with css transition time
          }
        } else {
          // Keep active to maintain visual consistency as discussed
          item.classList.add('active');
        }
      });
    });
  });
</script>
