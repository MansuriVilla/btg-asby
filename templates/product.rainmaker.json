    "comp_faq_section_JHanYe": {
      "type": "comp-faq-section",
      "blocks": {
        "faq_item_7tRJrF": {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "Do I need an app or subscription to use RAINMAKER?",
            "answer": "<p>No. RAINMAKER works on its own, with shot data displayed directly on the built-in screen. No phone, Wi-Fi, or subscription is needed for standalone practice. An optional premium subscription adds deeper analytics and expanded connected features.</p>",
            "is_open": true
          }
        },
        "faq_item_zqVEwb": {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "Can I use RAINMAKER indoors and outdoors?",
            "answer": "<p>Yes. Practice at the range, in your backyard, or indoors with a hitting net or impact screen. Position RAINMAKER 5 feet behind the ball, level with the hitting surface and aligned with your target. Indoors, leave at least 10 feet between the ball and net or screen, plus enough clearance to swing safely.</p>",
            "is_open": false
          }
        },
        "faq_item_rPBPdP": {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "What’s the difference between OLED and LCD display?",
            "answer": "<p>RAINMAKER tracks ball and club metrics including ball speed, club speed, launch angle, spin, carry distance, total distance, and smash factor. Pair it with the Blue Tees LAUNCH App to access additional metrics for 20+ total.</p>",
            "is_open": false
          }
        },
        "faq_item_DhkjYG": {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "What training modes are included?",
            "answer": "<p>Three modes work directly on the device: Practice Mode for shot feedback, Target Distance Mode for dialing in a specific yardage, and Swing Speed Mode for measuring clubhead speed without hitting a ball.</p>",
            "is_open": false
          }
        },
        "faq_item_7hgkH7": {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "Do I need special golf balls?",
            "answer": "<p>RAINMAKER works with standard and radar-enhanced golf balls. For more consistent indoor spin and directional data, use radar-enhanced balls such as Titleist RCT and enable the “RB Ball” setting on the device or in the LAUNCH App.</p>",
            "is_open": false
          }
        },
        "faq_item_PpCEyV": {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "What does the Blue Tees LAUNCH App add?",
            "answer": "<p>The LAUNCH App adds a virtual driving range, dispersion charts, session history, and club-level analytics. Customize “My Bag” to match your clubs and review your performance over time. The app is available for iOS and Android phones and tablets.</p>",
            "is_open": false
          }
        },
        "faq_item_Az8dFM": {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "Can I use RAINMAKER with GSPro or E6?",
            "answer": "<p>Yes. RAINMAKER supports GSPro and E6 on compatible Windows PCs. GSPro connects through the Blue Tees LAUNCH App, while E6 connects directly over Bluetooth. Each platform requires its own compatible software license.</p>",
            "is_open": false
          }
        },
        "faq_item_ed8Ceq": {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "How long does the battery last?",
            "answer": "<p>RAINMAKER delivers 6+ hours of battery life, with USB-C charging between sessions.</p>",
            "is_open": false
          }
        },
        "faq_item_BYNAmn": {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "Is RAINMAKER water-resistant?",
            "answer": "<p>Yes. Its IPX4 rating provides protection against splashes, light rain, and mist. Avoid submerging it or leaving it exposed to heavy rain, and dry it before storing.</p>",
            "is_open": false
          }
        }
      },
