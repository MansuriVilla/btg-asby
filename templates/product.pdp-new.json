    "comp_faq_section_DNaA3D": {
      "type": "comp-faq-section",
      "blocks": {
        "faq_item_64ETdV": {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "How loud is the 360° audio compared to the Player+?",
            "answer": "<p>Player Pro uses a redesigned acoustic chamber that pushes sound evenly in all directions, not just forward. It gets significantly louder without distorting, and golfers can hear crisp vocals and bass even when the speaker is mounted on the cart, bag, or behind them on the tee box.</p>",
            "is_open": true
          }
        },
        "faq_item_Yg7NTw": {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "Is the Player Pro fully waterproof?",
            "answer": "<p>Player Pro features an IPX7 waterproof rating, allowing it to withstand heavy rain, splashes, and even submersion in water up to 1 meter for 30 minutes.</p>",
            "is_open": false
          }
        },
        "faq_item_Rww8wz": {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "How responsive is the touchscreen outdoors?",
            "answer": "<p>The ultra-bright touchscreen is engineered specifically for outdoor visibility with anti-glare technology and responsive touch even when wearing golf gloves or in damp conditions.</p>",
            "is_open": false
          }
        },
        "faq_item_aGypRB": {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "What does “unlimited paring via Auracast” mean?",
            "answer": "<p>Auracast broadcast audio allows you to seamlessly connect an unlimited number of compatible speakers together, synchronizing music across multiple carts and groups across the course.</p>",
            "is_open": false
          }
        },
        "faq_item_bPPNb4": {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "Will the magnet hold on fast-moving carts or rough terrain",
            "answer": "<p>Engineered with industrial-grade Neodymium magnets, Player Pro locks firmly onto golf cart frames and stays secure over bumpy cart paths and rough terrain.</p>",
            "is_open": false
          }
        },
        "faq_item_PdCB8N": {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "Do I need to be on golf course to use Player Pro?",
            "answer": "<p>No! While Player Pro includes course GPS and golfing features, it works as a world-class premium Bluetooth speaker anywhere you go—at the pool, beach, tailgates, or home.</p>",
            "is_open": false
          }
        },
        "faq_item_wCrLCb": {
          "type": "faq_item",
          "settings": {
            "category": "Features",
            "question": "How does GPS distance tracking work?",
            "answer": "<p>Player Pro connects to satellites directly to deliver precision yardages to the front, center, and back of greens on over 40,000 courses worldwide.</p>",
            "is_open": false
          }
        },
        "faq_item_dL39kV": {
          "type": "faq_item",
          "settings": {
            "category": "Features",
            "question": "Can I keep score on the speaker?",
            "answer": "<p>Yes, you can track your score, putts, and driving accuracy right from the touchscreen and sync it directly to the mobile app.</p>",
            "is_open": false
          }
        },
        "faq_item_wqkDaa": {
          "type": "faq_item",
          "settings": {
            "category": "App",
            "question": "Is the companion app free?",
            "answer": "<p>Yes, the Blue Tees Game app is free to download on iOS and Android with full access to 3D course maps and statistics tracking.</p>",
            "is_open": false
          }
        }
      },
