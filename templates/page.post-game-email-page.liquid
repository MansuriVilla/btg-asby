<script>


// CHANGEING VALUE ON SCROLL
function valueUpdate(){
  
  function scrollToSection(event) {
    event.preventDefault();
    const sectionId = event.target.value;     
    const section = document.getElementById(sectionId);
   
    if (section) {
      section.scrollIntoView({
        behavior: 'smooth',
        block: 'center'
      });
    
      setTimeout(() => {
        document.getElementById('sectionDropdown').value = sectionId;
      }, 500);
    }
  }
 
  const dropdown = document.getElementById('sectionDropdown');
  dropdown.addEventListener('change', scrollToSection);
  
  window.addEventListener('scroll', function() {
    const sections = document.querySelectorAll('div[id^="section"]');
    let currentSection = "";
    sections.forEach(section => {
      const rect = section.getBoundingClientRect();
      const sectionCenter = rect.top + rect.height / 2;
      if (sectionCenter >= 0 && sectionCenter <= window.innerHeight) {
        currentSection = section.id;
      }
    });
    const dropdown = document.getElementById('sectionDropdown');
    if (currentSection && dropdown.value !== currentSection) {
      dropdown.value = currentSection;
    }
  });
  }
  
valueUpdate();

// FAQ SCRIPT
document.addEventListener('DOMContentLoaded', function () {
  function faqItems(){
    const faqItems = document.querySelectorAll('.faq_items--item');
    faqItems.forEach(function(item) {
      const faqHeader = item.querySelector('.faq_items--top');
      const faqAnswer = item.querySelector('.faq_items--answer');
      faqHeader.addEventListener('click', function() { 
        faqItems.forEach(function(otherItem) {
          if (otherItem !== item) {
            const otherAnswer = otherItem.querySelector('.faq_items--answer');
            const otherHeader = otherItem.querySelector('.faq_items--top');
            otherAnswer.classList.remove('show');  // Hide the answer
            otherHeader.classList.remove('active');  // Remove active class
          }
        });
        faqAnswer.classList.toggle('show');
        faqHeader.classList.toggle('active');
      });
    }); 
  }
  faqItems();
});



