  @keyframes modal-video
  {
  from {
    opacity:0
  }
  to {
    opacity:1
  }
  }
  @keyframes modal-video-inner
  {
  from {
    transform:translate(0, 100px)
  }
  to {
  transform:translate(0, 0)
  }
  }

.modal-video{ position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); z-index: 1000000;cursor: pointer; opacity: 1; animation-timing-function: ease-out; animation-duration: .3s; animation-name: modal-video;
