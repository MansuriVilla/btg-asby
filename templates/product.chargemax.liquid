.modal-video-close{ opacity: 0}
.modal-video-close .modal-video-movie-wrap{ -webkit-transform: translate(0, 100px); -moz-transform: translate(0, 100px); -ms-transform: translate(0, 100px);
-o-transform: translate(0, 100px);  transform: translate(0, 100px)}
