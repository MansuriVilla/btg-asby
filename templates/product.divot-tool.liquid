 /*.productinfo-list .product-info .desktop{display: none;}
 .productlist .desktop{display: none;}
 .productlist .mobile{display: block;}*/
 .productinfo-list .product-info p, .productlist2 .product-info p{min-height: auto;}
  
  
  
  }
