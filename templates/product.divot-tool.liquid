  .divot-tool-section .single-img img{margin-bottom: 0px;}
    
 .productinfo-list .row{margin-bottom: 0px;}
 .productinfo-list{padding: 0px 20px 40px 20px;}
 .productinfo-list .row .col-6,
 .productinfo-list .row .col-4{width: 100%;}
