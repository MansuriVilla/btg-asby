{% render 'video-scaling-animation', video_url:
                'https://cdn.shopify.com/videos/c/o/v/fd3ef901a9704c0aa663cab0a2a31730.mp4'
                %}

    </div>
  </div>

  <div class="as-seen-in divot-tool-section">
