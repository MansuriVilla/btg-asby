      "blocks": {
        "faq_item_wNhzbU": {
          "type": "faq_item",
          "settings": {
            "category": "Setup",
            "question": "What’s included in the Rainmaker Simulation Bundle?",
            "answer": "<p>The bundle includes the Rainmaker Launch Monitor, premium golf net, 4 × 5 ft hitting mat, interchangeable iron and driver hitting strips, 70 mm rubber tee, IR remote, protective carry case, USB-C cable, and quick start guide.</p>",
            "is_open": true
          }
        },
        "faq_item_jKQgqM": {
          "type": "faq_item",
          "settings": {
            "category": "Setup",
            "question": "How long does setup take?",
            "answer": "<p>The golf net is designed for tool-free assembly in approximately 15 minutes. Total setup time for the complete bundle may vary depending on your space and configuration.</p>",
            "is_open": false
          }
        },
        "faq_item_tWB7K7": {
          "type": "faq_item",
          "settings": {
            "category": "Setup",
            "question": "How much space do I need?",
            "answer": "<p>Allow enough room for your full swing and the complete hitting setup. For accurate shot tracking, position the Rainmaker 5 ft behind the golf ball, at the same height as the ball and aligned with your target.</p>",
            "is_open": false
          }
        },
        "faq_item_qKFdab": {
          "type": "faq_item",
          "settings": {
            "category": "Setup",
            "question": "Does Rainmaker work without a phone?",
            "answer": "<p>Yes. Rainmaker works as a standalone launch monitor with its own 4.3-inch full-color display. Pair it with the Blue Tees LAUNCH app to access 3D ball flight, multiple camera views, shot dispersion, and simulation features.</p>",
            "is_open": false
          }
        },
        "faq_item_LTTk3k": {
          "type": "faq_item",
          "settings": {
            "category": "Setup",
            "question": "Can I play simulated golf courses?",
            "answer": "<p>Yes. Rainmaker’s simulation mode provides access to 40,000 courses through the Blue Tees LAUNCH app. GSPro compatibility is also available for Windows PC with a separate subscription.</p>",
            "is_open": false
          }
        },
        "faq_item_Fc7dWK": {
          "type": "faq_item",
          "settings": {
            "category": "Setup",
            "question": "Can I practice with both irons and a driver?",
            "answer": "<p>Yes. The hitting mat includes interchangeable iron and driver hitting strips, giving you dedicated surfaces for different types of shots.</p>",
            "is_open": false
          }
        },
        "faq_item_7bc4bP": {
          "type": "faq_item",
          "settings": {
            "category": "Setup",
            "question": "Can I use the setup outdoors?",
            "answer": "<p>The golf net is designed for indoor and outdoor practice. Rainmaker is IPX4 splash resistant, so protect the device from heavy rain and prolonged exposure to water.</p>",
            "is_open": false
          }
        }
      },
