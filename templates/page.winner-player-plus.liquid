function formValidationHandler() {
  const form = document.querySelector('.site_form--container');

  if (!form) {
    return;
  }

  form.addEventListener('submit', function (event) {
    event.preventDefault(); // Prevent form submission by default

    // Remove all previous error messages
    document.querySelectorAll('.error-msg').forEach(msg => msg.remove());

    let isValid = true;

    // Only validate the phone number field
    const phoneField = document.getElementById('phone');
    if (phoneField && !validatePhoneField(phoneField)) {
      isValid = false;
      showError(phoneField, 'Please enter a valid phone number.');
    }

    // If valid, show success popup instead of alert
    if (isValid) {
      showSuccessPopup();
    }
  });

  // Validate the phone number field
  function validatePhoneField(input) {
    const phoneRegex = /^\+?\d{7,}$/;
    return phoneRegex.test(input.value.trim());
  }

  // Show error message for phone number field
  function showError(input, message) {
    if (!input) return;

    const errorContainer = document.createElement('div');
    errorContainer.className = 'error-msg';
    errorContainer.style.display = 'flex';
    errorContainer.style.alignItems = 'center';
    errorContainer.style.gap = '5px';
    errorContainer.style.color = 'red';
    errorContainer.style.fontSize = '0.75rem';
    errorContainer.style.letterSpacing = '1px';
    errorContainer.style.webkitTextStroke = '1px red';

    const icon = document.createElement('span');
    icon.textContent = '⚠️';
    icon.style.fontSize = '1rem';

    const errorMessage = document.createElement('span');
    errorMessage.textContent = message;

    errorContainer.appendChild(icon);
    errorContainer.appendChild(errorMessage);

    input.parentElement.appendChild(errorContainer);
  }

  // Show the success popup
  function showSuccessPopup() {
    const modal = document.getElementById('successPopUp');
    const closeButton = modal.querySelector('.close');

    // Show the modal
    modal.style.display = 'block';

    // Close the popup when the close button is clicked
    closeButton.addEventListener('click', function () {
      modal.style.display = 'none';
    });

    // Optional: Close the modal when clicking outside of it
    window.addEventListener('click', function (event) {
      if (event.target === modal) {
        modal.style.display = 'none';
      }
    });
  }

  // Restrict non-numeric input for phone field
  document.getElementById('phoneNumber').addEventListener('input', function (event) {
    // Allow only digits and plus sign at the beginning
    this.value = this.value.replace(/[^+\d]/g, ''); // Allow only + and digits
  });

  document.getElementById('phoneNumber').addEventListener('keydown', function (event) {
    // Prevent entering non-numeric keys except for special allowed keys (e.g., backspace, delete, etc.)
    const allowedKeys = ['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'Tab'];
    if (!/[\d+]/.test(event.key) && !allowedKeys.includes(event.key)) {
      event.preventDefault();
    }
  });
}

formValidationHandler();























  
</script>