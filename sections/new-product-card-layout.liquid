                </svg> {% endcomment %}
                <div style="color:#000;background:#CDFF07;line-height:1;border-radius:5px;padding:5px 10px;display: inline-flex;margin-bottom: 13px;font-family: Blue Tees Subhead;font-size: 12px;text-transform: uppercase;">#1 New Release</div>
              {%elsif prod.template_suffix contains 'captain' or prod.template_suffix == 'product-new' or prod.template_suffix == 'player-pro' %}
                <svg width="77" height="25" viewBox="0 0 77 25" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <g clip-path="url(#clip0_10087_26942)">
                  <path d="M74.037 0H2.96296C1.32656 0 0 1.32656 0 2.96296V22.037C0 23.6734 1.32656 25 2.96296 25H74.037C75.6734 25 77 23.6734 77 22.037V2.96296C77 1.32656 75.6734 0 74.037 0Z" fill="#CFFE14"/>
                  <path d="M23 16.5313V8H25.3321L28.2383 12.7461C28.336 12.9063 28.4336 13.086 28.5313 13.2852C28.6329 13.4805 28.7051 13.6465 28.7481 13.7832H28.8067C28.795 13.6426 28.7832 13.4942 28.7715 13.3379C28.7598 13.1817 28.7539 13.0254 28.7539 12.8692V8H30.6231V16.5313H28.2266L25.3555 11.9141C25.2344 11.7266 25.1309 11.5313 25.045 11.3282C24.9629 11.1211 24.9043 10.9532 24.8692 10.8243H24.8047C24.8164 10.9649 24.8282 11.1153 24.8399 11.2754C24.8555 11.4356 24.8633 11.5938 24.8633 11.75V16.5313H23ZM33.962 16.5313V8H40.46V9.64646H36.1827V11.3399H39.8858V12.9512H36.1827V14.8965H40.5245V16.5313H33.962ZM44.713 16.543L42.5275 8H44.7775L46.0607 13.5664C46.0919 13.7032 46.1173 13.8282 46.1368 13.9414C46.1603 14.0547 46.1798 14.1797 46.1954 14.3164H46.2364C46.2482 14.1797 46.2618 14.0547 46.2775 13.9414C46.2931 13.8282 46.3165 13.7032 46.3478 13.5664L47.6603 8H50.1622L51.5157 13.5489C51.5509 13.6856 51.5743 13.8145 51.5861 13.9356C51.6017 14.0528 51.6173 14.1797 51.6329 14.3164H51.6798C51.6915 14.1797 51.7052 14.0528 51.7208 13.9356C51.7364 13.8145 51.7599 13.6856 51.7911 13.5489L53.0333 8H54.9318L52.7404 16.543H50.2032L48.8732 11.1114C48.838 10.9746 48.8087 10.836 48.7853 10.6954C48.7618 10.5547 48.7462 10.4161 48.7384 10.2793H48.6915C48.6837 10.4161 48.6681 10.5547 48.6446 10.6954C48.6251 10.836 48.5997 10.9746 48.5685 11.1114L47.256 16.543H44.713Z" fill="#35394B"/>
