                  </svg>
                {% elsif prod.template_suffix == 'rainmaker'  %}
                {% comment %} <svg width="157" height="25" viewBox="0 0 157 25" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect width="157" height="25" rx="2.96296" fill="#CDFF07"/>
