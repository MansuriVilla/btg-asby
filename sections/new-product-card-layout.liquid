                  <clipPath id="clip0_10087_26942">
                  <rect width="77" height="25" fill="white"/>
                  </clipPath>
                  </defs>
                </svg>
       
                {%- endif -%}
              {%- endif -%}
              


              {% if block.settings.prodName != blank %}
                <h3 class="product-card__product-name">{{ block.settings.prodName }}</h3>
              {% else %}
                <h3 class="product-card__product-name">{{ block.settings.product.title }}</h3>
              {% endif %}
              {% if block.settings.subText != blank %}
                <p class="product-card__subtext">{{ block.settings.subText }}</p>
              {% endif %}
            </div>
            <div class="product-content__right">
              <div class="content-ctas">
                {% if block.settings.solidCtaText != blank %}
                  <a
                    class="content-cta content-cta__solid"
                    href="{{block.settings.product.url}}"
                    {% if settings.open_new_tab %}
                      target="_blank" rel="noopener noreferrer"
                    {% endif %}
                    aria-label="Shop {{prod.title}}"
                  >
                    {{- block.settings.solidCtaText -}}
                  </a>
                {% endif %}

                {% comment %}
                  {% if block.settings.outlineCtaText != blank %}
                    <a class="content-cta content-cta__outline" href="{{block.settings.learnMoreUrl}}">
                      {{- block.settings.outlineCtaText -}}
                    </a>
                  {% endif %}
                {% endcomment %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
    {% if section.settings.sectionCtaText != blank %}
      <div class="product-cards__section-cta">
        <a class="content-cta content-cta__solid section__cta" href="{{section.settings.allProductURL}}">
          {{- section.settings.sectionCtaText -}}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product Card",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "backgroundColor",
      "label": "Section Background Color",
      "alpha": true
    },
    {
      "type": "text",
      "id": "productCardHeading",
      "label": "Section Heading"
    },
    {
      "type": "text",
      "id": "productCardDesc",
      "label": "Section Description"
    },
    {
      "type": "text",
      "id": "sectionCtaText",
      "label": "Section Cta Text",
      "default": "SHOP ALL PRODUCTS"
    },
    {
      "type": "url",
      "id": "allProductURL",
      "label": "URL For Section Cta"
    }
  ],
  "blocks": [
    {
      "type": "Product",
      "name": "Product Cards",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "image_picker",
          "id": "featureImage",
          "label": "Image For Desktop"
        },
        {
          "type": "image_picker",
          "id": "featureImageMobile",
          "label": "Image For Mobile"
        },
        {
          "type": "image_picker",
          "id": "featureHoverImage",
          "label": "Hover Image For Desktop"
        },
        {
          "type": "image_picker",
          "id": "featureHoverImageMobile",
          "label": "Hover Image For Mobile"
        },
        {
          "type": "text",
          "id": "prodName",
          "label": "Product Name"
        },
        {
          "type": "checkbox",
          "id": "label",
          "label": "Display Label"
        },
        {
          "type": "text",
          "id": "subText",
          "label": "Sub Text"
        },
        {
          "type": "text",
          "id": "solidCtaText",
          "label": "Solid Cta Text",
          "default": "SHOW NOW"
        },
        {
          "type": "text",
          "id": "outlineCtaText",
          "label": "Outline Cta Text",
          "default": "LEARN MORE"
        },
        {
          "type": "url",
          "id": "learnMoreUrl",
          "label": "Learn More URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Card"
    }
  ]
}
{% endschema %} {% endcomment %}
<div
  class="product-cards__section product-cards__{{ section.id }}"
  style="background:{{ section.settings.backgroundColor }}"
>
  <div class="product-card__container new-page-width">
    {% if section.settings.productCardHeading != blank %}
      <div class="product-card__heading">
        <h2 class="product-card__heading-text">{{ section.settings.productCardHeading }}</h2>
        <p class="product-card__desc-text">{{ section.settings.productCardDesc }}</p>
      </div>
    {% endif %}
    <div class="product-cards__grid">
      {% for block in section.blocks %}
        {%- assign card_loading = 'lazy' -%}
        {%- assign card_fetchpriority = 'auto' -%}
        {%- if forloop.first -%}
          {%- assign card_loading = 'eager' -%}
          {%- assign card_fetchpriority = 'high' -%}
        {%- endif -%}
        <div class="product-card">
          <div class="product-card__background">
            <picture class="card-background__initial">
              {%- if block.settings.featureHoverImageMobile != blank -%}
                <source
                  srcset="{{ block.settings.featureHoverImageMobile | image_url: width: 500, format: 'webp' }}"
                  type="image/webp"
                  media="(max-width: 861px)"
                >
                <source
                  srcset="{{ block.settings.featureHoverImageMobile | image_url: width: 600 }}"
                  media="(max-width: 861px)"
                >
              {%- else -%}
                <source
                  srcset="{{ block.settings.featureHoverImage | image_url: width: 500, format: 'webp' }}"
                  type="image/webp"
                  media="(max-width: 861px)"
                >
                <source
                  srcset="{{ block.settings.featureHoverImage | image_url: width: 600 }}"
                  media="(max-width: 861px)"
                >
              {%- endif -%}
              <source
                srcset="{{ block.settings.featureHoverImage | image_url: width: 1200 }}"
                media="(min-width: 860px)"
              >
              {{
                block.settings.featureHoverImage
                | image_url: width: 800
                | image_tag:
                  class: 'image-fit',
                  loading: card_loading,
                  fetchpriority: card_fetchpriority,
                  widths: '400,600,800,1200,1600,2000',
                  sizes: '(max-width: 860px) 100vw, 50vw',
                  alt: block.settings.product.title,
                  height: block.settings.featureHoverImage.height,
                  width: block.settings.featureHoverImage.width
              }}
            </picture>

            <picture class="card-background__hovered">
              {%- if block.settings.featureImageMobile != blank -%}
                <source
                  srcset="{{ block.settings.featureImageMobile | image_url: width: 500, format: 'webp' }}"
                  type="image/webp"
                  media="(max-width: 861px)"
                >
                <source
                  srcset="{{ block.settings.featureImageMobile | image_url: width: 600 }}"
                  media="(max-width: 861px)"
                >
              {%- else -%}
                <source
                  srcset="{{ block.settings.featureImage | image_url: width: 500, format: 'webp' }}"
                  type="image/webp"
                  media="(max-width: 861px)"
                >
                <source
                  srcset="{{ block.settings.featureImage | image_url: width: 600 }}"
                  media="(max-width: 861px)"
                >
              {%- endif -%}
              <source
                srcset="{{ block.settings.featureImage | image_url: width: 1200 }}"
                media="(min-width: 860px)"
              >

              {{
                block.settings.featureImage
                | image_url: width: 800
                | image_tag:
                  class: 'image-fit',
                  loading: 'lazy',
                  widths: '400,600,800,1200,1600,2000',
                  sizes: '(max-width: 860px) 100vw, 50vw',
                  alt: block.settings.product.title,
                  height: block.settings.featureImage.height,
                  width: block.settings.featureImage.width
              }}
            </picture>
          </div>
          <div class="product-card__content">
            <div class="product-content__left">
              {% if block.settings.label %}
                {% render 'supercharged-ai-comp' %}
              {% endif %}
              {%- assign prod = block.settings.product -%}

              {%- if block.settings.product -%}
                {%- assign variant = prod.selected_or_first_available_variant -%}
