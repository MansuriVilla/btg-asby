{%- liquid
  assign selected_handle = section.settings.featured_collection

  if selected_handle != blank
    assign display_collection = collections[selected_handle]
    # Extra safety: if selected collection no longer exists or is unavailable
    unless display_collection.handle
      assign display_collection = collection
    endunless
  else
    # No collection selected → fallback to current collection (backend/URL)
    assign display_collection = collection
  endif

  assign current_filter_size = 0

  # Use filters from the displayed collection (more accurate)
  for filter in display_collection.filters
    assign current_filter_size = current_filter_size | plus: filter.active_values.size
  endfor
-%}

<div
  class="collection-content collection-content__new"
  data-section-id="{{ section.id }}"
  data-section-type="collection-grid"
>
  <div id="CollectionAjaxContent">
    <div class="page-width new-page-width">
      {%- if selected_handle == blank -%}
        <p style="text-align: center; color: #777; font-size: 14px; padding: 10px 0;">
          No featured collection selected — showing current collection: {{ collection.title }}
        </p>
      {%- endif -%}

      <div class="grid">
        <div class="grid__item medium-up--one-fifth grid__item--sidebar">
          {%- render 'collection-grid-filters',
            collection: display_collection,
            enable_sidebar: section.settings.enable_sidebar,
            filter_style: section.settings.filter_style,
            collapsed: section.settings.collapsed,
            enable_color_swatches: section.settings.enable_color_swatches
          -%}
        </div>

        <div class="grid__item medium-up--four-fifths grid__item--content">
          {%- liquid
            for block in section.blocks
              case block.type
                when 'product_grid'
                  assign paginate_by = block.settings.per_row | times: block.settings.rows_per_page
              endcase
            endfor

            assign video_blocks = section.blocks | where: 'type', 'video'
          -%}

          {%- paginate display_collection.products by paginate_by -%}
            {%- for block in section.blocks -%}
              {% comment %} <div
                {{ block.shopify_attributes }}
                {%- if block.type == 'product_grid' -%}
                  data-scroll-to
                {%- endif -%}
              > {% endcomment %}
                {%- case block.type -%}
                  {%- when 'collection_description' -%}
                    {%- if display_collection.description != blank and current_filter_size == 0 -%}
                      <div class="rte collection__description">
                        {{ display_collection.description }}
                      </div>
                    {%- endif -%}
                  {%- when 'subcollections' -%}
                    {%- if paginate.current_page == 1 and current_filter_size == 0 -%}
                      {%- render 'subcollections', per_row: block.settings.subcollections_per_row -%}
                    {%- endif -%}
                  {%- when 'product_grid' -%}
                    <div data-scroll-to>
                      {% render 'new-collection-grid',
                        collection: display_collection,
                        items: display_collection.products,
                        enable_sidebar: section.settings.enable_sidebar,
                        filter_style: section.settings.filter_style,
                        enable_sort: section.settings.enable_sort,
                        enable_collection_count: block.settings.enable_collection_count,
                        per_row: block.settings.per_row,
                        mobile_flush_grid: block.settings.mobile_flush_grid,
                        quick_shop_enable: settings.quick_shop_enable,
                        video_blocks: video_blocks
                      %}

                      {%- if paginate.pages > 1 -%}
                        {%- render 'pagination', paginate: paginate -%}
                      {%- endif -%}
                    </div>
                {%- endcase -%}
              {% comment %} </div> {% endcomment %}
            {%- endfor -%}
            {% if section.settings.accURL != blank %}
              <div class="collection-footer">
                <div class="collection-footer_container new-page-width">
                  <div class="center_left Hover__arrow">
                    <a
                      class="center_left-inner Arrow Arrow--right"
                      href="{{section.settings.accURL}}"
                      {% if settings.open_new_tab %}
                        target="_blank" rel="noopener noreferrer"
                      {% endif %}
                    >
                      <span class="arrow__text"> See all accessories </span>
                    </a>
                    <span class="center_right">
                      <svg
                        class="Site_arrow__hover"
                        style="--arrow-clr:var(--new-blue);"
                        width="16"
                        height="16"
                        viewBox="0 0 16 16"
                        fill="none"
                      >
                        <path class="Arrow__path Arrow__path--one" fill="currentColor" d="M7.28033 3.21967C6.98744 2.92678 6.51256 2.92678 6.21967 3.21967C5.92678 3.51256 5.92678 3.98744 6.21967 4.28033L7.28033 3.21967ZM11 8L11.5303 8.53033C11.8232 8.23744 11.8232 7.76256 11.5303 7.46967L11 8ZM6.21967 11.7197C5.92678 12.0126 5.92678 12.4874 6.21967 12.7803C6.51256 13.0732 6.98744 13.0732 7.28033 12.7803L6.21967 11.7197ZM6.21967 4.28033L10.4697 8.53033L11.5303 7.46967L7.28033 3.21967L6.21967 4.28033ZM10.4697 7.46967L6.21967 11.7197L7.28033 12.7803L11.5303 8.53033L10.4697 7.46967Z"></path>
                        <path class="Arrow__path Arrow__path--two" stroke="currentColor" d="M1.75 8H11" stroke-width="1.5" stroke-linecap="round"></path>
                      </svg>
                    </span>
                  </div>
                </div>
              </div>
            {% endif %}
          {%- endpaginate -%}
        </div>
      </div>
    </div>
  </div>
</div>


{%- if section.settings.enable_sidebar == false
  or section.settings.filter_style == 'drawer'
  or display_collection.filters.size == 0
-%}
  {% style %}
    .collection-content .grid__item--sidebar { width: 0; padding:0; display:none; }
    .collection-content .grid__item--content { width: 100%; }
    .grid__item--sidebar { position: static; overflow: hidden; }
  {% endstyle %}
{%- endif -%}

{% style %}

  {% if settings.open_pdp_collection_cta %}
    .single-color-link:hover{transform: scale(1.1);}
    .single-color-link .swatch{pointer-events:none;}
  {% endif %}

{% endstyle %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "CollectionPage",
    {% if display_collection.description != blank %}
      "description": {{ display_collection.description | strip_html | json }},
    {% endif %}
    "name": {{ display_collection.title | json }}
  }
</script>

{% schema %}
{
  "name": "Collection GPS",
  "tag": "section",
  "settings": [
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Select a featured collection",
      "info": "Products, description & title will come from this collection. If nothing selected → uses current collection (e.g. All Products)"
    },
    {
      "type": "text",
      "id": "collectionHeading",
      "label": "Collection Heading",
      "info": "Optional custom heading (leave blank to use the collection's title)"
    },
    {
      "type": "checkbox",
      "id": "hide_title",
      "label": "Hide The Title"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection.settings.header_filtering_and_sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_sidebar",
      "label": "t:sections.main-collection.settings.enable_sidebar.label",
      "default": true,
      "info": "t:sections.main-collection.settings.enable_sidebar.info"
    },
    {
      "type": "checkbox",
      "id": "collapsed",
      "label": "t:sections.main-collection.settings.collapsed.label",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_style",
      "label": "t:sections.main-collection.settings.filter_style.label",
      "default": "sidebar",
      "options": [
        {
          "value": "sidebar",
          "label": "t:sections.main-collection.settings.filter_style.options.sidebar.label"
        },
        {
          "value": "drawer",
          "label": "t:sections.main-collection.settings.filter_style.options.drawer.label"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_color_swatches",
      "label": "t:sections.main-collection.settings.enable_color_swatches.label",
      "info": "t:sections.main-collection.settings.enable_color_swatches.info"
    },
    {
      "type": "checkbox",
      "id": "enable_sort",
      "label": "t:sections.main-collection.settings.enable_sort.label",
      "default": true
    },
    {
      "type": "collection",
      "id": "accURL",
      "label": "Select Collection"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video Selection",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Choose a video"
        },
        {
          "type": "select",
          "id": "card_size",
          "label": "Card Width",
          "options": [
            { "value": "one-col", "label": "Default (1 columns)" },
            { "value": "small", "label": "Medium (2 columns)" },
            { "value": "full", "label": "Full (3 columns)" }
          ],
          "default": "one-col"
        },
        {
          "type": "text",
          "id": "selectIndex",
          "label": "Video Position"
        },
        {
          "type": "text",
          "label": "Text For Play Button",
          "id": "playText"
        }
      ]
    },
    {
      "type": "collection_description",
      "name": "t:sections.main-collection.blocks.collection_description.name",
      "limit": 1
    },
    {
      "type": "product_grid",
      "name": "t:sections.main-collection.blocks.products.name",
      "settings": [
        {
          "type": "checkbox",
          "id": "enable_collection_count",
          "label": "t:sections.main-collection.blocks.products.settings.enable_collection_count.label",
          "default": true
        },
        {
          "type": "range",
          "id": "per_row",
          "label": "t:sections.main-collection.blocks.products.settings.per_row.label",
          "default": 4,
          "min": 2,
          "max": 5,
          "step": 1
        },
        {
          "type": "range",
          "id": "rows_per_page",
          "label": "t:sections.main-collection.blocks.products.settings.rows_per_page.label",
          "default": 7,
          "min": 3,
          "max": 20,
          "step": 1
        },
        {
          "type": "checkbox",
          "id": "mobile_flush_grid",
          "label": "t:sections.main-collection.blocks.products.settings.mobile_flush_grid.label",
          "default": false
        }
      ],
      "limit": 1
    },

    {
      "type": "subcollections",
      "name": "t:sections.main-collection.blocks.subcollections.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.main-collection.blocks.subcollections.settings.content"
        },
        {
          "type": "range",
          "id": "subcollections_per_row",
          "label": "t:sections.main-collection.blocks.subcollections.settings.subcollections_per_row.label",
          "default": 5,
          "min": 2,
          "max": 5,
          "step": 1
        }
      ],
      "limit": 1
    }
  ],
  "presets": [
    {
      "name": "Collection GPS"
    }
  ]
}
{% endschema %}
