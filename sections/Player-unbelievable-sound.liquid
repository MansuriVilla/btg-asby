<div class="unbelievable_sound_padding">
	<div class="unbelievable_sound_box">
    	<div class="unbelievable_sound_left">

          	<div class="price"><!--span>{{all_products['player-gps-speaker'].compare_at_price_max | money}}</span -->{{all_products['player-gps-speaker'].price | money}}</div>
            <span class="player-subsmall-text">INCLUDES 1YR FREE PREMIUM ACCESS</span>
          	{% if section.settings.heading != blank %}
            	<h3>{{ section.settings.heading }}</h3>
            {% endif %}
          	{% if section.settings.sub_heading != blank %}
            	<h2>{{ section.settings.sub_heading }}</h2>
            {% endif %}
			{% if section.settings.text != blank %}
            	<p>{{ section.settings.text }}</p>
            {% endif %}
        	
          	{%- if section.settings.link_text != blank -%}
             <div class="button">
               <a href="{{ section.settings.link }}" class="addcart">
                 {{ section.settings.link_text }}
               </a>
             </div>
            {%- endif -%}
        </div>
        <div class="unbelievable_sound_right">
        	{% if section.settings.speaker_image != blank %}
                <img src="{{ section.settings.speaker_image | img_url: 'master' }}" alt="{{ section.settings.speaker_image.alt | img_alt: 'master' }}">
            {% endif %}
        </div>
    </div>
</div>




{% schema %}
  {
    "name": "Player unbelievable sound",
    "settings": [
	  {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
	  {
        "type": "text",
        "id": "sub_heading",
        "label": "Sub heading"
      },
	  {
        "type": "textarea",
        "id": "text",
        "label": "Text"
      },
	  {
        "type": "image_picker",
        "id": "speaker_image",
        "label": "speaker Image"
      },
	  {
          "type": "url",
          "id": "link",
          "label": "button link"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Button text",
          "default": "Optional button"
        }
    ],    
    "presets": [
      {
        "name": "Player unbelievable sound",
        "category": "Image"
      }
    ]
  }
{% endschema %}