{% assign section_id = section.id %}
{% assign snippet_context = 'stay-ready' %}

<div class="tips_ready-section" style="background:url({{ section.settings.section_bg_image | img_url: 'master' }}) center center / cover no-repeat">
  <div class="tips_ready-inner">
    <div class="tips_ready-center" style="background:url({{ section.settings.box_bg_image | img_url: 'master' }}) center center / cover no-repeat">

      {%- if section.settings.title -%}
            <h3>{{ section.settings.title | escape }}</h3>
        {%- endif -%}

        {%- if section.settings.sub_title -%}
            <p>{{ section.settings.sub_title | escape }}</p>
        {%- endif -%}

      
      {%- assign newsletter_form_id = 'newsletter-' | append: section_id -%}
        {% form 'customer', id: newsletter_form_id %}
          {%- if form.posted_successfully? -%}
            <div class="note note--success">
              {{ 'general.newsletter_form.newsletter_confirmation' | t }}
            </div>
          {%- endif -%}
          {%- if form.errors and form.context == snippet_context -%}
            {{ form.errors | default_errors }}
          {%- endif -%}
        
          {%- unless form.posted_successfully? -%}
            <label for="Email-{{ section_id }}" class="hidden-label">{{ 'general.newsletter_form.newsletter_email' | t }}</label>
            <input type="hidden" name="contact[tags]" value="prospect,newsletter">
            <input type="hidden" name="contact[context]" value="{{ snippet_context }}">
            <div class="input-group newsletter__input-group tips_ready-input-holder">
              <input type="email" value="{% if customer %}{{ customer.email }}{% endif %}" placeholder="{{ 'general.newsletter_form.newsletter_email' | t }}" name="contact[email]" id="Email-{{ section_id }}" class="tips_ready-form input-group-field newsletter__input tips_ready-input" autocorrect="off" autocapitalize="off" aria-label="{{ 'general.newsletter_form.newsletter_email' | t }}">
              <div class="input-group-btn">
                <button type="submit" class="dbtn" name="commit">
                  <!-- <span class="form__submit--large">{{ 'general.newsletter_form.submit' | t }}</span> -->
                  <span class="form__submit--small ">

                     <span>
            <svg width="26" height="21" viewBox="0 0 26 21" fill="none" xmlns="http://www.w3.org/2000/svg"> <path d="M15.6939 0.957958L25.1439 9.95796C25.2415 10.0508 25.3189 10.1611 25.3718 10.2825C25.4246 10.4039 25.4518 10.534 25.4518 10.6655C25.4518 10.7969 25.4246 10.927 25.3718 11.0484C25.3189 11.1698 25.2415 11.2801 25.1439 11.373L15.6939 20.373C15.4968 20.5606 15.2296 20.666 14.951 20.666C14.6723 20.666 14.4051 20.5606 14.2081 20.373C14.0111 20.1853 13.9004 19.9308 13.9004 19.6655C13.9004 19.4001 14.0111 19.1456 14.2081 18.958L21.8665 11.6655L1.30098 11.6655C1.0225 11.6655 0.755428 11.5601 0.558515 11.3726C0.361602 11.185 0.250977 10.9307 0.250977 10.6655C0.250977 10.4002 0.361602 10.1459 0.558515 9.95835C0.755428 9.77082 1.0225 9.66546 1.30098 9.66546L21.8665 9.66546L14.2081 2.37296C14.0111 2.18532 13.9004 1.93082 13.9004 1.66546C13.9004 1.40009 14.0111 1.1456 14.2081 0.957958C14.4051 0.770318 14.6723 0.664902 14.951 0.664902C15.2296 0.664902 15.4968 0.770318 15.6939 0.957958Z" fill="#101010"/></svg> 
          </span>
                  </span>
                </button>
              </div>
            </div>
          {%- endunless -%}
        {% endform %}
      <!--form class="tips_ready-form">
        <div class="tips_ready-input-holder">
          <input class="tips_ready-input" placeholder="Email Address" required />
          <span>
            <svg width="26" height="21" viewBox="0 0 26 21" fill="none" xmlns="http://www.w3.org/2000/svg"> <path d="M15.6939 0.957958L25.1439 9.95796C25.2415 10.0508 25.3189 10.1611 25.3718 10.2825C25.4246 10.4039 25.4518 10.534 25.4518 10.6655C25.4518 10.7969 25.4246 10.927 25.3718 11.0484C25.3189 11.1698 25.2415 11.2801 25.1439 11.373L15.6939 20.373C15.4968 20.5606 15.2296 20.666 14.951 20.666C14.6723 20.666 14.4051 20.5606 14.2081 20.373C14.0111 20.1853 13.9004 19.9308 13.9004 19.6655C13.9004 19.4001 14.0111 19.1456 14.2081 18.958L21.8665 11.6655L1.30098 11.6655C1.0225 11.6655 0.755428 11.5601 0.558515 11.3726C0.361602 11.185 0.250977 10.9307 0.250977 10.6655C0.250977 10.4002 0.361602 10.1459 0.558515 9.95835C0.755428 9.77082 1.0225 9.66546 1.30098 9.66546L21.8665 9.66546L14.2081 2.37296C14.0111 2.18532 13.9004 1.93082 13.9004 1.66546C13.9004 1.40009 14.0111 1.1456 14.2081 0.957958C14.4051 0.770318 14.6723 0.664902 14.951 0.664902C15.2296 0.664902 15.4968 0.770318 15.6939 0.957958Z" fill="#101010"/></svg> 
          </span>
        </div>
                    </form -->
    </div>
  </div>
</div>


{% schema %}
{
  "name": "Stay ready",
  "class": "stay-ready",
  "settings": [
	{
          "type": "text",
          "id": "title",
          "label": "t:sections.rich-text.blocks.heading.settings.title.label",
          "default": "STAY READY FOR WHAT’S NEXT."
        },
		{
          "type": "textarea",
          "id": "sub_title",
          "label": "Sub title",
          "default": "Sign up for first access to new product drops, stories, and exclusive offers."
        },
        {
            "type": "image_picker",
            "id": "section_bg_image",
            "label": "Section background Image"
        },
        {
            "type": "image_picker",
            "id": "box_bg_image",
            "label": "Box backgroundImage"
        }
  ]
}
{% endschema %}

<style>
  .tips_ready-inner{padding:clamp(40px, 5vw, 100px) 0px; margin: 0 15px;}
  
 .tips_ready-form {
  width: 100%;
  max-width: clamp(200px, 65vw, 420px);
}



.tips_ready-input::placeholder {
  color: #00000050;
}


.tips_ready-inner #newsletter-tips-ready-section {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}
  
  
  .tips_ready-input-holder {
  position: relative;
  width: 100%;
  display: flex;
  justify-content: flex-end;
  align-items: center;
 padding: 15px 20px;
  background: #fff;  
    margin: 0;
  border: 0;
  outline: 0;
    max-width: 420px;
}
.tips_ready-center {
    padding: clamp(40px, 4vw, 50px) clamp(15px, 4vw, 50px);
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  row-gap: 20px;
  max-width: 1200px;
  margin: 0 auto;
  border-radius: 12px;
}
  .tips_ready-center p {
  padding: 0;
    font-size: 16px;
    text-align: center;
}
  .tips_ready-input-holder span {
  /* position: absolute; */
  display: flex;
}
  .tips_ready-input {
  width: 100%;
    font-family: "Roboto Mono", monospace;
    border:0px;
    padding: 0px 20px 0 0;
}

  .tips_ready-input:focus{border:0;}

  .tips_ready-inner h3 {
  color: #2D2D2D;
    line-height:1;
    
}

@media only screen and (max-width:420px){
  .tips_ready-inner h3{max-width: 260px; text-align:center;}
  .tips_ready-center p{font-size:14px;}
  .tips_ready-input-holder span{max-width: 20px;}
  .tips_ready-input{padding: 0px 23px 0 0;}
}
  
</style>