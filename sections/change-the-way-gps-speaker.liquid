{%- if section.settings.divider -%}<div class="section--divider">{%- endif -%}

<div class="text-{{ section.settings.align_text }} page-width{% if section.settings.narrow_column %} page-width--narrow{% endif %}">
  {%- for block in section.blocks -%}
    <div class="theme-block" {{ block.shopify_attributes }}>
      {%- case block.type -%}
        {%- when 'heading' -%}
          {%- if block.settings['heading-image'] != blank -%}
            <div class="single-img"><img src="{{ block.settings.heading-image | img_url: 'master' }}" alt="{{ block.settings.heading-image.alt | img_alt: 'master' }}"></div>
          {%- endif -%}
          <!--
            h2>{{ block.settings.title | escape }}</h2>
            <h3>{{ block.settings.sub_title | escape }}</h3
          -->

        {%- when 'page' -%}
          <div class="rte">
            {%- if block.settings.page_text != blank -%}
              {{ pages[block.settings.page_text].content }}
            {%- else -%}
              {{ 'home_page.onboarding.no_content' | t }}
            {%- endif -%}
          </div>
        {%- when 'single_image' -%}
          <div class="rte">
            {%- if block.settings['single-image'] != blank -%}
              <div class="single-img"><img src="{{ block.settings.single-image | img_url: 'master' }}" alt="{{ block.settings.single-image.alt | img_alt: 'master' }}"></div>
            {%- endif -%}

            
          </div>
        {%- when 'icon_text' -%}
          <div class="rte">

            {%- if page.handle contains 'newsale-player-plus' or page.handle contains 'newsale-player-pack' or page.handle contains 'offer' -%}
               <div class="price-add-to-cart">
                   <div class="price_box">
                         <div class="price_text"><span class="old">{{all_products['player-gps-speaker'].compare_at_price_max | money}}</span> {{ all_products['player-gps-speaker'].price | money }}</div> 
                      </div>
                    {%- if page.handle contains 'offer' -%}
                      <div class="product-single__meta">
                        <div class="compare-text">*Value includes the first year of Premium Access, a $50 value, <i>FREE</i> - orig. $49.99</div>
                      </div>
                    {%- endif -%}
                    <div class="add-to-cart-btn">
                        <a href="https://www.blueteesgolf.com/products/player-gps-speaker" class="btn">
                          ADD TO CART
                        </a>
                    </div>
                 </div>
              {%- endif -%}
        
           <div class="single-img desktop"><img src="{{ 'gps-pro-icons-desktop.svg' | asset_url }}" alt=""></div>
            <div class="single-img mobile"><img src="{{ 'gps-pro-icons-mobile.svg' | asset_url }}" alt=""></div>
            <!--
              ul class="eight-icon">
                       {%- if block.settings.icon_1 != blank -%}
                     		<li class="single-icon-text">
                               <div class=""><img src="{{ block.settings.icon_1 | img_url: 'master' }}"></div>
                               <h3>{{ block.settings.icon_1_text }}</h3>
                             </li>
                       {%- endif -%}
              {%- if block.settings.icon_2 != blank -%}
                     		<li class="single-icon-text">
                               <div class=""><img src="{{ block.settings.icon_2 | img_url: 'master' }}"></div>
                               <h3>{{ block.settings.icon_2_text }}</h3>
                             </li>
                       {%- endif -%}
                       {%- if block.settings.icon_3 != blank -%}
                     		<li class="single-icon-text">
                               <div class=""><img src="{{ block.settings.icon_3 | img_url: 'master' }}"></div>
                               <h3>{{ block.settings.icon_3_text }}</h3>
                             </li>
                       {%- endif -%}
                       {%- if block.settings.icon_4 != blank -%}
                     		<li class="single-icon-text">
                               <div class=""><img src="{{ block.settings.icon_4 | img_url: 'master' }}"></div>
                               <h3>{{ block.settings.icon_4_text }}</h3>
                             </li>
                       {%- endif -%}
                       {%- if block.settings.icon_5 != blank -%}
                     		<li class="single-icon-text">
                               <div class=""><img src="{{ block.settings.icon_5 | img_url: 'master' }}"></div>
                               <h3>{{ block.settings.icon_5_text }}</h3>
                             </li>
                       {%- endif -%}
                       {%- if block.settings.icon_6 != blank -%}
                     		<li class="single-icon-text">
                               <div class=""><img src="{{ block.settings.icon_6 | img_url: 'master' }}"></div>
                               <h3>{{ block.settings.icon_6_text }}</h3>
                             </li>
                       {%- endif -%}
                        {%- if block.settings.icon_9 != blank -%}
                     		<li class="single-icon-text">
                               <div class=""><img src="{{ block.settings.icon_9 | img_url: 'master' }}"></div>
                               <h3>{{ block.settings.icon_9_text }}</h3>
                             </li>
                       {%- endif -%}
                       {%- if block.settings.icon_7 != blank -%}
                     		<li class="single-icon-text">
                               <div class=""><img src="{{ block.settings.icon_7 | img_url: 'master' }}"></div>
                               <h3>{{ block.settings.icon_7_text }}</h3>
                             </li>
                       {%- endif -%}
                       {%- if block.settings.icon_8 != blank -%}
                     		<li class="single-icon-text">
                               <div class=""><img src="{{ block.settings.icon_8 | img_url: 'master' }}"></div>
                               <h3>{{ block.settings.icon_8_text }}</h3>
                             </li>
                       {%- endif -%}
                     </ul
            -->
          </div>
        {%- when 'text' -%}
          <div class="rte">
            {%- if block.settings.text != blank -%}
              {%- if block.settings.enlarge_text %}<div class="enlarge-text">{% endif -%}
              {{ block.settings.text }}
              {%- if block.settings.enlarge_text %}</div>{% endif -%}
            {%- else -%}
              {{ 'home_page.onboarding.no_content' | t }}
            {%- endif -%}
          </div>
        {%- when 'button' -%}
          <div class="rte">
            <a href="{{ block.settings.link }}" class="btn">
              {{ block.settings.link_text }}
            </a>
          </div>
        {%- when 'four_icon' -%}
          <div class="rte">
            <ul class="four-icon">
              {%- if block.settings.icon_1 != blank -%}
                <li class="single-icon"><img src="{{ block.settings.icon_1 | img_url: 'master' }}" alt="{{ block.settings.icon_1.alt | img_alt: 'master' }}"></li>
              {%- endif -%}
              {%- if block.settings.icon_2 != blank -%}
                <li class="single-icon"><img src="{{ block.settings.icon_2 | img_url: 'master' }}" alt="{{ block.settings.icon_2.alt | img_alt: 'master' }}"></li>
              {%- endif -%}
              {%- if block.settings.icon_3 != blank -%}
                <li class="single-icon"><img src="{{ block.settings.icon_3 | img_url: 'master' }}" alt="{{ block.settings.icon_3.alt | img_alt: 'master' }}"></li>
              {%- endif -%}
              {%- if block.settings.icon_4 != blank -%}
                <li class="single-icon"><img src="{{ block.settings.icon_4 | img_url: 'master' }}" alt="{{ block.settings.icon_4.alt | img_alt: 'master' }}"></li>
              {%- endif -%}
            </ul>
          </div>
      {%- endcase -%}
    </div>
  {%- endfor -%}
</div>

{%- if section.settings.divider -%}</div>{%- endif -%}

{% schema %}
{
  "name": "Change the way GPS",
  "class": "index-section",
  "settings": [
    {
      "type": "select",
      "id": "align_text",
      "label": "t:sections.rich-text.settings.align_text.label",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.align_text.options.left.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.align_text.options.center.label"
