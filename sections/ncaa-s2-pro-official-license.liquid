<div class="ncaa-s2-pro-center-section">
	<div class="free_shop_returns_bg">
    	<div class="free_shop">
            <p>
                {%- if section.settings.icon_one_title != blank -%}
                    <span>{{ section.settings.icon_one_title | escape }}</span>
                {%- endif -%}
                {%- if section.settings.icon_one_sub_title != blank -%}
                    <br>{{ section.settings.icon_one_sub_title | escape }}
                {%- endif -%}
            </p> 
            {%- if section.settings.icon_one_right_icon != blank -%}
                <div class="icon"><img   src="{{ section.settings.icon_one_right_icon | img_url: 'master' }}" alt="{{ section.settings.icon_one_right_icon.alt | img_alt: 'master' }}"></div>
            {%- endif -%}
        </div>
        <div class="logo_icon_img"><img   src="{{'logo-icon2.png' | asset_url}}" alt=""></div>
        
        <div class="free_shop">
            <p>
                {%- if section.settings.icon_two_title != blank -%}
                    <span>{{ section.settings.icon_two_title | escape }}</span>
                {%- endif -%}
                {%- if section.settings.icon_two_sub_title != blank -%}
                    <br>{{ section.settings.icon_two_sub_title | escape }}
                {%- endif -%}
            </p> 
            {%- if section.settings.icon_two_right_icon != blank -%}
                <div class="icon"><img src="{{ section.settings.icon_two_right_icon | img_url: 'master' }}" alt="{{ section.settings.icon_two_right_icon.alt | img_alt: 'master' }}"></div>
            {%- endif -%}
        </div>
    </div>
    
    <div class="official_logo_bg">
        {%- if section.settings.official_title != blank -%}
            <p>{{ section.settings.official_title | escape }}</p>
        {%- endif -%}
  
        <div class="official_logo_img">
            {%- if section.settings.official_icon_1 != blank -%}
                <img src="{{ section.settings.official_icon_1 | img_url: 'master' }}" alt="{{ section.settings.official_icon_1.alt | img_alt: 'master' }}">
            {%- endif -%}
        	{%- if section.settings.official_icon_2 != blank -%}
                <img src="{{ section.settings.official_icon_2 | img_url: 'master' }}" alt="{{ section.settings.official_icon_2.alt | img_alt: 'master' }}">
            {%- endif -%}
            {%- if section.settings.official_icon_3 != blank -%}
                <img src="{{ section.settings.official_icon_3 | img_url: 'master' }}" alt="{{ section.settings.official_icon_3.alt | img_alt: 'master' }}">
            {%- endif -%}
            {%- if section.settings.official_icon_4 != blank -%}
                <img src="{{ section.settings.official_icon_4 | img_url: 'master' }}" alt="{{ section.settings.official_icon_4.alt | img_alt: 'master' }}">
            {%- endif -%}
            {%- if section.settings.official_icon_5 != blank -%}
                <img src="{{ section.settings.official_icon_5 | img_url: 'master' }}" alt="{{ section.settings.official_icon_5.alt | img_alt: 'master' }}">
            {%- endif -%}
        </div>
        
        <div class="page-width">
          <h3>LIMITED <span>EDITION</span></h3>
          <div class="official_2pro_img"><img   src="{{'pro2-img.png' | asset_url}}"></div>
          <div class="best_selling_col4">        
                       
                          <div class="best_selling_icon">
                                 <div class="top-icon"> <img   src="{{'pro2-icon1.png' | asset_url}}" alt=""></div>
                                 <p>HD<br> display</p>
                           </div>
                      
                          <div class="best_selling_icon">
                            <div class="top-icon"> <img   src="{{'pro2-icon2.png' | asset_url}}" alt=""></div>
                                 <p>Active<br> slope</p>
                          </div>
                      
                          <div class="best_selling_icon">
                            	<div class="top-icon"> <img   src="{{'pro2-icon3.png' | asset_url}}" alt=""></div>
                                 <p>pulse <br>vibration</p>
                          </div>
                      
                          <div class="best_selling_icon">
                            <div class="top-icon"> <img   src="{{'pro2-icon4.png' | asset_url}}" alt=""></div>
                                 <p>Tournament<br> legal</p>
                          </div>
                      
                          <div class="best_selling_icon">
                            <div class="top-icon"> <img   src="{{'pro2-icon5.png' | asset_url}}" alt=""></div>
                                 <p>slope<br> switch</p>
                          </div>
                      
                          <div class="best_selling_icon">
                            <div class="top-icon"> <img   src="{{'pro2-icon6.png' | asset_url}}" alt=""></div>
                                 <p>advanced<br> flag lock </p>
                          </div>
                      
                          <div class="best_selling_icon">
                            <div class="top-icon"> <img   src="{{'pro2-icon7.png' | asset_url}}" alt=""></div>
                                 <p>800 yard <br>range  </p>
                          </div>
                      
                          <div class="best_selling_icon">
                               <div class="top-icon"> <img   src="{{'pro2-icon8.png' | asset_url}}" alt=""></div>
                                 <p>water <br>resistant</p>
                          </div>
                      

                
            </div>
            
            <div class="btg_box_bg">
          	<div class="btg_col_box">
              	<div class="btg_box">
              	<div class="img"><img   src="{{'btg-img1.png' | asset_url}}" alt=""></div>
                  <div class="icon"><img   src="{{'pro2-icon5.png' | asset_url}}" alt=""></div>
                  <h4>SLOPE SWITCH</h4>
                  <p>Series 2 Pro+ Features our mos advanced slope technology to accurately adjust your distance while taking hills into account for better club selection. Can be easily toggled off on tournament plays.</p>
  				</div>
              </div>
              <div class="btg_col_box">
              	<div class="btg_box">
              	<div class="img"><img   src="{{'btg-img2.png' | asset_url}}" alt=""></div>
                  <div class="icon"><img   src="{{'pro2-icon1.png' | asset_url}}" alt=""></div>
                  <h4>HD DISPLAY</h4>
                  <p>Series 2 Pro+ features adjustable Optic Focus System and HD Clear Display.</p>
                  </div>
              </div>
              <div class="btg_col_box">
              	<div class="btg_box">
              	<div class="img"><img   src="{{'btg-img3.png' | asset_url}}" alt=""></div>
                  <div class="icon"><img   src="{{'pro2-icon8.png' | asset_url}}" alt=""></div>
                  <h4>WATER RESISTANT</h4>
                  <p>Series 2 Pro+ Features is built to withstand rain and dew so you can play in all weather conditions.</p>
                  </div>
              </div>
          </div>
        </div>
        
        <div class="premium_accessories_bg">
        	<h2>PREMIUM ACCESSORIES<br><span>INCLUDED</span></h2>
            <div class="premium_accessories_img">
            	<img   src="{{'official-img1.png' | asset_url}}" alt="">
                <img   src="{{'official-img2.png' | asset_url}}" alt="">
                <img   src="{{'official-img3.png' | asset_url}}" alt="">
                <img   src="{{'official-img4.png' | asset_url}}" alt="">
                <img   src="{{'official-img5.png' | asset_url}}" alt="">
            </div>
            <p>S2 PRO+ CARRYING CASES</p>
        </div>
            
    </div>
</div>



{% schema %}
{
  "name": "Official license",
  "class": "official-license",
  "settings": [
      {
        "type": "header",
        "content": "Top two Icon"
      },
      {
        "type": "text",
        "id": "icon_one_title",
        "label": "Heading",
        "default": "Free Shipping"
      },
      {
        "type": "text",
        "id": "icon_one_sub_title",
        "label": "Sub title",
        "default": "The Player speaker"
      },
      {
          "type": "image_picker",
          "id": "icon_one_right_icon",
          "label": "right icon"
      },
      {
        "type": "text",
        "id": "icon_two_title",
        "label": "Heading",
        "default": "60 Day Returns"
      },
      {
        "type": "text",
        "id": "icon_two_sub_title",
        "label": "Sub title",
        "default": "No Questions Asked"
      },
      {
          "type": "image_picker",
          "id": "icon_two_right_icon",
          "label": "right icon"
      },
      {
        "type": "header",
        "content": "OFFICIAL LICENSE"
      },
      {
        "type": "text",
        "id": "official_title",
        "label": "Heading",
        "default": "OFFICIAL LICENSE"
      },
      {
          "type": "image_picker",
          "id": "official_icon_1",
          "label": "Official icon 1"
      },
      {
          "type": "image_picker",
          "id": "official_icon_2",
          "label": "Official icon 2"
      },
      {
          "type": "image_picker",
          "id": "official_icon_3",
          "label": "Official icon 3"
      },
      {
          "type": "image_picker",
          "id": "official_icon_4",
          "label": "Official icon 4"
      },
      {
          "type": "image_picker",
          "id": "official_icon_5",
          "label": "Official icon 5"
      }
  ]
}
{% endschema %}