<div class="playmaker_plusMain">
  <div class="custom_header-area">
    <div class="playmaker_header-custom">
      <div class="page-width">
        <div class="playmaker_header-inner">
          <div class="playmaker_header-left">
            <img
              class="white-logo"
              src="{{ 'play-maker-header-logo.png' | asset_url }}"
              alt=""
            >
            <img
              style="display: none"
              class="dark-logo"
              src="{{ 'dark-header-logo-pm-plus-pdp.png' | asset_url }}"
              alt=""
            >
          </div>
          <div class="playmaker_header-center">
            <!-- Normal Menu for Larger Screens -->
            <ul class="playmaker_links-parent" id="menuLinks">
              <li class="playmaker_links">
                <a href="#overview" class="playmaker_link">Overview</a>
              </li>
              <li class="playmaker_links">
                <a href="#construction" class="playmaker_link">Construction</a>
              </li>
              <li class="playmaker_links">
                <a href="#data" class="playmaker_link">Data</a>
              </li>
              <li class="playmaker_links">
                <a href="#connectivity" class="playmaker_link">Connectivity</a>
              </li>
            </ul>

            <!-- Dropdown for Smaller Screens (Below 820px) -->
            <select id="menuSelect" class="menu_select" style="display: none">
              <option value="#overview">Overview</option>
              <option value="#construction">Construction</option>
              <option value="#data">Data</option>
              <option value="#connectivity">Connectivity</option>
            </select>
          </div>
          <div class="playmaker_header-right">
            <a
              href="javascript:void(0);"
              {%if product.available %}
              id="playmaker-watch"
              {%endif %}
              class="cta_solid-bg"
              >
                {%if product.available %}

                BUY NOW
              {% else %}
                SOLD OUT
                {%endif %}
              </a
            >
          </div>
        </div>
      </div>
    </div>

