</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Playing Bento Grid Videos On Hover And Autoplaying Them From 820px
    function videoPlayOnHover() {
      const videos = document.querySelectorAll('.videoPlays__Hover');

      if (!videos.length) return;

      videos.forEach((video) => {
        video.setAttribute('playsinline', 'true');
        video.setAttribute('webkit-playsinline', 'true');

        if (/Mobi|Android|iPhone|iPad/i.test(navigator.userAgent)) {
          video.setAttribute('autoplay', 'true');
          video.setAttribute('muted', 'true');
          video.play();
        } else {
          video.addEventListener('mouseenter', () => video.play());
          video.addEventListener('mouseleave', () => video.pause());
        }
      });
    }
    videoPlayOnHover();

    // On Click Chnage height to auto For The Compare Area Image
    function heightChange() {
      const button = document.getElementById('expandButton');
      const imageArea = document.getElementById('imageArea');
      const icon = document.getElementById('expandIcon');

      button.addEventListener('click', function () {
        if (window.innerWidth <= 820) {
          return;
        }

        if (imageArea.style.height === '100%') {
          imageArea.style.height = '440px';
          icon.style.transform = 'rotate(0deg)';
          button.setAttribute('aria-expanded', 'false');
        } else {
          imageArea.style.height = '100%';
          icon.style.transform = 'rotate(180deg)';
          button.setAttribute('aria-expanded', 'true');
        }
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth <= 820) {
          imageArea.style.height = '460px';
          icon.style.transform = 'rotate(0deg)';
          button.setAttribute('aria-expanded', 'false');
        }
      });
    }
    heightChange();

    // Updating Dropdown Value On Scroll For The Data Section Only
    function valueUpdate() {
      function scrollToSection(event) {
        event.preventDefault();
        const sectionId = event.target.value;
        const section = document.getElementById(sectionId);

        if (section) {
          section.scrollIntoView({
            behavior: 'smooth',
            block: 'center',
          });

          setTimeout(() => {
            document.getElementById('mobileSectionDropdown').value = sectionId;
          }, 500);
        }
      }

      const dropdown = document.getElementById('mobileSectionDropdown');
      if (dropdown) dropdown.addEventListener('change', scrollToSection);

      window.addEventListener('scroll', function () {
        const sections = document.querySelectorAll('div[id^="mobile-section"]');
        let currentSection = '';
        sections.forEach((section) => {
          const rect = section.getBoundingClientRect();
          const sectionCenter = rect.top + rect.height / 2;
          if (sectionCenter >= 0 && sectionCenter <= window.innerHeight) {
            currentSection = section.id;
          }
        });
        const mDropdown = document.getElementById('mobileSectionDropdown');
        if (mDropdown && currentSection && mDropdown.value !== currentSection) {
          mDropdown.value = currentSection;
        }
      });
    }
    valueUpdate();

    // This Function is to set Nav link Active On Scroll Based On Section ID's
    function settingLinksActive() {
      const sections = document.querySelectorAll('.has_section, .bg_white');
      const navLinks = document.querySelectorAll('.playmaker_link');
      const menuSelect = document.getElementById('menuSelect');
      const header = document.querySelector('.playmaker_header-custom');

      menuSelect.addEventListener('change', function () {
        const targetSection = document.querySelector(this.value);
        if (targetSection) {
          window.scrollTo({
            top: targetSection.offsetTop - 50,
            behavior: 'smooth',
          });
        }
      });

      let currentActiveId = null;
      let lastActiveSection = null;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {});

          const visibleEntries = entries.filter((entry) => entry.isIntersecting);

          if (visibleEntries.length > 0) {
            const bestEntry = visibleEntries.reduce((prev, curr) =>
              prev.boundingClientRect.top < curr.boundingClientRect.top ? prev : curr
            );
            const id = bestEntry.target.getAttribute('id');

            if (id !== currentActiveId || lastActiveSection !== id) {
              currentActiveId = id;

              navLinks.forEach((link) => {
                link.classList.toggle('active', link.getAttribute('href') === `#${id}`);
              });

              if (window.innerWidth <= 820) {
                menuSelect.value = `#${id}`;
              }

              if (bestEntry.target.classList.contains('bg_white')) {
                header.classList.add('section_IsWhite');
              } else {
                header.classList.remove('section_IsWhite');
              }

              lastActiveSection = id;
            }
          } else {
            if (lastActiveSection && !currentActiveId) {
              currentActiveId = lastActiveSection;
              navLinks.forEach((link) => {
                link.classList.toggle('active', link.getAttribute('href') === `#${currentActiveId}`);
              });
            }
          }
        },
        {
          threshold: 0.1,
          rootMargin: '0px 0px 1% 0px',
        }
      );

      sections.forEach((section) => {
        observer.observe(section);
      });

      window.addEventListener('resize', function () {});
    }
    settingLinksActive();

    //-------------------------------------------
    // This Function is to Animate The Texts, Screens and Background Image Watch Section Only
    //------------------

    function stickyAnimation() {
      const animationConfigs = {
        BG_right: {
          screen: { axis: 'x', distance: 100 },
          featureBg: { axis: 'y', distance: 0 },
          feature: { axis: 'y', distance: 75 },
          duration: 2.5,
          pause: 0.5,
          easeIn: 'none',
          easeOut: 'none',
        },
      };

      const containers = document.querySelectorAll('.stacking_section-container');

      const refreshScrollTrigger = () => {
        ScrollTrigger.refresh();
      };

      containers.forEach((container, index) => {
        const wrapper = document.createElement('div');
        wrapper.classList.add('pin-wrapper');
        container.parentNode.insertBefore(wrapper, container);
        wrapper.appendChild(container);

        let configKey = 'default';
        if (container.classList.contains('UI_right')) {
          configKey = 'UI_right';
        } else if (container.classList.contains('BG_right')) {
          configKey = 'BG_right';
        }

        const config = animationConfigs[configKey];

        const texts = gsap.utils.toArray('.feature', container);
        const screens = gsap.utils.toArray('.screen', container);
        const bgs = gsap.utils.toArray('.feature-bg', container);

        if (texts.length !== screens.length || texts.length !== bgs.length) {
          console.error(`Mismatch in element counts for container ${index + 1}`);
          return;
        }

        gsap.set([texts[0], screens[0], bgs[0]], { opacity: 1, x: 0, y: 0 });
        gsap.set([...texts.slice(1)], {
          opacity: 0,
          [config.feature.axis]: config.feature.distance,
        });
        gsap.set([...screens.slice(1)], {
          opacity: 0,
          [config.screen.axis]: config.screen.axis === 'x' ? config.screen.distance : -config.screen.distance,
        });
        gsap.set([...bgs.slice(1)], {
          opacity: 0,
          [config.featureBg.axis]: config.featureBg.distance,
        });

        const dropdown = container.querySelector('#desktopSectionDropdown');
        const prevBtn = document.getElementById('desktopPrevBtn');
        const nextBtn = document.getElementById('desktopNextBtn');
        const liveRegion = document.getElementById('desktopLiveRegion');
        let currentActiveFeature = null;

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: wrapper,
            start: 'top top',
            end: '+=' + window.innerHeight * 5,
            scrub: true,
            pin: wrapper,

            markers: false,
            onUpdate: (self) => {
              const currentTime = tl.time();
              let activeFeature = null;

              // Determine the active feature based on timeline time
              for (let j = 1; j <= texts.length; j++) {
                const start = tl.labels[`feature${j}_start`];
                const nextStart = j < texts.length ? tl.labels[`feature${j + 1}_start`] : tl.duration();
                if (currentTime >= start && currentTime < nextStart) {
                  activeFeature = j;
                  break;
                }
              }

              // Update dropdown if the active feature changes
              if (activeFeature !== currentActiveFeature) {
                if (dropdown) dropdown.value = `section${activeFeature}`;
                currentActiveFeature = activeFeature;
                
                if (prevBtn) prevBtn.disabled = activeFeature === 1;
                if (nextBtn) nextBtn.disabled = activeFeature === texts.length;
                
                if (dropdown && liveRegion && activeFeature) {
                  liveRegion.textContent = `Showing feature: ${dropdown.options[dropdown.selectedIndex].text}`;
                }
              }
            },
          },
        });

        function goToFeature(idx) {
          if (!tl.scrollTrigger) return;
          const st = tl.scrollTrigger;
          const labelTime = tl.labels[`feature${idx}_start`];
          if (labelTime === undefined) return;
          const progress = labelTime / tl.duration();
          const scrollPos = st.start + (st.end - st.start) * progress;
          window.scrollTo({ top: scrollPos + 5, behavior: 'smooth' });
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', () => {
            if (currentActiveFeature > 1) goToFeature(currentActiveFeature - 1);
          });
        }
        
        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            if (currentActiveFeature < texts.length) goToFeature(currentActiveFeature + 1);
          });
        }
        
        if (dropdown) {
          dropdown.addEventListener('change', (e) => {
            const idx = parseInt(e.target.value.replace('section', ''));
            goToFeature(idx);
          });
        }

        texts.forEach((txt, i) => {
          const animProps = {
            opacity: 1,
            duration: config.duration,
            ease: config.easeIn,
          };
          const exitProps = {
            opacity: 0,
            duration: config.duration,
            ease: config.easeOut,
          };

          const textAnim = { ...animProps, [config.feature.axis]: 0 };
          const screenAnim = { ...animProps, [config.screen.axis]: 0 };
          const bgAnim = { ...animProps, [config.featureBg.axis]: 0 };
          const textExit = {
            ...exitProps,
            [config.feature.axis]: -config.feature.distance,
          };
          const screenExit = {
            ...exitProps,
            [config.screen.axis]: config.screen.axis === 'x' ? -config.screen.distance : config.screen.distance,
          };
          const bgExit = {
            ...exitProps,
            [config.featureBg.axis]: -config.featureBg.distance,
          };

          // Add label at the start of the feature's entrance animation
          tl.add(`feature${i + 1}_start`);

          if (i < texts.length - 1) {
            tl.to(txt, textAnim)
              .to(screens[i], screenAnim, '<')
              .to(bgs[i], bgAnim, '<')
              .to({}, { duration: config.pause })
              .to(txt, textExit)
              .to(screens[i], screenExit, '<')
              .to(bgs[i], bgExit, '<');
          } else {
            tl.to(txt, textAnim)
              .to(screens[i], screenAnim, '<')
              .to(bgs[i], bgAnim, '<')
              .to({}, { duration: config.pause });
          }
        });
      });

      gsap.delayedCall(0.1, refreshScrollTrigger);

      window.addEventListener('resize', refreshScrollTrigger);
    }

    stickyAnimation();




  });
</script>
