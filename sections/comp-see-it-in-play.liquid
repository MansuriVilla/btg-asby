<script>
  (function() {
    function initSeeItInPlay() {
      const section = document.getElementById('comp-see-play-{{ s_id }}');
      if (!section) return;

      // 1. Desktop Add To Cart
      const addBtns = section.querySelectorAll('.js-comp-add-to-cart');
      addBtns.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          const card = this.closest('.comp-accessory-row');
          const variantId = this.getAttribute('data-variant-id') || (card ? card.getAttribute('data-variant-id') : '');
          const btnText = this.querySelector('.content-cta__text') || this.querySelector('[data-label]') || this;

          if (!variantId) {
            if (btnText) {
              const orig = btnText.textContent;
              btnText.textContent = 'DEMO ONLY';
              setTimeout(() => { btnText.textContent = orig; }, 1600);
            }
            return;
          }

          this.classList.add('is-loading');
          this.disabled = true;

          fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({ id: variantId, quantity: 1 })
          })
          .then(res => res.json())
          .then(itemData => {
            btn.classList.remove('is-loading');
            btn.disabled = false;
            if (btnText) {
              btnText.textContent = 'ADDED ✓';
              setTimeout(() => { btnText.textContent = 'ADD +'; }, 2000);
            }
            document.dispatchEvent(new CustomEvent('ajaxProduct:added', { detail: { product: itemData } }));
            document.dispatchEvent(new CustomEvent('cart:open'));
          })
          .catch(err => {
            console.error('Error adding to cart:', err);
            btn.classList.remove('is-loading');
            btn.disabled = false;
          });
        });
      });

      // 2. Mobile Video Grid & Modal Reel
      const modal = section.querySelector('#comp-sip-modal-{{ s_id }}');
      const mobileCards = section.querySelectorAll('.comp-see-in-play__mobile-card');
      if (!modal || mobileCards.length === 0) return;

      const videoEl = modal.querySelector('[data-modal-video]');
      const creatorEl = modal.querySelector('[data-modal-creator]');
      const pDrawer = modal.querySelector('[data-product-drawer]');
      const drawerToggle = modal.querySelector('[data-drawer-toggle]');
      const pTitle = modal.querySelector('[data-product-title]');
      const pSub = modal.querySelector('[data-product-sub]');
      const pPrice = modal.querySelector('[data-product-price]');
      const pCompare = modal.querySelector('[data-product-compare]');
      const pImg = modal.querySelector('[data-product-img]');
      const atcBtn = modal.querySelector('[data-modal-atc]');
      const timeCurrent = modal.querySelector('[data-modal-time-current]');
      const nextBtn = modal.querySelector('[data-modal-next]');
      const muteBtn = modal.querySelector('[data-modal-mute]');
      const playBtn = modal.querySelector('[data-modal-play]');
      const closeBtns = modal.querySelectorAll('[data-modal-close]');

      let currentIndex = 0;
      let isMuted = false;

      function formatTime(sec) {
        const m = Math.floor(sec / 60);
        const s = Math.floor(sec % 60);
        return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
      }

      function loadVideoIndex(index) {
        if (index < 0) index = mobileCards.length - 1;
        if (index >= mobileCards.length) index = 0;
        currentIndex = index;

        const card = mobileCards[currentIndex];
        const vUrl = card.getAttribute('data-video-url');
        const creator = card.getAttribute('data-creator');
        const title = card.getAttribute('data-product-title');
        const sub = card.getAttribute('data-product-sub');
        const price = card.getAttribute('data-product-price');
        const compare = card.getAttribute('data-product-compare');
        const img = card.getAttribute('data-product-img');
        const variantId = card.getAttribute('data-variant-id');

        if (creatorEl) creatorEl.textContent = creator || '@ALLIE.GOLFS';
        if (pTitle) pTitle.textContent = title;
        if (pSub) pSub.textContent = sub;
        if (pPrice) {
          pPrice.textContent = price;
          if (compare && compare.trim() !== '') {
            pPrice.classList.add('is-on-sale');
          } else {
            pPrice.classList.remove('is-on-sale');
          }
        }
        if (pCompare) {
          pCompare.textContent = compare || '';
          pCompare.style.display = (compare && compare.trim() !== '') ? '' : 'none';
        }
        if (pImg) pImg.src = img;
        if (atcBtn) atcBtn.setAttribute('data-variant-id', variantId || '');

        if (pDrawer) pDrawer.classList.remove('is-collapsed');

        if (videoEl) {
          videoEl.pause();
          videoEl.src = vUrl;
          videoEl.muted = isMuted;
          videoEl.load();
          videoEl.play().catch(function() {});
        }
      }

      function openModal(index) {
        modal.classList.add('is-open');
        document.body.style.overflow = 'hidden';
        loadVideoIndex(index);
      }

      function closeModal() {
        modal.classList.remove('is-open');
        document.body.style.overflow = '';
        if (videoEl) {
          videoEl.pause();
        }
      }

      // Card clicks
      mobileCards.forEach(function(card, idx) {
        card.addEventListener('click', function() {
          openModal(idx);
        });
      });

      // Close actions
      closeBtns.forEach(btn => btn.addEventListener('click', closeModal));

      // Product card collapse / expand toggle
      if (drawerToggle && pDrawer) {
        drawerToggle.addEventListener('click', function(e) {
          e.stopPropagation();
          pDrawer.classList.toggle('is-collapsed');
        });
      }

      // Next button
      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          loadVideoIndex(currentIndex + 1);
        });
      }

      // Swipe gesture on video modal (swipe up for next video)
      let touchStartY = 0;
      let touchEndY = 0;
      modal.addEventListener('touchstart', function(e) {
        touchStartY = e.changedTouches[0].screenY;
      }, { passive: true });

      modal.addEventListener('touchend', function(e) {
        touchEndY = e.changedTouches[0].screenY;
        const diff = touchStartY - touchEndY;
        if (diff > 50) {
          // Swipe Up -> Next Video
          loadVideoIndex(currentIndex + 1);
        } else if (diff < -80 && !pDrawer.contains(e.target)) {
          // Swipe Down -> Close
          closeModal();
        }
      }, { passive: true });

      // Video time update
      if (videoEl && timeCurrent) {
        videoEl.addEventListener('timeupdate', function() {
          timeCurrent.textContent = formatTime(videoEl.currentTime);
        });
      }

      // Mute toggle
      if (muteBtn && videoEl) {
        muteBtn.addEventListener('click', function() {
          isMuted = !isMuted;
          videoEl.muted = isMuted;
          const iconMuted = muteBtn.querySelector('.icon-muted');
          const iconUnmuted = muteBtn.querySelector('.icon-unmuted');
          if (iconMuted && iconUnmuted) {
            iconMuted.style.display = isMuted ? 'block' : 'none';
            iconUnmuted.style.display = isMuted ? 'none' : 'block';
          }
        });
      }

      // Play / Pause toggle
      if (playBtn && videoEl) {
        playBtn.addEventListener('click', function() {
          const iconPause = playBtn.querySelector('.icon-pause');
          const iconPlay = playBtn.querySelector('.icon-play');
          if (videoEl.paused) {
            videoEl.play();
            if (iconPause && iconPlay) {
              iconPause.style.display = 'block';
              iconPlay.style.display = 'none';
            }
          } else {
            videoEl.pause();
            if (iconPause && iconPlay) {
              iconPause.style.display = 'none';
              iconPlay.style.display = 'block';
            }
          }
        });
      }

      // Modal ATC button
      if (atcBtn) {
        atcBtn.addEventListener('click', function(e) {
          e.preventDefault();
          const variantId = this.getAttribute('data-variant-id');
          const btnText = this.querySelector('.comp-sip-modal__atc-text') || this;

          if (!variantId) {
            const orig = btnText.textContent;
            btnText.textContent = 'DEMO ONLY';
            setTimeout(() => { btnText.textContent = orig; }, 1600);
            return;
          }

          this.disabled = true;
          fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({ id: variantId, quantity: 1 })
          })
          .then(res => res.json())
          .then(itemData => {
            this.disabled = false;
            btnText.textContent = 'ADDED ✓';
            setTimeout(() => { btnText.textContent = 'ADD TO CART'; }, 2000);
            document.dispatchEvent(new CustomEvent('ajaxProduct:added', { detail: { product: itemData } }));
            document.dispatchEvent(new CustomEvent('cart:open'));
          })
          .catch(err => {
            console.error('Error adding to cart:', err);
            this.disabled = false;
          });
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSeeItInPlay);
    } else {
      initSeeItInPlay();
    }
  })();
</script>

