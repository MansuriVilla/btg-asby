{% liquid
  assign s_id = section.id
  assign title = section.settings.heading | default: 'SEE IT IN PLAY'
  assign subtitle = section.settings.subtitle | default: 'Real rounds. Real setups. See how Player Pro shows up when it matters most.'
  assign bg_image = section.settings.background_image
  assign video_blocks = section.blocks | where: 'type', 'video_reel'
  assign product_blocks = section.blocks | where: 'type', 'product_item'
  assign section_id = section.settings.custom_section_id | default: ''
  if section_id == blank
    assign section_id = 'comp-see-play-' | append: s_id
  endif
%}

<div
  class="comp-see-in-play comp-see-in-play-{{ s_id }}"
  id="{{ section_id }}"
  style="--comp-sip-pt: {{ section.settings.padding_top | default: 60 }}px; --comp-sip-pb: {{ section.settings.padding_bottom | default: 60 }}px;"
>
  {% if bg_image != blank %}
    <div class="comp-see-in-play__bg-image" style="background-image: url('{{ bg_image | image_url: width: 2000 }}');"></div>
  {% endif %}

  <!-- Linear gradient background overlay -->
  <div class="comp-see-in-play__linear-bg" aria-hidden="true"></div>

  <div class="comp-see-in-play__container">
    
    <!-- Header -->
    <header class="comp-see-in-play__header">
      <h2 class="comp-see-in-play__title custom_heading">{{ title }}</h2>
      {% if subtitle != blank %}
        <p class="comp-see-in-play__subtitle custom_body-text">{{ subtitle }}</p>
      {% endif %}
    </header>

    <!-- Desktop Floating White Card (hidden on mobile <= 991px) -->
    <div class="comp-see-in-play__card comp-see-in-play__card--desktop">
      <div class="comp-see-in-play__grid">
        
        <!-- Left Column: Video Reel Player -->
        <div class="comp-see-in-play__video-col">
          {% capture reel_thumbs %}
            {% if product_blocks.size > 0 %}
              {% for block in product_blocks %}
                {% liquid
                  assign v_src = ''
                  if block.settings.video.sources
                    for source in block.settings.video.sources
                      if source.format == 'mp4'
                        assign v_src = source.url
                        break
                      endif
                    endfor
                    if v_src == blank
                      assign v_src = block.settings.video.sources.first.url
                    endif
                  elsif block.settings.video_url != blank
                    assign v_src = block.settings.video_url
                  elsif video_blocks[forloop.index0] != blank
                    assign vb = video_blocks[forloop.index0]
                    if vb.settings.video.sources
                      assign v_src = vb.settings.video.sources.first.url
                    elsif vb.settings.video_url != blank
                      assign v_src = vb.settings.video_url
                    endif
                  endif

                  if v_src == blank
                    case forloop.index
                      when 1
                        assign v_src = 'https://cdn.shopify.com/videos/c/o/v/0fca515419e743d4a7ed6047598c316c.mp4'
                      when 2
                        assign v_src = 'https://cdn.shopify.com/videos/c/o/v/74124ef049424293875aee3998fb37b3.mp4'
                      when 3
                        assign v_src = 'https://cdn.shopify.com/videos/c/o/v/a5c1aedc48af44f0a298a83028cd054a.mp4'
                    endcase
                  endif

                  assign p_src = ''
                  if block.settings.poster != blank
                    assign p_src = block.settings.poster | image_url: width: 300
                  elsif block.settings.video.preview_image != blank
                    assign p_src = block.settings.video.preview_image | image_url: width: 300
                  elsif block.settings.custom_image != blank
                    assign p_src = block.settings.custom_image | image_url: width: 300
                  elsif block.settings.fallback_asset_img != blank
                    assign p_src = block.settings.fallback_asset_img | asset_url
                  endif

                  assign c_handle = block.settings.creator_handle
                  if c_handle == blank and video_blocks[forloop.index0] != blank
                    assign c_handle = video_blocks[forloop.index0].settings.creator_handle
                  endif
                  if c_handle == blank
                    case forloop.index
                      when 1
                        assign c_handle = '@ALLIE.GOLFS'
                      when 2
                        assign c_handle = '@COURSE.TOUR'
                      when 3
                        assign c_handle = '@BLUETEES'
                    endcase
                  endif
                %}
                <button
                  type="button"
                  class="comp-video-reel__thumb-btn {% if forloop.first %}is-active{% endif %}"
                  data-video-src="{{ v_src }}"
                  data-poster-src="{{ p_src }}"
                  data-creator-handle="{{ c_handle }}"
                  aria-label="Play video {{ forloop.index }} by {{ c_handle }}"
                >
                  {% if p_src != blank %}
                    <img src="{{ p_src }}" alt="{{ c_handle }}" class="comp-video-reel__thumb-img" loading="lazy">
                  {% else %}
                    <img src="{{ 'player-speaker-img.png' | asset_url }}" alt="{{ c_handle }}" class="comp-video-reel__thumb-img" loading="lazy">
                  {% endif %}
                  <span class="comp-video-reel__thumb-icon comp-video-reel__thumb-icon--play">▶</span>
                  <span class="comp-video-reel__thumb-icon comp-video-reel__thumb-icon--pause">❚❚</span>
                </button>
              {% endfor %}
            {% elsif video_blocks.size > 0 %}
              {% for block in video_blocks %}
                {% liquid
                  assign v_src = ''
                  if block.settings.video.sources
                    for source in block.settings.video.sources
                      if source.format == 'mp4'
                        assign v_src = source.url
                        break
                      endif
                    endfor
                    if v_src == blank
                      assign v_src = block.settings.video.sources.first.url
                    endif
                  elsif block.settings.video_url != blank
                    assign v_src = block.settings.video_url
                  endif

                  assign p_src = ''
                  if block.settings.poster != blank
                    assign p_src = block.settings.poster | image_url: width: 300
                  elsif block.settings.video.preview_image != blank
                    assign p_src = block.settings.video.preview_image | image_url: width: 300
                  endif

                  assign c_handle = block.settings.creator_handle | default: '@ALLIE.GOLFS'
                %}
                <button
                  type="button"
                  class="comp-video-reel__thumb-btn {% if forloop.first %}is-active{% endif %}"
                  data-video-src="{{ v_src }}"
                  data-poster-src="{{ p_src }}"
                  data-creator-handle="{{ c_handle }}"
                  aria-label="Play video {{ forloop.index }} by {{ c_handle }}"
                >
                  {% if p_src != blank %}
                    <img src="{{ p_src }}" alt="{{ c_handle }}" class="comp-video-reel__thumb-img" loading="lazy">
                  {% else %}
                    <img src="{{ 'player-speaker-img.png' | asset_url }}" alt="{{ c_handle }}" class="comp-video-reel__thumb-img" loading="lazy">
                  {% endif %}
                  <span class="comp-video-reel__thumb-icon comp-video-reel__thumb-icon--play">
                    <svg viewBox="0 0 24 24" width="8" height="8" fill="currentColor">
                      <polygon points="6,4 20,12 6,20"/>
                    </svg>
                  </span>
                  <span class="comp-video-reel__thumb-icon comp-video-reel__thumb-icon--pause">
                    <svg viewBox="0 0 24 24" width="8" height="8" fill="currentColor">
                      <rect x="5" y="4" width="4" height="16" rx="1"/>
                      <rect x="15" y="4" width="4" height="16" rx="1"/>
                    </svg>
                  </span>
                </button>
              {% endfor %}
            {% else %}
              <button
                type="button"
                class="comp-video-reel__thumb-btn is-active"
                data-video-src="https://cdn.shopify.com/videos/c/o/v/0fca515419e743d4a7ed6047598c316c.mp4"
                data-creator-handle="@ALLIE.GOLFS"
              >
                {{ 'player-speaker-img.png' | asset_img_url: '300x' | image_tag: class: 'comp-video-reel__thumb-img', loading: 'lazy', alt: 'Allie Golfs' }}
                <span class="comp-video-reel__thumb-icon comp-video-reel__thumb-icon--play">
                  <svg viewBox="0 0 24 24" width="8" height="8" fill="currentColor">
                    <polygon points="6,4 20,12 6,20"/>
                  </svg>
                </span>
                <span class="comp-video-reel__thumb-icon comp-video-reel__thumb-icon--pause">
                  <svg viewBox="0 0 24 24" width="8" height="8" fill="currentColor">
                    <rect x="5" y="4" width="4" height="16" rx="1"/>
                    <rect x="15" y="4" width="4" height="16" rx="1"/>
                  </svg>
                </span>
              </button>
              <button
                type="button"
                class="comp-video-reel__thumb-btn"
                data-video-src="https://cdn.shopify.com/videos/c/o/v/74124ef049424293875aee3998fb37b3.mp4"
                data-creator-handle="@COURSE.TOUR"
              >
                {{ 'mag-towel-img.png' | asset_img_url: '300x' | image_tag: class: 'comp-video-reel__thumb-img', loading: 'lazy', alt: 'Course Tour' }}
                <span class="comp-video-reel__thumb-icon comp-video-reel__thumb-icon--play">
                  <svg viewBox="0 0 24 24" width="8" height="8" fill="currentColor">
                    <polygon points="6,4 20,12 6,20"/>
                  </svg>
                </span>
                <span class="comp-video-reel__thumb-icon comp-video-reel__thumb-icon--pause">
                  <svg viewBox="0 0 24 24" width="8" height="8" fill="currentColor">
                    <rect x="5" y="4" width="4" height="16" rx="1"/>
                    <rect x="15" y="4" width="4" height="16" rx="1"/>
                  </svg>
                </span>
              </button>
              <button
                type="button"
                class="comp-video-reel__thumb-btn"
                data-video-src="https://cdn.shopify.com/videos/c/o/v/a5c1aedc48af44f0a298a83028cd054a.mp4"
                data-creator-handle="@BLUETEES"
              >
                {{ 'divot-img1.png' | asset_img_url: '300x' | image_tag: class: 'comp-video-reel__thumb-img', loading: 'lazy', alt: 'Blue Tees Round' }}
                <span class="comp-video-reel__thumb-icon comp-video-reel__thumb-icon--play">
                  <svg viewBox="0 0 24 24" width="8" height="8" fill="currentColor">
                    <polygon points="6,4 20,12 6,20"/>
                  </svg>
                </span>
                <span class="comp-video-reel__thumb-icon comp-video-reel__thumb-icon--pause">
                  <svg viewBox="0 0 24 24" width="8" height="8" fill="currentColor">
                    <rect x="5" y="4" width="4" height="16" rx="1"/>
                    <rect x="15" y="4" width="4" height="16" rx="1"/>
                  </svg>
                </span>
              </button>
            {% endif %}
          {% endcapture %}

          {% liquid
            assign first_v_src = 'https://cdn.shopify.com/videos/c/o/v/0fca515419e743d4a7ed6047598c316c.mp4'
            assign first_p_src = ''
            assign first_handle = '@ALLIE.GOLFS'

            if product_blocks.size > 0
              assign first_pb = product_blocks.first
              if first_pb.settings.video.sources
                for source in first_pb.settings.video.sources
                  if source.format == 'mp4'
                    assign first_v_src = source.url
                    break
                  endif
                endfor
                if first_v_src == blank
                  assign first_v_src = first_pb.settings.video.sources.first.url
                endif
              elsif first_pb.settings.video_url != blank
                assign first_v_src = first_pb.settings.video_url
              elsif video_blocks.size > 0 and video_blocks.first.settings.video_url != blank
                assign first_v_src = video_blocks.first.settings.video_url
              endif

              if first_pb.settings.poster != blank
                assign first_p_src = first_pb.settings.poster | image_url: width: 800
              endif
              if first_pb.settings.creator_handle != blank
                assign first_handle = first_pb.settings.creator_handle
              elsif video_blocks.size > 0 and video_blocks.first.settings.creator_handle != blank
                assign first_handle = video_blocks.first.settings.creator_handle
              endif
            elsif video_blocks.size > 0
              assign first_b = video_blocks.first
              if first_b.settings.video.sources
                for source in first_b.settings.video.sources
                  if source.format == 'mp4'
                    assign first_v_src = source.url
                    break
                  endif
                endfor
              elsif first_b.settings.video_url != blank
                assign first_v_src = first_b.settings.video_url
              endif
              if first_b.settings.poster != blank
                assign first_p_src = first_b.settings.poster | image_url: width: 800
              endif
              if first_b.settings.creator_handle != blank
                assign first_handle = first_b.settings.creator_handle
              endif
            endif
          %}

          {% render 'comp-video-reel',
             video_id: s_id,
             default_video: first_v_src,
             default_poster: first_p_src,
             default_handle: first_handle,
             reel_thumbs: reel_thumbs
          %}
        </div>

        <!-- Right Column: Shop Their Bag -->
        <div class="comp-see-in-play__shop-col">
          <h3 class="comp-see-in-play__shop-heading custom_heading">{{ section.settings.shop_heading | default: 'SHOP THEIR BAG' }}</h3>
          
          <div class="comp-see-in-play__products-list">
            {% if product_blocks.size > 0 %}
              {% for block in product_blocks %}
                {% render 'comp-accessory-row',
                   product: block.settings.product,
                   custom_title: block.settings.custom_title,
                   subtitle: block.settings.subtitle,
                   custom_price: block.settings.custom_price,
                   custom_compare_price: block.settings.custom_compare_price,
                   custom_image: block.settings.custom_image,
                   fallback_img: block.settings.fallback_asset_img,
                   enable_modal: block.settings.enable_modal
                %}
              {% endfor %}
            {% else %}
              {% render 'comp-accessory-row',
                 custom_title: 'Player Pro',
                 subtitle: 'Compact golf speaker',
                 custom_price: '$179',
                 custom_compare_price: '$199',
                 fallback_img: 'player-speaker-img.png'
              %}
              {% render 'comp-accessory-row',
                 custom_title: 'Icon Series MagTowel',
                 subtitle: '4-In-1 utility golf towel keeps your clubs and balls clean',
                 custom_price: '$39',
                 custom_compare_price: '$50',
                 fallback_img: 'mag-towel-img.png'
              %}
              {% render 'comp-accessory-row',
                 custom_title: 'Divot Tool',
                 subtitle: 'Six Functions In One ultimate divot tool',
                 custom_price: '$19.98',
                 custom_compare_price: '$50',
                 fallback_img: 'divot-img1.png'
              %}
            {% endif %}
          </div>
        </div>

      </div>
    </div>

    <!-- Mobile 3-Card Grid (Image 2 on mobile) -->
    <div class="comp-see-in-play__mobile-grid">
      {% liquid
        assign items_count = product_blocks.size
        if items_count == 0
          assign items_count = 3
        endif
      %}

      {% for i in (1..items_count) %}
        {% liquid
          assign idx = forloop.index0
          assign block = product_blocks[idx]
          assign v_block = video_blocks[idx]

          assign v_url = ''
          if block.settings.video.sources
            for source in block.settings.video.sources
              if source.format == 'mp4'
                assign v_url = source.url
                break
              endif
            endfor
            if v_url == blank
              assign v_url = block.settings.video.sources.first.url
            endif
          elsif block.settings.video_url != blank
            assign v_url = block.settings.video_url
          elsif v_block != blank
            if v_block.settings.video.sources
              assign v_url = v_block.settings.video.sources.first.url
            elsif v_block.settings.video_url != blank
              assign v_url = v_block.settings.video_url
            endif
          endif

          if v_url == blank
            case i
              when 1
                assign v_url = 'https://cdn.shopify.com/videos/c/o/v/0fca515419e743d4a7ed6047598c316c.mp4'
              when 2
                assign v_url = 'https://cdn.shopify.com/videos/c/o/v/74124ef049424293875aee3998fb37b3.mp4'
              when 3
                assign v_url = 'https://cdn.shopify.com/videos/c/o/v/a5c1aedc48af44f0a298a83028cd054a.mp4'
            endcase
          endif

          assign c_handle = block.settings.creator_handle
          if c_handle == blank and v_block != blank
            assign c_handle = v_block.settings.creator_handle
          endif
          if c_handle == blank
            case i
              when 1
                assign c_handle = '@ALLIE.GOLFS'
              when 2
                assign c_handle = '@COURSE.TOUR'
              when 3
                assign c_handle = '@BLUETEES'
            endcase
          endif

          assign poster_src = ''
          if block.settings.poster != blank
            assign poster_src = block.settings.poster | image_url: width: 600
          elsif block.settings.video.preview_image != blank
            assign poster_src = block.settings.video.preview_image | image_url: width: 600
          elsif v_block != blank and v_block.settings.poster != blank
            assign poster_src = v_block.settings.poster | image_url: width: 600
          elsif block.settings.custom_image != blank
            assign poster_src = block.settings.custom_image | image_url: width: 600
          elsif block.settings.fallback_asset_img != blank
            assign poster_src = block.settings.fallback_asset_img | asset_url
          else
            case i
              when 1
                assign poster_src = 'player-speaker-img.png' | asset_url
              when 2
                assign poster_src = 'mag-towel-img.png' | asset_url
              when 3
                assign poster_src = 'divot-img1.png' | asset_url
            endcase
          endif

          assign p = block.settings.product
          assign p_title = block.settings.custom_title
          if p_title == blank and p != blank
            assign p_title = p.title
          endif
          if p_title == blank
            case i
              when 1
                assign p_title = 'Player Pro'
              when 2
                assign p_title = 'Icon Series MagTowel'
              when 3
                assign p_title = 'Divot Tool'
            endcase
          endif

          assign p_sub = block.settings.subtitle
          if p_sub == blank
            case i
              when 1
                assign p_sub = 'Compact golf speaker'
              when 2
                assign p_sub = '4-In-1 utility golf towel'
              when 3
                assign p_sub = 'Six Functions In One'
            endcase
          endif

          assign p_price = block.settings.custom_price
          if p_price == blank and p != blank
            assign p_price = p.price | money_without_trailing_zeros
          endif
          if p_price == blank
            case i
              when 1
                assign p_price = '$179'
              when 2
                assign p_price = '$39'
              when 3
                assign p_price = '$19.98'
            endcase
          endif

          assign p_compare = block.settings.custom_compare_price
          if p_compare == blank and p != blank and p.compare_at_price > p.price
            assign p_compare = p.compare_at_price | money_without_trailing_zeros
          endif
          if p_compare == blank
            case i
              when 1
                assign p_compare = '$199'
              when 2
                assign p_compare = '$50'
              when 3
                assign p_compare = '$50'
            endcase
          endif

          assign p_img = ''
          if block.settings.custom_image != blank
            assign p_img = block.settings.custom_image | image_url: width: 240
          elsif p != blank and p.featured_image != blank
            assign p_img = p.featured_image | image_url: width: 240
          elsif block.settings.fallback_asset_img != blank
            assign p_img = block.settings.fallback_asset_img | asset_url
          else
            case i
              when 1
                assign p_img = 'player-speaker-img.png' | asset_url
              when 2
                assign p_img = 'mag-towel-img.png' | asset_url
              when 3
                assign p_img = 'divot-img1.png' | asset_url
            endcase
          endif

          assign v_id = ''
          if p != blank
            assign v_id = p.selected_or_first_available_variant.id
          endif
        %}

        <div
          class="comp-see-in-play__mobile-card"
          data-video-index="{{ idx }}"
          data-video-url="{{ v_url }}"
          data-creator="{{ c_handle }}"
          data-product-title="{{ p_title }}"
          data-product-sub="{{ p_sub }}"
          data-product-price="{{ p_price }}"
          data-product-compare="{{ p_compare }}"
          data-product-img="{{ p_img }}"
          data-variant-id="{{ v_id }}"
        >
          <div class="comp-see-in-play__mobile-card-media">
            {% if poster_src != blank %}
              <img src="{{ poster_src }}" alt="{{ p_title }}" class="comp-see-in-play__mobile-card-img" loading="lazy">
            {% endif %}
            <div class="comp-see-in-play__mobile-card-play" aria-label="Play video">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="6 3 20 12 6 21 6 3"></polygon>
              </svg>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

  </div>

  <!-- Full-screen Mobile Video Reel Modal (Image 3) -->
  <div class="comp-sip-modal" id="comp-sip-modal-{{ s_id }}" aria-hidden="true">
    <div class="comp-sip-modal__backdrop" data-modal-close></div>
    
    <div class="comp-sip-modal__content">
      
      <!-- Top Bar: Creator pill & Close button -->
      <div class="comp-sip-modal__top-bar">
        <div class="comp-sip-modal__creator-pill">
          <span class="comp-sip-modal__creator-avatar">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
            </svg>
          </span>
          <span class="comp-sip-modal__creator-text" data-modal-creator>@ALLIE.GOLFS</span>
        </div>

        <button type="button" class="comp-sip-modal__close-btn" data-modal-close aria-label="Close video">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Video Player -->
      <div class="comp-sip-modal__video-wrapper">
        <video
          class="comp-sip-modal__video"
          data-modal-video
          playsinline
          webkit-playsinline
          loop
          preload="auto"
        ></video>
      </div>

      <!-- Floating Tied Product Card (Bottom Drawer) -->
      <div class="comp-sip-modal__product-drawer" data-product-drawer>
        <!-- Floating Toggle Chevron on top-left of the card -->
        <button type="button" class="comp-sip-modal__drawer-toggle" data-drawer-toggle aria-label="Toggle product card">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <div class="comp-sip-modal__product-card" data-product-card>
          <div class="comp-sip-modal__product-top">
            <div class="comp-sip-modal__product-img-wrap">
              <img src="" alt="" class="comp-sip-modal__product-img" data-product-img loading="lazy">
            </div>
            
            <div class="comp-sip-modal__product-details">
              <div class="comp-sip-modal__product-title-row">
                <span class="comp-sip-modal__product-title custom_subHeading-text" data-product-title>Product Title</span>
              </div>
              <div class="comp-sip-modal__product-price-row">
                <span class="comp-sip-modal__product-price" data-product-price>$179</span>
                <span class="comp-sip-modal__product-compare" data-product-compare>$199</span>
              </div>
              <p class="comp-sip-modal__product-sub custom_body-text" data-product-sub>Compact golf speaker</p>
            </div>
          </div>

          <div class="comp-sip-modal__product-cta-wrap">
            <button type="button" class="comp-sip-modal__atc-btn js-modal-atc" data-modal-atc>
              <span class="comp-sip-modal__atc-text">ADD TO CART</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Controls Overlay: Time counter, Next Video Arrow, Mute button, Play/Pause -->
      <div class="comp-sip-modal__controls">
        <!-- Time Duration Pill -->
        <div class="comp-sip-modal__duration-pill">
          <span class="comp-sip-modal__time-current" data-modal-time-current>00:00</span>
        </div>

        <!-- Center Down Arrow to switch next video -->
        <button type="button" class="comp-sip-modal__next-btn" data-modal-next aria-label="Next video">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
        </button>

        <!-- Right: Mute & Play/Pause (Matches New Video Component style) -->
        <div class="comp-sip-modal__ctrl-actions">
          <button type="button" class="comp-sip-modal__ctrl-btn" data-modal-mute aria-label="Toggle mute">
            <svg class="icon-muted" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
