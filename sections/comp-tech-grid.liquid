{%- comment -%}
  Comp Product Blueprint / Tech Specs Section
  - 2 top large cards (50/50 split)
  - 3 bottom feature cards (33/33/33 split)
  - Bottom Footer block with 2 layout options:
      Option 1: "table" -> Comparison spec sheet matrix
      Option 2: "numbers" -> Stat counter / metric callout bars
  - Mobile optimized with smooth scrollable swipe cards & stacked table
  - Strict BTG Fonts:
      H1 / Main Heading -> custom_heading ('Blue Tees Headline Italic')
      Eyebrow / Subhead / Numbers -> custom_subHeading-text ('Blue Tees Subhead')
      Body / Descriptions -> custom_body-text ('Blue Tees Paragraph')
{%- endcomment -%}

{%- liquid
  assign section_id = section.settings.custom_section_id | default: ''
  if section_id == blank
    assign section_id = 'comp-tech-grid-' | append: section.id
  endif
-%}

<div
  id="{{ section_id }}"
  class="comp-tech-grid comp-tech-grid-{{ section.id }}"
  style="
    --ctg-pt: {{ section.settings.padding_top | default: 60 }}px;
    --ctg-pb: {{ section.settings.padding_bottom | default: 80 }}px;
    --ctg-bg: {{ section.settings.background_color | default: '#0B0D11' }};
    {% if section.settings.enable_gradient_bg %}
      --ctg-gradient: {{ section.settings.gradient_bg | default: 'radial-gradient(circle at 90% 10%, rgba(25, 45, 80, 0.45) 0%, rgba(11, 13, 17, 0) 60%), radial-gradient(circle at 10% 90%, rgba(18, 30, 50, 0.35) 0%, #0B0D11 100%)' }};
    {% endif %}
  "
>
  {%- if section.settings.enable_gradient_bg -%}
    <div class="comp-tech-grid__gradient" aria-hidden="true"></div>
  {%- endif -%}

  <div class="comp-tech-grid__container">
    <!-- Header -->
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <header class="comp-tech-grid__header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="comp-tech-grid__eyebrow custom_subHeading-text">
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="comp-tech-grid__heading custom_heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
      </header>
    {%- endif -%}

    <!-- Row 1: Top 2 Large Cards (50 / 50) -->
    {%- assign top_cards = section.blocks | where: 'type', 'top_card' -%}
    {%- if top_cards.size > 0 -%}
      <div class="comp-tech-grid__row comp-tech-grid__row--two">
        {%- for block in top_cards -%}
          <div class="comp-tech-grid__card comp-tech-grid__card--large" {{ block.shopify_attributes }}>
            <!-- Diagram Media Stage -->
            <div class="comp-tech-grid__media-stage">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    class: 'comp-tech-grid__media-img',
                    alt: block.settings.title | default: 'Diagram' | escape
                }}
              {%- else -%}
                <div class="comp-tech-grid__media-placeholder">
                  <div class="comp-tech-grid__blueprint-grid"></div>
                </div>
              {%- endif -%}
            </div>

            <!-- Content Area -->
            <div class="comp-tech-grid__content">
              {%- if block.settings.eyebrow != blank -%}
                <div class="comp-tech-grid__card-eyebrow custom_subHeading-text">
                  <span class="comp-tech-grid__card-num custom_subHeading-text">{{ forloop.index | prepend: '0' }}</span>
                  <span>{{ block.settings.eyebrow }}</span>
                </div>
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <h3 class="comp-tech-grid__card-title custom_heading">
                  {{ block.settings.title }}
                </h3>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="comp-tech-grid__card-desc custom_body-text">
                  {{ block.settings.description }}
                </p>
              {%- endif -%}

              {%- if block.settings.pill_text != blank -%}
                <div class="comp-tech-grid__pill-tag">
                  <span class="comp-tech-grid__pill-badge custom_subHeading-text">{{ block.settings.pill_prefix | default: 'YOU GET' }}</span>
                  <span class="comp-tech-grid__pill-text custom_body-text">{{ block.settings.pill_text }}</span>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- Row 2: Bottom 3 Feature Cards (33 / 33 / 33) -->
    {%- assign bottom_cards = section.blocks | where: 'type', 'feature_card' -%}
    {%- if bottom_cards.size > 0 -%}
      <div class="comp-tech-grid__row comp-tech-grid__row--three">
        {%- for block in bottom_cards -%}
          <div class="comp-tech-grid__card comp-tech-grid__card--standard" {{ block.shopify_attributes }}>
            <!-- Diagram Media Stage -->
            <div class="comp-tech-grid__media-stage comp-tech-grid__media-stage--compact">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    class: 'comp-tech-grid__media-img',
                    alt: block.settings.title | default: 'Diagram' | escape
                }}
              {%- else -%}
                <div class="comp-tech-grid__media-placeholder">
                  <div class="comp-tech-grid__blueprint-grid"></div>
                </div>
              {%- endif -%}
            </div>

            <!-- Content Area -->
            <div class="comp-tech-grid__content">
              {%- if block.settings.eyebrow != blank -%}
                <div class="comp-tech-grid__card-eyebrow custom_subHeading-text">
                  <span class="comp-tech-grid__card-num custom_subHeading-text">{{ forloop.index | plus: 2 | prepend: '0' }}</span>
                  <span>{{ block.settings.eyebrow }}</span>
                </div>
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <h3 class="comp-tech-grid__card-title custom_heading">
                  {{ block.settings.title }}
                </h3>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="comp-tech-grid__card-desc custom_body-text">
                  {{ block.settings.description }}
                </p>
              {%- endif -%}

              {%- if block.settings.pill_text != blank -%}
                <div class="comp-tech-grid__pill-tag">
                  <span class="comp-tech-grid__pill-badge custom_subHeading-text">{{ block.settings.pill_prefix | default: 'YOU GET' }}</span>
                  <span class="comp-tech-grid__pill-text custom_body-text">{{ block.settings.pill_text }}</span>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- Bottom Specs Section (Option 1: Table | Option 2: Numbers) -->
    {%- if section.settings.show_bottom_specs -%}
      <div class="comp-tech-grid__bottom-specs comp-tech-grid__bottom-specs--{{ section.settings.bottom_layout_type }}">
        
        <!-- Left: Heading / Eyebrow Info -->
        <div class="comp-tech-grid__specs-left">
          {%- if section.settings.specs_eyebrow != blank -%}
            <span class="comp-tech-grid__specs-eyebrow custom_subHeading-text">
              {{ section.settings.specs_eyebrow }}
            </span>
          {%- endif -%}
          {%- if section.settings.specs_heading != blank -%}
            <h3 class="comp-tech-grid__specs-heading custom_heading">
              {{ section.settings.specs_heading }}
            </h3>
          {%- endif -%}
        </div>

        <!-- Right: Option 1 - Comparison Table -->
        {%- if section.settings.bottom_layout_type == 'table' -%}
          <div class="comp-tech-grid__table-wrapper">
            <table class="comp-tech-grid__table">
              <thead>
                <tr>
                  <th class="custom_subHeading-text"></th>
                  <th class="custom_subHeading-text">{{ section.settings.table_col_1_header | default: 'MAT BASE' }}</th>
                  <th class="custom_subHeading-text comp-tech-grid__th-highlight">{{ section.settings.table_col_2_header | default: 'IRON STRIP' }}</th>
                  <th class="custom_subHeading-text comp-tech-grid__th-highlight">{{ section.settings.table_col_3_header | default: 'DRIVER TEE' }}</th>
                </tr>
              </thead>
              <tbody>
                {%- if section.settings.table_row_1_label != blank -%}
                  <tr>
                    <td class="comp-tech-grid__td-label custom_subHeading-text">{{ section.settings.table_row_1_label }}</td>
                    <td class="custom_body-text">{{ section.settings.table_row_1_val1 }}</td>
                    <td class="comp-tech-grid__td-highlight custom_body-text">{{ section.settings.table_row_1_val2 }}</td>
                    <td class="comp-tech-grid__td-highlight custom_body-text">{{ section.settings.table_row_1_val3 }}</td>
                  </tr>
                {%- endif -%}
                {%- if section.settings.table_row_2_label != blank -%}
                  <tr>
                    <td class="comp-tech-grid__td-label custom_subHeading-text">{{ section.settings.table_row_2_label }}</td>
                    <td class="custom_body-text">{{ section.settings.table_row_2_val1 }}</td>
                    <td class="comp-tech-grid__td-highlight custom_body-text">{{ section.settings.table_row_2_val2 }}</td>
                    <td class="comp-tech-grid__td-highlight custom_body-text">{{ section.settings.table_row_2_val3 }}</td>
                  </tr>
                {%- endif -%}
                {%- if section.settings.table_row_3_label != blank -%}
                  <tr>
                    <td class="comp-tech-grid__td-label custom_subHeading-text">{{ section.settings.table_row_3_label }}</td>
                    <td class="custom_body-text">{{ section.settings.table_row_3_val1 }}</td>
                    <td class="comp-tech-grid__td-highlight custom_body-text">{{ section.settings.table_row_3_val2 }}</td>
                    <td class="comp-tech-grid__td-highlight custom_body-text">{{ section.settings.table_row_3_val3 }}</td>
                  </tr>
                {%- endif -%}
              </tbody>
            </table>
          </div>

        {%- else -%}
          <!-- Right: Option 2 - Number / Metric Stat Bar Cards -->
          <div class="comp-tech-grid__stats-wrapper">
            {%- for i in (1..5) -%}
              {%- liquid
                assign val_key = 'stat_' | append: i | append: '_value'
                assign lbl_key = 'stat_' | append: i | append: '_label'
                assign stat_val = section.settings[val_key]
                assign stat_lbl = section.settings[lbl_key]
              -%}
              {%- if stat_val != blank -%}
                <div class="comp-tech-grid__stat-card comp-tech-grid__stat-card--{{ i }}">
                  <span class="comp-tech-grid__stat-num custom_heading">{{ stat_val }}</span>
                  <span class="comp-tech-grid__stat-label custom_subHeading-text">{{ stat_lbl }}</span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>
    {%- endif -%}

  </div>
</div>

<style>
  #{{ section_id }} {
    position: relative;
    background-color: var(--ctg-bg);
    padding-top: clamp(30px, 6vw, var(--ctg-pt, 60px));
    padding-bottom: clamp(30px, 6vw, var(--ctg-pb, 80px));
    overflow: hidden;
    color: #FFFFFF;
    box-sizing: border-box;
    isolation: isolate;
  }

  @media (max-width: 768px) {
    #{{ section_id }} {
      padding-top: 30px;
      padding-bottom: 30px;
    }
  }

  /* Radial glow from Figma: radial-gradient(50% 50% at 50% 50%, rgba(1, 74, 227, 0.28) 0%, rgba(1, 74, 227, 0) 100%) */
  #{{ section_id }} .comp-tech-grid__gradient {
    position: absolute;
    width: 1000px;
    height: 760px;
    right: -100px;
    top: -200px;
    pointer-events: none;
    z-index: 0;
    background: radial-gradient(50% 50% at 50% 50%, rgba(1, 74, 227, 0.28) 0%, rgba(1, 74, 227, 0) 100%);
    opacity: 0.95;
  }

  #{{ section_id }} .comp-tech-grid__container {
    position: relative;
    z-index: 2;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  /* @media (min-width: 900px) {
    #{{ section_id }} .comp-tech-grid__container {
      padding: 0 clamp(15px, 4.3vw, 80px);
    }
  } */

  /* Header */
  #{{ section_id }} .comp-tech-grid__header {
    margin-bottom: clamp(36px, 5vw, 72px);
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  #{{ section_id }} .comp-tech-grid__eyebrow {
    display: inline-block;
    color: #CCFF08;
    font-size: 14px;
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #{{ section_id }} .comp-tech-grid__heading {
    margin: 0;
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #FFFFFF;
  }

  /* Grid Rows */
  #{{ section_id }} .comp-tech-grid__row {
    display: grid;
    gap: 20px;
    margin-bottom: 20px;
  }

  #{{ section_id }} .comp-tech-grid__row--two {
    grid-template-columns: 1fr;
  }

  #{{ section_id }} .comp-tech-grid__row--three {
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    #{{ section_id }} .comp-tech-grid__row--two {
      grid-template-columns: repeat(2, 1fr);
    }
    #{{ section_id }} .comp-tech-grid__row--three {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Card Item */
  #{{ section_id }} .comp-tech-grid__card {
    background: #111821;
    border: 1px solid #26303D;
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  #{{ section_id }} .comp-tech-grid__card:hover {
    border-color: rgba(204, 255, 8, 0.4);
    transform: translateY(-2px);
  }

  /* Media Stage / Blueprint */
  #{{ section_id }} .comp-tech-grid__media-stage {
    position: relative;
    width: 100%;
    /* height: clamp(200px, 20vw, 330px); */
    background: #0D131B;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* #{{ section_id }} .comp-tech-grid__media-stage--compact {
    height: clamp(160px, 15vw, 250px);
  } */

  #{{ section_id }} .comp-tech-grid__media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #{{ section_id }} .comp-tech-grid__media-placeholder {
    position: relative;
    width: 100%;
    height: 100%;
    background: #0D131B;
  }

  #{{ section_id }} .comp-tech-grid__blueprint-grid {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(22, 32, 43, 0.6) 1px, transparent 1px),
      linear-gradient(90deg, rgba(22, 32, 43, 0.6) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  /* Card Content */
  #{{ section_id }} .comp-tech-grid__content {
    padding: clamp(20px, 2.2vw, 32px);
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  /* #{{ section_id }} .comp-tech-grid__card--standard .comp-tech-grid__content {
    padding: 24px;
  } */

  #{{ section_id }} .comp-tech-grid__card-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #99A3B0;
  }

  #{{ section_id }} .comp-tech-grid__card-num {
    font-size: 13px;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: #CCFF08;
    flex: 0 0 auto;
  }

  #{{ section_id }} .comp-tech-grid__card-title {
    margin: 0;
    font-size: clamp(18px, 1.8vw, 30px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #FFFFFF;
  }

  #{{ section_id }} .comp-tech-grid__card--standard .comp-tech-grid__card-title {
    font-size: clamp(20px, 1.6vw, 24px);
  }

  #{{ section_id }} .comp-tech-grid__card-desc {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    letter-spacing: 0.02em;
    color: #A8B3BF;
    flex: 1;
  }

  /* Pill Tag (YOU GET) */
  #{{ section_id }} .comp-tech-grid__pill-tag {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 8px;
    padding: 8px 14px 8px 12px;
    background: rgba(204, 255, 8, 0.08);
    border: 1px solid rgba(204, 255, 8, 0.35);
    border-radius: 999px;
    margin-top: 4px;
  }

  #{{ section_id }} .comp-tech-grid__pill-badge {
    color: #CCFF08;
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  #{{ section_id }} .comp-tech-grid__pill-text {
    color: #FFFFFF;
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.02em;
    white-space: normal;
  }

  /* Bottom Specs Section */
  #{{ section_id }} .comp-tech-grid__bottom-specs {
    margin-top: clamp(40px, 5vw, 72px);
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 900px) {
    #{{ section_id }} .comp-tech-grid__bottom-specs {
      grid-template-columns: minmax(280px, 500px) 1fr;
      gap: clamp(40px, 5vw, 80px);
    }
  }

  #{{ section_id }} .comp-tech-grid__specs-left {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  #{{ section_id }} .comp-tech-grid__specs-eyebrow {
    display: block;
    color: #CCFF08;
    font-size: 14px;
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #{{ section_id }} .comp-tech-grid__specs-heading {
    margin: 0;
    font-size: clamp(24px, 2.4vw, 32px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #FFFFFF;
  }

  /* Option 1: Table Styling (Figma Pixel Perfect) */
  #{{ section_id }} .comp-tech-grid__table-wrapper {
    box-sizing: border-box;
    width: 100%;
    max-width: 820px;
    background: #111821;
    border: 1px solid #26303D;
    border-radius: 16px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  #{{ section_id }} .comp-tech-grid__table {
    width: 100%;
    border-collapse: collapse;
    border-spacing: 0;
    min-width: 680px;
    text-align: left;
    box-sizing: border-box;
    background: inherit;
  }

  #{{ section_id }} .comp-tech-grid__table thead tr {
    height: 54px;
  }

  #{{ section_id }} .comp-tech-grid__table th {
    box-sizing: border-box;
    padding: 18px 20px;
    border: none;
    font-size: 12px;
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #FFFFFF;
    vertical-align: middle;
    background: inherit;
  }

  #{{ section_id }} .comp-tech-grid__table th:first-child {
    width: 140px;
  }

  #{{ section_id }} .comp-tech-grid__table th:not(:first-child) {
    width: 226px;
  }

  #{{ section_id }} .comp-tech-grid__table th.comp-tech-grid__th-highlight {
    background: rgba(204, 255, 8, 0.06);
    color: #CCFF08 !important;
  }

  #{{ section_id }} .comp-tech-grid__table tbody tr {
    box-sizing: border-box;
    border-top: 1px solid #26303D;
  }

  #{{ section_id }} .comp-tech-grid__table td {
    box-sizing: border-box;
    padding: 18px 20px;
    border: none;
    font-size: 15px;
    line-height: 1.45;
    letter-spacing: 0.02em;
    color: #A8B3BF;
    vertical-align: middle;
    background: inherit;
  }

  #{{ section_id }} .comp-tech-grid__table td:first-child {
    width: 140px;
  }

  #{{ section_id }} .comp-tech-grid__table td:not(:first-child) {
    width: 226px;
  }

  #{{ section_id }} .comp-tech-grid__td-label {
    color: #FFFFFF !important;
    font-size: 15px;
    line-height: 1.4;
    letter-spacing: 0.02em;
    width: 140px;
  }

  #{{ section_id }} .comp-tech-grid__table td.comp-tech-grid__td-highlight {
    background: rgba(204, 255, 8, 0.06);
  }

  /* Option 2: Numbers Stat Bar (Figma Pixel Perfect) */
  #{{ section_id }} .comp-tech-grid__stats-wrapper {
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: stretch;
    padding: 0px;
    width: 100%;
    max-width: 820px;
    background: #111821;
    border: 1px solid #26303D;
    border-radius: 16px;
    overflow: hidden;
    flex-wrap: nowrap;
  }

  #{{ section_id }} .comp-tech-grid__stat-card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(14px, 2.2vw, 32px) clamp(4px, 1.2vw, 20px);
    gap: clamp(4px, 0.5vw, 6px);
    flex: 1 1 0;
    min-width: 0;
    height: auto;
    min-height: clamp(86px, 10vw, 134px);
    text-align: center;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  /* Left divider between stats */
  #{{ section_id }} .comp-tech-grid__stat-card:not(:first-child) {
    border-left: 1px solid #26303D;
  }

  /* Highlight first 3 cards with lime tint background */
  #{{ section_id }} .comp-tech-grid__stat-card--1,
  #{{ section_id }} .comp-tech-grid__stat-card--2,
  #{{ section_id }} .comp-tech-grid__stat-card--3 {
    background: rgba(204, 255, 8, 0.06);
  }

  #{{ section_id }} .comp-tech-grid__stat-num {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: clamp(18px, 2.4vw, 44px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    font-stretch: 151%;
    white-space: nowrap;
  }

  /* Lime color for first 3 cards */
  #{{ section_id }} .comp-tech-grid__stat-card--1 .comp-tech-grid__stat-num,
  #{{ section_id }} .comp-tech-grid__stat-card--2 .comp-tech-grid__stat-num,
  #{{ section_id }} .comp-tech-grid__stat-card--3 .comp-tech-grid__stat-num {
    color: #CCFF08;
  }

  /* White color for 4th and 5th cards */
  #{{ section_id }} .comp-tech-grid__stat-card--4 .comp-tech-grid__stat-num,
  #{{ section_id }} .comp-tech-grid__stat-card--5 .comp-tech-grid__stat-num {
    color: #FFFFFF;
  }

  #{{ section_id }} .comp-tech-grid__stat-label {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: clamp(8px, 0.85vw, 12px);
    line-height: 1.25;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #99A3B0;
    align-self: stretch;
    word-break: normal;
    overflow-wrap: normal;
  }
</style>

