{% else %}
  {% if template.name == 'product' %}
    <div class="product-atc_main">
      <div class="new-page-width">
        <div class="product-atc_inner">
          <div class="product-atc_left">
            <div class="product-atc-img-container">
              <img
                class="product-atc_product-img"
                src="{{ product.featured_image | img_url: 'large' }}"
                alt="{{ product.title }}"
                decoding="async"
              >
            </div>
            <div class="product-atc-product-details">
              {% if product.title == 'Player+ GPS Speaker'
                or product.title == 'Series 3 Max+'
                or product.title == 'Series 2 Pro+'
                or product.title == 'RINGER GPS HANDHELD'
                or product.title == 'Ringer Pack Go Bundle'
              %}
                <div class="product-atc_offer" style="margin-bottom:5px;">
                  <div class="product-atc-offer_rate">
                    {% render 'offer-bug' %}
                  </div>
                </div>
              {% endif %}
              <h2>{{ product.title | upcase }}</h2>
              <div class="product-atc-product-rte">
                {% if product.compare_at_price > product.price %}
                  <div class="product-atc_discount-rate">
                    <p>{{ product.compare_at_price | money }}</p>
                  </div>
                {% endif %}
                <div class="product-atc_rate">
                  <p class="custom_subHeading-text">{{ product.price | money }}</p>
                </div>
              </div>
              {% comment %}
                {% if product.title == "Player+ GPS Speaker" %}
                    <p>90 Day Returns</p>
                {% endif %}
              {% endcomment %}
              {% comment %} <p>60 Day Returns</p> {% endcomment %}

              {% comment %}
                ::DO NOT DELTE::

                 Dynamic Membership Name Will Be Visible Here In This Below 'p' tag. Thanks
              {% endcomment %}
              {% if product.template_suffix == 'rainmaker' %}
                <p class="membership__showd">AI ANALYTICS PACKAGE | 1YR FREE (Included)</p>
              {% else %}
                <p class="membership__show skeleton-loader"></p>
              {% endif %}
            </div>
          </div>
          <div class="product-atc_right">
            {% if product.handle == 'rangefinder-series-2-pro' %}
              <div class="product-atc_cta">
                <a
                  href="https://www.amazon.com/Blue-Tees-Golf-Rangefinder-Magnification/dp/B0BDT2XVRC/ref=sr_1_6?crid=3V9O9QKP8V7VD&dib=eyJ2IjoiMSJ9.QOr5SVXB73OwlJZqMb6_P5AGa6HkoAxnqh80tK7j0BWoinVE_Xsw35rcTI-nqBrKbVuZJVFQ2a5zerBWqZk8zI1ZqOWXjR2vKXHFeni5Qi06b_6TF5lOIe8eFoiyF9OpLZy_vzpKnDAbJjpdz_znKZ_5ciHn3qbSwgN71W4KV7ecywrT8EFDKrKbqoUKn3uOwDPxERR2cl52avM93GiEEgy4qd59b4RJ9krEA-OkuaZfPoH7B9S2eSsICLHssgSOZJItmvKZQKdu_mDV-tU0-LbRAWZUMajWzqxlzuy_5Vw.W_6CckeduV3D_bygg714CWBOeOWvR7yOuMJIMfwmGts&dib_tag=se&keywords=Series%2B2%2BBlue%2BTees%2BGolf&qid=1765299810&sprefix=series%2B2%2Bblue%2Btees%2Bgolf%2Caps%2C236&sr=8-6&th=1"
                  class="btn"
                  target="_blank"
                >
                  SHOP NOW
                </a>
              </div>
            {% else %}
              <div class="product-atc_cta">
                <button
                  id="bottom-add-to-cart-stikey"

                  data-prod="pre-order"
                  aria-label="Add {{ product.title }} to cart"

                  {% unless product.selected_or_first_available_variant.available %}
                    disabled
                  {% endunless %}
                  class="btn{% if enable_preorder %} button_preorder btn_pre-order{% endif %} {% unless product.selected_or_first_available_variant.available %} sticky_sold-out--button button_sold-out{%endunless %}"
                  {% comment %} data-id="{{ product.variants.first.id }}" {% endcomment %}
                  data-id="{{ product.selected_or_first_available_variant.id }}"
                  {% if product.handle contains 'rangefinder-magnetic-strap'
                    or product.handle contains 'series-2-rangefinder-hard-case'
                    or product.template_suffix == 'new-s3-max'
                  %}
                    disabled="disabled"
                  {% endif %}
                >
                  {% if product.handle contains 'rangefinder-magnetic-strap'
                    or product.handle contains 'series-2-rangefinder-hard-case'
                    or product.template_suffix == 'new-s3-max'
                  %}
                    SOLD OUT
