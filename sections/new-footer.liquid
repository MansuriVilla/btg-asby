{%- liquid
  assign show_selectors = false
  assign currency_selector = false
  assign locale_selector = false

  if section.settings.show_currency_selector and shop.enabled_currencies.size > 1
    assign currency_selector = true
  endif

  if section.settings.show_locale_selector and shop.enabled_locales.size > 1
    assign locale_selector = true
  endif

  if currency_selector or locale_selector
    assign show_selectors = true
  endif
-%}
{% assign enable_preorder = false %}

{% case product.template_suffix %}
    {% comment %} {% when 'captain-pro', 'rainmaker', 'product-new', 'player-pro' %} {% endcomment %}
  {% when 'rainmaker' %}
    {% assign enable_preorder = true %}
{% endcase %}

{% if product.handle == 'speaker-bundle'
  or product.handle == 'gps-offer'
  or product.handle == 'laser-offer'
  or product.handle == 'player-gps-speaker-bundle-v2'
  or product.handle == 'ringer-gps-handheld-bundle-v2'
  or product.handle == 'series-4-ultra-bundle-v2'
%}
  <div class="ringer-funnel__footer">
    <div class="site_footer-page">
      <div class="site_footer-page-inner">
        <picture>
          <source
            srcset="{{ 'btg-full-footer-logo-funnel.png' | asset_url }}"
            media="(min-width:861px)"
          >
          <source
            srcset="{{ 'btg-full-footer-logo-funnel.png' | asset_url }}"
            media="(max-width:860px)"
          >
          <img
            class="sectionBanner__image"
            decoding="async"
            src="{{ 'btg-full-footer-logo-funnel.png' | asset_url }}"
            alt=""
          >
        </picture>
        <div class="site_footer-nav">
          <p>©2026 Blue Tees Golf. All Rights Reserved</p>
          <span>|</span>
          <a
            href="/pages/privacy-policy"
            class="anchor_hover"
            style="--hover-clr: #A1A3A9"
          >
            Privacy Policy
          </a>
          <span>|</span>
          <a href="#" class="anchor_hover" style="--hover-clr: #A1A3A9">Terms & Conditions</a>
        </div>
      </div>
    </div>
  </div>

  <style>
    .site_footer-page .site_footer-page-inner { background: #171717; color: #A1A3A9; padding: 50px 0; row-gap: clamp(20px, 4vw, 30px); display: flex; justify-content: center; align-items: center; row-gap: 50px; flex-direction: column; }
    .site_footer-page-inner img { max-width: 100%; }
    .site_footer-nav > * { display: flex; padding: 0; }
    .site_footer-nav > a { color: #A1A3A9; }
    .site_footer-nav { display: flex; align-items: center; justify-content: center; gap: 10px; }

        @media only screen and (max-width:860px){
      .site_footer-nav{flex-wrap:wrap;}
      .site_footer-nav p + span { display: none; }
        }
  </style>

  {% if product.handle == 'speaker-bundle' %}
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const ctaButtons = document.querySelectorAll(
          '.gird_cta.above__fold-cart-cta, .add-to-cart.above__fold-cart-cta'
        );
        if (!ctaButtons.length) return;

        const colorSwatches = document.querySelectorAll('.variant-input-wrap input[data-color-name]');

        // 🟩 Main color-based product
        const colorDataMap = {
          Black: '42266534019269',
          Navy: '42266534052037',
        };

        // 🟦 Second color-based product
        /*const secondProductMap = {
            'Black': '42924529811653',
            'Navy': '42924529844421',
          };*/

        // 🟥 Fixed product 1
        const fixedProduct1 = { id: '44829656154309', quantity: 1 };

        // 🟨 Fixed product 2 with selling plan
        const fixedProduct2 = {
          id: '42279859028165',
          quantity: 1,
          selling_plan: '2791211205',
        };

        let currentColor = null;

        function updateAllCTAs(colorName) {
          const newId = colorDataMap[colorName] || 'default';
          ctaButtons.forEach((btn) => btn.setAttribute('data-id', newId));
          currentColor = colorName;
        }

        // Set initial color on load
        const checkedSwatch = document.querySelector('.variant-input-wrap input[data-color-name]:checked');
        if (checkedSwatch) {
          const selectedColor = checkedSwatch.getAttribute('data-color-name');
          updateAllCTAs(selectedColor);
        }

        // Update on color change
        colorSwatches.forEach((swatch) => {
          swatch.addEventListener('change', function () {
            const colorName = swatch.getAttribute('data-color-name');
            updateAllCTAs(colorName);
          });
        });

        // Handle add to cart + redirect
        ctaButtons.forEach((button) => {
          button.addEventListener('click', function (event) {
            event.preventDefault();
            button.classList.add('btn--loading');

            const mainVariantId = button.getAttribute('data-id');
            //const secondVariantId = secondProductMap[currentColor] || null;

            const itemsToAdd = [{ id: mainVariantId, quantity: 1 }];

            /*if (secondVariantId) {
                itemsToAdd.push({ id: secondVariantId, quantity: 1 });
              }*/

            itemsToAdd.push(fixedProduct1);
            itemsToAdd.push(fixedProduct2);

            fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items: itemsToAdd }),
            })
              .then((response) => {
                if (!response.ok) throw new Error('Network response was not ok');
                return response.json();
              })
              .then(() => {
                // ✅ Redirect to checkout after success
                window.location.href = '/checkout';
              })
              .catch((error) => {
                button.classList.remove('btn--loading');
                console.error('Error adding product to cart:', error);
                alert('There was an issue adding the product to the cart.');
              });
          });
        });
      });
    </script>
