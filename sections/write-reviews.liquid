<section class="write-reviews__{{ page.handle }}">
  <div class="write-reviews__inner">
    <div class="reviews__content">
      <h2 class="reviews__heading">SHARE YOUR EXPERIENCE</h2>
      <p>Loved your Blue Tees Golf gear? We’d love to hear from you. Select your product to leave a review.</p>
      <div id="loox-product-select" class="lx-dropdown">
        <div class="dropdown-toggle reviews__cta cta "> 
          <span>LEAVE A REVIEW</span> <span> <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
 <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/> 
 </svg> </span></div>
        <div class="dropdown-menu">
          <div class="menu-item" data-value="7459406151877">Player+ Speaker</div>
          <div class="menu-item" data-value="7649196572869">Player GO</div>
          <div class="menu-item" data-value="7492065296581">Ringer GPS</div>
          <div class="menu-item" data-value="8238378549445">PlayMaker+</div>
          <div class="menu-item" data-value="8041899983045">Series 4 Ultra</div>
          <div class="menu-item" data-value="7833071714501">Series 3 Max+</div>
        </div>
      </div>
    </div>
  </div>
</section>



<style>
  
  
  /*-------------------------
  Reviews To Join Styles
  ----------------*/
  .write-reviews__inner :is(h2, .font-heading) { --font-heading: clamp(24px, 4.8vw, 52px); font-size: var(--font-heading); line-height: var(--font-heading); text-transform: none; }
  .write-reviews__inner :is(h5, .font-subtitle) { --font-subtitle: clamp(16px, 2vw, 20px); font-size: var(--font-subtitle); line-height: calc(var(--font-subtitle) + clamp(4px, 0.5vw, 8px)); text-transform: none; }

  .write-reviews__inner { padding: clamp(34px,4vw,80px) 25px clamp(25px, 4vw, 80px) ; color: #000; text-align: center; }
  .reviews__content { display: flex; flex-direction: column; gap: 20px; justify-content: center; align-items: center; }
  .reviews__cta { padding: clamp(10px,1vw,15px) clamp(20px,2vw,50px); background: #004DF5; display: inline-flex; max-width: fit-content; width: 100%; border-radius: 50px; font-size: clamp(12px,1vw,14px); font-weight: 900; color: #fff; border: 2px solid transparent; position: relative; cursor: pointer; align-items: center; justify-content: center;  gap: clamp(5px,0.8vw,10px);}
  .reviews__cta svg { max-width: 25px; display: flex; transition: transform 0.2s ease; }
.reviews__cta.dropdown-toggle__active svg { transform: scaleY(-1); }
  .reviews__content .reviews__heading { font-weight: 900;  max-width: clamp(290px, 58vw, 800px); }
  .reviews__content p { padding: 0; max-width: 545px; font-size: clamp(16px,2.2vw,20px); line-height: clamp(20px,2vw,28px); }
  .fs__stroke{text-shadow: -1px -1px 0 #fff, 1px -1px 0 #fff, -1px 1px 0 #fff, 1px 1px 0 #fff; color: #000;}

  #loox-product-select { position: relative; }
  .dropdown-menu { position: absolute; top: 120%; left: 0; width: 100%; background-color: #fff; border: 1px solid #ccc; border-radius: 14px; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1); z-index: 10; text-align: left; overflow: hidden; }
  .menu-item { padding: 10px; font-size: 16px; cursor: pointer; transition: background-color 0.2s ease; color:#000; font-weight: 500;
  text-transform: uppercase;}
  .menu-item:hover { background-color: #f0f0f0; }
  .menu-item.default { color: #666; }


  @media only screen and (max-width:860px){

      .reviews__content p{max-width: clamp(230px,40vw,355px);
    font-size: clamp(14px, 1.9vw, 16px);
    line-height: clamp(24px,2vw,28px);}
  }
</style>


<script>
  document.addEventListener('DOMContentLoaded', function() {
    const menuUp = "polygon(0% 0%, 100% 0%, 100% 0%, 0% 0%)";
    const menuDown = "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)";
    let menuOpen = false;

    const dropdown = document.querySelector("#loox-product-select");
    const toggle = dropdown.querySelector(".dropdown-toggle");
    const menu = dropdown.querySelector(".dropdown-menu");
    const menuItems = dropdown.querySelectorAll(".menu-item");

    // GSAP timeline for animating menu and items
    const tl = gsap.timeline({
      paused: true,
      defaults: { duration: 0.4, ease: "power2.inOut" }
    });

    tl.to(menu, {
      clipPath: menuDown,
      autoAlpha: 1
    })
    .fromTo(menuItems, {
      opacity: 0,
      y: "0.5em"
    }, {
      opacity: 1,
      y: "0em",
      stagger: 0.04
    }, "-=0.0");

    // Initialize menu state
    gsap.set(menu, { clipPath: menuUp, autoAlpha: 0 });
    gsap.set(menuItems, { opacity: 0, y: "0.5em" });

    // Toggle dropdown
    toggle.addEventListener("click", () => {
      if (!menuOpen) {
        tl.play();
        toggle.classList.add("dropdown-toggle__active")
        menuOpen = true;
      } else {
        tl.reverse();
        toggle.classList.remove("dropdown-toggle__active")
        menuOpen = false;
      }
    });

    // Handle item selection
    menuItems.forEach(item => {
      item.addEventListener("click", () => {
        const productId = item.getAttribute("data-value");
        toggle.textContent = item.textContent;
        if (productId) {
          looxWrite(productId);
          toggle.textContent = "LEAVE A REVIEW"; // Reset to default
        }
        tl.reverse();
        menuOpen = false;
      });
    });
    // Close dropdown on outside click
    document.addEventListener("click", (e) => {
      if (menuOpen && !e.target.closest("#loox-product-select")) {
        tl.reverse();
        menuOpen = false;
      }
    });
  });
</script>


{% schema %}
{
  "presets": [
    {
      "name": "Share Your Experience"
    }
  ]
}
{% endschema %}
