
<div class="tab_slides--section">
  <ul class="tab_nav">
    {% for block in section.blocks %}
      {% if block.type == 'tab' %}
        <li>
          <a href="#" class="tab_item" data-target="{{ block.settings.tab_title | downcase | handleize }}">
            <span class="none">{{ block.settings.tab_title }}</span> <span class="border"></span>
          </a>
        </li>
      {% endif %}
    {% endfor %}
  </ul>

  <div class="tab_slides--inner">
    {% for block in section.blocks %}
      {% if block.type == 'tab' %}
        <div id="{{ block.settings.tab_title | downcase | handleize }}" class="tab_slides-container">
          <div class="tab_slide">
            <div class="tab_slide-inner">
              {{ block.settings.tab_content }}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}

    <div id="specs" class="tab_slides-container">
      <div class="tab_slide">
        <div class="tab_slide-inner">
          <h3>Product Specs</h3>
          {% for block in section.blocks %}
            {% if block.type == 'accordion' %}
              <div class="tab_slide-accordion">
                <div class="tab_accordion-top">
                  <button class="accordion_item">
                    <span class="accoridon_title">{{ block.settings.accordion_title }}</span>
                    <span class="accoridon_icon">
                      <!-- Plus Icon SVG -->
                    </span>
                  </button>
                </div>
                <div class="tab_accordion-bottom">
                  <div class="accordion_content">
                    {{ block.settings.accordion_content }}
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<div class="sub_tab-nav">
  <ul>
    {% for block in section.blocks %}
      {% if block.type == 'subtab' %}
        <li>
          <a href="#" class="sub_tab_item" data-target="{{ block.settings.subtab_id }}">
            <span class="none">
              {% if block.settings.subtab_icon %}
                <img src="{{ block.settings.subtab_icon | img_url: '80x' }}" alt="{{ block.settings.subtab_title }}">
              {% endif %}
            </span>
            <span class="none">{{ block.settings.subtab_title }}</span>
          </a>
          <span class="border"></span>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</div>

{% for block in section.blocks %}
  {% if block.type == 'subtab' %}
    <div id="{{ block.settings.subtab_id }}" class="sub-tab">
      <div class="tab_slide">
        <div class="tab_slide-inner">
          <div class="tab_slide-content">
            <h3>{{ block.settings.subtab_title }}</h3>
            <p>{{ block.settings.subtab_text }}</p>
          </div>
          <div class="tab_slide-bottom full_screen-bg">
            <picture>
              {% if block.settings.subtab_image_desktop %}
                <source srcset="{{ block.settings.subtab_image_desktop | img_url: 'master' }}" media="(min-width:821px)" />
              {% endif %}
              {% if block.settings.subtab_image_mobile %}
                <source srcset="{{ block.settings.subtab_image_mobile | img_url: 'master' }}" media="(max-width:820px)" />
              {% endif %}
              <img src="{{ block.settings.subtab_image_desktop | img_url: 'master' }}" alt="{{ block.settings.subtab_title }}">
            </picture>
          </div>
        </div>
      </div>
    </div>
  {% endif %}
{% endfor %}



{% schema %}
{
  "name": "Product Tabs",
  "settings": [],
  "blocks": [
    {
      "type": "tab",
      "name": "Main Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab Title",
          "default": "FEATURES"
        },
        {
          "type": "richtext",
          "id": "tab_content",
          "label": "Tab Content"
        }
      ]
    },
    {
      "type": "subtab",
      "name": "Sub Tab",
      "settings": [
        {
          "type": "text",
          "id": "subtab_id",
          "label": "Sub Tab ID",
          "default": "durable"
        },
        {
          "type": "image_picker",
          "id": "subtab_icon",
          "label": "Sub Tab Icon"
        },
        {
          "type": "text",
          "id": "subtab_title",
          "label": "Sub Tab Title",
          "default": "Durable Ballistic Nylon"
        },
        {
          "type": "textarea",
          "id": "subtab_text",
          "label": "Sub Tab Description"
        },
        {
          "type": "image_picker",
          "id": "subtab_image_desktop",
          "label": "Sub Tab Image (Desktop)"
        },
        {
          "type": "image_picker",
          "id": "subtab_image_mobile",
          "label": "Sub Tab Image (Mobile)"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion Spec",
      "settings": [
        {
          "type": "text",
          "id": "accordion_title",
          "label": "Accordion Title",
          "default": "GENERAL"
        },
        {
          "type": "textarea",
          "id": "accordion_content",
          "label": "Accordion Content (HTML allowed)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Tabs Section",
      "category": "Product",
      "blocks": []
    }
  ]
}
{% endschema %}

