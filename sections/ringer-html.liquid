<script>
  {% comment %} function splittingEffect() {
    const targets = document.querySelectorAll('.has_splitting--effect');
  
    if (!targets.length) {
      console.warn('No elements found with class .has_splitting--effect');
      return;
    }
  
    targets.forEach((target, index) => {
      try {
        const originalText = target.textContent.trim();
  
        
        const words = originalText
          .split(/\s+/) 
          .filter(word => word.length > 0);
  
        target.innerHTML = ''; 
  
        const wrapper = document.createElement('div');
        wrapper.className = 'splitting-words-wrapper';
  
        
        words.forEach(word => {
          const wordWrapper = document.createElement('span');
          wordWrapper.className = 'has-splitting-word';
          wordWrapper.textContent = word + ' '; 
          wrapper.appendChild(wordWrapper);
        });
  
        target.appendChild(wrapper);
  
        
        gsap.set(target.querySelectorAll('.has-splitting-word'), {
          opacity: 0,
          y: 50
        });
  
        
        gsap.to(target.querySelectorAll('.has-splitting-word'), {
          opacity: 1,
          y: 0,
          duration: .9,
          stagger: 0.06,
          ease: "linear",
          scrollTrigger: {
            trigger: target,
            start: 'top bottom', 
            toggleActions: 'play none none reverse', 
          }
        });
      } catch (error) {
        console.error(`Error processing splitting effect for element ${index}:`, error);
      }
    });
  }
  splittingEffect(); {% endcomment %}
document.addEventListener("DOMContentLoaded", function () {
function scalingImageEffect() {
  const images = document.querySelectorAll('.scaling_image-img');

  if (!images.length) {
    console.warn('No elements found with class .scaling_image-img');
    return;
  }

  // Check if screen width is 768px or larger
  if (window.matchMedia("(min-width: 768px)").matches) {
    images.forEach((image) => {
      gsap.fromTo(
        image,
        { scale: 1.5 },
        {
          scale: 1,
          duration: 1,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: image,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true,
          }
        }
      );
    });
  }
}
scalingImageEffect();

  function ringerVideoControl() {
    const video = document.getElementById("ringer_video_pdp");
    const playPauseBtn = document.getElementById("ringer-play-pause-btn");
    if (!video) return;

    video.pause();

    const handlePlay = () => {
      video.play();
      if (playPauseBtn) {
        playPauseBtn.style.opacity = "0";
        playPauseBtn.style.pointerEvents = "none";
        playPauseBtn.setAttribute("tabindex", "-1");
      }
    };

    const handlePause = () => {
      video.pause();
      if (playPauseBtn) {
        playPauseBtn.style.opacity = "1";
        playPauseBtn.style.pointerEvents = "auto";
        playPauseBtn.setAttribute("tabindex", "0");
      }
    };

    if (playPauseBtn) {
      playPauseBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        if (video.paused) {
          handlePlay();
        } else {
          handlePause();
        }
      });
    }

    video.addEventListener("click", () => {
      if (!video.paused) {
        handlePause();
      }
    });
  }
  ringerVideoControl();

  function ringerGifControl() {
    const gifImg = document.getElementById("ringer-gif-img");
    const canvas = document.getElementById("ringer-gif-canvas");
    const playPauseBtn = document.getElementById("ringer-gif-play-pause-btn");
    const wrapper = document.getElementById("ringer-gif-wrapper");
    if (!gifImg || !canvas || !playPauseBtn) return;

    let isPlaying = false;
    const originalSrc = gifImg.src;

    function freezeGif() {
      try {
        canvas.width = gifImg.naturalWidth || gifImg.clientWidth;
        canvas.height = gifImg.naturalHeight || gifImg.clientHeight;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(gifImg, 0, 0, canvas.width, canvas.height);
        canvas.style.display = 'block';
        gifImg.style.visibility = 'hidden';
      } catch (e) {
        canvas.style.display = 'none';
        gifImg.style.visibility = 'visible';
      }
      isPlaying = false;
      playPauseBtn.style.opacity = '1';
      playPauseBtn.style.pointerEvents = 'auto';
      playPauseBtn.setAttribute('tabindex', '0');
    }

    function playGif() {
      canvas.style.display = 'none';
      gifImg.style.visibility = 'visible';
      // Restart GIF cycle
      const url = new URL(originalSrc, window.location.href);
      url.searchParams.set('t', Date.now());
      gifImg.src = url.toString();

      isPlaying = true;
      playPauseBtn.style.opacity = '0';
      playPauseBtn.style.pointerEvents = 'none';
      playPauseBtn.setAttribute('tabindex', '-1');
    }

    function handleToggle() {
      if (isPlaying) {
        freezeGif();
      } else {
        playGif();
      }
    }

    if (gifImg.complete) {
      freezeGif();
    } else {
      gifImg.addEventListener('load', function onFirstLoad() {
        freezeGif();
        gifImg.removeEventListener('load', onFirstLoad);
      });
    }

    playPauseBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      handleToggle();
    });

    if (wrapper) {
      wrapper.addEventListener('click', function() {
        if (isPlaying) {
          freezeGif();
        }
      });
    }
  }
  ringerGifControl();
});
</script>
<script>
  // Function to change image source for mobile view
function changeImageSrcForMobile() {
    const image = document.querySelector('.max3-product-page .series-3-max-golf-rangefinder-with-slope .single-img img');

    // Check if the image exists
    if (image) {
        // Set the new source for mobile view
        const mobileSrc = 'https://cdn.shopify.com/s/files/1/0057/8958/1381/files/Frame_1000011970_dfff30ea-ba36-4c78-9460-67ea31dc2b4c.png?v=1748598794'; // Replace with your mobile image path

        // Change image source if in mobile view
        if (window.innerWidth <= 768) { // Adjust the width as needed for your breakpoint
            image.src = mobileSrc;
        } else {
            // Optionally, reset the image source for larger screens
            const desktopSrc = 'https://cdn.shopify.com/s/files/1/0057/8958/1381/files/Frame_1000011967.png?v=1748589267'; // Replace with your desktop image path
            image.src = desktopSrc;
        }
    }
}

// Run the function on page load
changeImageSrcForMobile();

// Also, run the function on window resize to handle dynamic changes
window.addEventListener('resize', changeImageSrcForMobile);

</script>