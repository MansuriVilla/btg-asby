<div id="container" class="site_ticker-logo" data-animated>
  <div class="ticker-heading">
    <h2 class="ticker-heading__text">{{section.settings.tickerHeading}}</h2>
  </div>
  <ul id="list">
    {% for block in section.blocks %}
      <li class="logo_item logo_item--{{ block.id }}">
        <img
          class="logo_image"
          src="{{block.settings.logo | image_url}}"
          alt="{{block.settings.logo.alt}}"
          height="100%"
          width="100%"
          loading="lazy"
          decoding="async"
        >
      </li>
    {% endfor %}
  </ul>
 <div class="ticker_action--button">
   <button
      type="button"
      id="carousel-control-btn"
      class="carousel-control-btn"
      aria-label="Pause logo carousel"
      aria-pressed="false"
    >
      <svg class="pause-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="2" y="1" width="3" height="12" fill="currentColor"/>
        <rect x="9" y="1" width="3" height="12" fill="currentColor"/>
      </svg>
      <svg class="play-icon" style="display:none;" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M3 1.5L12 7L3 12.5V1.5Z" fill="currentColor"/>
      </svg>
    </button>
 </div>
</div>

<style>
  .site_ticker-logo{display:flex; flex-direction: column; width:100%;}
  .ticker_action--button{display:flex; justify-content: flex-end; padding:20px;}
.ticker-heading__text {
  padding: 0;
  font-size: clamp(16px,2vw,18px);
  line-height: 1;
  letter-spacing: clamp(2px,0.6vw, 4px);
  font-weight: 600;
  color: #9B9DA3;
      font-family: 'Blue Tees Paragraph';
}


  .ticker-heading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding-bottom: clamp(25px,2.4vw,35px);
  gap: 12px;
}

.carousel-control-btn {
  background: transparent;
  border: 1px solid #9B9DA3;
  border-radius: 50%;
  width: 28px;
  height: 28px;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #9B9DA3;
  cursor: pointer;
  padding: 0;
  transition: all 0.2s ease;
}

.carousel-control-btn:hover {
  color: #fff;
  background: #9B9DA3;
}

.carousel-control-btn:focus-visible {
  outline: 2px solid var(--new-blue);
  outline-offset: 2px;
}

#container[data-animated].paused #list {
  animation-play-state: paused;
}

    [data-animated] li img { max-width: clamp(128px,26vw,198px); width: 100%; aspect-ratio: 8/3; object-fit: contain; object-position: center center; }
    [data-animated] ul { display: flex; gap: clamp(40px,6vw,60px); list-style: none; align-items: center; margin: 0; padding-block: clamp(15px,3vw,25px); }
  .logo_item {
      opacity: 50%;
      margin: 0;
  }
    #container[data-animated] { overflow: hidden; }
    [data-animated] #list { width: max-content; animation: scroll 80s linear infinite; }
    @keyframes scroll {
     to { translate: calc(-50% - 5px); }
     }
</style>
<script>
    const list = document.querySelector('#list');
    const listContent = Array.from(list.children);
   {% comment %} if (!list || list.length === 0) {
    return;
} {% endcomment %}
  listContent.forEach((item) => {
    const duplicatedItem = item.cloneNode(true);
    duplicatedItem.setAttribute('aria-hidden', true);
    list.appendChild(duplicatedItem);
  });

  const controlBtn = document.querySelector('#carousel-control-btn');
  const container = document.querySelector('#container');
  
  if (controlBtn && container) {
    controlBtn.addEventListener('click', function() {
      const isPaused = container.classList.toggle('paused');
      controlBtn.setAttribute('aria-pressed', isPaused);
      
      const pauseIcon = controlBtn.querySelector('.pause-icon');
      const playIcon = controlBtn.querySelector('.play-icon');
      
      if (isPaused) {
        controlBtn.setAttribute('aria-label', 'Play logo carousel');
        pauseIcon.style.display = 'none';
        playIcon.style.display = 'block';
      } else {
        controlBtn.setAttribute('aria-label', 'Pause logo carousel');
        pauseIcon.style.display = 'block';
        playIcon.style.display = 'none';
      }
    });
  }
</script>

{% schema %}
{
  "name": "Logo Slider New",
  "tag": "section",
  "settings": [
    
    {
    
      "type": "text",
      "id": "tickerHeading",
      "label": "Section Heading"
    }

  ],
  "blocks": [
    {
      "type": "Logo_Slider",
      "name": "Logo Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Select Logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo Slider New"
    }
  ]
}
{% endschema %}
