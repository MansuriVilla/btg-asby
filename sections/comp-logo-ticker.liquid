{% liquid
  assign s_id = section.id
  assign bg_color = section.settings.bg_color | default: '#111417'
  assign speed = section.settings.speed | default: 25
  assign logo_height = section.settings.logo_height | default: 20
  assign gap = section.settings.gap | default: 60
  assign pause_on_hover = section.settings.pause_on_hover
  assign section_id = section.settings.custom_section_id | default: ''
  if section_id == blank
    assign section_id = 'comp-ticker-' | append: s_id
  endif
%}

<div
  class="comp-logo-ticker comp-logo-ticker-{{ s_id }} {% if pause_on_hover %}comp-logo-ticker--pause{% endif %}"
  id="{{ section_id }}"
  style="
    --comp-ticker-bg: {{ bg_color }};
    --comp-ticker-speed: {{ speed }}s;
    --comp-ticker-logo-h: {{ logo_height }}px;
    --comp-ticker-gap: clamp({{ gap | times: 0.6 | round }}px, 4vw, {{ gap }}px);
    --comp-ticker-pt: {{ section.settings.padding_top | default: 24 }}px;
    --comp-ticker-pb: {{ section.settings.padding_bottom | default: 24 }}px;
  "
  aria-label="Partner Brand Logos"
>
  <div class="comp-logo-ticker__wrapper">
    <!-- Track 1 (Original) -->
    <div class="comp-logo-ticker__track" aria-hidden="false">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="comp-logo-ticker__item" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="comp-logo-ticker__link" target="_blank" rel="noopener">
            {% endif %}

            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 400 | image_tag: 
                 loading: 'lazy', 
                 class: 'comp-logo-ticker__img', 
                 alt: block.settings.image.alt | default: 'Partner Logo' 
              }}
            {% else %}
              <img
                src="{{ 'as-seen-logo4.png' | asset_url }}"
                alt="Partner Logo"
                class="comp-logo-ticker__img"
                loading="lazy"
              >
            {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
        <!-- Default Preset Logos from Assets -->
        {% assign demo_logos = 'as-seen-logo4.png,as-seen-logo5.png,as-seen-logo6.png,as-seen-logo7.png,as-seen-logo8.png,as-seen-logo9.png,as-seen-logo10.png,as-seen-logo11.png' | split: ',' %}
        {% for logo in demo_logos %}
          <div class="comp-logo-ticker__item">
            {{ logo | asset_img_url: '400x' | image_tag: class: 'comp-logo-ticker__img', loading: 'lazy', alt: 'Partner Logo' }}
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <!-- Track 2 (Clone for infinite seamless loop) -->
    <div class="comp-logo-ticker__track" aria-hidden="true">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="comp-logo-ticker__item">
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="comp-logo-ticker__link" tabindex="-1">
            {% endif %}

            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 400 | image_tag: 
                 loading: 'lazy', 
                 class: 'comp-logo-ticker__img', 
                 alt: block.settings.image.alt | default: 'Partner Logo' 
              }}
            {% else %}
              {{ 'as-seen-logo4.png' | asset_img_url: '400x' | image_tag: class: 'comp-logo-ticker__img', loading: 'lazy', alt: 'Partner Logo' }}
            {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </div>
        {% endfor %}
      {% else %}
        {% for logo in demo_logos %}
          <div class="comp-logo-ticker__item">
            {{ logo | asset_img_url: '400x' | image_tag: class: 'comp-logo-ticker__img', loading: 'lazy', alt: 'Partner Logo' }}
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

<style>
  .comp-logo-ticker-{{ s_id }} {
    width: 100%;
    background-color: var(--comp-ticker-bg, #111417);
    padding-top: var(--comp-ticker-pt, 24px);
    padding-bottom: var(--comp-ticker-pb, 24px);
    overflow: hidden;
    position: relative;
    box-sizing: border-box;
  }

  .comp-logo-ticker-{{ s_id }} * {
    box-sizing: border-box;
  }

  .comp-logo-ticker-{{ s_id }} .comp-logo-ticker__wrapper {
    display: flex;
    width: max-content;
    overflow: hidden;
    user-select: none;
  }

  .comp-logo-ticker-{{ s_id }} .comp-logo-ticker__track {
    display: flex;
    align-items: center;
    gap: var(--comp-ticker-gap, 60px);
    padding-right: var(--comp-ticker-gap, 60px);
    flex-shrink: 0;
    animation: comp-ticker-scroll-{{ s_id }} var(--comp-ticker-speed, 25s) linear infinite;
    will-change: transform;
  }

  .comp-logo-ticker-{{ s_id }}.comp-logo-ticker--pause:hover .comp-logo-ticker__track {
    animation-play-state: paused;
  }

  .comp-logo-ticker-{{ s_id }} .comp-logo-ticker__item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .comp-logo-ticker-{{ s_id }} .comp-logo-ticker__link {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    outline: none;
    transition: opacity 0.2s ease;
  }

  .comp-logo-ticker-{{ s_id }} .comp-logo-ticker__link:hover {
    opacity: 0.8;
  }

  .comp-logo-ticker-{{ s_id }} .comp-logo-ticker__img {
    height: var(--comp-ticker-logo-h, 20px);
    max-height: auto;
    width: auto;
    object-fit: contain;
    /* filter: brightness(0) invert(1); */
    opacity: 0.95;
    transition: opacity 0.2s ease, transform 0.2s ease;
    display: block;
  }

  .comp-logo-ticker-{{ s_id }} .comp-logo-ticker__item:hover .comp-logo-ticker__img {
    opacity: 1;
    transform: scale(1.05);
  }

  @keyframes comp-ticker-scroll-{{ s_id }} {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-100%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .comp-logo-ticker-{{ s_id }} .comp-logo-ticker__track {
      animation: none;
    }
    .comp-logo-ticker-{{ s_id }} .comp-logo-ticker__wrapper {
      overflow-x: auto;
      scrollbar-width: none;
    }
  }
</style>

{% schema %}
{
  "name": "Logo Ticker Banner",
  "tag": "section",
  "class": "section-logo-ticker",
  "settings": [
    {
      "type": "text",
      "id": "custom_section_id",
      "label": "Section Anchor ID",
      "info": "Optional custom HTML ID for anchor navigation (e.g. brands, ticker). Do not include '#'"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111417"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Scroll Duration (Lower = Faster)",
      "default": 24
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 350,
      "step": 10,
      "unit": "px",
      "label": "Logo Height",
      "default": 30
    },
    {
      "type": "range",
      "id": "gap",
      "min": 30,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Gap Between Logos",
      "default": 60
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo Ticker Banner",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
