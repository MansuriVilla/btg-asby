.tabing_item--answer { max-height: 0; overflow: hidden; transition: .3s linear all; text-align: left; }
.tabing_item--answer p{ padding-top:0px;}
.tabing_item.active .tabing_item--answer { max-height: 100%; padding: 0px 0px 24px; } 
.tabing_imgs--item { display: none; opacity: 0; transition: .3s linear all; border-radius: 20px; overflow: hidden; }
.tabing_imgs--item.active  { display: block; opacity: 1; }
.tabing_item.active .tabing_item--icon { transform: scaleY(-1); }
.tabing_item--icon { transition: .3s linear all; }
.what_sets-us--left{flex: 50%; display: flex; flex-direction: column; justify-content: center; align-items: center;}
.what_sets-us-right{flex: 65%;}



/* .item_mobile{display:none !important;} */
  
/* Initially hide mobile items for screens larger than 768px */
.tabing_imgs--item.item_mobile {
    display: none;
}

/* Show mobile items when screen width is below 768px */
@media (max-width: 768px) {
    .tabing_item.active .tabing_imgs--item.item_mobile {
        display: block;
    }

    /* Hide desktop items on mobile */
    .tabing_imgs--item.item_dekstop-container {
        display: none;
    }
}

/* For screens larger than 768px, show desktop items and hide mobile */
@media (min-width: 769px) {
    .tabing_imgs--item.item_mobile {
        display: none;
    }

    .tabing_imgs--item.item_dekstop-container {
        display: block;
    }
}


  
