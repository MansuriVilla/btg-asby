document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.tabing_item');
    
    const mobileImages = document.querySelectorAll('.tabing_imgs--item.item_mobile');
    
    const desktopImages = document.querySelectorAll('.item_dekstop-container .tabing_imgs--item');

    
    function updateTabVisibility() {
        const isMobile = window.innerWidth < 768;

        if (isMobile) {
            
            mobileImages.forEach(img => img.classList.add('active'));
            desktopImages.forEach(img => img.classList.remove('active'));
        } else {
            
            mobileImages.forEach(img => img.classList.remove('active'));
            desktopImages.forEach(img => img.classList.add('active'));
        }
    }

    
    updateTabVisibility();

    
    window.addEventListener('resize', updateTabVisibility);

    
    function activateInitialTab() {
        const isMobile = window.innerWidth < 768;
        const firstTab = tabs[0];
        
        const firstImage = isMobile 
            ? document.querySelector('.tabing_imgs--item.item_mobile') 
            : document.querySelector('.item_dekstop-container .tabing_imgs--item');

        
        tabs.forEach(t => t.classList.remove('active'));
        const allImages = document.querySelectorAll('.tabing_imgs--item');
        allImages.forEach(img => img.classList.remove('active'));

        
        firstTab.classList.add('active');
        if (firstImage) {
            firstImage.classList.add('active');
        }
    }

    
    activateInitialTab();

    
    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            const tabId = tab.getAttribute('data-tab');

            
            tabs.forEach(t => t.classList.remove('active'));
            const allImages = document.querySelectorAll('.tabing_imgs--item');
            allImages.forEach(img => img.classList.remove('active'));

            
            tab.classList.add('active');
            
            const activeImages = document.querySelectorAll(`.tabing_imgs--item[data-tab="${tabId}"]`);
            activeImages.forEach(img => img.classList.add('active'));
        });
    });
});
</script>










