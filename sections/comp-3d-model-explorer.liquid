{%- comment -%}
  Comp 3D Model Explorer Section
  - WebGL optimized <model-viewer> with lazy loading
  - Dynamic 3D Hotspots with glowing radar dots
  - Slide-up Bottom Drawer modal on hotspot click
  - Theme typography & Figma specs
{%- endcomment -%}

{%- liquid
  assign section_id = section.settings.custom_section_id | default: ''
  if section_id == blank
    assign section_id = 'comp-3d-model-explorer-' | append: section.id
  endif
-%}

<div
  id="{{ section_id }}"
  class="comp-3d-explorer comp-3d-explorer-{{ section.id }}"
  data-comp-3d-explorer
  data-model-src="{{ section.settings.model_glb_url | escape }}"
  style="{% if section.settings.card_width_mobile != blank %}--c3d-card-width-mobile: {{ section.settings.card_width_mobile }}%;{% endif %}"
>
  <!-- Background radial spotlight & optional watermark -->
  <div class="comp-3d-explorer__spotlight"></div>

  {%- if section.settings.bg_watermark_image != blank -%}
    <div class="comp-3d-explorer__watermark">
      {{
        section.settings.bg_watermark_image
        | image_url: width: 1800
        | image_tag:
          loading: 'lazy',
          widths: '600, 900, 1200, 1800',
          sizes: '(max-width: 768px) 100vw, 1400px',
          alt: section.settings.heading | default: '3D Background' | escape
      }}
    </div>
  {%- endif -%}

  <div class="comp-3d-explorer__inner">
    <!-- Header: Heading + Angle Selector Pills -->
    <header class="comp-3d-explorer__header">
      <h2 class="comp-3d-explorer__heading custom_heading">
        {{ section.settings.heading | default: 'EXPLORE PLAYER PRO' }}
      </h2>

      <!-- Camera Angle Switcher -->
      <nav class="comp-3d-explorer__nav" aria-label="Camera angles">
        {%- if section.settings.show_side_pill != false -%}
          <button
            type="button"
            class="comp-3d-explorer__nav-btn custom_subHeading-text"
            data-angle="side"
            data-orbit="{{ section.settings.angle_side_deg | default: 90 }}deg {{ section.settings.angle_side_pitch | default: 75 }}deg 105%"
          >
            {{ section.settings.pill_side_label | default: 'SIDE' }}
          </button>
        {%- endif -%}
        {%- if section.settings.show_front_pill != false -%}
          <button
            type="button"
            class="comp-3d-explorer__nav-btn comp-3d-explorer__nav-btn--active custom_subHeading-text"
            data-angle="front"
            data-orbit="{{ section.settings.angle_front_deg | default: 0 }}deg {{ section.settings.angle_front_pitch | default: 75 }}deg 105%"
          >
            {{ section.settings.pill_front_label | default: 'FRONT' }}
          </button>
        {%- endif -%}
        {%- if section.settings.show_back_pill != false -%}
          <button
            type="button"
            class="comp-3d-explorer__nav-btn custom_subHeading-text"
            data-angle="back"
            data-orbit="{{ section.settings.angle_back_deg | default: 180 }}deg {{ section.settings.angle_back_pitch | default: 75 }}deg 105%"
          >
            {{ section.settings.pill_back_label | default: 'BACK' }}
          </button>
        {%- endif -%}
      </nav>
    </header>

    <!-- 3D Stage / Viewer -->
    <div class="comp-3d-explorer__stage">
      <div class="comp-3d-explorer__viewer-container" data-viewer-container>
        {%- if section.settings.model_glb_url != blank -%}
          <!-- Custom Loading & Retry State -->
          <div class="comp-3d-loader" data-3d-loader>
            <!-- Loading spinner -->
            <div class="comp-3d-loader__spinner-box" data-3d-spinner>
              <div class="comp-3d-loader__spinner"></div>
              <span class="comp-3d-loader__text custom_subHeading-text">LOADING 3D MODEL...</span>
            </div>

            <!-- Error & Retry Button -->
            <div class="comp-3d-loader__error-box" data-3d-error style="display: none;">
              <span class="comp-3d-loader__error-text custom_subHeading-text">Taking longer than expected to load</span>
              <button type="button" class="comp-3d-loader__retry-btn custom_subHeading-text" data-3d-retry>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="1 4 1 10 7 10"></polyline>
                  <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                </svg>
                <span>TRY AGAIN</span>
              </button>
            </div>
          </div>

          <model-viewer
            id="viewer-{{ section.id }}"
            data-src="{{ section.settings.model_glb_url }}"
            {% if section.settings.poster_image != blank %}
              poster="{{ section.settings.poster_image | image_url: width: 1200 }}"
            {% endif %}
            {% if section.settings.enable_user_rotation %}
              camera-controls
              touch-action="pan-y"
              disable-zoom
            {% endif %}
            shadow-intensity="0"
            shadow-softness="0"
            exposure="1.05"
            camera-orbit="{{ section.settings.angle_front_deg | default: 0 }}deg {{ section.settings.angle_front_pitch | default: 75 }}deg 105%"
            interaction-prompt="none"
            loading="lazy"
            reveal="auto"
            class="comp-3d-explorer__model-viewer"
          >
            <!-- Hotspots -->
            {%- for block in section.blocks -%}
              {%- assign slot_name = 'hotspot-' | append: forloop.index -%}
              {%- if block.settings.hotspot_position_exact != blank -%}
                {%- assign position_str = block.settings.hotspot_position_exact -%}
                {%- assign normal_str = block.settings.hotspot_normal_exact | default: '0m 0m 1m' -%}
              {%- else -%}
                {%- assign pos_x = block.settings.pos_x | default: 0 | divided_by: 100.0 | append: 'm' -%}
                {%- assign pos_y = block.settings.pos_y | default: 0 | divided_by: 100.0 | append: 'm' -%}
                {%- assign pos_z = block.settings.pos_z | default: 0 | divided_by: 100.0 | append: 'm' -%}
                {%- assign norm_x = block.settings.norm_x | default: 0 | divided_by: 100.0 -%}
                {%- assign norm_y = block.settings.norm_y | default: 100 | divided_by: 100.0 -%}
                {%- assign norm_z = block.settings.norm_z | default: 0 | divided_by: 100.0 -%}
                {%- assign position_str = pos_x | append: ' ' | append: pos_y | append: ' ' | append: pos_z -%}
                {%- assign normal_str = norm_x | append: 'm ' | append: norm_y | append: 'm ' | append: norm_z | append: 'm' -%}
              {%- endif -%}
              {%- liquid
                assign is_mobile_pos = false
                if block.settings.enable_mobile_hotspot_position
                  if block.settings.hotspot_position_exact_mobile != blank
                    assign is_mobile_pos = true
                    assign position_mob_str = block.settings.hotspot_position_exact_mobile
                    assign normal_mob_str = block.settings.hotspot_normal_exact_mobile | default: normal_str
                  elsif block.settings.pos_x_mobile != blank
                    assign is_mobile_pos = true
                    assign pos_x_mob = block.settings.pos_x_mobile | default: 0 | divided_by: 100.0 | append: 'm'
                    assign pos_y_mob = block.settings.pos_y_mobile | default: 0 | divided_by: 100.0 | append: 'm'
                    assign pos_z_mob = block.settings.pos_z_mobile | default: 0 | divided_by: 100.0 | append: 'm'
                    assign position_mob_str = pos_x_mob | append: ' ' | append: pos_y_mob | append: ' ' | append: pos_z_mob
                    assign normal_mob_str = normal_str
                  else
                    assign position_mob_str = position_str
                    assign normal_mob_str = normal_str
                  endif
                else
                  assign position_mob_str = position_str
                  assign normal_mob_str = normal_str
                endif
              -%}
              <button
                type="button"
                class="comp-3d-hotspot"
                slot="{{ slot_name }}"
                data-position="{{ position_str }}"
                data-normal="{{ normal_str }}"
                data-position-desktop="{{ position_str }}"
                data-normal-desktop="{{ normal_str }}"
                data-position-mobile="{{ position_mob_str }}"
                data-normal-mobile="{{ normal_mob_str }}"
                data-visible-view="{{ block.settings.visible_view | default: 'all' }}"
                data-block-id="{{ block.id }}"
                data-target-drawer="drawer-{{ block.id }}"
                aria-label="{{ block.settings.title | escape }}"
                {{ block.shopify_attributes }}
              >
                <span class="comp-3d-hotspot__halo">
                  <span class="comp-3d-hotspot__dot"></span>
                </span>
                {%- if block.settings.title != blank -%}
                  <span class="comp-3d-hotspot__label custom_subHeading-text">
                    {{ block.settings.title }}
                  </span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </model-viewer>
        {%- else -%}
          <!-- Placeholder if no model uploaded yet -->
          <div class="comp-3d-explorer__fallback">
            {%- if section.settings.poster_image != blank -%}
              {{
                section.settings.poster_image
                | image_url: width: 1200
                | image_tag: class: 'comp-3d-explorer__fallback-img', alt: '3D Preview'
              }}
            {%- else -%}
              <div class="comp-3d-explorer__empty-box custom_body-text">
                Upload a .glb 3D Model file in Section Settings
              </div>
            {%- endif -%}

            <!-- Static hotspots preview over fallback image -->
            {%- for block in section.blocks -%}
              {%- liquid
                assign s_top = block.settings.static_top | default: 50
                assign s_left = block.settings.static_left | default: 50
                if block.settings.enable_mobile_hotspot_position
                  assign s_top_mob = block.settings.static_top_mobile | default: s_top
                  assign s_left_mob = block.settings.static_left_mobile | default: s_left
                else
                  assign s_top_mob = s_top
                  assign s_left_mob = s_left
                endif
              -%}
              <button
                type="button"
                class="comp-3d-hotspot comp-3d-hotspot--static"
                style="--comp-static-top: {{ s_top }}%; --comp-static-left: {{ s_left }}%; --comp-static-top-mob: {{ s_top_mob }}%; --comp-static-left-mob: {{ s_left_mob }}%;"
                data-target-drawer="drawer-{{ block.id }}"
                aria-label="{{ block.settings.title | escape }}"
                {{ block.shopify_attributes }}
              >
                <span class="comp-3d-hotspot__halo">
                  <span class="comp-3d-hotspot__dot"></span>
                </span>
                {%- if block.settings.title != blank -%}
                  <span class="comp-3d-hotspot__label custom_subHeading-text">
                    {{ block.settings.title }}
                  </span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <!-- Bottom Drawer Modals -->
  <div class="comp-3d-drawer-backdrop" data-drawer-backdrop></div>

  {%- for block in section.blocks -%}
    <div
      id="drawer-{{ block.id }}"
      class="comp-3d-drawer"
      data-drawer
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
    >
      <div class="comp-3d-drawer__header-bar">
        <button type="button" class="comp-3d-drawer__close" data-drawer-close aria-label="Close details">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="comp-3d-drawer__scrollable">
        <!-- Top Media / Hero Banner / Video -->
        {%- if block.settings.drawer_hero_video != blank or block.settings.drawer_hero_image != blank -%}
          <div class="comp-3d-drawer__hero">
            {%- if block.settings.drawer_hero_video != blank -%}
              <video
                class="comp-3d-drawer__hero-video"
                src="{{ block.settings.drawer_hero_video }}"
                autoplay
                loop
                muted
                playsinline
                {% if block.settings.drawer_hero_image != blank %}
                  poster="{{ block.settings.drawer_hero_image | image_url: width: 1400 }}"
                {% endif %}
              ></video>
            {%- elsif block.settings.drawer_hero_image != blank -%}
              {{
                block.settings.drawer_hero_image
                | image_url: width: 1400
                | image_tag: loading: 'lazy', class: 'comp-3d-drawer__hero-img', alt: block.settings.drawer_title | default: 'Feature Banner' | escape
              }}
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <span class="comp-3d-drawer__hero-tag custom_heading">
                {{ block.settings.title }}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="comp-3d-drawer__body">
          {%- if block.settings.show_drawer_cards -%}
            {%- assign show_row1_heading = block.settings.show_drawer_heading | default: true -%}
            {%- if show_row1_heading -%}
              {%- if block.settings.drawer_title != blank or block.settings.drawer_subtitle != blank -%}
                <div class="comp-3d-drawer__header-content">
                  {%- if block.settings.drawer_title != blank -%}
                    <h3 class="comp-3d-drawer__title custom_heading">
                      {{ block.settings.drawer_title }}
                    </h3>
                  {%- endif -%}

                  {%- if block.settings.drawer_subtitle != blank -%}
                    <p class="comp-3d-drawer__subtext custom_body-text">
                      {{ block.settings.drawer_subtitle }}
                    </p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endif -%}

            <!-- 3-Column Feature Cards Row 1 -->
            {%- assign drawer_cards_ui = block.settings.drawer_cards_ui | default: 'ui_v1' -%}
            <div class="comp-3d-drawer__cards-grid comp-3d-drawer__cards-grid--{{ drawer_cards_ui }}">
              {% render 'comp-3d-drawer-card',
                card_ui: drawer_cards_ui,
                image: block.settings.card_1_image,
                title: block.settings.card_1_title,
                default_title: 'FRONT, CENTER, BACK GPS DISTANCES',
                desc: block.settings.card_1_desc,
                default_desc: 'Instantly view FCB yardages across 42,000+ courses to dial in every shot with confidence, wherever you play, round after round.'
              %}

              {% render 'comp-3d-drawer-card',
                card_ui: drawer_cards_ui,
                image: block.settings.card_2_image,
                title: block.settings.card_2_title,
                default_title: 'SHOT DISTANCE TRACKING',
                desc: block.settings.card_2_desc,
                default_desc: 'Automatically track the distance of every shot to measure performance, dial in your yardages, and play with more confidence—all directly on your screen.'
              %}

              {% render 'comp-3d-drawer-card',
                card_ui: drawer_cards_ui,
                image: block.settings.card_3_image,
                title: block.settings.card_3_title,
                default_title: 'DYNAMIC HAZARD DISTANCES',
                desc: block.settings.card_3_desc,
                default_desc: 'Get real-time distances to bunkers, water, trees, and trouble. Every hazard is mapped and surfaced clearly, helping you navigate the course with smarter decisions.'
              %}

              {%- if drawer_cards_ui == 'ui_v2' -%}
                {%- assign r1_c4_img = block.settings.row1_card_4_image | default: block.settings.card_4_image -%}
                {%- assign r1_c4_title = block.settings.row1_card_4_title | default: block.settings.card_4_title -%}
                {%- assign r1_c4_desc = block.settings.row1_card_4_desc | default: block.settings.card_4_desc -%}
                {% render 'comp-3d-drawer-card',
                  card_ui: drawer_cards_ui,
                  image: r1_c4_img,
                  title: r1_c4_title,
                  default_title: 'DYNAMIC HOLE VIEWS',
                  desc: r1_c4_desc,
                  default_desc: 'Full layout from tee to green. View fairway curves, landing areas, hazards, and green shapes in high definition right on your screen.'
                %}
              {%- endif -%}
            </div>
          {%- endif -%}

          <!-- Full Width Highlight Video / Media Banner -->
          {%- assign hl_media_type = block.settings.highlight_media_type | default: 'video' -%}
          {%- assign hl_vid = block.settings.highlight_video_url -%}
          {%- assign show_hl_block = false -%}
          {%- if hl_media_type == 'image' and block.settings.highlight_image != blank -%}
            {%- assign show_hl_block = true -%}
          {%- elsif hl_media_type == 'video' and hl_vid != blank -%}
            {%- assign show_hl_block = true -%}
          {%- elsif block.settings.highlight_title != blank or block.settings.highlight_desc != blank -%}
            {%- assign show_hl_block = true -%}
          {%- endif -%}

          {%- if show_hl_block -%}
            <div class="comp-3d-drawer__highlight-wrap">
              {%- if block.settings.highlight_title != blank or block.settings.highlight_desc != blank -%}
                <div class="comp-3d-drawer__highlight-header">
                  {%- if block.settings.highlight_title != blank -%}
                    <h4 class="comp-3d-drawer__highlight-title custom_heading">
                      {{ block.settings.highlight_title }}
                    </h4>
                  {%- endif -%}
                  {%- if block.settings.highlight_desc != blank -%}
                    <p class="comp-3d-drawer__highlight-desc custom_body-text">
                      {{ block.settings.highlight_desc }}
                    </p>
                  {%- endif -%}
                </div>
              {%- endif -%}
              <div class="comp-3d-drawer__highlight-media">
                {%- if hl_media_type == 'image' -%}
                  {%- if block.settings.highlight_image != blank -%}
                    {{
                      block.settings.highlight_image
                      | image_url: width: 1400
                      | image_tag:
                        loading: 'lazy',
                        class: 'comp-3d-drawer__highlight-img',
                        alt: block.settings.highlight_title | default: 'Feature Highlight' | escape
                    }}
                  {%- endif -%}
                {%- else -%}
                  {%- if hl_vid != blank -%}
                    {% render 'comp-video-player',
                      video_url: hl_vid,
                      poster: block.settings.highlight_image,
                      is_active: true,
                      title: block.settings.highlight_title,
                      video_class: 'comp-3d-drawer__highlight-video',
                      data_attr: 'data-3d-drawer-video',
                      controls_variant: 'full'
                    %}
                  {%- elsif block.settings.highlight_image != blank -%}
                    {{
                      block.settings.highlight_image
                      | image_url: width: 1400
                      | image_tag:
                        loading: 'lazy',
                        class: 'comp-3d-drawer__highlight-img',
                        alt: block.settings.highlight_title | default: 'Feature Highlight' | escape
                    }}
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

          <!-- 3-Column Feature Cards Row 2 -->
          {%- if block.settings.show_drawer_cards_bottom -%}
            {%- assign drawer_cards_ui = block.settings.drawer_cards_ui | default: 'ui_v1' -%}
            <div class="comp-3d-drawer__cards-grid comp-3d-drawer__cards-grid--{{ drawer_cards_ui }}">
              {% render 'comp-3d-drawer-card',
                card_ui: drawer_cards_ui,
                image: block.settings.card_4_image,
                title: block.settings.card_4_title,
                default_title: 'ON-DEVICE SCORING',
                desc: block.settings.card_4_desc,
                default_desc: 'Keep score without pulling out your phone. Track your round shot-by-shot with an intuitive, full-color interface.'
              %}

              {% render 'comp-3d-drawer-card',
                card_ui: drawer_cards_ui,
                image: block.settings.card_5_image,
                title: block.settings.card_5_title,
                default_title: 'CLOCK + ROUND TIMER',
                desc: block.settings.card_5_desc,
                default_desc: 'Stay on pace and in rhythm with an integrated clock and hole-by-hole round timer designed for focus and flow.'
              %}

              {% render 'comp-3d-drawer-card',
                card_ui: drawer_cards_ui,
                image: block.settings.card_6_image,
                title: block.settings.card_6_title,
                default_title: 'MUSIC PLAYER WITH ALBUM ART',
                desc: block.settings.card_6_desc,
                default_desc: 'Get real-time distances to bunkers, water, trees, and trouble. Every hazard is mapped and surfaced clearly, helping you navigate the course with smarter decisions.'
              %}

              {%- if drawer_cards_ui == 'ui_v2' and block.settings.card_7_title != blank or block.settings.card_7_image != blank -%}
                {% render 'comp-3d-drawer-card',
                  card_ui: drawer_cards_ui,
                  image: block.settings.card_7_image,
                  title: block.settings.card_7_title,
                  default_title: 'WEATHER AND ELEVATION',
                  desc: block.settings.card_7_desc,
                  default_desc: 'Live course conditions, temperature, humidity, and elevation adjustments to calculate your True Distance on every shot.'
                %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endfor -%}
</div>

<style>
  #{{ section_id }}.comp-3d-explorer {
    position: relative;
    width: 100%;
    min-height: 886px;
    background: linear-gradient(180deg, #1B1E22 0%, #000000 100%);
    overflow: hidden;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
  }

  /* Radial spotlight behind model */
  #{{ section_id }} .comp-3d-explorer__spotlight {
    position: absolute;
    width: 858px;
    height: 572px;
    left: calc(50% - 429px);
    top: calc(50% - 286px + 58px);
    background: radial-gradient(50% 50% at 50% 50%, #1B1E22 0%, rgba(27, 30, 34, 0) 100%);
    pointer-events: none;
    z-index: 1;
  }

  /* Watermark background image */
  #{{ section_id }} .comp-3d-explorer__watermark {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 1440px;
    height: 180px;
    pointer-events: none;
    z-index: 1;
    opacity: 0.85;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #{{ section_id }} .comp-3d-explorer__watermark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #{{ section_id }} .comp-3d-explorer__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 68px 20px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
  }

  /* Header */
  #{{ section_id }} .comp-3d-explorer__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    margin-bottom: 24px;
    text-align: center;
    width: 100%;
  }

  #{{ section_id }} .comp-3d-explorer__heading {
    margin: 0;
    font-size: 38px;
    line-height: 1;
    color: #FFFFFF;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    opacity: 0.95;
  }

  /* Angle Navigation Pill Bar */
  #{{ section_id }} .comp-3d-explorer__nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    gap: 4px;
    background: rgba(27, 30, 34, 0.4);
    border: 1px solid #474646;
    border-radius: 100px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-sizing: border-box;
  }

  #{{ section_id }} .comp-3d-explorer__nav-btn {
    appearance: none;
    border: none;
    background: transparent;
    border-radius: 100px;
    padding: 10px 24px;
    color: #B4B4B4;
    font-size: 14px;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease;
  }

  #{{ section_id }} .comp-3d-explorer__nav-btn:hover {
    color: #FFFFFF;
  }

  #{{ section_id }} .comp-3d-explorer__nav-btn--active {
    background: #FFFFFF;
    color: #1B1E22 !important;
  }

  /* Stage & Model Viewer */
  #{{ section_id }} .comp-3d-explorer__stage {
    position: relative;
    width: 100%;
    max-width: 900px;
