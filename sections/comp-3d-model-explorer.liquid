<script>
  (function () {
    const root = document.getElementById('{{ section_id }}');
    if (!root) return;

    // 1. Non-blocking lazy load for Google <model-viewer> and 3D GLB
    const viewer = root.querySelector('model-viewer');
    const loader = root.querySelector('[data-3d-loader]');
    const spinnerBox = root.querySelector('[data-3d-spinner]');
    const errorBox = root.querySelector('[data-3d-error]');
    const retryBtn = root.querySelector('[data-3d-retry]');

    let loadTimeout = null;

    function startLoadTimer() {
      clearTimeout(loadTimeout);
      // If model not loaded after 10s, show error with retry button
      loadTimeout = setTimeout(() => {
        if (viewer && !viewer.loaded && errorBox && spinnerBox) {
          spinnerBox.style.display = 'none';
          errorBox.style.display = 'flex';
        }
      }, 10000);
    }

    const viewerContainer = root.querySelector('[data-viewer-container]');

    function onModelLoaded() {
      clearTimeout(loadTimeout);
      if (viewerContainer) {
        viewerContainer.classList.add('is-model-loaded');
      }
      if (loader) {
        loader.style.opacity = '0';
        loader.style.pointerEvents = 'none';
        setTimeout(() => {
          loader.style.display = 'none';
        }, 350);
      }
    }

    function onModelError() {
      clearTimeout(loadTimeout);
      if (spinnerBox && errorBox) {
        spinnerBox.style.display = 'none';
        errorBox.style.display = 'flex';
      }
    }

    if (viewer) {
      viewer.addEventListener('load', onModelLoaded);
      viewer.addEventListener('error', onModelError);
    }

    if (retryBtn && viewer) {
      retryBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (viewerContainer) {
          viewerContainer.classList.remove('is-model-loaded');
        }
        if (errorBox && spinnerBox) {
          errorBox.style.display = 'none';
          spinnerBox.style.display = 'flex';
        }
        const src = viewer.getAttribute('data-src') || viewer.getAttribute('src');
        if (src) {
          // Force reload by appending timestamp cache buster
          const separator = src.indexOf('?') !== -1 ? '&' : '?';
          const freshSrc = src.split('?v3d=')[0] + separator + 'v3d=' + Date.now();
          viewer.removeAttribute('src');
          viewer.setAttribute('src', freshSrc);
          startLoadTimer();
        }
      });
    }

    // Fix for Pastel QA tool: Pastel proxies DOM nodes, causing Lit inside model-viewer to throw on TreeWalker.currentNode
    try {
      const origDescriptor = Object.getOwnPropertyDescriptor(TreeWalker.prototype, 'currentNode');
      if (origDescriptor && origDescriptor.set) {
        Object.defineProperty(TreeWalker.prototype, 'currentNode', {
          get: origDescriptor.get,
          set: function (val) {
            try {
              origDescriptor.set.call(this, val);
            } catch (err) {
              if (val && typeof val === 'object' && val.nodeType) {
                const unwrapped = val.__target || val._target || val;
                try { origDescriptor.set.call(this, unwrapped); } catch (e) {}
              }
            }
          },
          configurable: true,
          enumerable: true
        });
      }
    } catch (e) {}

    function init3DModel() {
      if (!viewer) return;

      const scheduleIdle = window.requestIdleCallback || function(cb) { return setTimeout(cb, 250); };

      scheduleIdle(() => {
        function attachSource() {
          const dataSrc = viewer.getAttribute('data-src');
          if (dataSrc && !viewer.getAttribute('src')) {
            startLoadTimer();
            viewer.setAttribute('src', dataSrc);
          }
        }

        if (window.customElements && window.customElements.get('model-viewer')) {
          attachSource();
          return;
        }

        if (!document.getElementById('model-viewer-script')) {
          const script = document.createElement('script');
          script.id = 'model-viewer-script';
          script.type = 'module';
          script.src = 'https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js';
          script.onload = () => {
            if (window.customElements && window.customElements.whenDefined) {
              window.customElements.whenDefined('model-viewer').then(attachSource);
            } else {
              attachSource();
            }
          };
          document.head.appendChild(script);
        } else if (window.customElements && window.customElements.whenDefined) {
          window.customElements.whenDefined('model-viewer').then(attachSource);
        }
      });
    }

    // Trigger on scroll near or immediate user interaction (click / touch)
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          init3DModel();
          observer.disconnect();
        }
      });
    }, { rootMargin: '200px' });

    observer.observe(root);

    // If user clicks or taps section before observer triggers, load immediately
    root.addEventListener('pointerdown', function() {
      init3DModel();
      observer.disconnect();
    }, { once: true, passive: true });
    const navButtons = root.querySelectorAll('.comp-3d-explorer__nav-btn');
    const allHotspots = root.querySelectorAll('.comp-3d-hotspot');

    function updateHotspotVisibility(activeAngle) {
      allHotspots.forEach(hs => {
        const targetView = hs.getAttribute('data-visible-view') || 'all';
        if (targetView === 'all' || targetView === activeAngle) {
          hs.classList.remove('is-angle-hidden');
        } else {
          hs.classList.add('is-angle-hidden');
        }
      });
    }

    // Responsive Hotspot Position Switcher for 3D
    function applyResponsiveHotspots() {
      const isMobile = window.innerWidth <= 768;
      allHotspots.forEach(hs => {
        const targetPos = isMobile ? hs.getAttribute('data-position-mobile') : hs.getAttribute('data-position-desktop');
        const targetNorm = isMobile ? hs.getAttribute('data-normal-mobile') : hs.getAttribute('data-normal-desktop');
        if (targetPos) {
          hs.setAttribute('data-position', targetPos);
        }
        if (targetNorm) {
          hs.setAttribute('data-normal', targetNorm);
        }
      });
    }

    applyResponsiveHotspots();
    window.addEventListener('resize', applyResponsiveHotspots);

    // Set initial visibility
    updateHotspotVisibility('front');

    navButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        navButtons.forEach(b => b.classList.remove('comp-3d-explorer__nav-btn--active'));
        btn.classList.add('comp-3d-explorer__nav-btn--active');

        const angle = btn.getAttribute('data-angle') || 'front';
        const orbit = btn.getAttribute('data-orbit');

        updateHotspotVisibility(angle);

        if (viewer && orbit) {
          viewer.cameraOrbit = orbit;
          if (typeof viewer.jumpCameraToGoal === 'function') {
            // allows smooth camera transition
          }
        }
      });
    });

    // 3. Hotspot Drawer Trigger
    const backdrop = root.querySelector('[data-drawer-backdrop]');
    const drawers = root.querySelectorAll('[data-drawer]');
    const hotspots = root.querySelectorAll('[data-target-drawer]');
    const closeBtns = root.querySelectorAll('[data-drawer-close]');

    function openDrawer(targetId) {
      const targetDrawer = document.getElementById(targetId);
      if (!targetDrawer) return;

      drawers.forEach(d => {
        d.classList.remove('is-active');
        d.setAttribute('aria-hidden', 'true');
      });

      targetDrawer.classList.add('is-active');
      targetDrawer.setAttribute('aria-hidden', 'false');
      backdrop.classList.add('is-active');
      document.body.classList.add('lock-scroll');
    }

    function closeAllDrawers() {
      drawers.forEach(d => {
        d.classList.remove('is-active');
        d.setAttribute('aria-hidden', 'true');
      });
      backdrop.classList.remove('is-active');
      document.body.classList.remove('lock-scroll');
    }

    hotspots.forEach(hotspot => {
      hotspot.addEventListener('click', (e) => {
        e.stopPropagation();
        const targetId = hotspot.getAttribute('data-target-drawer');
        if (targetId) openDrawer(targetId);
      });
    });

    closeBtns.forEach(btn => {
      btn.addEventListener('click', closeAllDrawers);
    });

    if (backdrop) {
      backdrop.addEventListener('click', closeAllDrawers);
    }

    // 4. Click on 3D Model to get exact coordinates in console / alert
    if (viewer) {
      viewer.addEventListener('click', (event) => {
        if (event.target.classList.contains('comp-3d-hotspot')) return;
        const hit = viewer.positionAndNormalFromPoint(event.clientX, event.clientY);
        if (hit) {
          const posStr = `${hit.position.x.toFixed(3)}m ${hit.position.y.toFixed(3)}m ${hit.position.z.toFixed(3)}m`;
          const normStr = `${hit.normal.x.toFixed(3)}m ${hit.normal.y.toFixed(3)}m ${hit.normal.z.toFixed(3)}m`;
          console.log(`[3D Explorer] Clicked coordinates:\nPosition: "${posStr}"\nNormal: "${normStr}"`);
        }
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAllDrawers();
    });
  })();
</script>

