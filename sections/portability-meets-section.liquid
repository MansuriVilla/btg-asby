{% comment %} {% assign icon = section.settings.icon %}
<div
  class="portiablity-meets-section portiablity-meets-section__{{ template.suffix | default: 'default' }} portiablity-meets-section__{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-index="{{ section.index }}"
>
  <div
    class="portiablity-meets-top"
    {% if section.settings.bg_color_top != blank %}
      style="background-color: {{ section.settings.bg_color_top }}"
    {% endif %}
  >
    
    <div
      class="portiablity-meets-content"
      {% if section.settings.bg_content_clr != blank %}
        style="background-color: {{ section.settings.bg_content_clr }}"
      {% endif %}
    >
       {% if section.settings.hero_heading_top != blank %}
            <h2 class="portiablity-meets-heading portiablity-meets-heading--top">
              {{ section.settings.hero_heading_top }}
            </h2>
          {% endif %}
      <div class="portiablity-meets-inner">
        {% if icon != blank %}
          {{
            icon
            | image_url: width: 50
            | image_tag:
              class: 'icon_image',
              alt: title,
              loading: 'eager',
              fetchpriority: 'high',
              widths: '400,600,800,1200,1600,1800,2400',
              sizes: '(max-width: 859px) 100vw, 100vw',
              height: icon.height,
              width: icon.width
          }}
        {% endif %}
        {% if section.settings.hero_heading_image != blank and section.settings.hero_heading_image_enable %}
          <img
            src="{{section.settings.hero_heading_image | image_url}}"
            alt="{{section.settings.hero_description | strip_html | escape }}"
            loading="lazy"
            height="100%"
            width="100%"
            class="hero_heading--image hero_heading--image--{{ product.template_suffix }}-{{ section.id }}-{{ section.index }}"
          >
        {% else %}
          {% if section.settings.hero_heading != blank %}
            <h2 class="portiablity-meets-heading{% if section.settings.heading_small %} heading_small{% endif %}">
              {{ section.settings.hero_heading }}
            </h2>
          {% endif %}
        {% endif %}

        {% if section.settings.hero_image != blank %}
          {{
            section.settings.hero_image
            | image_url: width: 1800
            | image_tag:
              alt: 'Hero Image',
              class: 'hero-image',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '400,600,800,1200,1600,1800,2400',
              sizes: '100vw',
              height: section.settings.hero_image.height,
              width: section.settings.hero_image.width
          }}
        {% endif %}
        {% if section.settings.hero_description != blank %}
          <div class="portiablity-meets-description{% if section.settings.desc_large %} desc_large{% endif %}">
            {{ section.settings.hero_description }}
          </div>
        {% endif %}
        {% if section.settings.note != blank %}
          <div class="portiablity-meets-note">
            {{ section.settings.note }}
          </div>
        {% endif %}
      </div>
      {% if section.settings.hero_main_image != blank %}
        {% capture extra_classes %}
    {% if section.settings.hero_main_image_large %} meets_image--full{% endif %}
    {% if section.settings.hero_main_image_large_top %} meets_top-image--full{% endif %}
    {% if section.settings.hero_main_image_fill_top %} meets_top-image--fill{% endif %}
    {% if section.settings.hero_main_image_full_mobile %} meets_top-image--full-mobile{% endif %}
  {% endcapture %}

        {% assign full_class = 'portiablity-meets-image' | append: extra_classes | strip %}
        <picture class="portiablity-meets_mockup {%if section.settings.container%}new-page-width{%else%}new-page-width-xl{% endif %}">
          <source srcset="{{ section.settings.hero_main_image | image_url  }}" media="(min-width:861px)">
          <source srcset="{{ section.settings.hero_main_image_mobile | image_url  }}" media="(max-width:860px)">
          {{
            section.settings.hero_main_image
            | image_url: width: 1800
            | image_tag:
              alt: 'Game Platform',
              class: full_class,
              loading: 'eager',
              fetchpriority: 'high',
              widths: '400,600,800,1200,1600,1800,2400',
              sizes: '100vw',
              height: section.settings.hero_main_image.height,
              width: section.settings.hero_main_image.width
          }}
        </picture>
      {% endif %}
    </div>
    {%- if section.settings.slider_heading != blank
      or section.settings.slider_description != blank
      or section.blocks.size > 0
    -%}
      <div class="portiablity-meets-slider-wrapper">
        <div class="horizon-slider_container portiablity-meets-slider">
          {%- if section.settings.slider_heading != blank -%}
            <h3 class="slider-heading">
              {{ section.settings.slider_heading }}
            </h3>
          {%- endif -%}

          {%- if section.settings.slider_description != blank -%}
            <div class="slider-description">
              {{ section.settings.slider_description }}
            </div>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <div class="horizon-slider_track">
              {%- for block in section.blocks -%}
                {%- comment -%}
                  Only render a slide if it has at least a title or description or image
                {%- endcomment -%}
                {%- if block.settings.title != blank
                  or block.settings.description != blank
                  or block.settings.image != blank
                  or block.settings['slide-icon'] != blank
                -%}
                  <div class="horizon-slide portiablity-meets-slider__slide portiablity-meets-slider__slide--{{ forloop.index }}">
                    <div class="portiablity-meets-slide-card{% if section.settings.extra_space %} extra_space{% endif %}{% if section.settings.image_space %} image_space{% endif %}{% if section.settings.layout_change %} has_layout-change{% endif %}">
                      {% unless section.settings.layout_change %}
                        <div class="portiablity-meets-slide-overlay">
                      {% endunless %}
                      {%- if block.settings['slide-icon'] != blank -%}
                        <div class="portiablity-meets-slide-icon">
                          <img
                            src="{{ block.settings.slide-icon | image_url: width: 45 }}"
                            alt="{{ block.settings.title | escape }}"
                            loading="lazy"
                            width="45"
                            height="45"
                          >
                        </div>
                      {%- endif -%}

                      {%- if block.settings.title != blank -%}
                        <h3 class="portiablity-meets-slide-title">
                          {{ block.settings.title }}
                        </h3>
                      {%- endif -%}

                      {%- if block.settings.description != blank -%}
                        <div class="portiablity-meets-slide-desc">
                          <p>{{ block.settings.description }}</p>
                        </div>
                      {%- endif -%}
                      {% unless section.settings.layout_change %}
                        </div>
                      {% endunless %}

                      {%- if block.settings.image != blank -%}
                        {{
                          block.settings.image
                          | image_url: width: 560
                          | image_tag: alt: block.settings.title
                          | strip
                          | default: 'Slide image',
                            loading: 'lazy',
                            widths: '300,400,500,600,800,1000,1200,1600',
                            sizes: '(max-width: 480px) 100vw, (max-width: 768px) 75vw, 50vw',
                            height: block.settings.image.height,
                            width: block.settings.image.width
                        }}
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  {% if section.settings.textColor != blank %}
    .portiablity-meets-section__{{ section.id }} :is(.portiablity-meets-heading, .portiablity-meets-slide-title,
    .portiablity-meets-slide-desc ){ color: {{ section.settings.textColor }};}
  {% endif %}


  {% if section.settings.bgImage != blank %}
    .portiablity-meets-section__{{ section.id }} .portiablity-meets-content .portiablity-meets_mockup{ background:url( {{- section.settings.bgImage | image_url -}} ) center center / cover no-repeat; width: 100%; height: 100%;}
  {% endif %}

  @media only screen and (min-width:1921px){
    {% if section.settings.bgImage != blank %}
      .portiablity-meets-section__{{ section.id }} .portiablity-meets-content .portiablity-meets_mockup{ background-size:contain;}
    {% endif %}
  }

  {% if section.settings.bg_content_clr != blank %}
    .portiablity-meets-section__{{ section.id }} .portiablity-meets-content{ background: {{- section.settings.bg_content_clr -}} ;}
  {% endif %}

  {% if section.settings.desc_clr != blank %}
    .portiablity-meets-section__{{ section.id }} .portiablity-meets-description {color: {{ section.settings.desc_clr }};}
  {% endif %}

  {% if section.settings.cardClr != blank %}
    .portiablity-meets-section__{{ section.id }} .portiablity-meets-slide-card { background: {{ section.settings.cardClr }}; }
  {% endif %}

  {% if section.settings.icon_white %}
    .portiablity-meets-section__{{ section.id }} .horizon-slider_container.portiablity-meets-slider .prev-btn::after,
    .portiablity-meets-section__{{ section.id }} .horizon-slider_container.portiablity-meets-slider .next-btn::after,
    .portiablity-meets-section__{{ section.id }} .next-btn::after, .portiablity-meets-section__{{- section.id }} .prev-btn::after { filter: inherit; }
  {% endif %}

  {% if section.settings.heading_clr != blank  %}
  .portiablity-meets-section__{{ section.id }} .slider-heading {color: {{ section.settings.heading_clr | default: '#fff' }}}
  {% endif %}
  
   {%- for block in section.blocks -%}
  {% if section.settings.desc_order != blank %}
  .portiablity-meets-slider__slide--{{ forloop.index }} .has_layout-change .portiablity-meets-slide-desc { order: {{section.settings.desc_order}}; }
  {% endif %}
  {% endfor %}

{% if section.settings.hero_heading_top != blank %}

  .portiablity-meets-heading.portiablity-meets-heading--top {
  margin-bottom: clamp(30px,3.8vw,70px);
}
{% endif %}
</style>

{% if section.blocks.size > 0 %}
  <script>
     document.addEventListener('DOMContentLoaded', () => {
      if (typeof horizonSlider !== 'function') return;

      {% comment %} const sliderSelector = '.portiablity-meets-section__{{ section.id }} .portiablity-meets-slider'; {% endcomment %}
      const sliderSelector = '.portiablity-meets-slider';
      const prod = window.location.pathname === '/products/player-pro'

      const showArrowsOnMobile = {{ section.settings.show_arrow | json }};

      horizonSlider({
        [sliderSelector]: {
          loop: true,
          margin: 30,
          nav: true,                      // base value — we'll override in responsive
          showTracker: false,
          autoplay: false,
          drag: false,

          responsive: {
            0: {
              items: 1,
              nav: showArrowsOnMobile,    // ← controlled by checkbox on mobile
              drag: true,
              margin: 20                  // optional: smaller margin on very small screens
            },
            640: {
              items: 2,
              drag: true,
              nav: showArrowsOnMobile,
              margin: 30
            },
            861: {                        // ← important: after 860px we force hide
              items: prod ? 4 : 3,
              nav: false,                   // always hide arrows on desktop
              margin: 50
            }
          }
        }
      });
    });
  </script>
{% endif %}

{% schema %}
{
  "name": "Portiablity Platform",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Hero Section (Dark)"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon"
    },
    {
      "type": "textarea",
      "id": "hero_heading_top",
      "label": "Hero Heading Top HTML",
    },
    {
      "type": "textarea",
      "id": "hero_heading",
      "label": "Hero Heading HTML",
      "default": "PORTABILITY MEETS PERFORMANCE."
    },
    {
      "type": "checkbox",
      "id": "hero_heading_image_enable",
      "label": "Check This To Upload Image As Title"
    },
    {
      "type": "image_picker",
      "id": "hero_heading_image",
      "label": "Tile Image",
      "visible_if": "{{ section.settings.hero_heading_image_enable }}"
    },
    {
      "type": "checkbox",
      "id": "heading_small",
      "label": "Check This To Make Text Small"
    },

    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "richtext",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "<p>Blue Tees’ first ever portable launch monitor, Rainmaker, blends pro-level data with the simplicity golfers actually want. Built for the range, the backyard, the sim bay — and every moment in between.</p>"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Add Note"
    },
    {
      "type": "checkbox",
      "id": "desc_large",
      "label": "Check This To Make Width Large"
    },
    {
      "type": "color",
      "id": "desc_clr",
      "label": "Change color for Description",
      "alpha": true,
      "default": "#fff"
    },
    {
      "type": "image_picker",
      "id": "hero_main_image",
      "label": "Hero Main Image Desktop"
    },
    {
      "type": "image_picker",
      "id": "hero_main_image_mobile",
      "label": "Hero Main Image Phone"
    },
    {
      "type": "checkbox",
      "id": "hero_main_image_large",
      "label": "Check This To Set Image As Full Width"
    },
    {
      "type": "checkbox",
      "id": "hero_main_image_large_top",
      "label": "Check This To Set Image As Full Width With Padding"
    },
    {
      "type": "checkbox",
      "id": "hero_main_image_fill_top",
      "label": "Check This To Set Image As Full Width Without Padding"
    },
    {
      "type": "checkbox",
      "id": "hero_main_image_full_mobile",
      "label": "Check This To Set Image As Full Height In Mobile"
    },
    {
      "type": "checkbox",
      "id": "container",
      "label": "Add Container"
    },
    {
      "type": "color",
      "id": "bg_color_top",
      "label": "Top Background Color",
      "default": "#000000",
      "alpha": true
    },
    {
      "type": "color_background",
      "id": "bg_content_clr",
      "label": "Content Background Color"
    },
    {
      "type": "color",
      "id": "textColor",
      "label": "Text Color",
      "alpha": true,
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "cardClr",
      "label": "Slider Card Color",
      "alpha": true
    },
    {
      "type": "image_picker",
      "id": "bgImage",
      "label": "Background Image"
    },
    {
      "type": "textarea",
      "id": "slider_heading",
      "label": "Slider Heading HTML",
      "default": "3 Standalone Modes"
    },
    {
      "type": "richtext",
      "id": "slider_description",
      "label": "Slider Description",
      "default": "<p>Rainmaker comes equipped with 3 stand-alone offline modes; Practice, Target Distance, and Swing Speed to ensure you can always get the most out of your training —anytime, anywhere.</p>"
    },
    {
      "type": "checkbox",
      "id": "extra_space",
      "label": "Add Extra Space To Slider Items"
    },
    {
      "type": "checkbox",
      "id": "image_space",
      "label": "Add Extra Space To Slider Items Images"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Check this to just get arrown in mobile e.g >= 860px"
    },
    {
      "type": "color",
      "id": "heading_clr",
      "label": "Heading Color",
      "default": "#fff"
    },
    {
      "type": "checkbox",
      "id": "icon_white",
      "label": "Change Arrow Color"
    },
    {
      "type": "checkbox",
      "id": "layout_change",
      "label": "Change Layout For Items"
    },
    {
      "type": "select",
      "id": "desc_order",
      "label": "Description Position",
      "options": [
        {
          "value": "0",
          "label": "Default"
        },
        {
          "value": "-1",
          "label": "top"
        },
        {
          "value": "1",
          "label": "Bottom"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "feature_slide",
      "name": "Feature Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "slide-icon",
          "label": "Slide Icon"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Understand where you're gaining strokes..."
        },
        {
          "type": "html",
          "id": "title",
          "label": "Title",
          "default": "AI-DRIVEN INSIGHTS"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Portiablity Platform",
      "blocks": [{ "type": "feature_slide" }, { "type": "feature_slide" }, { "type": "feature_slide" }]
    }
  ]
}
{% endschema %} {% endcomment %}
