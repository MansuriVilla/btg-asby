                          block.settings.image
                          | image_url: width: 560
                          | image_tag: alt: block.settings.title
                          | strip
                          | default: 'Slide image',
                            loading: section_loading,
                            fetchpriority: section_fetchpriority,
                            widths: '300,400,500,600,800,1000,1200,1600',
                            sizes: '(max-width: 480px) 100vw, (max-width: 768px) 75vw, 50vw',
                            height: block.settings.image.height,
                            width: block.settings.image.width
                        }}
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  {% if section.settings.textColor != blank %}
    .portiablity-meets-section__{{ section.id }} :is(.portiablity-meets-heading, .portiablity-meets-slide-title,
    .portiablity-meets-slide-desc ){ color: {{ section.settings.textColor }};}
  {% endif %}


  {% if section.settings.bgImage != blank %}
    .portiablity-meets-section__{{ section.id }} .portiablity-meets-content .portiablity-meets_mockup{ background:url( {{- section.settings.bgImage | image_url -}} ) center center / cover no-repeat; width: 100%; height: 100%;}
  {% endif %}

  @media only screen and (min-width:1921px){
    {% if section.settings.bgImage != blank %}
      .portiablity-meets-section__{{ section.id }} .portiablity-meets-content .portiablity-meets_mockup{ background-size:contain;}
    {% endif %}
  }

  {% if section.settings.bg_content_clr != blank %}
    .portiablity-meets-section__{{ section.id }} .portiablity-meets-content{ background: {{- section.settings.bg_content_clr -}} ;}
  {% endif %}

  {% if section.settings.desc_clr != blank %}
    .portiablity-meets-section__{{ section.id }} .portiablity-meets-description {color: {{ section.settings.desc_clr }};}
  {% endif %}

  {% if section.settings.cardClr != blank %}
    .portiablity-meets-section__{{ section.id }} .portiablity-meets-slide-card { background: {{ section.settings.cardClr }}; }
  {% endif %}

  {% if section.settings.icon_white %}
    .portiablity-meets-section__{{ section.id }} .horizon-slider_container.portiablity-meets-slider .prev-btn::after,
    .portiablity-meets-section__{{ section.id }} .horizon-slider_container.portiablity-meets-slider .next-btn::after,
    .portiablity-meets-section__{{ section.id }} .next-btn::after, .portiablity-meets-section__{{- section.id }} .prev-btn::after { filter: inherit; }
  {% endif %}

  {% if section.settings.heading_clr != blank  %}
  .portiablity-meets-section__{{ section.id }} .slider-heading {color: {{ section.settings.heading_clr | default: '#fff' }}}
  {% endif %}
  
   {%- for block in section.blocks -%}
  {% if section.settings.desc_order != blank %}
  .portiablity-meets-slider__slide--{{ forloop.index }} .has_layout-change .portiablity-meets-slide-desc { order: {{section.settings.desc_order}}; }
  {% endif %}
  {% endfor %}

{% if section.settings.hero_heading_top != blank %}

  .portiablity-meets-heading.portiablity-meets-heading--top {
  margin-bottom: clamp(30px,3.8vw,70px);
}
{% endif %}
</style>

{% if section.blocks.size > 0 %}
  <script>
     document.addEventListener('DOMContentLoaded', () => {
      if (typeof horizonSlider !== 'function') return;

      {% comment %} const sliderSelector = '.portiablity-meets-section__{{ section.id }} .portiablity-meets-slider'; {% endcomment %}
      const sliderSelector = '.portiablity-meets-slider';
      const prod = window.location.pathname === '/products/player-pro'

      const showArrowsOnMobile = {{ section.settings.show_arrow | json }};

      horizonSlider({
        [sliderSelector]: {
          loop: true,
          margin: 30,
          nav: true,                      // base value — we'll override in responsive
          showTracker: false,
          autoplay: false,
          drag: false,

          responsive: {
            0: {
              items: 1,
              nav: showArrowsOnMobile,    // ← controlled by checkbox on mobile
              drag: true,
              margin: 20                  // optional: smaller margin on very small screens
            },
            640: {
              items: 2,
              drag: true,
              nav: showArrowsOnMobile,
              margin: 30
            },
            861: {                        // ← important: after 860px we force hide
              items: prod ? 4 : 3,
              nav: false,                   // always hide arrows on desktop
              margin: 50
            }
          }
        }
      });
    });
  </script>
{% endif %}

