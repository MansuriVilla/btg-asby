          var targetX = 0;
          var targetY = rowY;
          var targetScale = 1;
          var targetZ = 1;
          var targetW = sideW;
          var targetH = sideH;
          var targetR = sideR;
  
          if (diff === 0) {
            // Center: the SAME card travels into the device screen cutout
            targetOpacity = 1;
            targetX = activeX;
            targetW = activeW;
            targetH = activeH;
            targetR = activeR;
            targetZ = 1;
          } else if (diff === -1) {
            targetOpacity = 0.55;
            targetX = activeX - spacing1;
            targetZ = 2;
          } else if (diff === 1) {
            targetOpacity = 0.55;
            targetX = activeX + spacing1;
            targetZ = 2;
          } else if (diff === -2) {
            targetOpacity = 0.25;
            targetX = activeX - spacing2;
            targetZ = 1;
          } else if (diff === 2) {
            targetOpacity = 0.25;
            targetX = activeX + spacing2;
            targetZ = 1;
          } else if (diff < -2) {
            targetOpacity = 0;
            targetX = activeX - spacing2 - activeW;
            targetZ = 0;
          } else if (diff > 2) {
            targetOpacity = 0;
            targetX = activeX + spacing2 + activeW;
            targetZ = 0;
          }
  
          if (isOverlap) {
            // Centre screen sits behind the device frame (inside the cutout); neighbours sit above it
            targetZ = diff === 0 ? 0 : (isOffscreenNow ? 0 : 2);
          }

          if (isTranslucentActive) {
            // Centre screen is see-through so the static image behind it shows
            item.style.background = diff === 0 ? 'transparent' : '';
            if (diff === 0) targetOpacity = 0.5;
          }

          item.style.pointerEvents = (isOffscreenNow || diff === 0) ? 'none' : 'auto';
  
          var wrappedBehind = (prevDiff !== undefined && Math.abs(diff - prevDiff) > 3);
          var shouldInstantReposition = !animate || wrappedBehind || (isOffscreenNow && wasOffscreenBefore);
          var entryX = diff < 0 ? (activeX - spacing2 - activeW) : (activeX + spacing2 + activeW);
  
          function tf(x, y) {
            return 'translate3d(calc(-50% + ' + x + 'px), calc(-50% + ' + y + 'px), 0) scale(' + targetScale + ')';
          }
  
          if (window.gsap) {
            var vars = {
              opacity: targetOpacity,
              xPercent: -50,
              yPercent: -50,
              x: targetX,
              y: targetY,
              width: targetW,
              height: targetH,
              borderRadius: targetR,
              scale: targetScale,
              zIndex: targetZ,
              overwrite: 'auto'
            };
            if (wrappedBehind && !isOffscreenNow) {
              gsap.set(item, { opacity: 0, xPercent: -50, yPercent: -50, x: entryX, y: rowY, width: sideW, height: sideH, borderRadius: sideR, scale: 1, zIndex: 0, overwrite: 'auto' });
              vars.duration = 0.5;
              vars.ease = 'power3.out';
