{%- liquid
  assign bg_color = section.settings.bg_color | default: '#1B1E22'
  assign has_gradient = false
  if section.settings.gradient_bg != blank
    assign has_gradient = true
  endif
  assign section_id = section.settings.custom_section_id | default: ''
  if section_id == blank
    assign section_id = 'CompScreenShowcase-' | append: section.id
  endif
  assign screen_ratio = section.settings.screen_ratio | default: 'square'
-%}

<div
  id="{{ section_id }}"
  class="comp-screen-showcase section-{{ section.id }} comp-screen-showcase--ratio-{{ screen_ratio }}"
  style="
    --css-bg-color: {{ bg_color }};
    {% if has_gradient %}--css-bg-gradient: {{ section.settings.gradient_bg }};{% endif %}
    --css-padding-top: {{ section.settings.padding_top | default: 60 }}px;
    --css-padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    --css-max-width: {{ section.settings.max_width | default: 1440 }}px;
    --css-screen-top: {{ section.settings.screen_top | default: 18 }}%;
    --css-screen-left: {{ section.settings.screen_left | default: 24 }}%;
    --css-screen-width: {{ section.settings.screen_width | default: 52 }}%;
    --css-screen-height: {{ section.settings.screen_height | default: 64 }}%;
    --css-screen-radius: {{ section.settings.screen_radius | default: 12 }}px;
    --css-mockup-width: {% if section.settings.custom_mockup_width %}{{ section.settings.mockup_width | default: 320 }}px{% else %}320px{% endif %};
    --css-mockup-width-mobile: {% if section.settings.custom_mockup_width %}{{ section.settings.mockup_width_mobile | default: 250 }}px{% else %}250px{% endif %};
    --css-feature-margin-top: {{ section.settings.feature_margin_top | default: -270 }}px;
    --css-feature-margin-top-mobile: {{ section.settings.feature_margin_top_mobile | default: 30 }}px;
    --css-header-margin-bottom: {{ section.settings.header_margin_bottom | default: -170 }}px;
    --css-header-margin-bottom-mobile: {{ section.settings.header_margin_bottom_mobile | default: 0 }}px;
    --css-screen-spacing: {% if section.settings.custom_screen_spacing %}{{ section.settings.screen_spacing | default: 280 }}px{% else %}default{% endif %};
    --css-screen-spacing-mobile: {% if section.settings.custom_screen_spacing %}{{ section.settings.screen_spacing_mobile | default: 140 }}px{% else %}default{% endif %};
  ">
  <div class="comp-screen-showcase__container">
    <!-- Top Header -->
    <div class="comp-screen-showcase__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="comp-screen-showcase__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="comp-screen-showcase__desc">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <!-- Upper Interactive Stage: Device Mockup + Sliding Screens -->
    <div class="comp-screen-showcase__stage" data-stage>
      <!-- Navigation Arrows -->
      <button
        type="button"
        class="comp-screen-showcase__arrow comp-screen-showcase__arrow--prev"
        data-arrow-prev
        aria-label="Previous screen">
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true">
          <path
            d="M12.5 15L7.5 10L12.5 5"
            stroke="#000000"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round" />
        </svg>
      </button>

      <button
        type="button"
        class="comp-screen-showcase__arrow comp-screen-showcase__arrow--next"
        data-arrow-next
        aria-label="Next screen">
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          aria-hidden="true">
          <path
            d="M7.5 5L12.5 10L7.5 15"
            stroke="#000000"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round" />
        </svg>
      </button>

      <!-- Center Device Frame with Screen Mask -->
      <div class="comp-screen-showcase__device-wrap" data-device-wrap>

        <!-- Outer Product Image with Cutout (Overlay frame sitting on top) -->
        {%- if section.settings.product_cutout_image != blank -%}
          {%- assign frame_alt = section.settings.heading | default: 'Player Pro' | escape -%}
          {{ section.settings.product_cutout_image
 | image_url: width: 1400
 | image_tag:
 loading: 'lazy',
 decoding: 'async',
 widths: '400, 600, 800, 1100, 1400',
 sizes: '(max-width: 768px) 90vw, 700px',
 class: 'comp-screen-showcase__device-frame',
 alt: frame_alt,
 data-device-frame: ''
          }}
        {%- else -%}
          <div class="comp-screen-showcase__device-frame-fallback"></div>
        {%- endif -%}
      </div>

      <!-- Single unified sliding screens list -->
      <div class="comp-screen-showcase__ambient-screens" data-ambient-screens>
        {%- for block in section.blocks -%}
          <div
            class="comp-screen-showcase__ambient-item"
            data-ambient-item
            data-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}>
            {%- if block.settings.screen_image != blank -%}
              {{ block.settings.screen_image
 | image_url: width: 600
 | image_tag:
 loading: 'lazy',
 class: 'comp-screen-showcase__ambient-img',
 alt: block.settings.feature_title | escape
              }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    <!-- Bottom Detail Feature Card (2 Columns: Left Video/Media, Right Copy) -->
    <div class="comp-screen-showcase__feature-wrap">
      {%- for block in section.blocks -%}
        <div
          class="comp-screen-showcase__feature-card{% if forloop.first %} is-active{% endif %}"
          data-feature-card
          data-index="{{ forloop.index0 }}">
          <!-- Left: Media Box -->
          <div class="comp-screen-showcase__feature-media">
            {%- if block.settings.feature_video != blank -%}
              {% render 'comp-video-player'
                ,
 video: block.settings.feature_video
                ,
 poster: block.settings.feature_image
                ,
 is_active: forloop.first
                ,
 title: block.settings.feature_title
                ,
 video_class: 'comp-screen-showcase__feature-video'
                ,
 data_attr: 'data-feature-video'
                ,
 controls_variant: 'buttonsonly'
                ,
 show_mute: false
              %}
            {%- elsif block.settings.feature_image != blank -%}
              {{ block.settings.feature_image
 | image_url: width: 1000
 | image_tag:
 loading: 'lazy',
 class: 'comp-screen-showcase__feature-img',
 alt: block.settings.feature_title,
 widths: '400, 600, 800, 1000'
              }}
            {%- else -%}
              <div class="comp-screen-showcase__feature-media-placeholder"></div>
            {%- endif -%}
          </div>

          <!-- Right: Text Content -->
          <div class="comp-screen-showcase__feature-content">
            {%- if block.settings.feature_title != blank -%}
              <h3 class="comp-screen-showcase__feature-title custom_heading">{{ block.settings.feature_title }}</h3>
            {%- endif -%}
            {%- if block.settings.feature_description != blank -%}
              <div class="comp-screen-showcase__feature-text">{{ block.settings.feature_description }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .comp-screen-showcase .comp-video-control-btn {
    all: unset;
    box-sizing: border-box !important;
    width: 32px !important;
    height: 32px !important;
    min-width: 32px !important;
    max-width: 32px !important;
    min-height: 32px !important;
    max-height: 32px !important;
    border-radius: 50% !important;
    background: rgba(27, 30, 34, 0.65) !important;
    backdrop-filter: blur(8px) !important;
    -webkit-backdrop-filter: blur(8px) !important;
    border: 1px solid rgba(255, 255, 255, 0.22) !important;
    color: #ffffff !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    padding: 0 !important;
    margin: 0 !important;
    line-height: 1 !important;
    letter-spacing: normal !important;
    transition: transform 0.2s ease
    , background-color 0.2s ease !important;
    outline: none !important;
    overflow: hidden !important;
    position: relative !important;
    vertical-align: middle !important;
    -webkit-appearance: none !important;
    appearance: none !important;
    pointer-events: auto !important;
  }
  .comp-screen-showcase .comp-video-control-btn::before,
  .comp-screen-showcase .comp-video-control-btn::after {
    display: none !important;
    content: none !important;
  }
  .comp-screen-showcase .comp-video-control-btn:hover {
    transform: scale(1.08) !important;
    background: rgba(27, 30, 34, 0.9) !important;
    border-color: rgba(255, 255, 255, 0.4) !important;
  }
  .comp-screen-showcase .comp-video-control-btn svg {
    pointer-events: none !important;
    flex-shrink: 0 !important;
    margin: 0 !important;
  }

  .comp-screen-showcase {
    position: relative;
    width: 100%;
    background: var(--css-bg-color);
    {% if has_gradient %}
      background: var(--css-bg-gradient);
    {% endif %}
    padding-top: clamp(30px, 6vw, var(--css-padding-top));
    padding-bottom: clamp(30px, 6vw, var(--css-padding-bottom));
    box-sizing: border-box;
    overflow: hidden;
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .comp-screen-showcase {
      padding-top: 30px;
      padding-bottom: 30px;
    }
  }

  .comp-screen-showcase__container {
    width: 100%;
    max-width: var(--css-max-width);
    margin: 0 auto;
    padding: 0 clamp(16px, 2.5vw, 36px);
    box-sizing: border-box;
  }

  /* Header */
  .comp-screen-showcase__header {
    text-align: center;
    max-width: 718px;
    margin: 0 auto var(--css-header-margin-bottom);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
    z-index: 2;
    position: relative;
    background: linear-gradient(180deg, var(--css-bg-color), transparent);
  }

  .comp-screen-showcase__title {
    font-family: 'Blue Tees Headline Italic'
    , sans-serif;
    font-size: clamp(28px, 3.2vw, 42px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
  }

  .comp-screen-showcase__desc {
    font-family: 'Blue Tees Paragraph'
    , sans-serif;
    font-size: clamp(14px, 1.15vw, 16px);
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: #ffffff;
    max-width: 612px;
    margin: 0 auto;
    opacity: 0.9;
  }

  /* Stage */
  .comp-screen-showcase__stage {
    position: relative;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: clamp(380px, 42vw, 520px);
  }

  /* Device Wrap with Cutout */
  .comp-screen-showcase__device-wrap {
    position: relative;
    width: var(--css-mockup-width);
    max-width: 90vw;
    aspect-ratio: 1 / 2.28;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .comp-screen-showcase__device-wrap--hidden {
    pointer-events: none;
    border: none !important;
    background: transparent !important;
  }


  /* Overlay Device Mockup Frame */
  .comp-screen-showcase__device-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    z-index: 3;
    {% comment %} filter: drop-shadow(0 20px 45px rgba(0, 0, 0, 0.7));
  {% endcomment %}
}

.comp-screen-showcase__device-frame-fallback {
  position: absolute;
  inset: 0;
  border-radius: 36px;
  border: 12px solid #1a222c;
  {% comment %} box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.1)
  , 0 24px 60px rgba(0, 0, 0, 0.8);
{% endcomment %}
pointer-events: none;
z-index: 3;
}

/* Single continuous sliding screens list */
.comp-screen-showcase__ambient-screens {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Ambient sliding cards: 165px wide, aspect-ratio 185/247 */
.comp-screen-showcase__ambient-item {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 165px;
  aspect-ratio: 185 / 247;
  border-radius: 7px;
  overflow: hidden;
  background: #111418;
  opacity: 0;
  filter: none;
  cursor: pointer;
  pointer-events: auto;
  will-change: transform
  , opacity;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1)
  , width 0.45s cubic-bezier(0.2, 0.8, 0.2, 1)
  , height 0.45s cubic-bezier(0.2, 0.8, 0.2, 1)
  , border-radius 0.45s ease
  , opacity 0.4s ease;
}

.comp-screen-showcase__ambient-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius: inherit;
}


/*

   .comp-screen-showcase--ratio-landscape .comp-screen-showcase__device-wrap { 
   aspect-ratio: 16 / 9; 
   } 
*/
.comp-screen-showcase--ratio-landscape .comp-screen-showcase__ambient-item {
  aspect-ratio: 16 / 9;
}

{% comment %} .comp-screen-showcase--ratio-circle .comp-screen-showcase__device-wrap {
  aspect-ratio: 1 / 1;
}
{% endcomment %}
.comp-screen-showcase--ratio-circle .comp-screen-showcase__ambient-item {
  aspect-ratio: 1 / 1;
  border-radius: 50%;
}

/* Arrows: Figma 44x44px round white pill */
.comp-screen-showcase__arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 5;
  width: 44px;
  height: 44px;
  border-radius: 1000px;
  background: #ffffff;
  border: none;
  color: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  transition: transform 0.2s ease
  , background 0.2s ease;
}
.comp-screen-showcase__arrow:hover {
  transform: translateY(-50%) scale(1.08);
  background: #f5f5f5;
}
.comp-screen-showcase__arrow--prev {
  left: clamp(2px, 1.5vw, 24px);
}
.comp-screen-showcase__arrow--next {
  right: clamp(2px, 1.5vw, 24px);
}

/* Feature Card at Bottom: Figma 843px x 324px, #1B2029 background, 10px radius */
.comp-screen-showcase__feature-wrap {
  position: relative;
  width: 100%;
  max-width: 843px;
  margin: var(--css-feature-margin-top) auto 0;
  z-index: 2;
  min-height: 324px;
}

.comp-screen-showcase__feature-card {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  /* gap: clamp(15px, 2vw, 24px); */
  align-items: center;
  background: #1B2029;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 10px;
  overflow: hidden;
  /* box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5); */
  opacity: 0;
  pointer-events: none;
  transform: none;
  transition: opacity 0.4s ease;
}
.comp-screen-showcase__feature-card.is-active {
  position: relative;
  opacity: 1;
  pointer-events: auto;
  transform: none;
}

.comp-screen-showcase__feature-media {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 324px;
  background: #000000;
  overflow: hidden;
}

.comp-screen-showcase__feature-video,
.comp-screen-showcase__feature-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.comp-screen-showcase__feature-media-placeholder {
  width: 100%;
  height: 100%;
  background: #202732;
}

/* Button Glass inside video: 30x30px, radius 100px */
.comp-screen-showcase__media-btn {
  position: absolute;
  bottom: 14px;
  left: 14px;
  width: 30px;
  height: 30px;
  border-radius: 100px;
  background: rgba(27, 30, 34, 0.4);
  backdrop-filter: blur(8px);
  border: 1px solid #474646;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 2;
  transition: transform 0.2s ease
  , background 0.2s ease;
}
.comp-screen-showcase__media-btn:hover {
  transform: scale(1.1);
  background: rgba(27, 30, 34, 0.7);
}

/* Right Text: Frame 1410105716, 329px max-width */
.comp-screen-showcase__feature-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: clamp(16px, 1.7vw, 24px) clamp(20px, 2.5vw, 36px);
  gap: 12px;
}

.comp-screen-showcase__feature-title {
  /* font-family: 'Blue Tees Subhead', sans-serif; */
  font-size: clamp(18px, 1.8vw, 20px);
  text-transform: uppercase;
  line-height: 1.2;
  letter-spacing: -0.02em;
  color: #ffffff;
  margin: 0;
}

.comp-screen-showcase__feature-text {
  font-family: 'Blue Tees Paragraph'
  , sans-serif;
  font-size: 16px;
  line-height: 1.55;
  letter-spacing: 0.02em;
  color: #ffffff;
  margin: 0;
}

@media (max-width: 991px) {
  .comp-screen-showcase__header {
    margin-bottom: calc(var(--css-header-margin-bottom) * 0.75);
  }
  .comp-screen-showcase__stage {
    min-height: clamp(340px, 46vw, 440px);
  }
  .comp-screen-showcase__feature-wrap {
    margin-top: var(--css-feature-margin-top-mobile);
  }
}

@media (max-width: 860px) {
  .comp-screen-showcase__header {
    margin-bottom: var(--css-header-margin-bottom-mobile);
  }
  .comp-screen-showcase__stage {
    min-height: 360px;
  }
  .comp-screen-showcase__device-wrap {
    width: var(--css-mockup-width-mobile);
  }
  .comp-screen-showcase__ambient-item {
    top: 50%;
    width: 135px;
  }
  .comp-screen-showcase__arrow--prev {
    left: 6px;
  }
  .comp-screen-showcase__arrow--next {
    right: 6px;
  }


  /*

   .comp-screen-showcase__feature-wrap { 
   margin-top: 24px; 
   } 
*/
  .comp-screen-showcase__feature-card {
    grid-template-columns: 1fr;
    min-height: auto;
  }
  .comp-screen-showcase__feature-media {
    min-height: 220px;
    aspect-ratio: 16 / 10;
  };


  /*

   .comp-screen-showcase__feature-content { 
   padding: 20px 20px 24px; 
   } 
*/
}
</style>

<script>
  (function () {
    function initScreenShowcase() {
      var root = document.getElementById('{{ section_id }}') || document.querySelector('.comp-screen-showcase.section-{{ section.id }}');
      if (!root) return;
  
      var ambientContainer = root.querySelector('[data-ambient-screens]');
      var originalItems = Array.from(root.querySelectorAll('[data-ambient-item]'));
      var featureCards = Array.from(root.querySelectorAll('[data-feature-card]'));
      var prevBtn = root.querySelector('[data-arrow-prev]');
      var nextBtn = root.querySelector('[data-arrow-next]');
  
      if (originalItems.length === 0) return;
  
      var realTotal = originalItems.length;
      var ambientItems = originalItems.slice();
  
      // Ensure at least 7 items in the loop pool so positions -2, -1, 0, +1, +2
      // always have dedicated off-screen buffer items that wrap invisibly in the background
      if (ambientContainer && realTotal > 0 && ambientItems.length < 7) {
        var frag = document.createDocumentFragment();
        while (ambientItems.length < 7) {
          for (var c = 0; c < realTotal; c++) {
            var clone = originalItems[c].cloneNode(true);
            clone.removeAttribute('id');
            var cloneImg = clone.querySelector('img');
            if (cloneImg) {
              cloneImg.decoding = 'async';
            }
            frag.appendChild(clone);
            ambientItems.push(clone);
          }
        }
        ambientContainer.appendChild(frag);
      }
  
      // If GSAP is loaded, disable native CSS transitions on ambient items to prevent dual-engine conflicts
      if (window.gsap) {
        ambientItems.forEach(function (item) {
          item.style.transition = 'none';
        });
      }
  
      var poolTotal = ambientItems.length;
      var virtualIndex = 0;
      var currentIndex = 0;
  
      function getWrappedDiff(itemIdx, activeVirtualIdx) {
        var diff = (itemIdx - activeVirtualIdx) % poolTotal;
        if (diff > poolTotal / 2) diff -= poolTotal;
        if (diff <= -poolTotal / 2) diff += poolTotal;
        return diff;
      }
  
      function updateAmbientDepth(activeVirtualIdx, animate) {
        if (ambientItems.length === 0) return;
  
        var vw = window.innerWidth;
        var isMobile = vw <= 768;
        var csVal = getComputedStyle(root);
        var customSpacingDesk = csVal.getPropertyValue('--css-screen-spacing').trim();
        var customSpacingMob = csVal.getPropertyValue('--css-screen-spacing-mobile').trim();
        var userSpacing = null;
        if (isMobile && customSpacingMob && customSpacingMob !== 'default') {
          userSpacing = parseFloat(customSpacingMob);
        } else if (!isMobile && customSpacingDesk && customSpacingDesk !== 'default') {
          var baseDesk = parseFloat(customSpacingDesk);
          userSpacing = vw <= 1024 ? Math.round(baseDesk * 0.78) : (vw <= 1300 ? Math.round(baseDesk * 0.91) : baseDesk);
        }
        var spacing1 = userSpacing !== null ? userSpacing : (isMobile ? 140 : (vw <= 1024 ? 220 : (vw <= 1300 ? 255 : 280)));
        var spacing2 = userSpacing !== null ? Math.round(spacing1 * 1.9) : (isMobile ? 260 : (vw <= 1024 ? 410 : (vw <= 1300 ? 485 : 535)));
  
        var cRect = ambientContainer.getBoundingClientRect();
        var deviceWrap = root.querySelector('[data-device-wrap]');
        var wRect = deviceWrap.getBoundingClientRect();
        var cs = getComputedStyle(root);
        var pTop = parseFloat(cs.getPropertyValue('--css-screen-top')) || 0;
        var pLeft = parseFloat(cs.getPropertyValue('--css-screen-left')) || 0;
        var pW = parseFloat(cs.getPropertyValue('--css-screen-width')) || 50;
        var pH = parseFloat(cs.getPropertyValue('--css-screen-height')) || 50;
        var pR = parseFloat(cs.getPropertyValue('--css-screen-radius')) || 0;
        var isCircle = root.classList.contains('comp-screen-showcase--ratio-circle');
        var isLandscape = root.classList.contains('comp-screen-showcase--ratio-landscape');
        var activeW = wRect.width * pW / 100;
        var activeH = wRect.height * pH / 100;
        if (isCircle) {
          // In circle mode, height must equal width so circles remain perfectly round (1:1) even if device wrap is tall
          var circleSize = activeW;
          activeW = circleSize;
          activeH = circleSize;
        }
        var activeR = isCircle ? '50%' : pR + 'px';
        var sideW = activeW;
        var sideH = activeH;
        var sideR = activeR;
        // When custom spacing is not set, keep neighbours from overlapping the active screen if it is wide
        if (userSpacing === null) {
          spacing1 = Math.max(spacing1, activeW + 24);
          spacing2 = Math.max(spacing2, spacing1 + activeW + 24);
        }
        var activeCx = (wRect.left - cRect.left) + wRect.width * (pLeft + pW / 2) / 100;
        var activeCy = (wRect.top - cRect.top) + wRect.height * (pTop + pH / 2) / 100;
        var activeX = activeCx - cRect.width / 2;
        var baseTopPx = parseFloat(getComputedStyle(ambientItems[0]).top) || (cRect.height * 0.5);
        var rowY = activeCy - baseTopPx;
  
        ambientItems.forEach(function (item, i) {
          var diff = getWrappedDiff(i, activeVirtualIdx);
          var prevDiff = item._prevDiff;
          item._prevDiff = diff;
  
          var isActive = (diff === 0);
          if (item._wasActive !== isActive) {
            item.classList.toggle('is-active', isActive);
            item._wasActive = isActive;
          }
          item._diff = diff;
  
          var isOffscreenNow = Math.abs(diff) > 2;
          var wasOffscreenBefore = prevDiff !== undefined && Math.abs(prevDiff) > 2;
  
          // Optimization: skip style/GSAP updates for items that stay hidden off-screen
          if (animate && isOffscreenNow && wasOffscreenBefore) {
            return;
          }
  
          var targetOpacity = 0;
          var targetX = 0;
          var targetY = rowY;
          var targetScale = 1;
          var targetZ = 1;
          var targetW = sideW;
          var targetH = sideH;
          var targetR = sideR;
  
          if (diff === 0) {
            // Center: the SAME card travels into the device screen cutout
            targetOpacity = 1;
            targetX = activeX;
            targetW = activeW;
            targetH = activeH;
            targetR = activeR;
            targetZ = 1;
          } else if (diff === -1) {
            targetOpacity = 0.55;
            targetX = activeX - spacing1;
            targetZ = 2;
          } else if (diff === 1) {
            targetOpacity = 0.55;
            targetX = activeX + spacing1;
            targetZ = 2;
          } else if (diff === -2) {
            targetOpacity = 0.25;
            targetX = activeX - spacing2;
            targetZ = 1;
          } else if (diff === 2) {
            targetOpacity = 0.25;
            targetX = activeX + spacing2;
            targetZ = 1;
          } else if (diff < -2) {
            targetOpacity = 0;
            targetX = activeX - spacing2 - activeW;
            targetZ = 0;
          } else if (diff > 2) {
            targetOpacity = 0;
            targetX = activeX + spacing2 + activeW;
            targetZ = 0;
          }
  
          item.style.pointerEvents = (isOffscreenNow || diff === 0) ? 'none' : 'auto';
  
          var wrappedBehind = (prevDiff !== undefined && Math.abs(diff - prevDiff) > 3);
          var shouldInstantReposition = !animate || wrappedBehind || (isOffscreenNow && wasOffscreenBefore);
          var entryX = diff < 0 ? (activeX - spacing2 - activeW) : (activeX + spacing2 + activeW);
  
          function tf(x, y) {
            return 'translate3d(calc(-50% + ' + x + 'px), calc(-50% + ' + y + 'px), 0) scale(' + targetScale + ')';
          }
  
          if (window.gsap) {
            var vars = {
              opacity: targetOpacity,
              xPercent: -50,
              yPercent: -50,
              x: targetX,
              y: targetY,
              width: targetW,
              height: targetH,
              borderRadius: targetR,
              scale: targetScale,
              zIndex: targetZ,
              overwrite: 'auto'
            };
            if (wrappedBehind && !isOffscreenNow) {
              gsap.set(item, { opacity: 0, xPercent: -50, yPercent: -50, x: entryX, y: rowY, width: sideW, height: sideH, borderRadius: sideR, scale: 1, zIndex: 0, overwrite: 'auto' });
              vars.duration = 0.5;
              vars.ease = 'power3.out';
              gsap.to(item, vars);
            } else if (shouldInstantReposition) {
              gsap.set(item, vars);
            } else {
              vars.duration = 0.5;
              vars.ease = 'power3.out';
              gsap.to(item, vars);
            }
          } else {
            function applyFinal() {
              item.style.opacity = targetOpacity;
              item.style.width = targetW + 'px';
              item.style.height = targetH + 'px';
              item.style.borderRadius = targetR;
              item.style.transform = tf(targetX, targetY);
              item.style.zIndex = targetZ;
            }
            if (shouldInstantReposition && !(wrappedBehind && !isOffscreenNow)) {
              item.style.transition = 'none';
              applyFinal();
            } else if (wrappedBehind && !isOffscreenNow) {
              item.style.transition = 'none';
              item.style.opacity = 0;
              item.style.width = sideW + 'px';
              item.style.height = sideH + 'px';
              item.style.borderRadius = sideR;
              item.style.transform = tf(entryX, rowY);
              item.style.zIndex = 0;
              requestAnimationFrame(function () {
                item.style.transition = '';
                applyFinal();
              });
            } else {
              item.style.transition = '';
              applyFinal();
            }
          }
        });
      }
  
      function updateArrowStates() {
        if (prevBtn) {
          prevBtn.disabled = false;
          prevBtn.style.opacity = '1';
          prevBtn.style.pointerEvents = 'auto';
        }
        if (nextBtn) {
          nextBtn.disabled = false;
          nextBtn.style.opacity = '1';
          nextBtn.style.pointerEvents = 'auto';
        }
      }
  
  
  
      function stepBy(delta) {
        if (!delta) return;
        virtualIndex = ((virtualIndex + delta) % poolTotal + poolTotal) % poolTotal;
        var realIdx = parseInt(ambientItems[virtualIndex].getAttribute('data-index'), 10) || 0;
        currentIndex = realIdx;
        updateArrowStates();
  
        // Switch bottom feature card with cross-dissolve
        featureCards.forEach(function (card, i) {
          var isActive = (i === currentIndex);
          card.classList.toggle('is-active', isActive);
  
          var vid = card.querySelector('video');
          if (vid) {
            if (isActive) {
              if (!vid.src && vid.dataset.src) {
                vid.src = vid.dataset.src;
              }
              vid.removeAttribute('data-manual-paused');
              vid.currentTime = 0;
              vid.play().catch(function () {});
            } else {
              vid.pause();
            }
          }
        });
  
        updateAmbientDepth(virtualIndex, true);
      }
  
      // Track manual pause on videos
      featureCards.forEach(function(card) {
        var vid = card.querySelector('video');
        if (vid) {
          vid.addEventListener('pause', function() {
            // Ignore pauses triggered by the viewport observer / slide change
            if (vid._autoPaused) {
              vid._autoPaused = false;
              return;
            }
            // If user paused while this card is active, mark as manual paused
            if (card.classList.contains('is-active')) {
              vid.setAttribute('data-manual-paused', 'true');
            }
          });
          vid.addEventListener('play', function() {
            vid.removeAttribute('data-manual-paused');
          });
        }
      });
  
      // Intersection Observer: pause video when section leaves viewport for performance & battery savings
      if ('IntersectionObserver' in window) {
        var sectionObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            var activeCard = featureCards[currentIndex];
            var vid = activeCard ? activeCard.querySelector('video') : null;
            if (!vid) return;
  
            if (entry.isIntersecting) {
              if (vid.paused && !vid.hasAttribute('data-manual-paused')) {
                vid.play().catch(function () {});
              }
            } else {
              if (!vid.paused) {
                vid._autoPaused = true;
                vid.pause();
              }
            }
          });
        }, { threshold: 0.2 });
        sectionObserver.observe(root);
      }
  
      if (prevBtn) {
        prevBtn.addEventListener('click', function (e) {
          e.preventDefault();
          stepBy(-1);
        });
      }
  
      if (nextBtn) {
        nextBtn.addEventListener('click', function (e) {
          e.preventDefault();
          stepBy(1);
        });
      }
  
      // Event delegation for ambient items click to navigate
      if (ambientContainer) {
        ambientContainer.addEventListener('click', function (e) {
          var item = e.target.closest('[data-ambient-item]');
          if (!item) return;
          var diff = item._diff;
          if (typeof diff === 'number' && diff !== 0) {
            stepBy(diff);
          }
        });
      }
  
      // Swipe support for touch devices
      var touchStartX = 0;
      var stage = root.querySelector('[data-stage]');
      if (stage) {
        stage.addEventListener('touchstart', function (e) {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });
        stage.addEventListener('touchend', function (e) {
          var touchEndX = e.changedTouches[0].screenX;
          if (touchStartX - touchEndX > 45) {
            stepBy(1);
          } else if (touchEndX - touchStartX > 45) {
            stepBy(-1);
          }
        }, { passive: true });
      }
  
      updateAmbientDepth(0, false);
      updateArrowStates();
  
      var resizeRaf = null;
      window.addEventListener('resize', function () {
        if (resizeRaf) cancelAnimationFrame(resizeRaf);
        resizeRaf = requestAnimationFrame(function () {
          updateAmbientDepth(virtualIndex, false);
        });
      }, { passive: true });
    }
  
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initScreenShowcase);
    } else {
      initScreenShowcase();
    }
  })();
</script>

