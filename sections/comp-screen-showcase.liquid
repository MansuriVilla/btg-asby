        if (roDevice) ro.observe(roDevice);
      }
    }
  
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initScreenShowcase);
    } else {
      initScreenShowcase();
    }
  })();
</script>

