        var isMobile = vw <= 768;
        var csVal = getComputedStyle(root);
        var customSpacingDesk = csVal.getPropertyValue('--css-screen-spacing').trim();
        var customSpacingMob = csVal.getPropertyValue('--css-screen-spacing-mobile').trim();
