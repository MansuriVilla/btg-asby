        sectionObserver.observe(root);
      }
  
      if (prevBtn) {
        prevBtn.addEventListener('click', function (e) {
          e.preventDefault();
          stepBy(-1);
        });
      }
  
      if (nextBtn) {
        nextBtn.addEventListener('click', function (e) {
          e.preventDefault();
          stepBy(1);
        });
      }

      var featPrev = root.querySelector('[data-feature-prev]');
      var featNext = root.querySelector('[data-feature-next]');
      if (featPrev) {
        featPrev.addEventListener('click', function (e) {
          e.preventDefault();
          stepBy(-1);
        });
      }
      if (featNext) {
        featNext.addEventListener('click', function (e) {
          e.preventDefault();
          stepBy(1);
        });
      }
  
      // Event delegation for ambient items click to navigate
      if (ambientContainer) {
        ambientContainer.addEventListener('click', function (e) {
          var item = e.target.closest('[data-ambient-item]');
          if (!item) return;
          var diff = item._diff;
          if (typeof diff === 'number' && diff !== 0) {
            stepBy(diff);
          }
        });
      }
  
      // Swipe support for touch devices
      // Applies to both the screens stage and the feature tile below it
      var touchStartX = 0;
      var touchStartY = 0;
      var stage = root.querySelector('[data-stage]');
      var featureWrap = root.querySelector('.comp-screen-showcase__feature-wrap');
      [stage, featureWrap].forEach(function (swipeEl) {
