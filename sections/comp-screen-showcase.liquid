              });
            } else {
              item.style.transition = '';
              applyFinal();
            }
          }
        });
      }
  
      function updateArrowStates() {
        if (prevBtn) {
          prevBtn.disabled = false;
          prevBtn.style.opacity = '1';
          prevBtn.style.pointerEvents = 'auto';
        }
        if (nextBtn) {
          nextBtn.disabled = false;
          nextBtn.style.opacity = '1';
          nextBtn.style.pointerEvents = 'auto';
        }
      }
  
  
  
      function stepBy(delta) {
        if (!delta) return;
        virtualIndex = ((virtualIndex + delta) % poolTotal + poolTotal) % poolTotal;
        var realIdx = parseInt(ambientItems[virtualIndex].getAttribute('data-index'), 10) || 0;
        currentIndex = realIdx;
        updateArrowStates();
  
        // Switch bottom feature card with cross-dissolve
        featureCards.forEach(function (card, i) {
          var isActive = (i === currentIndex);
          card.classList.toggle('is-active', isActive);
  
          var vid = card.querySelector('video');
          if (vid) {
            if (isActive) {
              if (!vid.src && vid.dataset.src) {
                vid.src = vid.dataset.src;
              }
              vid.removeAttribute('data-manual-paused');
              vid.currentTime = 0;
              vid.play().catch(function () {});
            } else {
              vid.pause();
            }
          }
        });
  
        updateAmbientDepth(virtualIndex, true);
      }
  
      // Track manual pause on videos
      featureCards.forEach(function(card) {
        var vid = card.querySelector('video');
        if (vid) {
          vid.addEventListener('pause', function() {
