        var deviceWrap = root.querySelector('[data-device-wrap]');
        var wRect = deviceWrap.getBoundingClientRect();
        var cs = getComputedStyle(root);
        var pTop = parseFloat(cs.getPropertyValue('--css-screen-top')) || 0;
        var pLeft = parseFloat(cs.getPropertyValue('--css-screen-left')) || 0;
        var pW = parseFloat(cs.getPropertyValue('--css-screen-width')) || 50;
        var pH = parseFloat(cs.getPropertyValue('--css-screen-height')) || 50;
        var pR = parseFloat(cs.getPropertyValue('--css-screen-radius')) || 0;
        var isCircle = root.classList.contains('comp-screen-showcase--ratio-circle');
        var isLandscape = root.classList.contains('comp-screen-showcase--ratio-landscape');
        var activeW = wRect.width * pW / 100;
        var activeH = wRect.height * pH / 100;
        if (isCircle) {
          // In circle mode, height must equal width so circles remain perfectly round (1:1) even if device wrap is tall
          var circleSize = activeW;
          activeW = circleSize;
          activeH = circleSize;
        }
        var activeR = isCircle ? '50%' : pR + 'px';
        var isOverlap = root.classList.contains('comp-screen-showcase--overlap');
        var isTranslucentActive = root.classList.contains('comp-screen-showcase--translucent-active');
        var sideScale = isOverlap ? (parseFloat(cs.getPropertyValue('--css-side-scale')) || 0.78) : 1;
        var sideW = activeW * sideScale;
        var sideH = activeH * sideScale;
        var sideR = activeR;
        // When custom spacing is not set, keep neighbours from overlapping the active screen if it is wide
        if (userSpacing === null) {
          if (isOverlap) {
            // Neighbours sit tight against the centre screen so they overlap the device body
