<div class="aio-section aio-section__{{ page.handle }} aio-section__{{ section.id }}">
  <div class="aio-top-section" style="background-color: {{ section.settings.bg_color_top }}">
    <div class="new-page-width">
      <div class="aio-container">
        <div class="aio-top">
          <div class="aio-left">
            {% if section.settings.hero_logo != blank %}
              <img
                src="{{ section.settings.hero_logo | image_url: width: 300 }}"
                alt="Game Logo"
                class="aio-hero-logo"
                loading="lazy"
              >
            {% endif %}

            <h2 class="aio-heading">
              {{ section.settings.hero_heading }}
            </h2>

            <div class="aio-description">
              {{ section.settings.hero_description }}
            </div>

            {% if section.settings.tryCtaURL != blank %}
              <a class="content-cta content-cta__solid section__cta" href="{{section.settings.tryCtaURL}}"{% if settings.open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
                {{- section.settings.tryCtaText -}}
              </a>
            {% endif %}

            {% if section.settings.app_store_btn != blank %}
              <div class="aio-app-btns">
                <a class="aio-app-btn" href="{{ section.settings.app_store_url }}" target="_blank">
                  <img
                    src="{{ section.settings.app_store_btn | image_url: width: 400 }}"
                    alt="App Store"
                    loading="lazy"
                  >
                </a>
                {% if section.settings.play_store_btn != blank %}
                  <a class="aio-app-btn" href="{{ section.settings.play_store_url }}" target="_blank">
                    <img
                      src="{{ section.settings.play_store_btn | image_url: width: 400 }}"
                      alt="Play Store"
                      loading="lazy"
                    >
                  </a>
                {% endif %}
                <div class="aio-app__bottom">

              <div class="review_ratings" aria-label="4.9 out of 5 stars" role="img">
                <img src="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/blue-star-btg-icon.svg?v=1784881543"
                  alt class="rating-star" height="16px" width="16px" decoding="async"  loading="lazy">
                <img src="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/blue-star-btg-icon.svg?v=1784881543"
                  alt class="rating-star" height="16px" width="16px" decoding="async"  loading="lazy">
                <img src="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/blue-star-btg-icon.svg?v=1784881543"
                  alt class="rating-star" height="16px" width="16px" decoding="async"  loading="lazy">
                <img src="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/blue-star-btg-icon.svg?v=1784881543"
                  alt class="rating-star" height="16px" width="16px" decoding="async"  loading="lazy">
                <img src="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/blue-star-btg-icon.svg?v=1784881543"
                  alt class="rating-star" height="16px" width="16px" decoding="async"  loading="lazy">
                  </div>
              
              <p class="review_text custom_subHeading-text">4.9 RATING AVG. (25k+ REVIEWS)</p>
                  
                </div>
              </div>
            {% endif %}
          </div>
          <div class="aio-right">
            {% if section.settings.hero_main_image != blank %}
              {{
                section.settings.hero_main_image
                | image_url: width: 1800
                | image_tag:
                  alt: 'Game Platform',
                  class: 'aio-hero-image',
                  loading: 'eager',
                  fetchpriority: 'high',
                  widths: '400,600,800,1200,1600,1800,2400',
                  sizes: '100vw',
                  height: section.settings.hero_main_image.height,
                  width: section.settings.hero_main_image.width
              }}
            {% endif %}
          </div>
        </div>

        <div class="aio-slider-wrapper">
          <div class="horizon-slider_container aio-slider">
            <div class="horizon-slider_track">
              {% for block in section.blocks %}
                <div class="horizon-slide">
                  <div class="aio-slide-card">
                    {% if block.settings.image != blank %}
                      {{
                        block.settings.image
                        | image_url: width: 1200
                        | image_tag:
                          alt: block.settings.title,
                          loading: 'lazy',
                          widths: '300,400,500,600,800,1000,1200,1600',
                          sizes: '(max-width: 480px) 100vw, (max-width: 768px) 50vw, 33vw',
                          height: block.settings.image.height,
                          width: block.settings.image.width
                      }}
                    {% else %}
                      <div style="background-color: #333; height:100%; width:100%;"></div>
                    {% endif %}
                    <div class="aio-slide-overlay">
                      {% if block.settings.badge != blank %}
                        <img
                          class="aio-slide-badge"
                          src="{{ block.settings.badge | image_url }}"
                          alt="{{ block.settings.title }}"
                          height="100%"
                          width="100%"
                          decoding="async"
                        >
                      {% endif %}
                      <h3 class="aio-slide-title">{{- block.settings.title -}}</h3>
                      <div class="aio-slide-desc">{{- block.settings.description -}}</div>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {% if section.settings.eco_heading != blank %}
    <div class="aio-bottom" style="background-color: {{ section.settings.bg_color_bottom }}">
      <div class="new-page-width">
        <div class="aio-eco-container">
          <div class="aio-eco-text">
            <h2 class="eco-heading">{{ section.settings.eco_heading }}</h2>
            <div class="eco-description">
              {{ section.settings.eco_description }}
            </div>
          </div>

          <div class="aio-eco-image-wrapper">
            {% if section.settings.eco_image != blank %}
              <img
                src="{{ section.settings.eco_image | image_url: width: 1000 }}"
                alt="Ecosystem"
                class="aio-eco-image"
                loading="lazy"
              >
            {% endif %}
          </div>
        </div>
        <div class="aio-eco-buttons">
          {% if section.settings.btn_primary_text != blank %}
            <a href="{{ section.settings.btn_primary_url }}" class="btn-blue"{% if settings.open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
              {{- section.settings.btn_primary_text -}}
            </a>
          {% endif %}
          {% if section.settings.btn_secondary_text != blank %}
            <a href="{{ section.settings.btn_secondary_url }}" class="btn-outline-blue"{% if settings.open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>
              {{- section.settings.btn_secondary_text -}}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof horizonSlider === 'function') {
      horizonSlider({
        '.aio-slider': {
          loop: true,
          margin: 20,
          nav: true,
          showTracker: false,
          drag: true,
          autoplay: false,
          responsive: {
            0: { items: 1.2 },
            640: { items: 2.2 },
            1024: { items: 3.1 },
            1400: { items: 3.3 },
          },
        },
      });
    }
  });
</script>

{% schema %}
{
  "name": "All-In-One Platform",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Hero Section (Dark)"
    },
    {
      "type": "image_picker",
      "id": "hero_logo",
      "label": "Hero Top Logo"
    },
    {
      "type": "textarea",
      "id": "hero_heading",
      "label": "Hero Heading HTML",
      "default": "THE ALL-IN-ONE<br><span class='custom_heading outline'>AI GPS PLATFORM</span>"
    },
    {
      "type": "richtext",
      "id": "hero_description",
      "label": "Hero Description",
      "default": "<p>GAME is the intelligent engine behind the entire Blue Tees ecosystem...</p>"
    },
    {
      "type": "text",
      "id": "tryCtaText",
      "label": "Cta Text"
    },
    {
      "type": "url",
      "id": "tryCtaURL",
      "label": "Cta URL"
    },
    {
      "type": "image_picker",
      "id": "app_store_btn",
      "label": "App Store Button Image"
    },
    {
      "type": "url",
      "id": "app_store_url",
      "label": "App Store URL"
    },
    {
      "type": "image_picker",
      "id": "play_store_btn",
      "label": "Play Store Button Image"
    },
    {
      "type": "url",
      "id": "play_store_url",
      "label": "Play Store URL"
    },
    {
      "type": "image_picker",
      "id": "hero_main_image",
      "label": "Hero Main Image (Laptop/Phone)"
    },
    {
      "type": "color",
      "id": "bg_color_top",
      "label": "Top Background Color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "feature_slide",
      "name": "Feature Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        },
        {
          "type": "image_picker",
          "id": "badge",
          "label": "Select Image For Badge"
        },
        {
          "type": "html",
          "id": "title",
          "label": "Title",
          "default": "AI-DRIVEN INSIGHTS"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Understand where you're gaining strokes..."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "All-In-One Platform",
      "blocks": [{ "type": "feature_slide" }, { "type": "feature_slide" }, { "type": "feature_slide" }]
    }
  ]
}
{% endschema %}
