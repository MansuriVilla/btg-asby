<style>
.golfers-inner {
  padding: 50px 0 60px;
}
.golfers-inner__content {
  display: flex;
  flex-direction: column;
  gap: 30px;
  align-items: center;
}
.golfers-content__hearder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.view-all__stats {
  display: flex;
  align-items: center;
  gap: 10px;
}
.view-all__stats span:last-child {
  font-weight: 900;
  line-height: clamp(20px, 3.4vw, 60px);
}
.golfers-inner__content h2 {
  
}
.golfers-inner__content h2 br {
  display: none;
}
.product-buttons__container {
  overflow-x: auto;
  -ms-overflow-style: none;
  scrollbar-width: none;
  width: 100%;
  display: block;
  scroll-behavior: smooth;
}
.product-buttons__container::-webkit-scrollbar {
  display: none;
}
.product__buttons {
  display: flex;
  gap: 11px;
  white-space: nowrap;
  min-width: fit-content;
  padding: 0 15px;
  justify-content: center;
}
.button {
  position: relative;
  display: inline-block;
  overflow: hidden;
  min-width: max-content;
}
.review-button {
  display: inline-block;
  padding: 7px 30px;
  text-decoration: none;
  color: var(--new-black);
  background-color: transparent;
  border: 1px solid var(--new-black);
  border-radius: 50px;
  transition: background-color 0.3s, color 0.3s;
  font-weight: 300;
  position: relative;
  min-width: max-content;
  cursor: pointer;
}
.review-button.active {
  background-color: var(--new-blue);
  color: white;
  border-color: var(--new-blue);
  font-weight: 900;
}
.review-button:not(.review-button.active):hover {
  background: #e5e5e5;
}
#review-loader {
  text-align: center;
  padding: 20px;
  font-size: clamp(14px,2vw,18px);
  color: #666;
  display: flex;
  flex-direction: column;
  align-items: center;  
  justify-content: center;
  gap: clamp(12px,2vw,20px);
  min-height: 50vh;
}
#review-loader svg {
  max-width: clamp(30px,5vw,50px);
}
.trusted-bg-golfers___all-reviews .page-width {
  padding: 0;
}
@media only screen and (max-width: 860px) {
  .view-all__stats {
    flex-wrap: wrap;
    justify-content: center;
    flex-direction: column;
  }
  .golfers-inner__content h2 {
    text-align: center;
    margin-bottom: 27px;
  }
  .golfers-inner__content h2 br {
    display: block;
  }
}
</style>

<section class="trusted-bg-golfers___{{ page.handle }}">
  <div class="page-width">
    <div class="golfers-inner">
      <div class="golfers-inner__content">
        <div class="golfers-content__hearder">
          <h2>
            TRUSTED BY <br>
            GOLFERS <br>
            WORLDWIDE
          </h2>
          <div class="view-all__stats">
            <span>
              <svg width="128" height="25" viewBox="0 0 128 25" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12.0569 0.389404L14.7795 9.41502H23.9193L16.5296 15.1586L19.4466 24.3894L12.0569 18.6458L4.4727 24.3894L7.38969 15.1586L0 9.41502H9.13994L12.0569 0.389404Z" fill="var(--new-blue)"/>
                <path d="M37.9215 0.389404L40.8385 9.41502H49.9784L42.5887 15.1586L45.3112 24.3894L37.9215 18.6458L30.5318 24.3894L33.4488 15.1586L25.8646 9.41502H35.1991L37.9215 0.389404Z" fill="var(--new-blue)"/>
                <path d="M63.9788 0.389404L66.7013 9.41502H76.0357L68.4515 15.1586L71.3685 24.3894L63.9788 18.6458L56.5891 24.3894L59.3116 15.1586L51.9219 9.41502H61.0618L63.9788 0.389404Z" fill="var(--new-blue)"/>
                <path d="M89.8442 0.389404L92.7612 9.41502H101.901L94.5114 15.1586L97.4284 24.3894L89.8442 18.6458L82.4545 24.3894L85.3715 15.1586L77.9818 9.41502H87.1216L89.8442 0.389404Z" fill="var(--new-blue)"/>
                <path d="M115.903 0.389404L118.82 9.41502H127.96L120.57 15.1586L123.293 24.3894L115.903 18.6458L108.513 24.3894L111.236 15.1586L103.846 9.41502H113.181L115.903 0.389404Z" fill="var(--new-blue)"/>
              </svg>
            </span>
            <span>4.8/5 BASED ON 2,000+ REVIEWS</span>
          </div>
        </div>
        <div class="product-buttons__container">
          <div class="product__buttons">
            {% for block in section.blocks %}
              {% if block.settings.product %}
                <div class="button">
                  <div class="circle"></div>
                  <a href="javascript:void(0)" class="review-button" data-product-id="{{ block.settings.product.id }}">
                    {{-
                      block.settings.reviewText
                      | default: block.settings.product.title
                      | default: 'No product selected'
                    -}}
                  </a>
                </div>



              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
    <div id="review-loader" style="display:none;">
      <svg
        version="1.1"
        xmlns="http://www.w3.org/2000/svg"
        xmlns:xlink="http://www.w3.org/1999/xlink"
        x="0px"
        y="0px"
        viewBox="0 0 2400 2400"
        xml:space="preserve"
      >
        <g stroke-width="200" stroke-linecap="round" stroke="currentColor" fill="none" id="spinner"><line x1="1200" y1="600" x2="1200" y2="100"/><line opacity="0.5" x1="1200" y1="2300" x2="1200" y2="1800"/><line opacity="0.917" x1="900" y1="680.4" x2="650" y2="247.4"/><line opacity="0.417" x1="1750" y1="2152.6" x2="1500" y2="1719.6"/><line opacity="0.833" x1="680.4" y1="900" x2="247.4" y2="650"/><line opacity="0.333" x1="2152.6" y1="1750" x2="1719.6" y2="1500"/><line opacity="0.75" x1="600" y1="1200" x2="100" y2="1200"/><line opacity="0.25" x1="2300" y1="1200" x2="1800" y2="1200"/><line opacity="0.667" x1="680.4" y1="1500" x2="247.4" y2="1750"/><line opacity="0.167" x1="2152.6" y1="650" x2="1719.6" y2="900"/><line opacity="0.583" x1="900" y1="1719.6" x2="650" y2="2152.6"/><line opacity="0.083" x1="1750" y1="247.4" x2="1500" y2="680.4"/><animateTransform attributeName="transform" attributeType="XML" type="rotate" keyTimes="0;0.08333;0.16667;0.25;0.33333;0.41667;0.5;0.58333;0.66667;0.75;0.83333;0.91667" values="0 1199 1199;30 1199 1199;60 1199 1199;90 1199 1199;120 1199 1199;150 1199 1199;180 1199 1199;210 1199 1199;240 1199 1199;270 1199 1199;300 1199 1199;330 1199 1199" dur="0.83333s" begin="0s" repeatCount="indefinite" calcMode="discrete"/></g>
      </svg>
      <span>Getting Reviews...</span>
    </div>
    <div
      id="looxReviews"
      data-product-id="{% if section.blocks.size > 0 and section.blocks[0].settings.product %}{{ section.blocks[0].settings.product.id }}{% else %}0{% endif %}"
    ></div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
const buttons = document.querySelectorAll('.review-button');
let looxReviews = document.getElementById('looxReviews');
const parentElement = looxReviews.parentElement;
const loader = document.getElementById('review-loader');
const productButtonsContainer = document.querySelector('.product-buttons__container');

// Wait for DOM to fully render
setTimeout(() => {
    // Set the first button as active, center it, and load its reviews
    if (buttons.length > 0) {
    buttons[0].classList.add('active');
    centerActiveButton(buttons[0]);
    const firstProductId = buttons[0].getAttribute('data-product-id');
    loadReviews(firstProductId);
    }

    // Handle button clicks
    buttons.forEach((button) => {
    button.addEventListener('click', function () {
        // Remove active class from all buttons
        buttons.forEach((btn) => btn.classList.remove('active'));
        // Add active class to clicked button
        this.classList.add('active');
        // Center the active button
        centerActiveButton(this);
        // Load reviews for the clicked button
        const productId = this.getAttribute('data-product-id');
        loadReviews(productId);
    });
    });
}, 300);

// Function to load reviews based on productId
function loadReviews(productId) {
    loader.style.display = 'flex';

    // Remove and recreate the looxReviews element
    looxReviews.remove();
    looxReviews = document.createElement('div');
    looxReviews.id = 'looxReviews';
    if (productId === '') {
    looxReviews.removeAttribute('data-product-id');
    } else {
    looxReviews.setAttribute('data-product-id', productId);
    }
    parentElement.appendChild(looxReviews);
    looxReviews.innerHTML = '';

    // Observe when reviews load to hide loader
    const observer = new MutationObserver(function (mutations) {
    mutations.forEach(function (mutation) {
        if (mutation.type === 'childList' && mutation.addedNodes.length > 0) {
        loader.style.display = 'none';
        observer.disconnect();
        }
    });
    });
    observer.observe(looxReviews, { childList: true, subtree: true });

    // Initialize Loox or hide loader if Loox isn’t available
    if (typeof Loox !== 'undefined') {
    setTimeout(() => {
        Loox.init();
    }, 100);
    } else {
    setTimeout(() => {
        loader.style.display = 'none';
    }, 4000);
    }
}

// Function to center the active button
function centerActiveButton(button) {
    const container = productButtonsContainer;
    const containerWidth = container.offsetWidth;
    const buttonWidth = button.offsetWidth;
    const containerRect = container.getBoundingClientRect();
    const buttonRect = button.getBoundingClientRect();
    const containerScrollLeft = container.scrollLeft;

    const buttonRelativeLeft = buttonRect.left - containerRect.left + containerScrollLeft;
    const centerOffset = (containerWidth / 2) - (buttonWidth / 2);
    let newScrollLeft = buttonRelativeLeft - centerOffset;

    const maxScrollLeft = container.scrollWidth - containerWidth;
    newScrollLeft = Math.max(0, Math.min(newScrollLeft, maxScrollLeft));

    container.scrollTo({
    left: newScrollLeft,
    behavior: 'smooth',
    });
}
});
</script>







{% schema %}
{
  "name": "Review Tabs",
  "settings": [],
  "blocks": [
    {
      "type": "Review_Button",
      "name": "Review Button",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product",
          "info": "Select a product to display its name and reviews. Leave blank for 'All Reviews' button."
        },
        {
          "type": "text",
          "id": "reviewText",
          "label": "Add Button Text",
          "info": "Enter custom text for the button. Defaults to the product name if left blank, or 'All Reviews' if no product is selected."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Review Tabs"
    }
  ]
}
{% endschema %}