<div
  class="round-section{% if section.settings.no_space_top %} no_space_top{% endif %}"
  style="background-color: {{ section.settings.bg_color }};"
>
  {% if section.settings.heading != blank %}
    <div class="round-container new-page-width">
      <div class="round-left">
        <h2 class="round-heading">
          {{ section.settings.heading | newline_to_br }}
        </h2>
        {% if section.settings.desc != blank %}
          <p class="round-description">
            {{ section.settings.desc }}
          </p>
        {% endif %}

        {% if section.settings.main_cta_text != blank %}
          <a
            href="{{ section.settings.main_cta_link }}"
            class="round-cta"
            {% if settings.open_new_tab %}
              target="_blank" rel="noopener noreferrer"
            {% endif %}
          >
            {{ section.settings.main_cta_text }}
          </a>
        {% endif %}
      </div>

      {% if section.blocks.size > 1 %}
        <div class="round-right">
          <div class="horizon-slider_container round-slider">
            <div class="horizon-slider_track">
              {% for block in section.blocks %}
                {% assign product = block.settings.product %}
                <div class="horizon-slide">
                  <div class="round-card">
                    {% assign card_image = block.settings.image | default: product.featured_image %}
                    {% assign card_alt = card_image.alt | default: block.settings.customTitle | default: product.title | default: 'Product Image' %}
                    {% if card_image != blank %}
                      {{
                        card_image
                        | image_url: width: 1200
                        | image_tag: alt: card_alt,
                          loading: 'lazy',
                          widths: '300,400,500,600,800,1000,1200,1600',
                          sizes: '(max-width: 480px) 100vw, (max-width: 768px) 50vw, 33vw',
                          height: card_image.height,
                          width: card_image.width
                      }}
                    {% else %}
                      <div
                        style="background-color: #999; width: 100%; height: 100%; position: absolute; inset:0;"
                      ></div>
                    {% endif %}

                    <div class="round-card-content">
                      {% if block.settings.customTitle != blank %}
                        <h3 class="round-card-title">{{ block.settings.customTitle }}</h3>
                      {% else %}
                        <h3 class="round-card-title">{{ product.title }}</h3>
                      {% endif %}
                      {% if block.settings.cardTagline %}
                        <p class="round-card-subtitle">{{ block.settings.cardTagline }}</p>
                      {% endif %}

                      <div class="round-card-buttons content-ctas">
                        <a
                          href="{{ product.url }}"
                          class="content-cta content-cta__solid"
                          {% if settings.open_new_tab %}
                            target="_blank" rel="noopener noreferrer"
                          {% endif %}
                          >SHOP NOW</a
                        >
                        {% comment %} <a href="{{ product.url }}" class="card-btn card-btn-outline">Learn More</a> {% endcomment %}
                      </div>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
          {% if section.settings.main_cta_text != blank %}
            <a href="{{ section.settings.main_cta_link }}" class="round-cta mobile">
              {{ section.settings.main_cta_text }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% endif %}
  <div class="new-page-width">
    {% if section.settings.teesHeading != blank %}
      <div class="tees_block-section{% if section.settings.no_space_top %} no_space_top{% endif %}">
        <div class="tees_heading">
          <h3 class="tees_heading-text">{{ section.settings.teesHeading }}</h3>
        </div>
        <ul class="tees_blocks">
          <li class="block_item">
            {% if section.settings.itemOneIcon != blank %}
              <div class="item_left" style="--icon-bg:{{ section.settings.itemIconColor }}">
                <img
                  src="{{ section.settings.itemOneIcon | image_url }}"
                  alt="{{ section.settings.itemOneText }}"
                  height="100%"
                  width="100%"
                  decoding="async"
                >
              </div>
            {% endif %}
            {% if section.settings.itemOneText != blank %}
              <div class="item_right">
                <p class="custom_subHeading-text">{{ section.settings.itemOneText }}</p>
              </div>
            {% endif %}
          </li>
          <li class="block_item">
            {% if section.settings.itemTwoIcon != blank %}
              <div class="item_left" style="--icon-bg:{{ section.settings.itemIconColor }}">
                <img
                  src="{{ section.settings.itemTwoIcon | image_url }}"
                  alt="{{ section.settings.itemTwoText }}"
                  height="100%"
                  width="100%"
                  decoding="async"
                >
              </div>
            {% endif %}
            {% if section.settings.itemTwoText != blank %}
              <div class="item_right">
                <p class="custom_subHeading-text">{{ section.settings.itemTwoText }}</p>
              </div>
            {% endif %}
          </li>
          <li class="block_item">
            {% if section.settings.itemThreeIcon != blank %}
              <div class="item_left" style="--icon-bg:{{ section.settings.itemIconColor }}">
                <img
                  src="{{ section.settings.itemThreeIcon | image_url }}"
                  alt="{{ section.settings.itemThreeText }}"
                  height="100%"
                  width="100%"
                  decoding="async"
                >
              </div>
            {% endif %}
            {% if section.settings.itemThreeText != blank %}
              <div class="item_right">
                <p class="custom_subHeading-text">{{ section.settings.itemThreeText }}</p>
              </div>
            {% endif %}
          </li>
        </ul>
      </div>
    {% endif %}
  </div>
</div>

{% if section.blocks.size > 1 %}
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      if (typeof horizonSlider === 'function') {
        horizonSlider({
          '.round-slider': {
            loop: true,
            margin: 20,
            nav: true,
            showTracker: false,
            drag: true,
            autoplay: false,
            responsive: {
              0: {
                items: 1.2,
              },
              640: {
                items: 2.1,
              },
              1024: {
                items: 2.3,
              },
            },
          },
        });
      } else {
        console.warn('Horizon Slider library not loaded.');
      }
    });
  </script>
{% endif %}

{% schema %}
{
  "name": "Round Out Game Slider",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Section Heading",
      "default": "ROUND OUT<br>YOUR GAME"
    },
    {
      "type": "text",
      "id": "desc",
      "label": "Section Description"
    },
    {
      "type": "text",
      "id": "main_cta_text",
      "label": "Main CTA Text",
      "default": "SHOP ACCESSORIES"
    },
    {
      "type": "url",
      "id": "main_cta_link",
      "label": "Main CTA Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#EBF0F5",
      "alpha": true
    },
    {
      "type": "textarea",
      "id": "teesHeading",
      "label": "Tees Heading"
    },
    {
      "type": "color",
      "id": "itemIconColor",
      "label": "All Icon Bg",
      "default": "#000",
      "alpha": true
    },
    {
      "type": "image_picker",
      "id": "itemOneIcon",
      "label": "Added Icon For Item 1"
    },
    {
      "type": "text",
      "id": "itemOneText",
      "label": "Added Text For Item 1"
    },
    {
      "type": "image_picker",
      "id": "itemTwoIcon",
      "label": "Added Icon For Item 2"
    },
    {
      "type": "text",
      "id": "itemTwoText",
      "label": "Added Text For Item 2"
    },
    {
      "type": "image_picker",
      "id": "itemThreeIcon",
      "label": "Added Icon For Item 3"
    },
    {
      "type": "text",
      "id": "itemThreeText",
      "label": "Added Text For Item 3"
    },
    {
      "type": "checkbox",
      "id": "no_space_top",
      "label": "Remove Space From Top"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "customTitle",
          "label": "Product Title"
        },
        {
          "type": "text",
          "id": "cardTagline",
          "label": "Product Tagline"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Card Image",
          "info": "Overrides the product's featured image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Round Out Game Slider",
      "blocks": [
        {
          "type": "product_card"
        },
        {
          "type": "product_card"
        },
        {
          "type": "product_card"
        }
      ]
    }
  ]
}
{% endschema %}
