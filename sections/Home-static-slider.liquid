{% comment %}
  <script src="https://cdn.jsdelivr.net/npm/fireworks-js@2.x/dist/index.umd.js"></script>
{% endcomment %}

{% comment %}
  USE 'data-slide-none="true"' TO HIDE ANY BANNER AND IT'S NAV ITEM
{% endcomment %}

{% if template.name == 'page'
  and template.suffix == 'offer-page-bf-v1'
  or template.name == 'page'
  and template.suffix == 'offer-page-bf-v2'
%}
  <div
    class="am-main_slider-container"
    id="snow_init"
    role="region"
    aria-roledescription="carousel"
    aria-label="Promotional banner carousel"
  >
    <div class="am-main_slider-img">
      <div
        class="am-slide_item two_col-banner fireworks two_col-banner--image-bottom"
        style="--banner-bg: url('https://cdn.shopify.com/s/files57/8958/1381/files/BF2026_Banner_SALES_page_PPRO-RM_desktop.webp?v=1793006646'); --banner-bg-mobile:url('https://cdn.shopify.com/s/files/1/0057/8958/1381/files/BF2026_Banner_SALES_page_Captains_mobile-1.webp?v=1793013780');"
        data-banner-two-col
        data-slide-none="true"
        data-slide-index="1"
      >
        {% comment %}
          <video
            autoplay
            playsinline
            webkit-playsinline
            muted
            preload="none"
            loop
            style="width: 100%;left: 0;position: absolute;height: 100%;object-fit: cover;top: 0;z-index: -1;"
          >
            <source
              src="https://cdn.shopify.com/videos/c/o/v/57f915e9268148e29cedfd893014bfef.mp4"
              media="(min-width:861px)"
            >
            <source
              src="https://cdn.shopify.com/videos/c/o/v/73a5d858a7514285bb6ba07149609fc5.mp4"
              media="(max-width:860px)"
            >
            Your browser does not support the video tag.
          </video>
        {% endcomment %}

        <div class="item__container">
          <div class="am-slider_item-inner two_col--slide">
            <div class="item__left">
              <div class="item__left--inner">
                <div class="item__left--top">
                  <div class="top_top">
                    {% comment %}
                      <div class="top_left">
                        <img src="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/Group_1410105090.png?v=1768897926"
                          alt="Black Friday Exclusive Logo" decoding="async">
                      </div>
                    {% endcomment %}
                    <div class="top_right">
                      <picture>
                        <source
                          srcset="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/pm-hm-hd-sale-title.png?v=1764933010"
                          media="(min-width:861px)"
                        >
                        <source
                          srcset="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/pm-hm-hd-sale-title.png?v=1764933010"
                          media="(max-width:860px)"
                        >
                        <img
                          class="top_prod-title"
                          decoding="async"
                          src="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/pm-hm-hd-sale-title.png?v=1764933010"
                          alt="sale-logo-icon"
                        >
                      </picture>
                    </div>
                  </div>
                  <div class="top_bottom">
                    <div class="top_bottom-title">
                      <h3 class="bottom__title">
                        <span>GPS READY.</span>
                        <span>SWING FRIENDLY.</span>
                      </h3>
                    </div>
                  </div>
                </div>
                <div class="item__left--center">
                  <div class="center_top">
                    <p>
                      A full caddie on your wrist—dynamic yardages, shot tracking, and real- <br>
                      time swing data powered by a stunning AMOLED display.
                    </p>
                  </div>
                  <div class="center_bottom">
                    <span class="price__compare--save common_bug custom_subHeading-text">
                      <span class="save_text">SAVE</span>
                      {{
                        all_products['playmaker-watch'].compare_at_price_max
                        | minus: all_products['playmaker-watch'].price
                        | money
                      }}
                    </span>
                    <div class="center_price-area  ">
                      <p class="price__actual custom_heading">
                        {{ all_products['playmaker-watch'].price | money }}
                      </p>
                      <p class="price__compare custom_heading">
                        <span class="price__compare--price">
                          {{- all_products['playmaker-watch'].compare_at_price_max | money }}
                          <svg
                            width="403"
                            height="9"
                            viewBox="0 0 403 9"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                          >
                            <path d="M201.497 8.43298V4.21649H0C21.221 6.36282 118.858 8.43298 201.497 8.43298Z"
                              fill="var(--new-red)"></path>
                            <path d="M201.503 8.43698V4.22049H403C381.779 6.36682 284.142 8.43698 201.503 8.43698Z"
                              fill="var(--new-red)"></path>
                            <path d="M201.497 0L201.497 4.21649H402.994C381.773 2.07016 284.136 0 201.497 0Z"
                              fill="var(--new-red)"></path>
                            <path d="M201.497 0L201.497 4.21649H0C21.221 2.07016 118.857 0 201.497 0Z"
                              fill="var(--new-red)"></path>
                          </svg>
                        </span>
                      </p>
                    </div>
                  </div>
                </div>
                <div class="item__left--bottom">
                  <a
                    class="content-cta content-cta__solid"
                    style="padding: clamp(5px,1vw,10px) clamp(18px,1.2vw,20px);"
                    href="/products/playmaker-watch"
                    >SHOP NOW</a
                  >
                </div>
              </div>
            </div>
            {% comment %}
              <div class="item__right">
                <div class="item__right-inner">


                  <picture>
                    <source
                      srcset="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/mockup-spring-sale-pm-desktop.png?v=1775034046"
                      media="(min-width:861px)">
                    <source
                      srcset="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/Frame_1410105391.png?v=1775114118"
                      media="(min-width:481px)">
                    <source
                      srcset="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/mockup-spring-sale-pm-mobile.png?v=1775033947"
                      media="(max-width:480px)">
                    <img class="offer-logo" decoding="async"
                      src="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/mockup-spring-sale-pm-desktop.png?v=1775034046"
                      alt="sale-logo-icon">
                  </picture>
                </div>
              </div>
            {% endcomment %}
          </div>
        </div>
      </div>
      <div
        class="am-slide_item two_col-banner fireworks two_col-banner--image-bottom"
        data-banner-two-col
        style="--banner-bg: url('https://cdn.shopify.com/s/files/1/0057/8958/1381/files/BF2026_Banner_SALES_page_Rainmaker_Bundle_desktop.webp?v=1793002893'); --banner-bg-mobile:url('https://cdn.shopify.com/s/files/1/0057/8958/1381/files/BF2026_Banner_SALES_page_Rainmaker_Bundle_mobile.webp?v=1793002892');"
        data-slide-index="0"
      >
        {% comment %}
          <video autoplay playsinline webkit-playsinline muted preload="none" loop class="banner-video_new">
            <source src="https://cdn.shopify.com/videos/c/o/v/9cf00f3a10794ee3a62cba0ad2eba5eb.mp4"
              media="(min-width:861px)">
            <source src="https://cdn.shopify.com/videos/c/o/v/9cf00f3a10794ee3a62cba0ad2eba5eb.mp4"
              media="(max-width:860px)">
