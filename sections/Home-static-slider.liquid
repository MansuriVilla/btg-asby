                      <h3 class="bottom__title">
                        <img
                          src="{{ 'winter-deals-typo-banner.png'  | asset_url }}"
                          alt="Black Friday Exclusive Logo"
                          decoding="async"
                        >
                      </h3>
                      {% comment %} {% render 'supercharged-ai-comp' %} {% endcomment %}
                    </div>
                  </div>
                </div>
                {% comment %}
                  <div class="item__left--center">
                    <div class="center_top">
                      <p>EXCLUSIVE BUNDLES & OFFERS</p>
