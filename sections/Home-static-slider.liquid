{% comment %} <script src="https://cdn.jsdelivr.net/npm/fireworks-js@2.x/dist/index.umd.js"></script> {% endcomment %}

{% comment %}
  USE 'data-slide-none="true"' TO HIDE ANY BANNER AND IT'S NAV ITEM
{% endcomment %}

{% if template.name == 'page'
  and template.suffix == 'offer-page-bf-v1'
  or template.name == 'page'
  and template.suffix == 'offer-page-bf-v2'
%}
  <div class="am-main_slider-container" id="snow_init">
    <div class="am-main_slider-img">
      <div
        class="am-slide_item two_col-banner "
        style="--banner-bg: url('https://cdn.shopify.com/s/files/1/0057/8958/1381/files/pga-show-banner-bg-home-page.png?v=1768816067'); --banner-bg-mobile:url('https://cdn.shopify.com/s/files/1/0057/8958/1381/files/pga-show-banner-bg-home-page.png?v=1768816067');"
        data-banner-one-col
        data-slide-index="0"
        data-slide-none="true"
      >
        <div class="item__container">
          <div class="am-slider_item-inner two_col--slide">
            <div class="item__left">
              <div class="item__left--inner">
                <div class="item__left--top">
                  <div class="top_top">
                    <div class="top_left">
                      <img
                        src="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/Group_1410105090.png?v=1768897926"
                        alt="Black Friday Exclusive Logo"
                        decoding="async"
