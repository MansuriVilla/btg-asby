<div
  class="background-with-number"
  style="background: var(--new-black) url({{ section.settings.single-image | img_url: 'master' }}) no-repeat center center / cover"
>
  <div class="page-width">
    <ul>
      <li> 
        <img  src="{{'stats_person.svg' | asset_url}}" alt="Active golf players icon"/>
        <h3>{{ section.settings.title_1 | escape }}</h3>
        <p>{{ section.settings.sub_title_1 | escape }}</p>
      </li>
      <li>
        <img  src="{{'stats_bag.svg' | asset_url}}" alt="Golf bags equipped icon"/>
        <h3>{{ section.settings.title_2 | escape }}</h3>
        <p>{{ section.settings.sub_title_2 | escape }}</p>
      </li>
      <li>
        <img  src="{{'stats_blub.svg' | asset_url}}" alt="Innovative ideas icon"/>
        <h3 class="spacing_change">{{ section.settings.title_3 | escape }}</h3>
        <p>{{ section.settings.sub_title_3 | escape }}</p>
      </li>
      <li>
        <img  src="{{'stats_glob.svg' | asset_url}}" alt="Global golf courses icon"/>
        <h3>{{ section.settings.title_4 | escape }}</h3>
        <p>{{ section.settings.sub_title_4 | escape }}</p>
      </li>
      <li>
        <img  src="{{'stats_trophy.svg' | asset_url}}" alt="Championship awards icon"/>
        <h3>{{ section.settings.title_5 | escape }}</h3>
        <p>{{ section.settings.sub_title_5 | escape }}</p>
      </li>
    </ul>
  </div>
</div>

{% comment %} 
<div class="prodcut-paige-banner" >
  <div class="page-width">
  <div class="paige-banner-inner">
    <div class="paige-banner">
      <picture>
          <source srcset="{{ 'product-paige-banner-bg.jpg' | asset_url }}" media="(min-width:576px)">
          <source srcset="{{ 'product-paige-banner-mobile-bg.jpg' | asset_url }}" media="(max-width:575px)">
          <img src="{{ 'product-paige-banner-bg.jpg' | asset_url }}" alt="play maker plus logo">
      </picture>
    </div>
    <div class="paige-banner-content ">
      <div class="paige-banner-logo">
         <img  src="{{'game-logo-paige.png' | asset_url}}" alt="Blue Tees Golf with Paige Spiranac"/>
      </div>
      <div class="paige-banner-title">
        <h2>WIN A FOURSOME WITH PAIGE</h2>
      </div>
      <div class="paige-banner-descp">
        <p>Enter for your chance to win the most unforgettable foursome of your life— plus unlock $500+ in rewards along the way.</p>
      </div>
      <div class="paige-banner-btn">
        <a class="btn" href="/pages/paige-landing-page">ENTER FOR FREE NOW</a>
      </div>
    </div>
  </div>
  </div>
</div> {% endcomment %}

