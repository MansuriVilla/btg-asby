{% liquid
  assign heading = section.settings.heading
  assign body_text = section.settings.body_text
  assign floating_image = section.settings.floating_image
  assign floating_image_mobile = section.settings.floating_image_mobile
  assign bg_image = section.settings.bg_image
  assign bg_clr = section.settings.bg_clr
%}

<div class="our-values__section">
  <div class="new-page-width">
    <div class="our-values__section--inner">
      <picture>
        <source srcset="{{ floating_image | image_url }}" media="(min-width:992px)">
        <source srcset="{{ floating_image_mobile | image_url }}" media="(max-width:991px)">
        {{ floating_image  | image_url: width: 900 | image_tag: class: 'our-values--floating_image', loading: 'eager', alt: heading}}
      </picture>
      <div class="our-values__section--left">
        {% if heading != blank %}
          <div class="our-values__left--content">
            <h2>{{ heading }}</h2>
            {% if body_text != blank %}
              <p>{{ body_text }}</p>
            {% endif %}
          </div>
        {% endif %}
      </div>
      <div class="our-values__section--right">
        <div class="our-values__right--content">
          <div class="our-values__right--items">
            {% for block in section.blocks %}
              {% liquid
                assign item_heading = block.settings.item_heading
                assign item_body_text = block.settings.item_body_text
              %}
              {% if item_heading != blank %}
                  {%- assign num = forloop.index | prepend: '00' | slice: -2, 2 -%}

                <div class="our-values__right--item">
                  <div class="our-values__item--left">
                    <h4>{{ num }}</h4>
                  </div>
                  <div class="our-values__item--right">
                    <h4>{{ item_heading }}</h4>
                    <p>{{ item_body_text }}</p>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% style %}
  .our-values__section{background:url({{bg_image | image_url }}) center center / cover no-repeat {{bg_clr}}; position: relative;}
{% endstyle %}

{% schema %}
{
  "name": "Our Values",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_clr",
      "label": "Section Background Color"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Section Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading"
    },
    {
      "type": "text",
      "id": "body_text",
      "label": "Section Description"
    },
    {
      "type": "image_picker",
      "id": "floating_image",
      "label": "Floating Image"
    },
    {
      "type": "image_picker",
      "id": "floating_image_mobile",
      "label": "Floating Image Mobile"
    }
  ],
  "blocks": [
    {
      "type": "our_values",
      "name": "Our Value Item",
      "settings": [
        {
          "type": "text",
          "id": "item_heading",
          "label": "Item Heading"
        },
        {
          "type": "text",
          "id": "item_body_text",
          "label": "Item Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Values"
    }
  ]
}
{% endschema %}
