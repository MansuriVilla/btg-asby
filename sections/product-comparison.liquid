<div class="product-comparison" data-section-id="{{ section.id }}">
  <div class="product-comparison__container new-page-width">
    <div class="product-comparison__header">
      <h2 class="product-comparison__title{% if section.settings.title_narrow %} product-comparison__title-narrow{% endif %}">
        {{ section.settings.heading }}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="product-comparison__subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- assign categories = '' -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'feature' -%}
        {%- unless categories contains block.settings.category -%}
          {%- if categories != '' -%}
            {%- assign categories = categories | append: ',' -%}
          {%- endif -%}
          {%- assign categories = categories | append: block.settings.category -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
    {%- assign category_array = categories | split: ',' -%}

    {%- if category_array.size > 0 -%}
      <div class="product-comparison__tabs" role="tablist" aria-label="Feature categories">
        {%- for category in category_array -%}
          <button
            class="product-comparison__tab content-cta{% if forloop.first %} content-cta__solid product-comparison__tab--active{% else %} content-cta__outline{% endif %}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            data-category="{{ category | handleize }}"
            type="button"
            
          >
            {{ category | upcase }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="product-comparion__area">
      <div class="product-comparison__products">
        {%- assign products = section.blocks | where: 'type', 'product' -%}
        {%- for block in products -%}
          <article class="product-comparison__product-card" {{ block.shopify_attributes }}>
            <figure class="product-comparison__product-image-wrapper">
              {%- if block.settings.product_image != blank -%}
                {{
                  block.settings.product_image
                  | image_url: width: 300
                  | image_tag:
                    class: 'product-comparison__product-image',
                    alt: block.settings.product_name,
                    loading: 'lazy'
                }}
              {%- else -%}
                <div class="product-comparison__product-placeholder"></div>
              {%- endif -%}
            </figure>
            <h3 class="product-comparison__product-name">{{ block.settings.product_name }}</h3>
            {%- if block.settings.button_text != blank -%}
              {%- if block.settings.product_ref != blank -%}
                {%- assign product_ref = all_products[block.settings.product_ref] -%}
                {%- if product_ref != blank -%}
                  {%- assign current_variant = product_ref.selected_or_first_available_variant -%}
                  <button
                    type="button"
                    class="content-cta content-cta__solid{% if block.settings.is_preorder %} product-comparison__product-cta--preorder{% endif %} js-add-to-cart-btn"
                    data-id="{{ current_variant.id }}"
                    aria-label="Add {{ block.settings.product_name }} to cart"
                    {% if product.selected_or_first_available_variant.available  or product.template_suffix == 'new-s3-max'%}
                      disabled
                    {% endif %}
                  >
                    {%- if product.selected_or_first_available_variant.available -%}
                      {{ block.settings.button_text | upcase }}
                    {%- else -%}
                      SOLD OUT
                    {%- endif -%}
                  </button>
                {%- else -%}
                   <a
                    href="{{ block.settings.button_link }}"
                    {% if settings.open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}
                    class="content-cta content-cta__solid{% if block.settings.is_preorder %} product-comparison__product-cta--preorder{% endif %}"
                  >
                    {{ block.settings.product_name | default: block.settings.button_text | upcase }}
                  </a>
                {%- endif -%}
              {%- else -%}
                <a
                  href="{{ block.settings.button_link }}"
                   {% if settings.open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}
                  class="content-cta content-cta__solid{% if block.settings.is_preorder %} product-comparison__product-cta--preorder{% endif %}"
                >
                  {{ block.settings.button_text | upcase }}
                </a>
              {%- endif -%}
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>

      <div class="product-comparison__table-wrapper">
        <table class="product-comparison__table" role="table">
          <thead class="product-comparison__table-head visually-hidden" role="rowgroup">
            <tr role="row">
              <th scope="col" role="columnheader">Feature</th>
              {%- for block in products -%}
                <th scope="col" role="columnheader">{{ block.settings.product_name }}</th>
              {%- endfor -%}
            </tr>
          </thead>
          <tbody class="product-comparison__table-body" role="rowgroup">
            {%- assign features = section.blocks | where: 'type', 'feature' -%}
            {%- for feature in features -%}
              <tr
                class="product-comparison__row"
                data-category="{{ feature.settings.category | handleize }}"
                role="row"
                {{ feature.shopify_attributes }}
              >
                <th scope="row" class="product-comparison__feature-name custom_heading" role="rowheader">
                  {{ feature.settings.feature_name }}
                </th>
                {%- for i in (1..4) -%}
                  {%- assign value_key = 'product_' | append: i | append: '_value' -%}
                  {%- assign value = feature.settings[value_key] -%}
                  {%- assign highlight_key = 'product_' | append: i | append: '_highlight' -%}
                  {%- assign is_highlight = feature.settings[highlight_key] -%}
                  {% if value != blank %}
                    <td class="product-comparison__cell{% if is_highlight %} product-comparison__cell--highlight{% endif %}" role="cell">
                      {%- if value == 'check' -%}
                        <span class="product-comparison__check" aria-label="Yes">
                          <span class="visually-hidden">Yes</span>
                          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <circle cx="12" cy="12" r="10" fill="#36d363"/>
                            <path d="M8 12.5L10.5 15L16 9.5" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </span>
                      {%- elsif value == 'cross' -%}
                        <span class="product-comparison__cross" aria-label="No">
                          <span class="visually-hidden">No</span>
                          <svg
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                          >
                            <circle cx="11.9987" cy="11.9987" r="10.6667" fill="white"/>
                            <path d="M12 0C18.636 0 24 5.364 24 12C24 18.636 18.636 24 12 24C5.364 24 0 18.636 0 12C0 5.364 5.364 0 12 0ZM16.308 6L12 10.308L7.692 6L6 7.692L10.308 12L6 16.308L7.692 18L12 13.692L16.308 18L18 16.308L13.692 12L18 7.692L16.308 6Z" fill="#D80027"/>
                          </svg>
                        </span>
                      {%- elsif value != blank -%}
                        <span class="product-comparison__value">{{ value }}</span>
                      {%- endif -%}
                    </td>
                  {% endif %}
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>
    {%- if section.settings.disclaimer != blank -%}
      <p class="product-comparison__disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</div>


<script>
  (function () {
    const section = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!section) return;

    const tabs = section.querySelectorAll('.product-comparison__tab');
    const rows = section.querySelectorAll('.product-comparison__row');

    if (tabs.length === 0) return;

    // Initialize: Hide rows that don't belong to the first active tab
    const activeTab = section.querySelector('.product-comparison__tab--active');
    if (activeTab) {
      const initialCategory = activeTab.dataset.category;
      rows.forEach((row) => {
        if (row.dataset.category !== initialCategory) {
          row.classList.add('is-hidden');
        }
      });
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        // Update active tab
        tabs.forEach((t) => {
          t.classList.remove('product-comparison__tab--active');
          t.classList.remove('content-cta__solid');
          t.classList.add('content-cta__outline');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('product-comparison__tab--active');
        tab.classList.remove('content-cta__outline');
        tab.classList.add('content-cta__solid');
        tab.setAttribute('aria-selected', 'true');

        // Filter rows
        const selectedCategory = tab.dataset.category;
        rows.forEach((row) => {
          const rowCategory = row.dataset.category;
          if (rowCategory === selectedCategory) {
            row.classList.remove('is-hidden');
          } else {
            row.classList.add('is-hidden');
          }
        });
      });
    });

    // Add to Cart Functionality (Refined per store reference)
    const addToCartButtons = section.querySelectorAll('.js-add-to-cart-btn');
    addToCartButtons.forEach((btn) => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const button = this;
        const variantId = button.getAttribute('data-id');
        if (!variantId) return;

        button.classList.add('btn--loading');
        button.setAttribute('disabled', 'disabled');

        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            id: variantId,
            quantity: 1
          })
        })
        .then(response => {
           if (!response.ok) throw new Error('Network response was not ok');
           return response.json();
        })
        .then(data => {
            button.classList.remove('btn--loading');
            
            // Dispatch the store's custom event for cart drawers/updates
            document.dispatchEvent(
              new CustomEvent('ajaxProduct:added', {
                detail: { product: data },
              })
            );

            // Optional: Still provide manual feedback if no listener catches the event
            const originalText = button.innerText;
            button.innerText = 'ADDED!';
            setTimeout(() => {
               button.innerText = originalText;
               button.removeAttribute('disabled');
            }, 2000);
        })
        .catch((error) => {
          button.classList.remove('btn--loading');
          button.removeAttribute('disabled');
          console.error('Error adding product to cart:', error);
        });
      });
    });

  })();
</script>

