{% liquid
  assign title = section.settings.title
  assign description = section.settings.description
  assign desktop_image = section.settings.contentBackground
  assign mobile_image = section.settings.contentBackgroundMobile
  assign has_overlay = section.settings.has_overlay

  if has_overlay
    assign has_overlay = true
  endif

  assign image_alt = title | replace: '<br>', ' ' | replace: '<br />', ' ' | strip_html | escape
  assign block_loading = 'lazy'
  assign block_fetchpriority = 'auto'
  if section.index == 1 or section.index == nil or section.settings.eager_load
    assign block_loading = 'eager'
    assign block_fetchpriority = 'high'
  endif
%}

<div class="floating_content--section">
  <div class="floating_content--inner{% if has_overlay %} floating_overlay{% endif %}">
    {% if desktop_image != blank %}
      <div class="floating_content--background">
        <picture class="content_background">
          <source
            srcset="{{ desktop_image | image_url: width: 1920, format: 'webp' }}"
            type="image/webp"
            media="(min-width: 861px)"
          >
          <source
            srcset="{{ mobile_image | image_url: width: 860 }}"
            media="(max-width: 860px)"
          >
          {{
            desktop_image
            | image_url: width: 1920
            | image_tag:
              class: 'content_background--image',
              loading: block_loading,
              fetchpriority: block_fetchpriority,
              widths: '400,600,800,1200,1600,2000',
              sizes: '(max-width: 860px) 100vw, 50vw',
              alt: image_alt
          }}
        </picture>
      </div>
    {% endif %}
    {% if title != blank %}
      <div class="floating_content">
        <h3 class="content_title">{{ title }}</h3>
        <p class="content_description">{{ description }}</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Content With Background",
  "tag": "section",
  "settings": [
    {
      "type": "html",
      "id": "title",
      "label": "Section Title"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Section Description"
    },
    {
      "type": "image_picker",
      "id": "contentBackground",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "contentBackgroundMobile",
      "label": "Mobile Image"
    },
    {
      "type": "checkbox",
      "id": "has_overlay",
      "label": "Enable Overlay"
    },
    {
      "type": "checkbox",
      "id": "eager_load",
      "label": "Eager Load First Image (Above the fold)",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Content With Background"
    }
  ]
}
{% endschema %}
