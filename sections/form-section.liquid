{% liquid 
  assign mobile_image_center = false
  
  if section.settings.mobile_image_center
  assign mobile_image_center = true
  endif


%}



{% if section.settings.formBlock contains 'class="hs-form-frame"' %}
  <script src="https://js.hsforms.net/forms/embed/7645267.js" defer></script>
{% endif %}

<div class="form_section form_section-{{ section.id }}  {%if section.settings.layout_style == 'split_right'%} layout-{{ section.settings.layout_style }}{%endif %}" id="lpContactForm">
  {%- if section.settings.image_desktop != blank -%}
    <div class="form_section-image-bg">
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 992px)" srcset="{{ section.settings.image_mobile | image_url: width: 800 }}">
        {%- endif -%}
        <img src="{{ section.settings.image_desktop | image_url: width: 2000 }}" alt="{{ section.settings.image_desktop.alt | escape }}" class="form_section-bg-img" loading="lazy">
      </picture>
    </div>
  {%- endif -%}

  <div class="{%if section.settings.layout_style == 'split_right'%} new-page-width{%else%} form_section-container{%endif %}">
    <div class="form_section-grid-container">
      {%- if section.settings.layout_style != 'background' and section.settings.image_desktop != blank -%}
        <div class="form_section-side-image">
          <picture>
            {%- if section.settings.image_mobile != blank -%}
              <source media="(max-width: 992px)" srcset="{{ section.settings.image_mobile | image_url: width: 800 }}">
            {%- endif -%}
            <img src="{{ section.settings.image_desktop | image_url: width: 1200 }}" alt="{{ section.settings.image_desktop.alt | escape }}" class="form_section-col-img" loading="lazy">
          </picture>
        </div>
      {%- endif -%}

      <div class="form_section-form-content">
        {%- if section.settings.logo_image != blank -%}
          <div class="form_section-logo-wrapper">
            <img src="{{ section.settings.logo_image | image_url: width: 300 }}" alt="{{ section.settings.logo_image.alt | escape }}" class="form_section-logo" loading="lazy">
          </div>
        {%- endif -%}
        {%- if section.settings.tag_line != blank -%}
          <div class="form_section-tag_line-wrapper">
            <p class="tag_line">{{ section.settings.tag_line }}</p>
          </div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="form_section-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="form_section-subheading">{{ section.settings.subheading }}</div>
        {%- endif -%}

        <div class="form-wrapper" id="formWrapper-{{ section.id }}" style="position: relative; min-height: 400px;">
          <div class="form-loader" id="formLoader-{{ section.id }}">
            <div class="spinner"></div>
            <p>Loading form...</p>
          </div>
          {{ section.settings.formBlock }}
        </div>
      </div>
    </div>
  </div>

  {% if section.settings.formNote != blank %}
    <p class="form_section-note custom_body-text italic">{{ section.settings.formNote }}</p>
  {% endif %}
</div>

<style>
  {% if section.settings.formBlock contains 'class="hs-form-frame"' %}
    .hs-form-frame{background: #fff; border-radius: 20px;}
  {% endif %}
    .form_section {
      position: relative;
      {% if section.settings.image_desktop == blank %}
        background: url("https://cdn.shopify.com/s/files/1/0057/8958/1381/files/btg-topography-new.svg?v=1768554403") center center / cover no-repeat;
      {% endif %}
      background-color: {{ section.settings.sectionBackgroundClr }};
      padding-block: clamp(60px, 6vw, 91px);
      overflow: hidden;
    }

    /* Background Image Style */
    .form_section-image-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      pointer-events: none;
    }

    .form_section-bg-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    .layout-background .form_section-image-bg {
      display: block;
    }

    .layout-split_left .form_section-image-bg,
    .layout-split_right .form_section-image-bg {
      display: none;
    }

    .form_section-container {
      position: relative;
      z-index: 2;
      max-width: 1184px;
      width: 100%;
      padding-inline: 20px;
      margin-inline: auto;
    }

    /* Grid Layouts */
    .form_section-grid-container {
      display: flex;
      flex-direction: column;
      gap: 30px;
    }

    .layout-background .form_section-grid-container {
      align-items: center;
    }

    .layout-background .form_section-form-content {
      width: 100%;
      max-width: 650px;
    }

    @media (min-width: 992px) {
      .layout-split_left .form_section-grid-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 50px;
      }
      .layout-split_right .form_section-grid-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: 50px;
      }
         .layout-split_right .form_section-side-image {
        order: 2;
        position: absolute;
        right: 0;
        max-width: 1480px;
    }
      .layout-split_right .form_section-form-content {
        order: 1;
            z-index: 9;
      }
    }

    .form_section-side-image {
      width: 100%;
    }

    .form_section-col-img {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 16px;
      object-fit: contain;
    }

    .form_section-logo-wrapper {
      margin-bottom: 25px;
    }

    .form_section-logo {
      max-height: 50px;
      width: auto;
      object-fit: contain;
      display: block;
    }

    .form_section-heading {
      font-size: clamp(38px, 3.5vw, 62px);
      font-weight: 900;
      line-height: 1.1;
      color: #ffffff;
      text-transform: uppercase;
      margin: 0 0 15px 0;
      letter-spacing: -0.02em;
      {% comment %} font-style: italic; {% endcomment %}
    }

    .form_section-tag_line-wrapper .tag_line {
  color: #9B9DA3;
  font-weight: 900;
  letter-spacing: 2.4px;
  line-height: 120%;
  padding: 0;
  margin-bottom: 10px;
  font-size: clamp(16px,1.5vw,24px);
}

    .form_section-subheading {
      font-size: clamp(14px, 1.5vw, 16px);
      line-height: 1.5;
      {% comment %} color: #b0b5c1; {% endcomment %}
      color: #fff;
      margin: 0 0 30px 0;
      max-width: clamp(250px,32vw,550px);
    }

    {% if section.settings.formNote != blank %}
      .form_section-note {
        position: relative;
        z-index: 2;
        padding: 0;
        color: #9B9DA3;
        max-width: 630px;
        text-align: center;
        margin-inline: auto;
        margin-block: clamp(20px, 2.9vw, 50px) 0;
      }
    {% endif %}

    .form-wrapper {
      position: relative;
      min-height: 400px;
      overflow: hidden;
    }

    .form-loader {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: rgba(0, 0, 0, 0.04);
      z-index: 10;
      transition: opacity 0.4s ease;
    }

    .form-loader .spinner {
      width: 48px;
      height: 48px;
      border: 5px solid var(--new-black);
      border-top: 5px solid #fff;
      border-radius: 50%;
      animation: spin 1s linear infinite;
      margin-bottom: 16px;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .form-loader p {
      margin: 0;
      font-size: 1.1rem;
      color: #9B9DA3;
    }

    .form-wrapper.loaded .form-loader {
      display: none !important;
    }

    @media only screen and (max-width: 991px){
      .layout-split_right .form_section-form-content {
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
  z-index: 1;
}

.layout-split_right .form_section-heading {margin: 0 0 360px 0;}
.layout-split_right.form_section{padding-block: 10px clamp(60px, 6vw, 91px);}
.layout-split_right .form_section-side-image{position: absolute;
  {%if mobile_image_center %}
    top: 53%;
    {%else %}
      top: 24%;
      {%endif %}
      left: 50%;
      transform: translate(-50%, -50%);}
    }
    @media only screen and (max-width: 380px){
      .layout-split_right .form_section-side-image{
  {%if mobile_image_center %}
  top: 49%;
  {%else %}
    top: 24%;
    {%endif %}
}
    }
    @media only screen and (max-width: 320px){
      .layout-split_right .form_section-side-image{
  {%if mobile_image_center %}
  top: 45%;
  {%else %}
    top: 24%;
    {%endif %}
}
    }

</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const wrapper = document.getElementById('formWrapper-{{ section.id }}');
    if (!wrapper) return;

    const observer = new MutationObserver(function(mutations, obs) {
      const hasForm = wrapper.querySelector(
        'form, .klaviyo-form, .hs-form-frame, .hs-form, .hs-form-field, iframe, input[type="email"], .klaviyo-form-trigger'
      );

      const hasContent = wrapper.children.length > 1 ||
                         wrapper.innerHTML.includes('klaviyo') ||
                         wrapper.innerHTML.includes('hbspt') ||
                         wrapper.innerHTML.includes('hubspot');
               {% unless section.settings.formBlock contains 'class="hs-form-frame"' %}

                 setTimeout(() => {
               {% endunless %}
               if (hasForm || hasContent) {
                wrapper.classList.add('loaded');
                obs.disconnect();
              }

            {% unless section.settings.formBlock contains 'class="hs-form-frame"' %}

            }, 4200);
            {% endunless %}
    });

    observer.observe(wrapper, { childList: true, subtree: true, characterData: true });

    setTimeout(() => {
      wrapper.classList.add('loaded');
    }, 10000);

    window.addEventListener('klaviyoForms', function(e) {
      if (e.detail && (e.detail.type === 'embedOpen' || e.detail.type === 'open' || e.detail.type === 'render')) {
        wrapper.classList.add('loaded');
      }
    }, { once: true });
  });
</script>

{% schema %}
{
  "name": "Form Section",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout Style",
      "options": [
        {
          "value": "background",
          "label": "Image as Background"
        },
        {
          "value": "split_left",
          "label": "Image Left, Form Right"
        },
        {
          "value": "split_right",
          "label": "Image Right, Form Left"
        }
      ],
      
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image (Above Heading)"
    },
    {
      "type": "checkbox",
      "id": "mobile_image_center",
      "label": "Center Image in mobile"
    },
    
    {
      "type": "textarea",
      "id": "tag_line",
      "label": "Tag Line"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      
    },
    {
      "type": "liquid",
      "id": "formBlock",
      "label": "Paste Embed Code For Form."
    },
    {
      "type": "text",
      "id": "formNote",
      "label": "Note Here"
    },
    {
      "type": "color",
      "id": "sectionBackgroundClr",
      "label": "Background Color",
      "alpha": true,
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Form Section"
    }
  ]
}
{% endschema %}
