                    <stop offset="1" stop-opacity="0" />
                  </radialGradient>
                </defs>
              </svg>
            {%- endif -%}
          </h2>
        </div>

        <!-- Description Paragraph -->
        <div class="comp-game-ai__desc custom_body-text">
          {{
            section.settings.description
            | default: 'Player Pro supercharges your round with the power of the GAME app’s integrated AI. By analyzing real-time course data, your positioning, and playing conditions, it delivers you the True Distance™ to the hole, audible caddie advice using Scout AI™, and intelligent Club Recommendations to dial in your game.'
          }}
        </div>

        {%- if section.settings.button_text != blank -%}
          {%- assign ai_btn_url = section.settings.button_url | default: '#' -%}
          {% render 'cta-button',
            text: section.settings.button_text,
            url: ai_btn_url,
            type: 'link',
            variant: 'solid',
            class: 'comp-game-ai__cta-btn'
          %}
        {%- endif -%}
      </div>
    </div>

    <!-- Bottom Slider / Carousel Area: Custom Left-Aligned Slider -->
    <div class="comp-game-ai__slider-wrapper">
      <div
        class="comp-game-ai__slider"
        id="comp-game-ai-slider-{{ section.id }}"
      >
        <div class="comp-game-ai__slider-track" data-game-ai-slider-track>
          {%- for block in section.blocks -%}
            <div
              class="comp-game-ai__slide{% if forloop.first %} is-active{% endif %}"
              data-slide-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {% render 'comp-showcase-card',
                block: block,
                is_active: forloop.first,
                card_class: 'comp-game-ai__card',
                video_data_attr: 'data-game-ai-video',
                show_mute: false
              %}
            </div>
          {%- endfor -%}
        </div>
      </div>

      <!-- Slider Navigation & Progress Controls -->
      <div class="comp-game-ai__nav-row">
        <button
          type="button"
          class="comp-game-ai__arrow comp-game-ai__arrow--prev"
          data-game-ai-prev
          aria-label="Previous slide"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="comp-game-ai__progress-track" data-game-ai-track>
          <div class="comp-game-ai__progress-bar" data-game-ai-bar></div>
        </div>

        <button
          type="button"
          class="comp-game-ai__arrow comp-game-ai__arrow--next"
          data-game-ai-next
          aria-label="Next slide"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .comp-game-ai {
    position: relative;
    width: 100%;
    background-color: var(--cgai-bg, #000000);
    background-image: var(--cgai-bg-grad, linear-gradient(180deg, #1B1E22 0%, #000000 100%));
    padding-top: clamp(30px, 6vw, var(--cgai-pt, 80px));
    padding-bottom: clamp(30px, 6vw, var(--cgai-pb, 100px));
    overflow: hidden;
    color: #FFFFFF;
    box-sizing: border-box;
  }

  @media (max-width: 768px) {
    .comp-game-ai {
      padding-top: 30px;
      padding-bottom: 30px;
    }
  }

  /* Background Video Layer */
  .comp-game-ai__bg-video-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .comp-game-ai__bg-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .comp-game-ai__video--mobile {
    display: none !important;
  }

  @media (max-width: 1280px) {
    .comp-game-ai__bg-video{object-position: 39%;}
  }
  @media (max-width: 1180px) {
    .comp-game-ai__bg-video{object-position: 36%;}
  }
  @media (max-width: 1024px) {
    .comp-game-ai__video--desktop {
      display: none !important;
    }
    .comp-game-ai__video--mobile {
      display: block !important;
    }
  }
  @media (max-width: 620px) {
    .comp-game-ai__bg-video{height: 88%;}
  }
  @media (max-width: 480px) {
    .comp-game-ai__bg-video{height: 80%;}
    .comp-game-ai__hero-stage-placeholder{min-height: 320px !important;}
    {%if product.template_suffix == 'player-pro' %}
      .comp-game-ai__bg-video{height: 88%;}
          .comp-game-ai__hero-stage-placeholder {
        min-height: 380px !important;
    }
    {% endif %}
  }

  /* Glow Layer */
  .comp-game-ai__bg-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .comp-game-ai__glow-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
  }

  .comp-game-ai__glow-fallback {
    position: absolute;
    top: 5%;
    left: 50%;
    transform: translateX(-50%);
    width: 120%;
    height: 900px;
    background: radial-gradient(55% 50% at 35% 35%, rgba(0, 149, 255, 0.45) 0%, rgba(93, 39, 241, 0.35) 45%, rgba(0, 0, 0, 0) 80%),
                radial-gradient(45% 45% at 75% 30%, rgba(0, 69, 255, 0.35) 0%, rgba(0, 0, 0, 0) 75%);
    filter: blur(50px);
  }

  .comp-game-ai.has-bg-video {
    background-image: none;
  }

  .comp-game-ai__inner {
    position: relative;
    z-index: 2;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
    box-sizing: border-box;
  }

  /* Top Hero Area */
  .comp-game-ai__hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 40px;
    align-items: center;
    /* margin-bottom: 70px; */
  }

  /* Left Hero Stage - Clean Single Image */
  .comp-game-ai__hero-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .comp-game-ai__hero-stage-img,
  .comp-game-ai__hero-stage-video {
    width: 100%;
    max-width: 650px;
    height: auto;
    display: block;
    object-fit: contain;
    border-radius: 12px;
    filter: drop-shadow(0 20px 45px rgba(0, 0, 0, 0.7));
  }

  .comp-game-ai__hero-stage-placeholder {
    width: 100%;
    min-height: 480px;
    border: 2px dashed rgba(255, 255, 255, 0.25);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.6);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Right Hero Content */
  .comp-game-ai__hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 530px;
    margin: 0 auto;
  }

  .comp-game-ai__promo-badge {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-bottom: 20px;
  }

  .comp-game-ai__promo-top {
