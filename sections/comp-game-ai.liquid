                <defs>
                  <radialGradient id="paint0_radial_8771_2675" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse"
                    gradientTransform="translate(358.528 50.4093) rotate(90) scale(47.0851 80.5516)">
                    <stop stop-color="#0095FF" />
                    <stop offset="1" stop-opacity="0" />
                  </radialGradient>
                  <radialGradient id="paint1_radial_8771_2675" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse"
                    gradientTransform="translate(127.423 62.593) rotate(90) scale(62.593 127.423)">
                    <stop stop-color="#5D27F1" />
                    <stop offset="1" stop-opacity="0" />
                  </radialGradient>
                  <radialGradient id="paint2_radial_8771_2675" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse"
                    gradientTransform="translate(305.738 50.1309) rotate(90) scale(46.8067 79.8862)">
                    <stop stop-color="#2B00FF" />
                    <stop offset="1" stop-opacity="0" />
                  </radialGradient>
                  <radialGradient id="paint3_radial_8771_2675" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse"
                    gradientTransform="translate(354.696 57.1194) rotate(90) scale(39.8206 69.5783)">
