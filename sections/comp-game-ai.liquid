                  transform="matrix(0.999836 0.0181257 -0.0615513 0.998104 236.133 -2.26562)"
                  fill="url(#paint1_radial_8771_2675)" />
                <ellipse cx="305.738" cy="50.1309" rx="79.8862" ry="46.8067" fill="url(#paint2_radial_8771_2675)" />
                <ellipse cx="354.695" cy="57.1194" rx="69.5783" ry="39.8206" fill="url(#paint3_radial_8771_2675)" />
                <mask id="stroke0_8771_2675" maskUnits="userSpaceOnUse" x="295.445" y="28.5801" width="101" height="56"
                  fill="black">
                  <rect fill="white" x="295.445" y="28.5801" width="101" height="56" />
                  <path
                    d="M299.736 81.5801L333.471 30.9954H349.871L365.649 81.5801H347.657L339.318 50.5096C339.111 49.7715 338.938 49.1602 338.799 48.6758C338.684 48.1914 338.58 47.7301 338.488 47.2919H338.384C338.13 47.7301 337.865 48.1914 337.588 48.6758C337.335 49.1372 336.966 49.76 336.481 50.5442L317.175 81.5801H299.736ZM314.683 72.4112L320.946 62.0313H351.567L354.023 72.4112H314.683ZM368.453 81.5801L377.345 31.203H393.607L384.714 81.5801H368.453Z" />
