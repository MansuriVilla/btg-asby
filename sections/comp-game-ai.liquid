{%- liquid
  assign bg_color = section.settings.bg_color | default: '#000000'
  assign bg_gradient = section.settings.bg_gradient | default: 'linear-gradient(180deg, #1B1E22 0%, #000000 100%)'
  assign glow_image = section.settings.glow_image
  assign hero_stage_image = section.settings.hero_stage_image
  assign section_bg_video = section.settings.section_bg_video
  assign section_bg_video_url = section.settings.section_bg_video_url
  assign section_bg_video_mobile = section.settings.section_bg_video_mobile
  assign section_bg_video_mobile_url = section.settings.section_bg_video_mobile_url
  assign has_mobile_bg_video = false
  if section_bg_video_mobile != blank or section_bg_video_mobile_url != blank
    assign has_mobile_bg_video = true
  endif
  assign hero_stage_video_mobile = section.settings.hero_stage_video_mobile
  assign hero_stage_video_mobile_url = section.settings.hero_stage_video_mobile_url
  assign has_mobile_hero_video = false
  if hero_stage_video_mobile != blank or hero_stage_video_mobile_url != blank
    assign has_mobile_hero_video = true
  endif
  assign section_bg_video_opacity = section.settings.section_bg_video_opacity | default: 100 | divided_by: 100.0
  assign section_id = section.settings.custom_section_id | default: ''
  if section_id == blank
    assign section_id = 'CompGameAI-' | append: section.id
  endif
-%}

<div
  id="{{ section_id }}"
  class="comp-game-ai section-{{ section.id }}{% if section_bg_video != blank or section_bg_video_url != blank or has_mobile_bg_video %} has-bg-video{% endif %}"
  style="
    --cgai-bg: {{ bg_color }};
    {% if bg_gradient != blank %}--cgai-bg-grad: {{ bg_gradient }};{% endif %}
    --cgai-pt: {{ section.settings.padding_top | default: 80 }}px;
    --cgai-pb: {{ section.settings.padding_bottom | default: 100 }}px;
    {% if section.settings.card_width != blank %}
      --cgai-card-width: {{ section.settings.card_width }}px;
    {% endif %}
  "
>
  {%- comment -%} Section Background Video Layer {%- endcomment -%}
  {%- if section_bg_video != blank or section_bg_video_url != blank or has_mobile_bg_video -%}
    {%- assign desktop_bg_video_class = 'comp-game-ai__bg-video' -%}
    {%- if has_mobile_bg_video -%}
      {%- assign desktop_bg_video_class = 'comp-game-ai__bg-video comp-game-ai__video--desktop' -%}
    {%- endif -%}
    <div class="comp-game-ai__bg-video-wrap" style="opacity: {{ section_bg_video_opacity }};" aria-hidden="true">
      {%- if section_bg_video != blank -%}
        {{
          section_bg_video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            playsinline: true,
            controls: false,
            class: desktop_bg_video_class
        }}
      {%- elsif section_bg_video_url != blank -%}
        <video
          class="{{ desktop_bg_video_class }}"
          autoplay
          loop
          muted
          playsinline
          preload="auto"
        >
          <source src="{{ section_bg_video_url }}" type="video/mp4">
        </video>
      {%- endif -%}

      {%- if section_bg_video_mobile != blank -%}
        {{
          section_bg_video_mobile
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            playsinline: true,
            controls: false,
            class: 'comp-game-ai__bg-video comp-game-ai__video--mobile'
        }}
      {%- elsif section_bg_video_mobile_url != blank -%}
        <video
          class="comp-game-ai__bg-video comp-game-ai__video--mobile"
          autoplay
          loop
          muted
          playsinline
          preload="auto"
        >
          <source src="{{ section_bg_video_mobile_url }}" type="video/mp4">
        </video>
      {%- endif -%}
    </div>
  {%- endif -%}
  {% comment %} <!-- Background Glow Layer (Absolute image or CSS radial fallback) -->
  <div class="comp-game-ai__bg-glow" aria-hidden="true">
    {%- if glow_image != blank -%}
      {{
        glow_image
        | image_url: width: 2200
        | image_tag:
          loading: 'lazy',
          decoding: 'async',
          class: 'comp-game-ai__glow-img',
          alt: ''
      }}
    {%- else -%}
      <div class="comp-game-ai__glow-fallback"></div>
    {%- endif -%}
  </div> {% endcomment %}

  <div class="comp-game-ai__inner">
    <!-- Top Hero Area -->
    <div class="comp-game-ai__hero">
      <!-- Left Column: Hero Stage Image or Video -->
      <div class="comp-game-ai__hero-stage" style="opacity:0;">
        {%- assign desktop_hero_class = '' -%}
        {%- if has_mobile_hero_video -%}
          {%- assign desktop_hero_class = ' comp-game-ai__video--desktop' -%}
        {%- endif -%}

        {%- if section.settings.hero_stage_video != blank -%}
          {{
            section.settings.hero_stage_video
            | video_tag:
              autoplay: true,
              loop: true,
              muted: true,
              playsinline: true,
              image_size: '1400x',
              class: 'comp-game-ai__hero-stage-video' | append: desktop_hero_class
          }}
        {%- elsif section.settings.hero_stage_video_url != blank -%}
          <video
            class="comp-game-ai__hero-stage-video{{ desktop_hero_class }}"
            autoplay
            loop
            muted
            playsinline
            {% if section.settings.hero_stage_image != blank %}
              poster="{{ section.settings.hero_stage_image | image_url: width: 1400 }}"
            {% endif %}
          >
            <source src="{{ section.settings.hero_stage_video_url }}" type="video/mp4">
          </video>
        {%- elsif section.settings.hero_stage_image != blank -%}
          {{
            section.settings.hero_stage_image
            | image_url: width: 1400
            | image_tag:
              loading: 'eager',
              decoding: 'async',
              class: 'comp-game-ai__hero-stage-img' | append: desktop_hero_class,
              alt: section.settings.promo_text | default: 'Game AI Speaker & Features'
          }}
        {%- elsif has_mobile_hero_video == false -%}
          <!-- Placeholder until media uploaded -->
          <div class="comp-game-ai__hero-stage-placeholder">
            <span>Upload Hero Stage Image or Video in Theme Customizer</span>
          </div>
        {%- endif -%}

        {%- if hero_stage_video_mobile != blank -%}
          {{
            hero_stage_video_mobile
            | video_tag:
              autoplay: true,
              loop: true,
              muted: true,
              playsinline: true,
              image_size: '991x',
              class: 'comp-game-ai__hero-stage-video comp-game-ai__video--mobile'
          }}
        {%- elsif hero_stage_video_mobile_url != blank -%}
          <video
            class="comp-game-ai__hero-stage-video comp-game-ai__video--mobile"
            autoplay
            loop
            muted
            playsinline
            {% if section.settings.hero_stage_image != blank %}
              poster="{{ section.settings.hero_stage_image | image_url: width: 991 }}"
            {% endif %}
          >
            <source src="{{ hero_stage_video_mobile_url }}" type="video/mp4">
          </video>
        {%- endif -%}
      </div>

      <!-- Right Column: Content + Headline + Badges -->
      <div class="comp-game-ai__hero-content">
        <!-- Promo Badge -->
        <div class="comp-game-ai__promo-badge">
          <div class="comp-game-ai__promo-top">
            <span class="comp-game-ai__promo-highlight">{{ section.settings.promo_text | default: '6 MONTHS FREE' }}</span>
            <span class="comp-game-ai__promo-strikethrough">{{ section.settings.promo_orig_price | default: '$39.50' }}</span>
          </div>
          <span class="comp-game-ai__promo-sub">{{ section.settings.promo_subtext | default: 'INCLUDED WITH PURCHASE' }}</span>
        </div>

        <!-- Heading with Gradient Glow -->
        <div class="comp-game-ai__title-wrap" style="--cgai-title-max-width: {{ section.settings.title_max_width | default: 488 }}px;">
          <h2 class="comp-game-ai__title custom_heading">
            {%- if section.settings.enable_glow_blob -%}
              <div class="comp-game-ai__title-glow-blob" aria-hidden="true">
                {%- if section.settings.title_glow_image != blank -%}
                  {{ section.settings.title_glow_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'comp-game-ai__title-glow-img', alt: '' }}
                {%- else -%}
                  <div class="comp-game-ai__title-glow-gradient" style="--cgai-glow-1: {{ section.settings.glow_color_1 | default: '#0095FF' }}; --cgai-glow-2: {{ section.settings.glow_color_2 | default: '#5D27F1' }};"></div>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if section.settings.title_image != blank -%}
              {{ section.settings.title_image | image_url: width: 1000 | image_tag: loading: 'eager', class: 'comp-game-ai__title-img', alt: section.settings.promo_text | default: 'GAME AI' }}
            {%- elsif section.settings.title_svg != blank -%}
              <div class="comp-game-ai__title-custom-svg">
                {{ section.settings.title_svg }}
              </div>
            {%- else -%}
              <svg style="width: 100%;" width="488" height="126" viewBox="0 0 488 126" fill="none" xmlns="http://www.w3.org/2000/svg">
                <ellipse cx="358.528" cy="50.4093" rx="80.5516" ry="47.0851" fill="url(#paint0_radial_8771_2675)" />
