{%- liquid
  assign isModal = false
  if template == 'product.modal'
    assign isModal = true
  endif
-%}

{%- render 'new-pdp-template',
  product: product,
  section_id: section.id,
  blocks: section.blocks,

  image_position: section.settings.image_position,
  image_container_width: section.settings.image_size,
  product_zoom_enable: section.settings.product_zoom_enable,
  sku_enable: section.settings.sku_enable,
  isModal: isModal,
  thumbnail_position: section.settings.thumbnail_position,
  thumbnail_arrows: section.settings.thumbnail_arrows,
  mobile_layout: section.settings.mobile_layout,
  video_looping: section.settings.enable_video_looping,
  video_style: section.settings.product_video_style,

  promo_text: section.settings.promo_text,
  promo_subtitle: section.settings.promo_subtitle,
  promo_link: section.settings.promo_link,
  promo_bg_color: section.settings.promo_bg_color,
  promo_text_color: section.settings.promo_text_color,
  promo_bg_image: section.settings.promo_bg_image,

  enable_sticky_bar: section.settings.enable_sticky_bar,
  sticky_bar_image: section.settings.sticky_bar_image,
  sticky_bar_title: section.settings.sticky_bar_title,
  sticky_bar_badge: section.settings.sticky_bar_badge,
  sticky_nav_1_label: section.settings.sticky_nav_1_label,
  sticky_nav_1_anchor: section.settings.sticky_nav_1_anchor,
  sticky_nav_2_label: section.settings.sticky_nav_2_label,
  sticky_nav_2_anchor: section.settings.sticky_nav_2_anchor,
  sticky_nav_3_label: section.settings.sticky_nav_3_label,
  sticky_nav_3_anchor: section.settings.sticky_nav_3_anchor,
  sticky_nav_4_label: section.settings.sticky_nav_4_label,
  sticky_nav_4_anchor: section.settings.sticky_nav_4_anchor,
  sticky_nav_5_label: section.settings.sticky_nav_5_label,
  sticky_nav_5_anchor: section.settings.sticky_nav_5_anchor
-%}
