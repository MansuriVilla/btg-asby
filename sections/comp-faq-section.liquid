{% liquid
  assign s_id = section.id
  assign section_id = section.settings.custom_section_id | default: ''
  if section_id == blank
    assign section_id = 'comp-faq-' | append: s_id
  endif
  assign bg_color = section.settings.background_color | default: '#ffffff'
  assign padding_top = section.settings.padding_top | default: 60
  assign padding_bottom = section.settings.padding_bottom | default: 60
  assign tabs_list = section.settings.tabs | default: 'Hardware,Features,App'
  assign active_tab = section.settings.active_tab | default: 'Hardware'
%}

<div
  class="comp-faq-section comp-faq-section-{{ s_id }}"
  id="{{ section_id }}"
  style="--comp-faq-bg: {{ bg_color }}; --comp-faq-pt: {{ padding_top }}px; --comp-faq-pb: {{ padding_bottom }}px;"
>
  <div class="comp-faq-container">
    <div class="comp-faq-grid">
      
      {% comment %} Left Column: Media Image {% endcomment %}
      <div class="comp-faq-media-col">
        <div class="comp-faq-media-card">
          {% if section.settings.image != blank %}
            {{ section.settings.image | image_url: width: 1200 | image_tag: 
               loading: 'lazy', 
               class: 'comp-faq-media-img', 
               alt: section.settings.image.alt | default: 'FAQ Product Image' 
            }}
          {% else %}
            <img
              src="{{ 'player-speaker-img.png' | asset_url }}"
              alt="Player Pro Speaker on Golf Bag"
              class="comp-faq-media-img fallback-img"
              loading="lazy"
              onerror="this.onerror=null; this.src='{{ 'mobile-speaker-img.png' | asset_url }}';"
            >
          {% endif %}
        </div>
      </div>

      {% comment %} Right Column: Content (Heading, Tabs, Accordion) {% endcomment %}
      <div class="comp-faq-content-col">
        
        {% comment %} Micro-component: Heading {% endcomment %}
        {% render 'comp-faq-heading', 
           title: section.settings.heading, 
           tag: 'h2', 
           color: section.settings.heading_color 
        %}

        {% comment %} Micro-component: Tabs / Labels {% endcomment %}
        {% render 'comp-faq-tabs', 
           tabs: tabs_list, 
           active_tab: active_tab, 
           section_id: s_id 
        %}

        {% comment %} Micro-component: Whole Accordion Container {% endcomment %}
        <div class="comp-faq-accordion-holder">
          {% capture accordion_items %}
            {% for block in section.blocks %}
              {% render 'comp-faq-item',
                 id: block.id,
                 question: block.settings.question,
                 answer: block.settings.answer,
                 category: block.settings.category,
                 is_open: block.settings.is_open
              %}
            {% endfor %}
          {% endcapture %}

          {% render 'comp-faq-accordion', 
             section_id: s_id, 
             content: accordion_items 
          %}
        </div>

      </div>

    </div>
  </div>
</div>

<style>
  .comp-faq-section-{{ s_id }} {
    background-color: var(--comp-faq-bg, #ffffff);
    padding-top: clamp(1.8rem, 1.2rem + 2.5vw, 4.5rem);
    padding-bottom: clamp(1.8rem, 1.2rem + 2.5vw, 4.5rem);
    width: 100%;
    position: relative;
  }

  .comp-faq-section-{{ s_id }} .comp-faq-container {
    max-width: min(100% - clamp(1.5rem, 3vw, 3rem), 78.75rem);
    margin: 0 auto;
    padding: 0 clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
    width: 100%;
  }

  .comp-faq-section-{{ s_id }} .comp-faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 46%) minmax(0, 54%);
    gap: clamp(1.75rem, 1rem + 2.5vw, 3.5rem);
    align-items: flex-start;
  }

  .comp-faq-section-{{ s_id }} .comp-faq-media-col {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .comp-faq-section-{{ s_id }} .comp-faq-media-card {
    width: 100%;
    max-width: min(100%, 32.5rem);
    aspect-ratio: 4 / 4.75;
    border-radius: 10px;
    overflow: hidden;
    position: relative;
    background-color: #f1f5f9;
    {% comment %} box-shadow: 0 12px 32px -8px rgba(15, 23, 42, 0.08); {% endcomment %}
  }

  .comp-faq-section-{{ s_id }} .comp-faq-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: inherit;
    transition: transform 0.4s ease;
  }

  .comp-faq-section-{{ s_id }} .comp-faq-media-card:hover .comp-faq-media-img {
    transform: scale(1.02);
  }

  .comp-faq-section-{{ s_id }} .comp-faq-content-col {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  @media (max-width: 991px) {
    .comp-faq-section-{{ s_id }} .comp-faq-grid {
      grid-template-columns: 1fr;
      gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    }

    .comp-faq-section-{{ s_id }} .comp-faq-media-card {
      max-width: 100%;
      aspect-ratio: 16 / 11;
    }
  }

  @media (max-width: 640px) {
    .comp-faq-section-{{ s_id }} .comp-faq-media-card {
      aspect-ratio: 1 / 1;
      border-radius: clamp(0.9rem, 0.7rem + 0.8vw, 1.25rem);
    }
  }
</style>

{% schema %}
{
  "name": "FAQ Pro Showcase",
  "tag": "section",
  "class": "section-comp-faq",
  "settings": [
    {
      "type": "text",
      "id": "custom_section_id",
      "label": "Section Anchor ID",
      "info": "Optional custom HTML ID for anchor navigation (e.g. faqs, faq). Do not include '#'"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Showcase Image"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "GOT QUESTIONS?\nWE'VE GOT ANSWERS."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#0f172a"
    },
    {
      "type": "text",
      "id": "tabs",
      "label": "Category Tabs (comma-separated)",
      "default": "Hardware,Features,App"
    },
    {
      "type": "text",
      "id": "active_tab",
      "label": "Default Active Tab",
      "default": "Hardware"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Tab Category",
          "default": "Hardware",
          "info": "Matches tab name: e.g. Hardware, Features, App"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Frequently Asked Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Provide a detailed and helpful response to answer customer inquiries clearly.</p>"
        },
        {
          "type": "checkbox",
          "id": "is_open",
          "label": "Open by Default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Pro Showcase",
      "settings": {
        "heading": "GOT QUESTIONS?\nWE'VE GOT ANSWERS.",
        "tabs": "Hardware,Features,App",
        "active_tab": "Hardware"
      },
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "How loud is the 360° audio compared to the Player+?",
            "answer": "<p>Player Pro uses a redesigned acoustic chamber that pushes sound evenly in all directions, not just forward. It gets significantly louder without distorting, and golfers can hear crisp vocals and bass even when the speaker is mounted on the cart, bag, or behind them on the tee box.</p>",
            "is_open": true
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "Is the Player Pro fully waterproof?",
            "answer": "<p>Player Pro features an IPX7 waterproof rating, allowing it to withstand heavy rain, splashes, and even submersion in water up to 1 meter for 30 minutes.</p>",
            "is_open": false
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "How responsive is the touchscreen outdoors?",
            "answer": "<p>The ultra-bright touchscreen is engineered specifically for outdoor visibility with anti-glare technology and responsive touch even when wearing golf gloves or in damp conditions.</p>",
            "is_open": false
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "What does “unlimited paring via Auracast” mean?",
            "answer": "<p>Auracast broadcast audio allows you to seamlessly connect an unlimited number of compatible speakers together, synchronizing music across multiple carts and groups across the course.</p>",
            "is_open": false
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "Will the magnet hold on fast-moving carts or rough terrain",
            "answer": "<p>Engineered with industrial-grade Neodymium magnets, Player Pro locks firmly onto golf cart frames and stays secure over bumpy cart paths and rough terrain.</p>",
            "is_open": false
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "category": "Hardware",
            "question": "Do I need to be on golf course to use Player Pro?",
            "answer": "<p>No! While Player Pro includes course GPS and golfing features, it works as a world-class premium Bluetooth speaker anywhere you go—at the pool, beach, tailgates, or home.</p>",
            "is_open": false
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "category": "Features",
            "question": "How does GPS distance tracking work?",
            "answer": "<p>Player Pro connects to satellites directly to deliver precision yardages to the front, center, and back of greens on over 40,000 courses worldwide.</p>",
            "is_open": false
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "category": "Features",
            "question": "Can I keep score on the speaker?",
            "answer": "<p>Yes, you can track your score, putts, and driving accuracy right from the touchscreen and sync it directly to the mobile app.</p>",
            "is_open": false
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "category": "App",
            "question": "Is the companion app free?",
            "answer": "<p>Yes, the Blue Tees Game app is free to download on iOS and Android with full access to 3D course maps and statistics tracking.</p>",
            "is_open": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
