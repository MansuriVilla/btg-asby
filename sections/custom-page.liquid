  document.addEventListener('DOMContentLoaded', () => {
    // Dynamic aria-label for LEARN MORE links (Issue 128)
    document.querySelectorAll('.card').forEach(card => {
      const productNameEl = card.querySelector('.product-name');
      if (productNameEl && productNameEl.textContent.trim()) {
        const productName = productNameEl.textContent.trim();
        const learnMoreLink = Array.from(card.querySelectorAll('a')).find(
          a => a.textContent.trim().toUpperCase() === 'LEARN MORE'
        );
        if (learnMoreLink) {
          learnMoreLink.setAttribute('aria-label', `Learn more about ${productName}`);
        }
      }
    });

    const menuItems = document.querySelectorAll('.tab_nav .tab_item');
    const contentSections = document.querySelectorAll('.cards-container');

    const showContent = (targetId) => {
      contentSections.forEach((section) => section.classList.remove('active'));

      const targetContent = document.getElementById(targetId);
      if (targetContent) {
        targetContent.classList.add('active');
      }
    };

    const updateAria = (activeTargetId) => {
      menuItems.forEach((item) => {
        const isSelected = item.getAttribute('data-target') === activeTargetId;
        item.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        item.setAttribute('tabindex', isSelected ? '0' : '-1');
      });
    };

    menuItems.forEach((item, index) => {
      item.addEventListener('click', (e) => {
        e.preventDefault();

        menuItems.forEach((btn) => btn.parentElement.classList.remove('active'));
        item.parentElement.classList.add('active');

        const targetId = item.getAttribute('data-target');
        showContent(targetId);
        updateAria(targetId);

        sessionStorage.setItem('activeContent', targetId);
      });

      // Handle keyboard arrow navigation
      item.addEventListener('keydown', (e) => {
        let nextIndex;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          nextIndex = (index + 1) % menuItems.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          nextIndex = (index - 1 + menuItems.length) % menuItems.length;
        } else {
          return;
        }
        e.preventDefault();
        menuItems[nextIndex].focus();
        menuItems[nextIndex].click();
      });
    });

    const savedContentId = sessionStorage.getItem('activeContent');
    if (savedContentId) {
      showContent(savedContentId);
      updateAria(savedContentId);

      menuItems.forEach((item) => {
        const link = item;
        if (link.getAttribute('data-target') === savedContentId) {
          item.parentElement.classList.add('active');
        }
      });
    } else {
      showContent('most-popular');
      updateAria('most-popular');
      menuItems[0].parentElement.classList.add('active');
    }

