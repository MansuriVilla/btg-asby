    function videoControlling(videoId, iconId) {
      const video = document.getElementById(videoId);
      const icon = document.getElementById(iconId);

      if (!video || !icon) return;

      icon.addEventListener('click', function () {
        if (video.paused) {
          video.play();
          video.muted = false;
          icon.style.display = 'none';
        }
      });

      video.addEventListener('click', function () {
        if (!video.paused) {
          video.pause();
          video.muted = true;
          icon.style.display = 'block';
        }
      });

      video.addEventListener('ended', function () {
        icon.style.display = 'block';
        video.currentTime = 0;
        video.muted = true;
      });
    }

    // Initialize for both desktop and mobile
    videoControlling('preview-video-2', 'video_block-icon-desktop');
    videoControlling('preview-video-2', 'video_block-icon-mobile');
  });
</script>

<script type="text/javascript">
  var lastFocusedElement;

  function trapFocus(element) {
    var KEYCODE_TAB = 9;

    $(element).off('keydown.trap').on('keydown.trap', function(e) {
      var isTabPressed = (e.key === 'Tab' || e.keyCode === KEYCODE_TAB);
      if (!isTabPressed) { 
        return; 
      }
      
      var focusableEls = element.querySelectorAll('a[href]:not([disabled]), button:not([disabled]), textarea:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), [tabindex]:not([tabindex="-1"])');
      var visibleFocusableEls = Array.prototype.filter.call(focusableEls, function(el) {
        return el.offsetWidth > 0 || el.offsetHeight > 0 || el.getClientRects().length > 0;
      });

      if (visibleFocusableEls.length === 0) return;

      var firstFocusableEl = visibleFocusableEls[0];  
      var lastFocusableEl = visibleFocusableEls[visibleFocusableEls.length - 1];

      if (e.shiftKey) /* shift + tab */ {
        if (document.activeElement === firstFocusableEl) {
          lastFocusableEl.focus();
          e.preventDefault();
        }
      } else /* tab */ {
        if (document.activeElement === lastFocusableEl) {
          firstFocusableEl.focus();
          e.preventDefault();
        }
      }
    });
  }

  function closeModal() {
    $('.pop-upbox').fadeOut(function () {
      if (lastFocusedElement) {
        lastFocusedElement.focus();
      }
    });
    var video1 = $('#video1').get(0);
    if(video1) video1.pause();
    $(document).off('keydown.modal');
  }

  $('.poptrigger').click(function (e) {
    e.preventDefault();
    lastFocusedElement = document.activeElement;
    var popID = $(this).attr('data-rel');
    var $modal = $('#' + popID);
    
    $modal.fadeIn(function() {
      // Focus first interactive element or the dialog itself
      var $focusable = $modal.find('a[href]:not([disabled]), button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])').filter(':visible');
      if ($focusable.length) {
        $focusable.first().focus();
      } else {
        $modal.attr('tabindex', '-1').focus();
      }
    });

    var video = $modal.find('#video1').get(0);
    if (video && typeof video.play === 'function') {
      video.play();
    }
    
    trapFocus($modal[0]);
    
    // Add Esc key listener
    $(document).off('keydown.modal').on('keydown.modal', function(e) {
      if (e.key === 'Escape' || e.keyCode === 27) {
        closeModal();
      }
    });
    
    return false;
  });

  $(document).on('click', '.closePop, #fade', function (e) {
    e.preventDefault();
    closeModal();
    return false;
  });

  $(document).on('click', function (event) {
    if ($(event.target).has('.popup-box').length) {
      closeModal();
    }
  });
</script>

