    // slideInView();



    function slideInView() {
      const container = document.querySelector('.slide_in-view__container .slide_in-view__row');
      const imagesContainer = document.querySelector('.slide_in-view__images');
      const items = imagesContainer ? imagesContainer.querySelectorAll('.picture_cloning') : [];
      const toggleBtn = document.getElementById('slider-toggle');

      if (!container || !imagesContainer || items.length === 0 || !toggleBtn) {
        console.warn('Slide-in view elements not found');
        return;
      }

      imagesContainer.id = 'slider-images-container';

      // Clone items once for infinite loop
      if (!imagesContainer.dataset.cloned) {
        imagesContainer.dataset.cloned = 'true';
        items.forEach((item) => {
          const clone = item.cloneNode(true);
          imagesContainer.appendChild(clone);
        });
      }

      let sliderTween = null;
      let isPlaying = true;
      let initSlides = false;

      function startMarquee() {
        const singleSetWidth = imagesContainer.scrollWidth / 2;

        sliderTween = gsap.to(imagesContainer, {
          x: -singleSetWidth,
          ease: 'none',
          duration: 40,
          repeat: -1,
        });
      }

      ScrollTrigger.create({
        trigger: container,
        start: 'top 80%',
        end: 'top top',
        markers: false,
        onEnter: () => {
          if (initSlides) return;
          initSlides = true;

          gsap.set('.slide_in-view__images .picture_cloning', {
            opacity: 1,
          });

          startMarquee();
        },
      });

      // Pause on hover
      container.addEventListener('mouseenter', () => {
        if (sliderTween && isPlaying) {
          sliderTween.pause();
        }
      });
      container.addEventListener('mouseleave', () => {
        if (sliderTween && isPlaying) {
          sliderTween.play();
        }
      });

      // Pause on focusin / focusout for keyboard users
      container.addEventListener('focusin', () => {
        if (sliderTween && isPlaying) {
          sliderTween.pause();
        }
      });
      container.addEventListener('focusout', () => {
        if (sliderTween && isPlaying) {
          sliderTween.play();
        }
      });

  // Toggle Play/Pause
  function toggleSlider() {
    if (!sliderTween) return;

    if (isPlaying) {
      sliderTween.pause();
      toggleBtn.setAttribute('aria-label', 'Play slider animation');
      toggleBtn.setAttribute('aria-pressed', 'true');
      toggleBtn.querySelector('.pause-icon').style.display = 'none';
      toggleBtn.querySelector('.play-icon').style.display = 'block';
      toggleBtn.classList.add('paused');
    } else {
      sliderTween.play();
      toggleBtn.setAttribute('aria-label', 'Pause slider animation');
      toggleBtn.setAttribute('aria-pressed', 'false');
      toggleBtn.querySelector('.pause-icon').style.display = 'block';
      toggleBtn.querySelector('.play-icon').style.display = 'none';
      toggleBtn.classList.remove('paused');
    }

    isPlaying = !isPlaying;
  }

  toggleBtn.addEventListener('click', toggleSlider);

  // Keyboard accessibility
  toggleBtn.addEventListener('keydown', (e) => {
    if (e.key === ' ' || e.key === 'Enter') {
      e.preventDefault();
      toggleSlider();
    }
  });

  ScrollTrigger.refresh();
}

