    hbspt.forms.create({
        portalId: '7645267',
        formId: '69feb0ff-964f-4812-a34d-18bfe4f5d980',
        region: 'na1',
        onFormReady: function($form) {
            const form = $form[0] || $form;
            if (!form) return;

            // 1. Required fields note
            const requiredNote = document.createElement('p');
            requiredNote.className = 'hs-a11y-required-note';
            requiredNote.style.color = 'rgb(225, 50, 0)';
            requiredNote.style.fontSize = '14px';
            requiredNote.style.marginBottom = '15px';
            requiredNote.textContent = '* indicates required fields';
            form.insertBefore(requiredNote, form.firstChild);

            // === BORDER + ERROR STYLING FUNCTION ===
            function updateFieldStyles() {
                const fields = form.querySelectorAll('.hs-form-field');

                fields.forEach(field => {
                    const input = field.querySelector('input.hs-input, select.hs-input, textarea.hs-input');
                    if (!input) return;

                    const hasError = field.querySelector('.hs-error-msgs') || 
                                     input.classList.contains('error') || 
                                     input.classList.contains('invalid') ||
                                     input.getAttribute('aria-invalid') === 'true';

                    if (hasError) {
                        // Error State - Red Border
                        input.style.border = '1.4px solid rgb(225, 50, 0)';
                        input.style.boxShadow = '0 0 0 3px rgba(240, 0, 0, 0.1)';
                    } else {
                        // Normal State - Black Border
                        input.style.border = '1.4px solid #000000';
                        input.style.boxShadow = 'none';
                    }
                });
            }

            // Apply initial styles
            updateFieldStyles();

            // 2. Submit Button Styling
            function styleSubmitButton() {
                const submitButton = form.querySelector('button.hs-button, input[type="submit"], .hs-submit .hs-button');
                if (submitButton) {
                    submitButton.style.backgroundColor = '#004df5';
                    submitButton.style.borderColor = '#004df5';
                    submitButton.style.color = '#ffffff';
                    submitButton.style.fontWeight = '600';
                    submitButton.style.borderRadius = '4px';

                    submitButton.addEventListener('mouseenter', () => {
                        submitButton.style.backgroundColor = '#0039cc';
                    });
                    submitButton.addEventListener('mouseleave', () => {
                        submitButton.style.backgroundColor = '#004df5';
                    });
                }
            }
            styleSubmitButton();

            // 3. Error Messages Color + ARIA Alert Wrapper Fix
            const errorObserver = new MutationObserver(() => {
                form.querySelectorAll('.hs-error-msgs').forEach(errorContainer => {
                    // Fix validation error container role on UL element
                    if (errorContainer.tagName === 'UL' && errorContainer.getAttribute('role') === 'alert') {
                        errorContainer.removeAttribute('role');
                        
                        // Wrap the UL in a div with role="alert" for clean semantics
                        if (!errorContainer.parentElement.classList.contains('hs-error-alert-wrapper')) {
                            const wrapper = document.createElement('div');
                            wrapper.className = 'hs-error-alert-wrapper';
                            wrapper.setAttribute('role', 'alert');
                            
                            errorContainer.parentNode.insertBefore(wrapper, errorContainer);
                            wrapper.appendChild(errorContainer);
                        }
                    }

                    errorContainer.style.color = 'rgb(225, 50, 0)';

                    const errorTexts = errorContainer.querySelectorAll('label, li, span, div');
                    errorTexts.forEach(el => el.style.color = 'rgb(225, 50, 0)');
                });

                // Update borders whenever errors appear/disappear
                updateFieldStyles();
            });

            errorObserver.observe(form, { childList: true, subtree: true });

            // 4. Submit handler + error focus
            form.addEventListener('submit', () => {
                setTimeout(() => {
                    updateFieldStyles();   // Update borders on submit
                    const firstError = form.querySelector('.hs-error-msgs, [aria-invalid="true"]');
                    if (firstError) {
                        const field = firstError.closest('.hs-form-field');
                        const input = field ? field.querySelector('input, select, textarea') : null;
                        if (input) input.focus();
                    }
                }, 150);
            });

            // Final observer for dynamic changes
            const mainObserver = new MutationObserver(() => {
                updateFieldStyles();
                styleSubmitButton();
            });
            mainObserver.observe(form, { childList: true, subtree: true });
        }
    });
</script>
