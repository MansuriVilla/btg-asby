            const form = $form[0] || $form;
            if (!form) return;

            // 1. Add mandatory fields instruction note (Issue 137)
            const requiredNote = document.createElement('p');
            requiredNote.className = 'hs-a11y-required-note';
            requiredNote.style.color = '#e02b2b';
            requiredNote.style.fontSize = '14px';
            requiredNote.style.marginBottom = '15px';
            requiredNote.textContent = '* indicates required fields';
            form.insertBefore(requiredNote, form.firstChild);

            // Add aria-required to all required inputs
            form.querySelectorAll('.hs-form-required').forEach(indicator => {
              const field = indicator.closest('.hs-form-field');
              if (field) {
                const input = field.querySelector('input, select, textarea');
                if (input) {
                  input.setAttribute('aria-required', 'true');
                }
              }
            });

            // 2. Intercept submit and handle error focus (Issue 139)
            form.addEventListener('submit', (e) => {
              setTimeout(() => {
                const firstErrorInput = form.querySelector('.invalid, .error, [aria-invalid="true"], .hs-input.error');
                if (firstErrorInput) {
                  firstErrorInput.focus();
                } else {
                  const firstErrorMsg = form.querySelector('.hs-error-msgs');
                  if (firstErrorMsg) {
                    const field = firstErrorMsg.closest('.hs-form-field');
                    const input = field ? field.querySelector('input, select, textarea') : null;
                    if (input) {
                      input.focus();
                    }
                  }
                }
              }, 100);
            });

            // 3. Fix list markup & ARIA role on error lists (Issues 141, 142)
            const observer = new MutationObserver(() => {
              form.querySelectorAll('.hs-error-msgs').forEach(ul => {
                // If only one error, remove list semantics (Issue 141)
                const items = ul.querySelectorAll('li');
                if (items.length === 1) {
                  ul.setAttribute('role', 'presentation');
                }

                // Remove role="alert" from <ul> (Issue 142)
                if (ul.getAttribute('role') === 'alert') {
                  ul.removeAttribute('role');
                }

                // Wrap inside alert container div (Issue 142)
                const inputWrapper = ul.closest('.input');
                if (inputWrapper && !inputWrapper.querySelector('.hs-error-alert-wrapper')) {
                  const alertWrapper = document.createElement('div');
                  alertWrapper.className = 'hs-error-alert-wrapper';
                  alertWrapper.setAttribute('role', 'alert');
                  alertWrapper.setAttribute('aria-live', 'assertive');
                  ul.parentNode.insertBefore(alertWrapper, ul);
                  alertWrapper.appendChild(ul);
                }
              });
            });

            observer.observe(form, {
              childList: true,
              subtree: true
            });
          }
        });
      </script>
    </div>
  </div>
</div>

