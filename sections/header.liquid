{% schema %}
{
  "name": "t:sections.header.name",
  "tag": "header",
  "settings": [
    {
      "type": "header",
      "content": "Mobile top links"
    },
    {
      "type": "text",
      "id": "deal_text",
      "label": "Deal Text"
    },
    {
      "type": "url",
      "id": "deal_link",
      "label": "Deal Link"
    },
    {
      "type": "text",
      "id": "deal_link_text",
      "label": "Deal Link Text"
    },
    {
      "type": "text",
      "id": "deal_link_small_text",
      "label": "Deal Link Small Text"
    },
    {
      "type": "text",
      "id": "deal_right_text",
      "label": "Deal Right Text"
    },
    {
      "type": "url",
      "id": "custom_link",
      "label": "Customs link"
    },
    {
      "type": "text",
      "id": "custom_link_text",
      "label": "Custom link text"
    },
    {
      "type": "url",
      "id": "limited_drop_link",
      "label": "Limted drop link"
    },
    {
      "type": "text",
      "id": "limited_drop_link_text",
      "label": "Limited drop text"
    },
    {
      "type": "link_list",
      "id": "main_menu_link_list",
      "label": "t:sections.header.settings.main_menu_link_list.label",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "mega_menu_images",
      "label": "t:sections.header.settings.mega_menu_images.label",
      "default": true,
      "info": "t:sections.header.settings.mega_menu_images.info"
    },
    {
      "type": "select",
      "id": "main_menu_alignment",
      "label": "t:sections.header.settings.main_menu_alignment.label",
      "default": "left",
