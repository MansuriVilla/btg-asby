<div
  class="background-with-number"
  style="background: var(--new-black) url({{ section.settings.single-image | img_url: 'master' }}) no-repeat center center / cover"
>
  <div class="page-width">
    <ul>
      <li>
        <h3>{{ section.settings.title_1 | escape }}</h3>
        <p>{{ section.settings.sub_title_1 | escape }}</p>
      </li>
      <li>
        <h3>{{ section.settings.title_2 | escape }}</h3>
        <p>{{ section.settings.sub_title_2 | escape }}</p>
      </li>
      <li>
        <h3>{{ section.settings.title_3 | escape }}</h3>
        <p>{{ section.settings.sub_title_3 | escape }}</p>
      </li>
      <li>
        <h3>{{ section.settings.title_4 | escape }}</h3>
        <p>{{ section.settings.sub_title_4 | escape }}</p>
      </li>
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "3max number with bg",
  "class": "number-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "single-image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "title 1",
      "default": "Rich text"
    },
    {
      "type": "text",
      "id": "sub_title_1",
      "label": "Sub title 1",
      "default": "Rich text"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "title 2",
      "default": "Rich text"
    },
    {
      "type": "text",
      "id": "sub_title_2",
      "label": "Sub title 2",
      "default": "Rich text"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "title 3",
      "default": "Rich text"
    },
    {
      "type": "text",
      "id": "sub_title_3",
      "label": "Sub title 3",
      "default": "Rich text"
    },
    {
      "type": "text",
      "id": "title_4",
      "label": "title 4",
      "default": "Rich text"
    },
    {
      "type": "text",
      "id": "sub_title_4",
      "label": "Sub title 4",
      "default": "Rich text"
    }
  ]
}
{% endschema %}
