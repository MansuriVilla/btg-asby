<script src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrollToPlugin.min.js" defer="defer"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    gsap.registerPlugin(ScrollToPlugin);
    document.querySelectorAll('[data-anchor]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        gsap.to(window, {
          duration: 2,
          scrollTo: {
            y: '#lpContactForm',
            offsetY: 50,
          },
          ease: 'power2.out',
        });
      });
    });
  });
  if (window.innerWidth >= 991) {
    function setDynamicLinks() {
      const ctaLinks = document.querySelectorAll('.dynamic_link');
      if (ctaLinks.length === 0) {
        console.warn("No elements with class 'dynamic_link' found.");
        return;
      }

      const userAgent = navigator.userAgent.toLowerCase();
      const appStoreUrl = 'https://apps.apple.com/us/app/blue-tees-game/id6448720121';
      const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.bluetees';

      const targetUrl =
        userAgent.includes('mac') || userAgent.includes('iphone') || userAgent.includes('ipad')
          ? appStoreUrl
          : userAgent.includes('android') || userAgent.includes('windows')
          ? playStoreUrl
          : appStoreUrl;

      ctaLinks.forEach((link) => {
        link.href = targetUrl;
      });
    }
    setDynamicLinks();
  }

  document.addEventListener('DOMContentLoaded', () => {
    const video = document.querySelector('.product-video__{{ section.id }}');
    const playPauseBtn = document.querySelector('.video-control__play-pause-btn');
    if (video && playPauseBtn) {
      const pauseIcon = playPauseBtn.querySelector('.icon-pause');
      const playIcon = playPauseBtn.querySelector('.icon-play');

      playPauseBtn.addEventListener('click', () => {
        if (video.paused) {
          video.play();
          playPauseBtn.setAttribute('aria-label', 'Pause video');
          playPauseBtn.setAttribute('aria-pressed', 'false');
          pauseIcon.style.display = 'block';
          playIcon.style.display = 'none';
        } else {
          video.pause();
          playPauseBtn.setAttribute('aria-label', 'Play video');
          playPauseBtn.setAttribute('aria-pressed', 'true');
          pauseIcon.style.display = 'none';
          playIcon.style.display = 'block';
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Rainmaker Hero",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout & Spacing Settings"
    },
    {
      "type": "checkbox",
      "id": "no_space_top",
      "label": "Remove Padding From Top"
    },
    {
      "type": "checkbox",
      "id": "no_bottom_space",
      "label": "Remove Padding From Bottom"
    },
    {
      "type": "header",
      "content": "Background Settings"
    },
    {
      "type": "select",
      "id": "bg_type",
      "label": "Background Type",
      "options": [
        {
          "value": "gradient",
          "label": "Gradient Color"
        },
        {
          "value": "solid",
          "label": "Single Static Color"
        }
      ],
      "default": "gradient"
    },
    {
      "type": "color_background",
      "id": "bg_clr",
      "label": "Gradient Background Color",
      "default": "linear-gradient(-180deg,#242632,#000000 24%)"
    },
    {
      "type": "color",
      "id": "bg_solid_clr",
      "label": "Static Solid Color",
      "default": "#242632"
    },
