{%- liquid
  assign title_alt = section.settings.title.alt
  if title_alt == blank
    assign title_str = section.settings.title | image_url | downcase
    if title_str contains 'unlock_your_captain_pro' or title_str contains 'unlock-your-captain-pro'
      assign title_alt = "Unlock your Captain Pro's full intelligence"
    elsif title_str contains 'unlock_your_captain_air' or title_str contains 'unlock-your-captain-air'
      assign title_alt = "Unlock your Captain Air's full intelligence"
    elsif page.template_suffix contains 'captain-pro' or product.handle contains 'captain-pro' or template.suffix contains 'captain-pro'
      assign title_alt = "Captain Pro your secret to smarter golf"
    elsif page.template_suffix contains 'captain-air' or product.handle contains 'captain-air' or template.suffix contains 'captain-air'
      assign title_alt = "Captain Air your secret to smarter golf"
    elsif page.template_suffix contains 'rainmaker' or product.handle contains 'rainmaker' or template.suffix contains 'rainmaker'
      assign title_alt = "Rainmaker Launch Monitor"
    elsif page.template_suffix contains 'player-pro' or product.handle contains 'player-pro' or template.suffix contains 'player-pro'
      assign title_alt = "Player Pro"
    elsif page.template_suffix contains 's3-max' or product.handle contains 's3-max' or template.suffix contains 's3-max'
      assign title_alt = "Series 3 Max+"
    else
      if product != blank and product.title != blank
        assign title_alt = product.title
      elsif page != blank and page.title != blank
        assign title_alt = page.title
      else
        assign title_alt = shop.name | default: 'Blue Tees Golf'
      endif
    endif
  endif

  assign badge_image_alt = section.settings.badge_image.alt
  if badge_image_alt == blank
    assign badge_image_alt = shop.name | default: 'Blue Tees Golf' | append: ' Logo'
  endif

  assign product_image_alt = section.settings.product_image.alt
  if product_image_alt == blank
    if page.template_suffix contains 'captain-pro' or product.handle contains 'captain-pro' or template.suffix contains 'captain-pro'
      assign product_image_alt = "Captain Pro Rangefinder"
    elsif page.template_suffix contains 'captain-air' or product.handle contains 'captain-air' or template.suffix contains 'captain-air'
      assign product_image_alt = "Captain Air Rangefinder"
    elsif page.template_suffix contains 'rainmaker' or product.handle contains 'rainmaker' or template.suffix contains 'rainmaker'
      assign product_image_alt = "Rainmaker Launch Monitor"
    elsif page.template_suffix contains 'player-pro' or product.handle contains 'player-pro' or template.suffix contains 'player-pro'
      assign product_image_alt = "Player Pro Speaker"
    elsif page.template_suffix contains 's3-max' or product.handle contains 's3-max' or template.suffix contains 's3-max'
      assign product_image_alt = "Series 3 Max+ Rangefinder"
    else
      if product != blank and product.title != blank
        assign product_image_alt = product.title
      elsif page != blank and page.title != blank
        assign product_image_alt = page.title
      else
        assign product_image_alt = 'Product Image'
      endif
    endif
  endif
-%}
<div
  class="hero-{{ section.id }}{% if section.settings.no_space_top %} no_space-top{% endif %}"
  data-section-id="{{ section.id }}"
>
  {% if section.settings.show_video %}
    <div class="hero_video">
  {% endif %}
  {% if section.settings.badge_text != blank %}
    <div class="badge">
      {{ section.settings.badge_text }}
    </div>
  {% endif %}
  {% if section.settings.badge_image != blank %}
    <div class="badge_logo">
      {{
        section.settings.badge_image
        | image_url: width: 250
        | image_tag:
          alt: badge_image_alt,
          fetchpriority: 'high',
          widths: '400,600,800,1200,1600,2000',
          height: 'auto',
          sizes: '(max-width: 860px) 100vw, 50vw',
          loading: 'eager'
      }}
    </div>
  {% endif %}
  <div class="hero-title">
    {% if section.settings.title_type == 'text' %}
      {% if section.settings.title_text != blank %}
        <h1 class="hero-title__text">{{ section.settings.title_text }}</h1>
      {% endif %}
    {% else %}
      {% if section.settings.title != blank %}
        <picture>
          <source srcset="{{ section.settings.title | image_url }}" media="(min-width:861px)">
          {% if section.settings.titleMobile != blank %}
            <source srcset="{{ section.settings.titleMobile | image_url }}" media="(max-width:860px)">
          {% endif %}
          <img src="{{ section.settings.title | image_url }}" alt="{{ title_alt | escape }}" loading="lazy">
        </picture>
      {% endif %}
    {% endif %}
  </div>
  {% if section.settings.subtext != blank %}
    <p class="hero-subtext">
      {{ section.settings.subtext }}
    </p>
  {% endif %}

  {% if section.settings.button_type == 'custom' and section.settings.custom_button_code != blank %}
    <div class="hero-custom-button-wrapper">
      {{ section.settings.custom_button_code }}
    </div>
  {% elsif section.settings.button_text != blank %}
    <a
      {% if request.path contains 'products' %}
        href="javascript:void(0);"
        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      {% else %}
        {% if request.path contains 'pages' and page.template_suffix contains 'qr-lp' -%}
          href="javascript:void(0);"
        {%- else -%}
          href="{{section.settings.button_link}}"
        {%- endif %}
      {% endif %}

      {% if request.path contains 'products' and product.selected_or_first_available_variant.available %}
        id="pre-order-btn"
      {% endif %}

      {%- liquid
        assign cta_product_title = ""
        if product != blank and product.title != blank
          assign cta_product_title = product.title
        elsif page != blank and page.title != blank
          assign cta_product_title = page.title
        endif

        assign cta_label = section.settings.button_text
        if cta_product_title != blank
          if cta_label contains 'ADD' or cta_label contains 'Add' or cta_label contains 'add'
            assign cta_label = cta_label | append: ' ' | append: cta_product_title | append: ' to cart'
          else
            assign cta_label = cta_label | append: ' - ' | append: cta_product_title
          endif
        endif
      -%}
      aria-label="{{ cta_label | escape }}"

      class="content-cta content-cta__solid{% if page.template_suffix contains 'rainmaker-qr-lp' or page.template_suffix contains 'rainmaker-event-qr-lp' %} add_1yr_membership_qr{% elsif request.path contains 'pages' and page.template_suffix contains 'qr-lp' %} add_6mos_membership_qr{% endif %}"
    >
      {% if request.path contains 'pages' or request.path contains 'products' and product.available %}
        {{ section.settings.button_text }}
      {% else %}
        SOLD OUT
      {% endif %}
    </a>
  {% endif %}
  {% if section.settings.show_video %}
    </div>
  {% endif %}
  {% if page.template_suffix == 'rainmaker-qr-lp' %}
    <p class="hero-subtext app_text rainmaker_text">Included with your Rainmaker • $79.99 value</p>
  {% elsif request.path contains 'pages' and page.template_suffix contains 'qr-lp' %}
    <p class="hero-subtext app_text">
      Have an existing membership? Simply log in to<br>
      your GAME account and add your new device.

      <a
        href="https://arena.blueteesgolf.com/app/summery"
        class="anchor_hover dynamic_link"
        style="color:#FFFFFF; --hover-clr:#fff;"
        >LOG IN</a
      >
    </p>
  {% endif %}

  <div class="product-image-container product-image-container_{{page.template_suffix}}{% if section.settings.image_has_ratio %} product_image-ratio{% endif %}{% if section.settings.show_video %} product-container_hasVideo{% endif %}">
    {% comment %} <div class="product-glow"></div> {% endcomment %}
    {% if section.settings.show_video %}
      {%- assign mobile_video = section.settings.product_video_mobile -%}
      {%- assign desktop_video = section.settings.product_video -%}

      <video autoplay loop muted playsinline class="product-video product-video__{{ section.id }}">
        <source
          src="{{ desktop_video.sources | where: 'format', 'mp4' | first | map: 'url' }}"
          type="video/mp4"
          media="(min-width:861px)"
        >
        {% if mobile_video != blank %}
          <source
            src="{{ mobile_video.sources | where: 'format', 'mp4' | first | map: 'url' }}"
            type="video/mp4"
            media="(max-width:860px)"
          >
        {% endif %}

        Your browser does not support the video tag.
      </video>
      <button type="button" class="video-control__play-pause-btn" aria-label="Pause video" aria-pressed="false">
        <svg class="icon icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="16" height="16">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
        </svg>
        <svg class="icon icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="16" height="16" style="display: none;">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </button>
    {% else %}
      <picture>
        <source srcset="{{ section.settings.product_image | image_url }}" media="(min-width:861px)">
        <source srcset="{{ section.settings.product_image_mobile | image_url }}" media="(max-width:860px)">
        {{
          section.settings.product_image
          | image_url: width: 2000
          | image_tag:
            alt: product_image_alt,
            loading: 'lazy',
            widths: '400,600,800,1000,1200,1400,1600,1800,2000,2400',
            sizes: '(min-width: 861px) 50vw, 100vw',
            class: 'hero__image_lp'
        }}
      </picture>
    {% endif %}
  </div>

  {% if section.settings.heading_bottom != blank %}
    <div class="hero__heading-bottom">
      <div class="hero__heading--inner-top">
        <h2 class="heading_bottom">{{ section.settings.heading_bottom }}</h2>
        <p class="subheading_bottom">{{ section.settings.subheading_bottom }}</p>
      </div>
      <div class="hero__heading--inner-bottom">
        <button
          {% unless product.selected_or_first_available_variant.available %}
            disabled
          {% endunless %}
          data-variant-id="{{ product.selected_or_first_available_variant.id }}"
          id="pre-order-btn"
          class="content-cta content-cta__solid {% unless current_variant.available %} button_sold-out{%endunless %}"
        >
          {% if  product.template_suffix == 'new-s3-max'%}
            SOLD OUT
          {% elsif request.path contains 'products' and product.available %}
            {{ section.settings.bottom_button_text }}

          {% else %}
            SOLD OUT
          {% endif %}
        </button>
      </div>
    </div>
  {% endif %}
</div>

{% if request.path contains 'products' and product.available %}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      $('#pre-order-btn').on('click', function (e) {
        e.preventDefault();

        var $btn = $(this);

        // Prevent double click
        if ($btn.hasClass('btn--loading')) return;
        $btn.addClass('btn--loading');

        // ✅ correct: reads data-variant-id
        var variantId = $btn.data('variant-id'); // or $btn.data('variantId')

        if (!variantId) {
          console.error('Missing variantId. Check data-variant-id on the button.');
          $btn.removeClass('btn--loading');
          return;
        }

        $.ajax({
          url: '/cart/add.js',
          type: 'POST',
          dataType: 'json',
          data: { id: variantId, quantity: 1 },
          success: function (data) {
            $btn.removeClass('btn--loading');
            document.dispatchEvent(new CustomEvent('ajaxProduct:added', { detail: data }));
            console.log('Added to cart', data);
          },
          error: function (err) {
            console.error('Add to cart error:', err);
            $btn.removeClass('btn--loading');
          },
        });
      });
    });
  </script>
{% endif %}

