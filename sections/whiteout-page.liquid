{{ 'jquery.js' | asset_url | script_tag }}
<script>
  function instantBuy(proid,id){
  
     var $ = jQuery;

  var formParams = {
    'data-product-id':proid,
    'id':id
  };
     $.ajax({
      url: "/cart/add",
      type: "post",
      data: formParams,
      success: function(){ 
       window.location.href = "/checkout";
        
      },
      error: function(){
      }
     })
 }
</script>






