<div class="page-full page-content">
  {%- render 'breadcrumbs' -%}
  <header class="section-header">
    <h1 class="section-header__title">{{ page.title | escape }}</h1>
  </header>

  <div class="rte rte--nomargin">
    {{ page.content }}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-page-full-width.name",
  "tag": "section",
  "settings": [
     {
      "type": "checkbox",
      "id": "hide_default_content",
      "label": "Hide Default Content Block"
    }
  ]
}
{% endschema %}
