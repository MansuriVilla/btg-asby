{% liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign anchor_id = section.settings.anchor_id
%}

<div
  class="jobs-opening__area"
  {% if anchor_id != blank %}
    id="{{anchor_id}}"
  {% endif %}
>
  <div class="new-page-width">
    <div class="jobs-opening__inner">
      {% assign careers_page = pages['career-opportunities'] %}
      {% if heading != blank %}
        <div
          class="new-page-width"
          {% if anchor_id != blank %}
            id="{{anchor_id}}"
          {% endif %}
        >
            <div class="jobs-opening__bottom--inner--top">
            <h3>{{ heading }}</h3>
            {% if description != blank %}
              <p>{{ description }}</p>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if careers_page != blank %}
        <div class="careers-page-content">
          {{ careers_page.content }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Career page job listing",
  "class": "career-page-job-listing",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Section Description"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section ID"
    }
  ],
  "presets": [
    {
      "name": "Career page job listing"
    }
  ]
}
{% endschema %}
