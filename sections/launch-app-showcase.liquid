  <script>
    (function () {
      function initLaunchAppShowcase(section) {
        if (!section || section.dataset.lasInit === 'true') return;
        section.dataset.lasInit = 'true';

        var slider = section.querySelector('[data-las-slider]');
        var track = section.querySelector('[data-las-track]');
        var slides = Array.from(section.querySelectorAll('[data-las-slide]'));
        var prevBtn = section.querySelector('[data-las-prev]');
        var nextBtn = section.querySelector('[data-las-next]');
        var progressTrack = section.querySelector('[data-las-progress-track]');
        var progressBar = section.querySelector('[data-las-progress-bar]');

        if (!slider || !track || slides.length === 0) return;

        var currentIndex = 0;
        var totalSlides = slides.length;
        var currentTranslate = 0;
        var isDragging = false;
        var startX = 0;
        var dragStartTranslate = 0;

        track.querySelectorAll('img, a').forEach(function (el) {
          el.setAttribute('draggable', 'false');
        });

        function getGap() {
          var style = window.getComputedStyle(track);
          return parseFloat(style.gap || style.columnGap) || 32;
        }

        function getSlideStep() {
          return slides[0].offsetWidth + getGap();
        }

        function getMaxTranslate() {
          var padLeft = parseFloat(window.getComputedStyle(slider).paddingLeft) || 0;
          var padRight = parseFloat(window.getComputedStyle(slider).paddingRight) || 0;
          var visibleWidth = slider.clientWidth - padLeft - padRight;
          return Math.max(0, track.scrollWidth - visibleWidth);
        }

        function updateUI() {
          slides.forEach(function (slide, idx) {
            slide.classList.toggle('is-active', idx === currentIndex);
          });

          var maxT = getMaxTranslate();
          if (prevBtn) prevBtn.disabled = currentIndex <= 0;
          if (nextBtn) nextBtn.disabled = currentIndex >= totalSlides - 1 || Math.abs(currentTranslate) >= maxT - 5;

          if (progressBar) {
            if (maxT <= 0) {
              progressBar.style.width = '100%';
              progressBar.style.transform = 'translateX(0%)';
            } else {
              var barWidthPct = Math.max(25, Math.min(100, (1 / totalSlides) * 100 * 1.6));
              progressBar.style.width = barWidthPct + '%';
              var progressRatio = Math.min(1, Math.max(0, Math.abs(currentTranslate) / maxT));
              var maxShift = ((100 - barWidthPct) / barWidthPct) * 100;
              progressBar.style.transform = 'translateX(' + (progressRatio * maxShift).toFixed(2) + '%)';
            }
          }
        }

        function setTranslate(targetX, animate) {
          var maxT = getMaxTranslate();
          currentTranslate = Math.min(0, Math.max(-maxT, targetX));

          if (animate) {
            track.classList.remove('is-dragging');
          } else {
            track.classList.add('is-dragging');
          }
          track.style.transform = 'translate3d(' + currentTranslate + 'px, 0, 0)';
          updateUI();
        }

        function goToSlide(index) {
          currentIndex = Math.max(0, Math.min(index, totalSlides - 1));
          var step = getSlideStep();
          var maxT = getMaxTranslate();
          var targetX = -(currentIndex * step);
          if (Math.abs(targetX) > maxT) {
            targetX = -maxT;
          }
          setTranslate(targetX, true);
        }

        if (prevBtn) {
          prevBtn.addEventListener('click', function () {
            goToSlide(currentIndex - 1);
          });
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', function () {
            goToSlide(currentIndex + 1);
          });
        }

        if (progressTrack) {
          progressTrack.addEventListener('click', function (e) {
            var rect = progressTrack.getBoundingClientRect();
            var ratio = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
            goToSlide(Math.round(ratio * (totalSlides - 1)));
          });
        }

        // Pointer / Touch Drag Support
        track.addEventListener('pointerdown', function (e) {
          if (e.button !== 0 && e.pointerType === 'mouse') return;
          isDragging = true;
          startX = e.clientX;
          dragStartTranslate = currentTranslate;
          track.classList.add('is-dragging');
          if (track.setPointerCapture) {
            try { track.setPointerCapture(e.pointerId); } catch (err) {}
          }
        });

        track.addEventListener('pointermove', function (e) {
          if (!isDragging) return;
          var deltaX = e.clientX - startX;
          setTranslate(dragStartTranslate + deltaX, false);
        });

        function endDrag(e) {
          if (!isDragging) return;
          isDragging = false;
          track.classList.remove('is-dragging');
          var movedBy = e.clientX - startX;
          var step = getSlideStep();

          if (Math.abs(movedBy) > 50) {
            if (movedBy < 0 && currentIndex < totalSlides - 1) {
              currentIndex += 1;
            } else if (movedBy > 0 && currentIndex > 0) {
              currentIndex -= 1;
            }
          } else {
            currentIndex = Math.max(0, Math.min(totalSlides - 1, Math.round(Math.abs(currentTranslate) / step)));
          }
          goToSlide(currentIndex);
        }

        track.addEventListener('pointerup', endDrag);
        track.addEventListener('pointercancel', endDrag);

        // Support Shopify Theme Editor Block Selection
        document.addEventListener('shopify:block:select', function (e) {
          if (!section.contains(e.target)) return;
          var idx = e.target.getAttribute('data-las-slide');
          if (idx !== null) {
            goToSlide(parseInt(idx, 10));
          }
        });

        window.addEventListener('resize', function () {
          goToSlide(currentIndex);
        });

        goToSlide(0);
      }

      function initAll() {
        document.querySelectorAll('[data-launch-app-showcase]').forEach(initLaunchAppShowcase);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAll);
      } else {
        initAll();
      }

      document.addEventListener('shopify:section:load', function (e) {
        var root = e.target.querySelector('[data-launch-app-showcase]');
        if (root) initLaunchAppShowcase(root);
      });
    })();
  </script>
{%- endif -%}

