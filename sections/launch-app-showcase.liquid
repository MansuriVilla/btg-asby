{% comment %}
  Launch App Showcase Section (Game AI / Launch App Figma Specs)
  - Top 2-column split: Hero mockup image (786x761 on desktop) + Heading (42px), Description (16px) & App Store / Google Play badges (right)
  - Bottom custom slider of feature cards (524x537, #E9E9E9 or dark #1B2029 variant, 32px gap, 10px radius)
  - Supports both Light Centered cards (Style 1: 380x276 top image + centered 18px title & 14px description) and Dark Split cards (Style 2: 524x295 top media + device preview / icon + left-aligned copy)
  - Includes hover navigation arrows (44x44) and bottom progress bar (1060px wide, 2px height)
  - Uses clamp() for fluid typography and spacing, and visible_if for conditional schema fields
{% endcomment %}

{%- liquid
  assign section_id = section.settings.custom_section_id | default: ''
  if section_id == blank
    assign section_id = 'launch-app-showcase-' | append: section.id
  endif

  assign section_loading = 'lazy'
  assign section_fetchpriority = 'auto'
  if section.index == 1 or section.index == nil or section.settings.eager_load
    assign section_loading = 'eager'
    assign section_fetchpriority = 'high'
  endif

  assign hero_alt = section.settings.heading | strip_html | escape | default: 'Launch App Showcase'
-%}

<div
  id="{{ section_id }}"
  class="launch-app-showcase launch-app-showcase--{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-launch-app-showcase
  style="
    --las-bg: {{ section.settings.bg_color | default: '#FFFFFF' }};
    --las-text: {{ section.settings.text_color | default: '#101820' }};
    --las-subtext: {{ section.settings.subtext_color | default: '#101820' }};
    --las-card-bg: {{ section.settings.card_bg_color | default: '#E9E9E9' }};
  "
>
  <div class="launch-app-showcase__inner">
    <!-- Top Split Hero Area (1440px container) -->
    <div class="launch-app-showcase__hero {% if section.settings.reverse_hero_layout %}launch-app-showcase__hero--reverse{% endif %}">
      <!-- Left Column: Hero Mockup Image (778x778 frame / 786x761 image) -->
      <div class="launch-app-showcase__hero-media">
        {%- if section.settings.hero_image != blank -%}
          <picture>
            {%- if section.settings.has_mobile_hero_image and section.settings.hero_image_mobile != blank -%}
              <source
                media="(max-width: 860px)"
                srcset="
                  {{ section.settings.hero_image_mobile | image_url: width: 600 }} 600w,
                  {{ section.settings.hero_image_mobile | image_url: width: 900 }} 900w,
                  {{ section.settings.hero_image_mobile | image_url: width: 1200 }} 1200w
                "
                sizes="100vw"
              >
            {%- endif -%}
            {{
              section.settings.hero_image
              | image_url: width: 1600
              | image_tag:
                alt: hero_alt,
                class: 'launch-app-showcase__hero-img',
                loading: section_loading,
                fetchpriority: section_fetchpriority,
                widths: '400, 600, 800, 1100, 1400, 1600',
                sizes: '(max-width: 860px) 100vw, 786px'
            }}
          </picture>
        {%- else -%}
          <div class="launch-app-showcase__hero-placeholder custom_subHeading-text">
            Upload Hero Mockup Image (786 × 761px)
          </div>
        {%- endif -%}
      </div>

      <!-- Right Column: Content (534px wide, gap 24.61px) -->
      <div class="launch-app-showcase__hero-content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="launch-app-showcase__eyebrow custom_subHeading-text">
            {{ section.settings.eyebrow }}
          </span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="launch-app-showcase__heading custom_heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="launch-app-showcase__description custom_body-text">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        {%- if section.settings.show_store_badges -%}
          {%- if section.settings.combined_store_image != blank
            or section.settings.app_store_image != blank
            or section.settings.play_store_image != blank
          -%}
            <div class="launch-app-showcase__stores">
              {%- if section.settings.combined_store_image != blank -%}
                {%- assign comb_alt = section.settings.combined_store_image.alt | default: 'Download on App Store and Google Play' | escape -%}
                {{
                  section.settings.combined_store_image
                  | image_url: width: 482
                  | image_tag:
                    alt: comb_alt,
                    class: 'launch-app-showcase__store-combined-img',
                    loading: 'lazy'
                }}
              {%- else -%}
                {%- if section.settings.app_store_image != blank -%}
                  {%- assign app_store_alt = section.settings.app_store_image.alt | default: 'Download on the App Store' | escape -%}
                  {%- if section.settings.app_store_link != blank -%}
                    <a
                      href="{{ section.settings.app_store_link }}"
                      class="launch-app-showcase__store-link"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {{
                        section.settings.app_store_image
                        | image_url: width: 320
                        | image_tag:
                          alt: app_store_alt,
                          class: 'launch-app-showcase__store-img',
                          loading: 'lazy'
                      }}
                    </a>
                  {%- else -%}
                    <span class="launch-app-showcase__store-link">
                      {{
                        section.settings.app_store_image
                        | image_url: width: 320
                        | image_tag:
                          alt: app_store_alt,
                          class: 'launch-app-showcase__store-img',
                          loading: 'lazy'
                      }}
                    </span>
                  {%- endif -%}
                {%- endif -%}

                {%- if section.settings.play_store_image != blank -%}
                  {%- assign play_store_alt = section.settings.play_store_image.alt | default: 'Get it on Google Play' | escape -%}
                  {%- if section.settings.play_store_link != blank -%}
                    <a
                      href="{{ section.settings.play_store_link }}"
                      class="launch-app-showcase__store-link"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {{
                        section.settings.play_store_image
                        | image_url: width: 320
                        | image_tag:
                          alt: play_store_alt,
                          class: 'launch-app-showcase__store-img',
                          loading: 'lazy'
                      }}
                    </a>
                  {%- else -%}
                    <span class="launch-app-showcase__store-link">
                      {{
                        section.settings.play_store_image
                        | image_url: width: 320
                        | image_tag:
                          alt: play_store_alt,
                          class: 'launch-app-showcase__store-img',
                          loading: 'lazy'
                      }}
                    </span>
                  {%- endif -%}
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.show_cta and section.settings.cta_text != blank -%}
          <div class="launch-app-showcase__cta-wrap">
            <a
              href="{{ section.settings.cta_link | default: '#' }}"
              class="content-cta content-cta__solid launch-app-showcase__cta"
            >
              {{ section.settings.cta_text }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>

    <!-- Bottom GameAI Slider Area -->
    {%- if section.blocks.size > 0 -%}
      <div class="launch-app-showcase__slider-section">
        {%- if section.settings.enable_slider_header -%}
          {%- if section.settings.slider_heading != blank or section.settings.slider_subheading != blank -%}
            <div class="launch-app-showcase__slider-header">
              {%- if section.settings.slider_heading != blank -%}
                <h3 class="launch-app-showcase__slider-title custom_heading">
                  {{ section.settings.slider_heading }}
                </h3>
              {%- endif -%}
              {%- if section.settings.slider_subheading != blank -%}
                <div class="launch-app-showcase__slider-subtitle custom_body-text">
                  {{ section.settings.slider_subheading }}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}

        <div class="launch-app-showcase__slider-wrapper">
          <div class="launch-app-showcase__slider" data-las-slider>
            <div class="launch-app-showcase__track" data-las-track>
              {%- for block in section.blocks -%}
                {%- liquid
                  assign card_alt = block.settings.title | strip_html | escape | default: 'App Feature'
                  assign is_dark_card = block.settings.enable_dark_card
                -%}
                <div
                  class="launch-app-showcase__slide {% if forloop.first %}is-active{% endif %}"
                  data-las-slide="{{ forloop.index0 }}"
                  {{ block.shopify_attributes }}
                >
                  <div class="launch-app-showcase__card {% if is_dark_card %}launch-app-showcase__card--dark{% endif %}">
                    <!-- Top Image / Media Area -->
                    <div class="launch-app-showcase__card-media">
                      {%- if block.settings.image != blank -%}
                        {{
                          block.settings.image
                          | image_url: width: 1050
                          | image_tag:
                            alt: card_alt,
                            class: 'launch-app-showcase__card-img',
                            loading: 'lazy',
                            widths: '380, 524, 760, 1050',
                            sizes: '(max-width: 768px) 85vw, 524px'
                        }}
                      {%- else -%}
                        <div class="launch-app-showcase__card-img-placeholder"></div>
                      {%- endif -%}
                    </div>

                    <!-- Bottom Text Area (242px height in Figma) -->
                    <div class="launch-app-showcase__card-bottom">
                      {%- if is_dark_card -%}
                        <div class="launch-app-showcase__card-dark-inner">
                          {%- if block.settings.device_image != blank or block.settings.show_badge_icon -%}
                            <div class="launch-app-showcase__card-device-wrap">
                              {%- if block.settings.device_image != blank -%}
                                {%- assign dev_alt = block.settings.title | strip_html | escape -%}
                                {{
                                  block.settings.device_image
                                  | image_url: width: 444
                                  | image_tag:
                                    alt: dev_alt,
                                    class: 'launch-app-showcase__card-device-img',
                                    loading: 'lazy'
                                }}
                              {%- endif -%}
                              {%- if block.settings.show_badge_icon -%}
                                <div class="launch-app-showcase__card-badge-icon">
                                  {%- if block.settings.badge_icon != blank -%}
                                    {{
                                      block.settings.badge_icon
                                      | image_url: width: 80
                                      | image_tag:
                                        alt: '',
                                        loading: 'lazy'
                                    }}
                                  {%- else -%}
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                                      <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z" fill="#FFFFFF"/>
                                    </svg>
                                  {%- endif -%}
                                </div>
                              {%- endif -%}
                            </div>
                          {%- endif -%}

                          <div class="launch-app-showcase__card-text-group launch-app-showcase__card-text-group--left">
                            {%- if block.settings.title != blank -%}
                              <h3 class="launch-app-showcase__card-title custom_heading">
                                {{ block.settings.title }}
                              </h3>
                            {%- endif -%}
                            {%- if block.settings.description != blank -%}
                              <div class="launch-app-showcase__card-desc custom_body-text">
                                {{ block.settings.description }}
                              </div>
                            {%- endif -%}
                          </div>
                        </div>
                      {%- else -%}
                        <div class="launch-app-showcase__card-text-group">
                          {%- if block.settings.title != blank -%}
                            <h3 class="launch-app-showcase__card-title custom_heading">
                              {{ block.settings.title }}
                            </h3>
                          {%- endif -%}
                          {%- if block.settings.description != blank -%}
                            <div class="launch-app-showcase__card-desc custom_body-text {% if block.settings.wide_description %}launch-app-showcase__card-desc--wide{% endif %}">
                              {{ block.settings.description }}
                            </div>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>

          <!-- Slider Floating Side Arrows & Bottom Progress Track -->
          {%- if section.blocks.size > 1 -%}
            <div class="launch-app-showcase__controls">
              <button
                type="button"
                class="launch-app-showcase__arrow launch-app-showcase__arrow--prev"
                data-las-prev
                aria-label="Previous slide"
              >
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M15.8333 10H4.16666M4.16666 10L9.16666 5M4.16666 10L9.16666 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>

              {%- if section.settings.show_progress_bar -%}
                <div class="launch-app-showcase__progress-track" data-las-progress-track>
                  <div class="launch-app-showcase__progress-bar" data-las-progress-bar></div>
                </div>
              {%- endif -%}

              <button
                type="button"
                class="launch-app-showcase__arrow launch-app-showcase__arrow--next"
                data-las-next
                aria-label="Next slide"
              >
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M4.16666 10H15.8333M15.8333 10L10.8333 5M15.8333 10L10.8333 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  /* ==========================================================================
     Launch App Showcase (Figma 1440px Spec + Fluid Clamp)
     ========================================================================== */
  .launch-app-showcase--{{ section.id }} {
    position: relative;
    width: 100%;
    background-color: var(--las-bg, #FFFFFF);
    color: var(--las-text, #101820);
    padding-top: clamp(36px, 3.5vw, 49px);
    padding-bottom: clamp(48px, 6vw, 90px);
    overflow: hidden;
    box-sizing: border-box;
    z-index: 2;
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__inner {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  /* ==========================================================================
     Top Hero Split (Frame 1410105721)
     ========================================================================== */
  .launch-app-showcase--{{ section.id }} .launch-app-showcase__hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 786fr) minmax(0, 534fr);
    align-items: center;
    justify-content: space-between;
    gap: clamp(24px, 3.5vw, 56px);
    width: 100%;
    padding-inline: clamp(16px, 4vw, 64px);
    margin-bottom: clamp(24px, 2vw, 38px);
    box-sizing: border-box;
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__hero--reverse {
    grid-template-columns: minmax(0, 534fr) minmax(0, 786fr);
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__hero--reverse .launch-app-showcase__hero-media {
    order: 2;
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__hero--reverse .launch-app-showcase__hero-content {
    order: 1;
  }

  /* Left Mockup Image (Frame 1410105930 / image 325: 786px x 761px) */
  .launch-app-showcase--{{ section.id }} .launch-app-showcase__hero-media {
    position: relative;
    width: 100%;
    max-width: 786px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__hero-img {
    width: 100%;
    max-width: clamp(320px, 54.5vw, 786px);
    height: auto;
    object-fit: contain;
    display: block;
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__hero-placeholder {
    width: 100%;
    aspect-ratio: 786 / 761;
    max-height: 560px;
    background: #F4F5F7;
    border: 1px dashed #CBD5E1;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #64748B;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Right Content Column (Frame 1171277703: width 534px, gap 24.61px) */
  .launch-app-showcase--{{ section.id }} .launch-app-showcase__hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: clamp(16px, 1.7vw, 24.61px);
    width: 100%;
    max-width: 536px;
    margin-inline: auto;
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__eyebrow {
    font-size: clamp(11px, 0.85vw, 13px);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--new-blue, #004df5);
  }

  /* Heading: 42px, line-height 100%, letter-spacing -0.02em, #101820 */
  .launch-app-showcase--{{ section.id }} .launch-app-showcase__heading {
    font-size: clamp(26px, 2.92vw, 42px);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--las-text, #101820);
    margin: 0;
    max-width: 536px;
    width: 100%;
  }

  /* Body Copy - M: 456px width, 16px font-size, 150% line-height, 0.02em letter-spacing, #101820 */
  .launch-app-showcase--{{ section.id }} .launch-app-showcase__description {
    font-size: clamp(14px, 1.11vw, 16px);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--las-subtext, #101820);
    max-width: 456px;
    width: 100%;
    margin: 0 auto;
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__description p {
    margin: 0;
    padding: 0;
    font-size: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    color: inherit;
  }

  /* App Store / Google Play Badges (241px x 58px container in Figma) */
  .launch-app-showcase--{{ section.id }} .launch-app-showcase__stores {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: clamp(8px, 0.7vw, 10px);
    min-height: clamp(42px, 4vw, 58px);
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__store-combined-img {
    width: clamp(190px, 16.7vw, 241px);
    height: auto;
    object-fit: contain;
    display: block;
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__store-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1), opacity 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .launch-app-showcase--{{ section.id }} a.launch-app-showcase__store-link:hover {
    transform: translateY(-2px);
    opacity: 0.92;
  }

  .launch-app-showcase--{{ section.id }} a.launch-app-showcase__store-link:active {
    transform: scale(0.98);
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__store-img {
    height: clamp(34px, 2.7vw, 40px);
    width: auto;
    object-fit: contain;
    display: block;
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__cta-wrap {
    margin-top: 4px;
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: clamp(10px, 0.9vw, 14px) clamp(24px, 2vw, 34px);
    font-size: clamp(13px, 0.9vw, 15px);
    font-weight: 700;
  }

  /* ==========================================================================
     GameAI Slider Section (width 1440px, left offset 80px, gap 32px)
     ========================================================================== */
  .launch-app-showcase--{{ section.id }} .launch-app-showcase__slider-section {
    position: relative;
    width: 100%;
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__slider-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto clamp(24px, 3vw, 40px) auto;
    padding-inline: 20px;
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__slider-title {
    font-size: clamp(22px, 2.2vw, 36px);
    line-height: 1.05;
    color: var(--las-text, #101820);
    text-transform: uppercase;
    margin: 0 0 12px 0;
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__slider-subtitle {
    font-size: clamp(14px, 1vw, 16px);
    line-height: 1.5;
    color: var(--las-subtext, #101820);
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__slider-subtitle p {
    margin: 0;
    padding: 0;
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__slider-wrapper {
    position: relative;
    width: 100%;
    user-select: none;
    -webkit-user-select: none;
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__slider {
    position: relative;
    width: 100%;
    padding-left: clamp(16px, 5.55vw, 80px);
    padding-right: clamp(16px, 5.55vw, 80px);
    box-sizing: border-box;
    overflow: visible;
  }

  /* Frame 1410105709: flex-direction row, gap 32px */
  .launch-app-showcase--{{ section.id }} .launch-app-showcase__track {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: clamp(16px, 2.22vw, 32px);
    will-change: transform;
    transition: transform 0.45s cubic-bezier(0.25, 1, 0.5, 1);
    cursor: grab;
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__track.is-dragging {
    cursor: grabbing;
    transition: none;
  }

  /* Style_2 Card: width 524px, height 537px, border-radius 10px, background #E9E9E9 */
  .launch-app-showcase--{{ section.id }} .launch-app-showcase__slide {
    flex: 0 0 auto;
    width: clamp(300px, 36.38vw, 524px);
    box-sizing: border-box;
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__card {
    position: relative;
    width: 100%;
    height: clamp(430px, 37.29vw, 537px);
    background: var(--las-card-bg, #E9E9E9);
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
  }

  /* Top Image Stage (image 295: width 380px, height 276px, left 72px, top 38px) */
  .launch-app-showcase--{{ section.id }} .launch-app-showcase__card-media {
    position: relative;
    width: 100%;
    height: clamp(220px, 20.48vw, 295px);
    padding: clamp(24px, 2.63vw, 38px) clamp(28px, 5vw, 72px) 0;
    box-sizing: border-box;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    flex-shrink: 0;
  }

  .launch-app-showcase--{{ section.id }} .launch-app-showcase__card-img {
    width: 100%;
    max-width: clamp(240px, 26.38vw, 380px);
    height: clamp(180px, 19.16vw, 276px);
    object-fit: contain;
    object-position: center center;
    display: block;
    pointer-events: none;
