{% liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign feature_image = section.settings.feature_image
  assign anchor_id = section.settings.anchor_id
%}
<div class="jobs-opening__area">
  <div class="jobs-opening__inner">
    {% if feature_image != blank %}
      <div class="jobs-opening__top">
        {{
          feature_image
          | image_url: width: 2000
          | image_tag:
            alt: heading,
            fetchpriority: 'high',
            widths: '400,600,800,1200,1600,2000',
            height: 'auto',
            sizes: '(max-width: 860px) 100vw, 50vw',
            loading: 'eager'
        }}
      </div>
    {% endif %}
    {% if section.blocks.size > 0 and heading != blank %}
      <div class="jobs-opening__bottom">
        {% if heading != blank %}
          <div class="new-page-width" id="{{anchor_id}}">
            <div class="jobs-opening__bottom--inner--top">
              <h3>{{ heading }}</h3>
              {% if description != blank %}
                <p>{{ description }}</p>
              {% endif %}
            </div>
          </div>
        {% endif %}
        {% if section.blocks.size > 0 %}
          <div class="new-page-width">
            <div class="jobs-opening__bottom--inner horizon-slider_container jobs_slider">
              <div class="horizon-slider_track">
                {% for block in section.blocks %}
                  {% liquid
                    assign job_title = block.settings.job_title
                    assign job_loc = block.settings.job_loc
                    assign job_link = block.settings.job_link
                    assign job_lable = block.settings.job_lable
                    assign num = forloop.index
                  %}
                  <div class="jobs_item horizon-slide jobs_item--{{ num }}" {{ block.shopify_attributes }}>
                    <div class="jobs_item--inner">
                      {% if job_title != blank %}
                        <h4 class="job_title">{{ job_title }}</h4>
                      {% endif %}
                      {% if job_loc != blank %}
                        <span class="job_location">{{ job_loc }}</span>
                      {% endif %}
                      {% if job_link != blank %}
                        <a href="{{ job_link }}" target="_blank" class="content-cta content-cta__solid">
                          {{ job_lable | escape }}
                        </a>
                      {% endif %}
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>
{% if section.blocks.size > 0 %}
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      horizonSlider({
        '.jobs_slider': {
          loop: true,
          margin: 20,
          nav: true,
          showTracker: false,
          drag: true,
          dots: false,
          autoplay:false,
          responsive: {
            0: { items: 1 },
            575: { items: 2 },
            991: { items: 3 },
          },
        },
      });
    });
  </script>
{% endif %}
{% schema %}
{
  "name": "Jobs Section",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "feature_image",
      "label": "Feature Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Section Description"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section ID"
    }
  ],
  "blocks": [
    {
      "type": "jobs_item",
      "name": "Jobs item",
      "settings": [
        {
          "type": "html",
          "id": "job_title",
          "label": "Job Heading"
        },
        {
          "type": "text",
          "id": "job_loc",
          "label": "Job Location"
        },
        {
          "type": "text",
          "id": "job_lable",
          "label": "CTA Text"
        },
        {
          "type": "url",
          "id": "job_link",
          "label": "CTA Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Jobs Section"
    }
  ]
}
{% endschema %}
