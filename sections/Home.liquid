<script type="text/javascript">
  document.addEventListener("DOMContentLoaded", () => {
  /*-------------------------------
    Slider In View
  -----------------*/

  function slideInView() {
    const container = document.querySelector(
      ".slide_in-view__container .slide_in-view__row"
    );
    const imagesContainer = document.querySelector(".slide_in-view__images");
    const images = imagesContainer.querySelectorAll("img");

    if (!container || !imagesContainer || images.length === 0) {
      console.warn("Slide-in view elements not found");
      return;
    }

    let originalImagesWidth = 0;
    images.forEach((img) => {
      const style = window.getComputedStyle(img);
      const marginLeft = parseFloat(style.marginLeft);
      const marginRight = parseFloat(style.marginRight);
      originalImagesWidth += img.offsetWidth + marginLeft + marginRight;
    });

    images.forEach((img) => {
      const clone = img.cloneNode(true);
      imagesContainer.appendChild(clone);
    });

    let initSlides = false;

    ScrollTrigger.create({
      trigger: container,
      start: "top 80%",
      end: "top top",
      markers: false,
      onEnter: () => {
        if (initSlides) return;
        initSlides = true;

        gsap.set(".slide_in-view__images img", {
          opacity: 0,
          x: "50%",
        });

        gsap.to(".slide_in-view__images img", {
          opacity: 1,
          x: "0%",
          duration: 0.8,
          stagger: 0.05,
          ease: "power4.out",
        });

        gsap.to(imagesContainer, {
          x: -originalImagesWidth,
          ease: "none",
          duration: 70,
          repeat: -1,
        });
      },
    });

    ScrollTrigger.refresh();
  }

  slideInView();
  });


</script>
<script type="text/javascript">
// Trigger to open the popup
$('.poptrigger').click(function () {
    var popID = $(this).attr('data-rel');
    var $popup = $('#' + popID); // Find the specific popup
    $popup.fadeIn();

    // Find the video inside the specific popup and play it
    var video = $popup.find('video').get(0); // Get the video inside the popup
    if (video) {
        video.play();
    }

    return false;
});

// Close the popup and stop the video inside it
$(document).on("click", ".closePop, #fade", function () {
    $('.pop-upbox').fadeOut(function () {
        // Find the video inside the currently visible popup and stop it
        var video = $(this).find('video').get(0); // Dynamically get video within the popup
        if (video) {
            video.pause();
            video.currentTime = 0; // Reset the video to the beginning
        }
    });

    return false;
});	
</script>







