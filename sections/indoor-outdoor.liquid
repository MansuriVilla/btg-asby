{% comment %}
  Indoor / Outdoor Switcher Section (Exact Figma 1440x886 Specs + Fluid Clamp)
  - Dynamic tab switcher (e.g., OUTDOOR / INDOOR) using blocks
  - Full-bleed background image per tab + optional top gradient overlay + optional foreground cutout layer
  - Right-aligned content block (632px wide, positioned at left: 728px on 1440px viewport)
  - Pill switcher: 332x48px, rgba(27, 30, 34, 0.4), 1px solid #474646, buttons 157x34px
  - Heading: 42px (100% line-height, -0.02em tracking) + Description: 16px (150% line-height, 560px max-width)
  - 2x2 feature badges grid: 509px wide, 8px gap, tiles 250.5x59px, rgba(0, 0, 0, 0.5), border-radius 16.9223px, 16px bold text
  - Bottom partner logos row (E6 86x86px, GSPro 138x42px)
  - Uses clamp() for fluid typography and spacing, and visible_if for conditional schema fields
{% endcomment %}

{%- liquid
  assign section_id = section.settings.custom_section_id | default: ''
  if section_id == blank
    assign section_id = 'indoor-outdoor-' | append: section.id
  endif

  assign section_loading = 'lazy'
  assign section_fetchpriority = 'auto'
  if section.index == 1 or section.index == nil or section.settings.eager_load
    assign section_loading = 'eager'
    assign section_fetchpriority = 'high'
  endif
-%}

<div
  id="{{ section_id }}"
  class="indoor-outdoor-section indoor-outdoor-section--{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-indoor-outdoor-switcher
  style="
    --io-bg: {{ section.settings.bg_color | default: '#1B1E22' }};
    --io-text: {{ section.settings.text_color | default: '#FFFFFF' }};
    --io-subtext: {{ section.settings.subtext_color | default: '#FFFFFF' }};
  ">
  <!-- Background Media Stage -->
  <div class="indoor-outdoor__backgrounds">
    {%- for block in section.blocks -%}
      {%- liquid
        assign is_active = false
        if forloop.first
          assign is_active = true
        endif
        assign bg_alt = block.settings.heading | default: block.settings.tab_label | strip_html | escape
      -%}
      <div class="indoor-outdoor__bg-slide {% if is_active %}is-active{% endif %}" data-io-bg="{{ forloop.index0 }}">
        {%- if block.settings.bg_image != blank -%}
          <picture>
            {%- if block.settings.has_mobile_bg and block.settings.bg_image_mobile != blank -%}
              <source
                media="(max-width: 860px)"
                srcset="
                  {{ block.settings.bg_image_mobile | image_url: width: 600 }} 600w,
                  {{ block.settings.bg_image_mobile | image_url: width: 900 }} 900w,
                  {{ block.settings.bg_image_mobile | image_url: width: 1200 }} 1200w
                "
                sizes="100vw">
            {%- endif -%}
            {{
              block.settings.bg_image | image_url: width: 2400 | image_tag: alt: bg_alt, class: 'indoor-outdoor__bg-img', loading: section_loading, fetchpriority: section_fetchpriority, widths: '750, 1100, 1440, 1920, 2400', sizes: '100vw'
            }}
          </picture>
        {%- else -%}
          <div class="indoor-outdoor__bg-placeholder"></div>
        {%- endif -%}

        <!-- Top Gradient Overlay (Rectangle 956521) -->
        {%- if section.settings.enable_top_gradient -%}
          <div class="indoor-outdoor__top-gradient" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
        {%- endif -%}

        <!-- Optional Foreground Cutout Image (image 322) -->
        {%- if block.settings.has_foreground_image and block.settings.foreground_image != blank -%}
          {{
            block.settings.foreground_image | image_url: width: 2400 | image_tag: alt: bg_alt, class: 'indoor-outdoor__fg-img', loading: section_loading, widths: '750, 1100, 1440, 1920, 2400', sizes: '100vw'
          }}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <!-- Foreground Content Container (1440px reference frame) -->
  <div class="indoor-outdoor__container">
    <div class="indoor-outdoor__layout indoor-outdoor__layout--{{ section.settings.desktop_content_position | default: 'right' }}">
      <!-- Frame 1410105928 (632px wide) -->
      <div class="indoor-outdoor__content-col">
        <!-- Frame 1410105858: Pill Switcher Navigation (332px x 48px) -->
        {%- if section.blocks.size > 1 -%}
          <div class="indoor-outdoor__switcher-wrap">
            <div
              class="indoor-outdoor__switcher"
              role="tablist"
              aria-label="Environment Mode Switcher">
              {%- for block in section.blocks -%}
                <button
                  type="button"
                  class="indoor-outdoor__tab-btn custom_subHeading-text {% if forloop.first %}is-active{% endif %}"
                  role="tab"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-controls="io-panel-{{ block.id }}"
                  id="io-tab-{{ block.id }}"
                  data-io-tab="{{ forloop.index0 }}">
                  <span>{{ block.settings.tab_label | default: 'MODE' }}</span>
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <!-- Tab Panels -->
        <div class="indoor-outdoor__panels">
          {%- for block in section.blocks -%}
            {%- liquid
              assign is_active = false
              if forloop.first
                assign is_active = true
              endif
            -%}
            <div
              id="io-panel-{{ block.id }}"
              class="indoor-outdoor__panel {% if is_active %}is-active{% endif %}"
              role="tabpanel"
              aria-labelledby="io-tab-{{ block.id }}"
              data-io-panel="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}>
              <!-- Frame 1171277703: Heading & Description (gap: 24.61px) -->
              <div class="indoor-outdoor__header-group">
                {%- if block.settings.heading != blank -%}
                  <h2 class="indoor-outdoor__heading custom_heading">
                    {{ block.settings.heading }}
                  </h2>
                {%- endif -%}

                {%- if block.settings.description != blank -%}
                  <div class="indoor-outdoor__description custom_body-text">
                    {{ block.settings.description }}
                  </div>
                {%- endif -%}
              </div>

              <!-- Frame 1410105927: 2x2 Feature Badges Grid (509px x 126px, gap 8px) -->
              {%- if block.settings.show_features -%}
                {%- if block.settings.feature_1 != blank or block.settings.feature_2 != blank or block.settings.feature_3 != blank or block.settings.feature_4 != blank
                -%}
                  <ul class="indoor-outdoor__features-grid">
                    {%- if block.settings.feature_1 != blank -%}
                      <li class="indoor-outdoor__feature-pill custom_subHeading-text">
                        <span>{{ block.settings.feature_1 }}</span>
                      </li>
                    {%- endif -%}
                    {%- if block.settings.feature_2 != blank -%}
                      <li class="indoor-outdoor__feature-pill custom_subHeading-text">
                        <span>{{ block.settings.feature_2 }}</span>
                      </li>
                    {%- endif -%}
                    {%- if block.settings.feature_3 != blank -%}
                      <li class="indoor-outdoor__feature-pill custom_subHeading-text">
                        <span>{{ block.settings.feature_3 }}</span>
                      </li>
                    {%- endif -%}
                    {%- if block.settings.feature_4 != blank -%}
                      <li class="indoor-outdoor__feature-pill custom_subHeading-text">
                        <span>{{ block.settings.feature_4 }}</span>
                      </li>
                    {%- endif -%}
                  </ul>
                {%- endif -%}
              {%- endif -%}

              <!-- Partner Logos Row (E6 86x86px, GSPro 138x42px) -->
              {%- if block.settings.show_logos -%}
                {%- if block.settings.logo_1 != blank or block.settings.logo_2 != blank or block.settings.logo_3 != blank -%}
                  <div class="indoor-outdoor__logos">
                    {%- if block.settings.logo_1 != blank -%}
                      {%- assign logo_1_alt = block.settings.logo_1.alt | default: 'Partner Logo 1' | escape -%}
                      {%- assign logo_1_style = 'width: clamp(56px, 6vw, ' | append: block.settings.logo_1_width | append: 'px);' -%}
                      <div class="indoor-outdoor__logo-item">
                        {{
                          block.settings.logo_1 | image_url: width: 320 | image_tag: alt: logo_1_alt, class: 'indoor-outdoor__logo-img', loading: 'lazy', style: logo_1_style
                        }}
                      </div>
                    {%- endif -%}
                    {%- if block.settings.logo_2 != blank -%}
                      {%- assign logo_2_alt = block.settings.logo_2.alt | default: 'Partner Logo 2' | escape -%}
                      {%- assign logo_2_style = 'width: clamp(92px, 9.6vw, ' | append: block.settings.logo_2_width | append: 'px);' -%}
                      <div class="indoor-outdoor__logo-item">
                        {{
                          block.settings.logo_2 | image_url: width: 320 | image_tag: alt: logo_2_alt, class: 'indoor-outdoor__logo-img', loading: 'lazy', style: logo_2_style
                        }}
                      </div>
                    {%- endif -%}
                    {%- if block.settings.logo_3 != blank -%}
                      {%- assign logo_3_alt = block.settings.logo_3.alt | default: 'Partner Logo 3' | escape -%}
                      {%- assign logo_3_style = 'width: clamp(72px, 7.5vw, ' | append: block.settings.logo_3_width | append: 'px);' -%}
                      <div class="indoor-outdoor__logo-item">
                        {{
                          block.settings.logo_3 | image_url: width: 320 | image_tag: alt: logo_3_alt, class: 'indoor-outdoor__logo-img', loading: 'lazy', style: logo_3_style
                        }}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

<style>


  /*
   ==========================================================================
   indoor-outdoor Section (Figma: 1440px x 886px, linear-gradient #1B1E22 -> #000000)
   ==========================================================================
*/
  .indoor-outdoor-section--{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: clamp(620px, 61.53vw, 886px);
    background: linear-gradient(180deg, var(--io-bg, #1B1E22) 0%, #000000 100%);
    color: var(--io-text, #FFFFFF);
    display: flex;
    align-items: flex-start;
    padding-top: clamp(60px, 7.5vw, 110px);
    padding-bottom: clamp(48px, 6vw, 88px);
    overflow: hidden;
    box-sizing: border-box;
    z-index: 2;
  }


  /*
   ==========================================================================
   Backgrounds & Overlays (image 321, Rectangle 956521, image 322)
   ==========================================================================
*/
  .indoor-outdoor-section--{{ section.id }} .indoor-outdoor__backgrounds {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .indoor-outdoor-section--{{ section.id }}
  .indoor-outdoor__bg-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.45s cubic-bezier(0.4, 0, 0.2, 1)
    , visibility 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .indoor-outdoor-section--{{ section.id }}
  .indoor-outdoor__bg-slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .indoor-outdoor-section--{{ section.id }}
  .indoor-outdoor__bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    display: block;
    z-index: 0;
  }

  .indoor-outdoor-section--{{ section.id }}
  .indoor-outdoor__bg-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #1B1E22 0%, #000000 100%);
  }

  /* Rectangle 956521: Top Gradient Overlay */
  .indoor-outdoor-section--{{ section.id }} .indoor-outdoor__top-gradient {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: clamp(380px, 47.9vw, 690px);
    background: linear-gradient(180deg, #1B1E22 2.46%, rgba(27, 30, 34, 0.94) 47.33%, rgba(27, 30, 34, 0) 100%);
    z-index: 1;
    pointer-events: none;
  }

  /* Foreground Cutout Layer (image 322) */
  .indoor-outdoor-section--{{ section.id }} .indoor-outdoor__fg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    display: block;
    z-index: 2;
    pointer-events: none;
  }


  /*
   ==========================================================================
   Foreground Container (1440px grid, Frame 1410105928 at left: 728px, width: 632px)
   ==========================================================================
*/
  .indoor-outdoor-section--{{ section.id }} .indoor-outdoor__container {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding-inline: clamp(16px, 5.55vw, 80px);
    box-sizing: border-box;
  }

  .indoor-outdoor-section--{{ section.id }}
  .indoor-outdoor__layout {
    display: flex;
    width: 100%;
  }

  .indoor-outdoor-section--{{ section.id }}
  .indoor-outdoor__layout--right {
    justify-content: flex-end;
  }

  .indoor-outdoor-section--{{ section.id }}
  .indoor-outdoor__layout--left {
    justify-content: flex-start;
  }

  .indoor-outdoor-section--{{ section.id }}
  .indoor-outdoor__layout--center {
    justify-content: center;
  }

  /* Frame 1410105928: width 632px */
  .indoor-outdoor-section--{{ section.id }} .indoor-outdoor__content-col {
    width: 100%;
    max-width: clamp(460px, 43.89vw, 642px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }


  /*
   ==========================================================================
   Frame 1410105858: Pill Switcher (332px x 48px, padding 6px, gap 4px)
   ==========================================================================
*/
  .indoor-outdoor-section--{{ section.id }} .indoor-outdoor__switcher-wrap {
    margin-bottom: clamp(14px, 1.32vw, 19px);
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .indoor-outdoor-section--{{ section.id }}
  .indoor-outdoor__switcher {
    box-sizing: border-box;
    display: inline-flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 6px;
    gap: 4px;
    width: clamp(280px, 23.05vw, 332px);
    height: clamp(42px, 3.33vw, 48px);
    background: rgba(27, 30, 34, 0.4);
    border: 1px solid #474646;
    border-radius: 100px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  /* BUTTONS: width 157px, height 34px, padding 12px 16px, border-radius 100px */
  .indoor-outdoor-section--{{ section.id }} .indoor-outdoor__tab-btn {
    box-sizing: border-box;
    appearance: none;
    border: none;
    background: transparent;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 10px 16px;
    gap: 10px;
    flex: 1 1 0;
    min-width: clamp(130px, 10.9vw, 157px);
    height: clamp(30px, 2.36vw, 34px);
    border-radius: 100px;
    color: #B4B4B4;
    font-size: clamp(12px, 0.97vw, 14px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 180ms cubic-bezier(0.4, 0, 0.2, 1)
    , color 180ms cubic-bezier(0.4, 0, 0.2, 1)
    , transform 100ms ease;
  }

  .indoor-outdoor-section--{{ section.id }}.indoor-outdoor__tab-btn:hover {
    color: #FFFFFF;
  }

  .indoor-outdoor-section--{{ section.id }}.indoor-outdoor__tab-btn:active {
    transform: scale(0.98);
  }

  .indoor-outdoor-section--{{ section.id }}.indoor-outdoor__tab-btn:focus-visible {
    outline: 2px solid #FFFFFF;
    outline-offset: 2px;
  }

  .indoor-outdoor-section--{{ section.id }}
  .indoor-outdoor__tab-btn.is-active {
    background: #FFFFFF;
    color: #1B1E22;
  }


  /*
   ==========================================================================
   Tab Panels & Typography (Frame 1171277703: width 632px, gap 24.61px)
   ==========================================================================
*/
  .indoor-outdoor-section--{{ section.id }} .indoor-outdoor__panels {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
    align-items: start;
  }

  .indoor-outdoor-section--{{ section.id }}
  .indoor-outdoor__panel {
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1)
    , visibility 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .indoor-outdoor-section--{{ section.id }}
  .indoor-outdoor__panel.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  @keyframes ioFadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .indoor-outdoor-section--{{ section.id }}
  .indoor-outdoor__header-group {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: clamp(16px, 1.71vw, 24.61px);
    width: 100%;
    {% comment %} max-width: 632px;
    / {% endcomment %}
  margin-bottom: clamp(16px, 1.35vw, 19.4px);
}

/* BUILD YOUR HOME GAME: 42px, line-height 100%, letter-spacing -0.02em, uppercase, #FFFFFF */
.indoor-outdoor-section--{{ section.id }} .indoor-outdoor__heading {
  font-size: clamp(26px, 2.92vw, 42px);
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--io-text, #FFFFFF);
  text-transform: uppercase;
  margin: 0;
  width: 100%;
}

/* Body Copy - M: width 560px, font-size 16px, line-height 150% (24px), letter-spacing 0.02em, #FFFFFF */
.indoor-outdoor-section--{{ section.id }} .indoor-outdoor__description {
  font-size: clamp(14px, 1.11vw, 16px);
  font-weight: 400;
  line-height: 1.5;
  letter-spacing: 0.02em;
  color: var(--io-subtext, #FFFFFF);
  max-width: clamp(320px, 38.89vw, 560px);
  width: 100%;
  margin: 0 auto;
}

.indoor-outdoor-section--{{ section.id }}
.indoor-outdoor__description p {
  margin: 0;
  padding: 0;
  font-size: inherit;
  line-height: inherit;
  letter-spacing: inherit;
  color: inherit;
}


/*
   ==========================================================================
   Frame 1410105927: 2x2 Feature Badges Grid (509px wide, gap 8px)
   Tiles: 250.5px x 59px, padding 24px, background rgba(0,0,0,0.5), radius 16.9223px
   Text: 16px, weight 700, letter-spacing 0.1em, #FFFFFF
   ==========================================================================
*/
.indoor-outdoor-section--{{ section.id }} .indoor-outdoor__features-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  width: 100%;
  max-width: clamp(340px, 35.35vw, 509px);
  list-style: none;
  padding: 0;
  margin: 0 auto;
}

.indoor-outdoor-section--{{ section.id }}
.indoor-outdoor__feature-pill {
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  padding: 18px 20px;
  min-height: clamp(48px, 4.1vw, 59px);
  background: rgba(0, 0, 0, 0.5);
  border-radius: clamp(12px, 1.175vw, 16.9223px);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  text-align: center;
  transition: background-color 150ms cubic-bezier(0.4, 0, 0.2, 1)
  , transform 100ms ease;
}

.indoor-outdoor-section--{{ section.id }}
.indoor-outdoor__feature-pill span {
  font-size: clamp(12px, 1.11vw, 16px);
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0.1em;
  color: #FFFFFF;
  text-transform: uppercase;
  white-space: nowrap;
}


/*
   ==========================================================================
   Partner Logos Row (E6: 86x86px, GSPro: 138x42px, gap ~31px)
   ==========================================================================
*/
.indoor-outdoor-section--{{ section.id }} .indoor-outdoor__logos {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: clamp(20px, 2.15vw, 31px);
  margin-top: clamp(14px, 1.2vw, 18px);
}

.indoor-outdoor-section--{{ section.id }}
.indoor-outdoor__logo-item {
  display: flex;
  align-items: center;
  justify-content: center;
}

.indoor-outdoor-section--{{ section.id }}
.indoor-outdoor__logo-img {
  height: auto;
  max-height: clamp(56px, 6vw, 86px);
  object-fit: contain;
  display: block;
}


/*
   ==========================================================================
   Responsive Mobile & Tablet Adjustments
   ==========================================================================
*/
@media (max-width: 991px) {
  .indoor-outdoor-section--{{ section.id }} {
    min-height: clamp(660px, 130vw, 860px);
    align-items: flex-start;
    padding-block: clamp(36px, 8vw, 56px);
  }

  .indoor-outdoor-section--{{ section.id }}
  .indoor-outdoor__layout {
    justify-content: center;
  }

  .indoor-outdoor-section--{{ section.id }}
  .indoor-outdoor__content-col {
    max-width: 100%;
  }

  .indoor-outdoor-section--{{ section.id }}
  .indoor-outdoor__description {
    max-width: 100%;
  }

  .indoor-outdoor-section--{{ section.id }}
  .indoor-outdoor__features-grid {
    max-width: 509px;
  }

  .indoor-outdoor-section--{{ section.id }}
  .indoor-outdoor__feature-pill span {
    white-space: normal;
  }
}

@media (max-width: 420px) {
  .indoor-outdoor-section--{{ section.id }} .indoor-outdoor__switcher {
    width: 100%;
    max-width: 310px;
  }

  .indoor-outdoor-section--{{ section.id }}
  .indoor-outdoor__tab-btn {
    min-width: 0;
  }

  .indoor-outdoor-section--{{ section.id }}
  .indoor-outdoor__features-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
  (function () {
    function initIndoorOutdoorSwitcher(root) {
      if (!root || root.dataset.ioInitialized === 'true') return;
      root.dataset.ioInitialized = 'true';

      var tabs = Array.from(root.querySelectorAll('[data-io-tab]'));
      var panels = Array.from(root.querySelectorAll('[data-io-panel]'));
      var bgs = Array.from(root.querySelectorAll('[data-io-bg]'));

      if (tabs.length === 0) return;

      function activateTab(index) {
        tabs.forEach(function (tab, i) {
          var active = i === index;
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        panels.forEach(function (panel, i) {
          panel.classList.toggle('is-active', i === index);
        });

        bgs.forEach(function (bg, i) {
          bg.classList.toggle('is-active', i === index);
        });
      }

      tabs.forEach(function (tab, index) {
        tab.addEventListener('click', function () {
          activateTab(index);
        });
      });

      // Support Shopify Theme Editor block selection
      document.addEventListener('shopify:block:select', function (event) {
        if (!root.contains(event.target)) return;
        var panelIndex = event.target.getAttribute('data-io-panel');
        if (panelIndex !== null) {
          activateTab(parseInt(panelIndex, 10));
        }
      });
    }

    function initAll() {
      var sections = document.querySelectorAll('[data-indoor-outdoor-switcher]');
      sections.forEach(initIndoorOutdoorSwitcher);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', function (event) {
      var root = event.target.querySelector('[data-indoor-outdoor-switcher]');
      if (root) initIndoorOutdoorSwitcher(root);
    });
  })();
</script>

