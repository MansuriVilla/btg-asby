}
@media only screen and (max-width: 768px) {
  .two-layout__video-toggle {
    bottom: 14px;
    right: 14px;
    width: 40px;
    height: 40px;
  }
}
</style>

<script>
  function copyPromoCode(code, btn) {
    if (!code) return;
    navigator.clipboard.writeText(code).then(function() {
      var origText = btn.textContent;
      btn.textContent = "Copied!";
      setTimeout(function() {
        btn.textContent = origText;
      }, 2000);
    }).catch(function(err) {
      console.error("Failed to copy promo code: ", err);
    });
  }

  function getOS() {
        const ua = navigator.userAgent.toLowerCase();
        const platform = navigator.platform.toLowerCase();

        if (/iphone|ipad|ipod|macintosh/.test(ua) || /macintel/.test(platform)) {
            return 'apple';     // macOS or iOS → keep your original order (mov first)
        }
        if (/android/.test(ua) || /win/.test(platform)) {
            return 'non-apple'; // Windows or Android → flip to webm first
        }
        return 'unknown';       // fallback
    }

    // === Set sources in correct order ===
    function setupVideoSources() {
        const video = document.getElementById('myVideo');
        const isApple = getOS() === 'apple';

        // Clear any existing sources
        video.innerHTML = '<p>Your browser does not support the video tag.</p>';

        if (isApple) {
            // macOS / iOS order (as you have now)
            video.innerHTML += `
                <source src="test-1.mov" type="video/quicktime">
                <source src="test.webm" type="video/webm">
            `;
        } else {
            // Windows / Android order (webm first)
            video.innerHTML += `
                <source src="test.webm" type="video/webm">
                <source src="test-1.mov" type="video/quicktime">
            `;
        }

        // Reload the video so it picks the new sources
        video.load();
    }

  function toggleTwoLayoutVideo(btn, e) {
    if (e) e.stopPropagation();
    const wrapper = btn.closest('.two-layout__video-wrapper');
    if (!wrapper) return;
    const video = wrapper.querySelector('video');
    if (!video) return;

    const pauseIcon = btn.querySelector('.pause-icon');
    const playIcon = btn.querySelector('.play-icon');

    if (video.paused) {
      var playPromise = video.play();
      if (playPromise !== undefined) {
        playPromise.catch(function(err) { console.log('Video play error:', err); });
      }
      if (pauseIcon) pauseIcon.style.display = 'block';
      if (playIcon) playIcon.style.display = 'none';
      btn.setAttribute('aria-label', 'Pause video');
      btn.setAttribute('aria-pressed', 'false');
      btn.classList.remove('paused');
    } else {
      video.pause();
      if (pauseIcon) pauseIcon.style.display = 'none';
      if (playIcon) playIcon.style.display = 'block';
      btn.setAttribute('aria-label', 'Play video');
      btn.setAttribute('aria-pressed', 'true');
      btn.classList.add('paused');
    }
  }

  function initTwoLayoutVideoControls() {
    const videoWrappers = document.querySelectorAll('.two-layout__video-wrapper');
    videoWrappers.forEach(function(wrapper) {
      const video = wrapper.querySelector('video');
      const toggleBtn = wrapper.querySelector('.two-layout__video-toggle');
      if (!video || !toggleBtn) return;

      const pauseIcon = toggleBtn.querySelector('.pause-icon');
      const playIcon = toggleBtn.querySelector('.play-icon');

      function updateButtonState(isPaused) {
        if (isPaused) {
          if (pauseIcon) pauseIcon.style.display = 'none';
          if (playIcon) playIcon.style.display = 'block';
          toggleBtn.setAttribute('aria-label', 'Play video');
          toggleBtn.setAttribute('aria-pressed', 'true');
          toggleBtn.classList.add('paused');
        } else {
          if (pauseIcon) pauseIcon.style.display = 'block';
          if (playIcon) playIcon.style.display = 'none';
          toggleBtn.setAttribute('aria-label', 'Pause video');
          toggleBtn.setAttribute('aria-pressed', 'false');
          toggleBtn.classList.remove('paused');
        }
      }

      video.addEventListener('play', function() {
        updateButtonState(false);
      });

      video.addEventListener('pause', function() {
        updateButtonState(true);
      });

      video.addEventListener('click', function() {
        toggleTwoLayoutVideo(toggleBtn);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTwoLayoutVideoControls);
  } else {
    initTwoLayoutVideoControls();
  }
  document.addEventListener('shopify:section:load', initTwoLayoutVideoControls);
</script>


<script>
async function buyNow(button) {

  // Add loading class
  button.classList.add("btn--loading");

  // Optional: prevent multiple clicks
  button.style.pointerEvents = "none";

  const items = [
    {
      id: 45793869299909,
      quantity: 1,
      selling_plan: 6775537861
    },
    {
      id: 45724258697413,
      quantity: 1,
      properties: {
        "_landing_page": "campaign-1"
      }
    }
  ];

  try {
    const response = await fetch("/cart/add.js", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      body: JSON.stringify({ items })
    });

    if (response.ok) {
      document.dispatchEvent(new CustomEvent("ajaxProduct:added", { detail: {} }));
    } else {
      throw new Error("Unable to add products.");
    }

  } catch (error) {
    alert(error.message);
  } finally {
    button.classList.remove("btn--loading");
    button.style.pointerEvents = "auto";
  }
}
</script>

{% schema %}
{
  "name": "Two Layout Section New",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "layoutHeading",
      "label": "Section Heading"
    },
    {
      "type": "color",
      "id": "sectionColor",
      "label": "Section Background Color",
      "alpha": true,
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "heading_clr",
      "label": "Heading Color",
      "default": "#fff"
    },
    {
      "type": "header",
      "content": "Extras"
    },
    {
      "type": "checkbox",
      "id": "sectionLayout",
      "label": "Change Section Layout To Blocks"
    },
    {
      "type": "checkbox",
      "id": "section_container",
      "label": "Enable Container"
    },
    {
      "type": "checkbox",
      "id": "section_custom",
      "label": "Custom Layout"
    },
    {
      "type": "checkbox",
      "id": "section_pad",
      "label": "Add Padding From Top and Bottom"
    },
    {
      "type": "checkbox",
      "id": "eager_load",
      "label": "Eager Load First Image (Above the fold)",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "two_layout_block",
      "name": "Block",
      "settings": [
        {
          "type": "header",
          "content": "Block Content"
        },
        {
          "type": "select",
          "id": "layout",
          "options": [
             { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center",
          "label": "Layout Options",
          "info":"Only for the content block."
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "html",
          "id": "sectionTitle",
          "label": "Block Heading"
        },
        {
          "type": "text",
          "id": "sectionDescription",
          "label": "Block Description"
        },
        {
          "type": "header",
          "content": "Price & Discount Badge"
        },
        {
          "type": "text",
          "id": "top_label",
          "label": "Top Badge Text",
          "info": "e.g. $50 OFF - SPECIAL OFFER"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare At / Original Price",
          "info": "e.g. $599"
        },
        {
          "type": "text",
          "id": "regular_price",
          "label": "Discounted / Main Price",
          "info": "e.g. $549"
        },
        {
          "type": "text",
          "id": "price_note",
          "label": "Price Subtext / Note",
          "info": "e.g. INCLUDES 1 YR GAME INTELLIGENCE MEMBERSHIP ($79 VALUE)"
        },
        {
          "type": "header",
          "content": "Promo / Coupon Code"
        },
        {
          "type": "text",
          "id": "promo_text",
          "label": "Promo Line Prefix Text",
          "info": "e.g. Use Code"
        },
        {
          "type": "text",
          "id": "promo_code",
          "label": "Promo Code",
          "info": "e.g. BIGBREAK50RM"
        },
        {
          "type": "checkbox",
          "id": "cta_enable",
          "label": "Enable CTA"
        },
        {
          "type": "text",
