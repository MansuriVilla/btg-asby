}

.two-layout__video-wrapper {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  overflow: hidden;
}
.two-layout__video-wrapper video {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 12px;
  cursor: pointer;
}
.two-layout__video-toggle {
  position: absolute;
  bottom: 20px;
  right: 20px;
  z-index: 10;
  background: rgba(0, 0, 0, 0.55);
  border: 1.5px solid rgba(255, 255, 255, 0.5);
