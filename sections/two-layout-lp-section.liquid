{% liquid
   assign section_layout = section.settings.sectionLayout
   assign layout_heading = section.settings.layoutHeading
   assign section_padding = section.settings.section_pad
   assign section_container = section.settings.section_container
   assign section_custom = section.settings.section_custom
 %}

<div
  class="two-layout__section two-layout__section--{{section.id}}{%if section_padding %} two-layout__section--has-pad{%endif%}{%if section_container %} new-page-width{%endif%}{%if section_custom %} section_custom{%endif%}"
  data-section-id="{{ section.id }}"
>
  {% if layout_heading != blank %}
    <h2 class="two-layout__heading">{{ layout_heading }}</h2>
  {% endif %}
  {% if section_layout %}
    <div class="two-layout_section-block-container new-page-width">
  {% endif %}
  {% for block in section.blocks %}
    {% liquid
      
      assign layout = block.settings.layout
      assign icon = block.settings.icon
      assign title = block.settings.sectionTitle
      assign description = block.settings.sectionDescription
      assign cta_enable = block.settings.cta_enable
      assign cta_text = block.settings.cta_text
      assign cta_link = block.settings.cta_link
      assign disclaimer = block.settings.disclaimer
      assign desktop_image = block.settings.sectionImage
      assign deff_mobile_image = block.settings.hasMobileImage
      assign mobile_image = block.settings.sectionImageMobile
      assign section_direction = block.settings.sectionDirection
      assign image_full = block.settings.image_full
      assign video_src = block.settings.video_src
      assign has_image = block.settings.hasImage
      assign has_store_icon = block.settings.has_store_icon
      assign app_store_link = block.settings.app_store_link
      assign app_store_image = block.settings.app_store_image
      assign play_store_link_new = block.settings.play_store_link_new
      assign play_store_image_new = block.settings.play_store_image_new
      assign cta_link_two = block.settings.cta_link_two
      assign cta_text_two = block.settings.cta_text_two
      
      assign image_alt = title | replace: '<br>', ' ' | replace: '<br />', ' ' | strip_html | escape
      assign block_loading = 'lazy'
      assign block_fetchpriority = 'auto'
      if section.index == 1 or section.index == nil or section.settings.eager_load
        if forloop.first
          assign block_loading = 'eager'
          assign block_fetchpriority = 'high'
        endif
      endif
      assign custom_page = false
      case page.template_suffix
      when 'big-break'
      assign custom_page = true
      endcase
    %}

    {% if section_layout %}
      <div class="section-block">
    {% else %}
      <div
        class="two-layout_section-container {%if custom_page %} new-page-width {%else%} new-page-width-xl{%endif%}{% if section_direction %} section-row__revers{% endif %}"
        {%if custom_page %}
          id="offer_section"
        {%endif %}
      >
    {% endif %}

    <div class="section-left">
      <div class="section-left__inner layout--{{ layout }}">
        {% if icon != blank %}
          {{
            icon
            | image_url: width: 50
            | image_tag:
              class: 'icon_image',
              alt: image_alt,
              loading: block_loading,
              fetchpriority: block_fetchpriority,
              widths: '400,600,800,1200,1600,1800,2400',
              sizes: '(max-width: 859px) 100vw, 100vw',
              height: icon.height,
              width: icon.width
          }}
        {% endif %}
        {% if title != blank %}
          <h3 class="section-left__title">
            {{ title }}
          </h3>
        {% endif %}
        {% if description != blank %}
          <p class="section-left__description">
            {{ description }}
          </p>
        {% endif %}

        {% assign top_label = block.settings.top_label %}
        {% assign compare_price = block.settings.compare_price %}
        {% assign regular_price = block.settings.regular_price %}
        {% assign price_note = block.settings.price_note %}
        {% assign promo_text = block.settings.promo_text %}
        {% assign promo_code = block.settings.promo_code %}

        {% if top_label != blank %}
          <div class="section-left__badge">
            <span>{{ top_label }}</span>
          </div>
        {% endif %}

        {% if regular_price != blank or compare_price != blank %}
          <div class="section-left__price-wrap">
            {% if compare_price != blank %}
              <span class="compare-at-price">
                {{ compare_price }}
                 <img class="price__strike-out-img" src="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/btg-strike-out-price.svg?v=1782886928" alt="discount price slash out" loading="eager" decoding="async" width="403px" height="9px">
              </span>
            {% endif %}
            {% if regular_price != blank %}
              <span class="main-price">{{ regular_price }}</span>
            {% endif %}
            {% if price_note != blank %}
              <span class="price-note">{{ price_note }}</span>
            {% endif %}
          </div>
        {% endif %}

        {% if promo_text != blank or promo_code != blank %}
          <div class="section-left__promo-wrap">
            {% if promo_text != blank %}
              <span class="promo-text">{{ promo_text }}</span>
            {% endif %}
            {% if promo_code != blank %}
              <span class="promo-code-wrap">
                <strong class="promo-code">{{ promo_code }}</strong> at Checkout.
                <button type="button" class="promo-copy-btn" onclick="copyPromoCode('{{ promo_code }}', this)">Copy Code</button>
              </span>
            {% endif %}
          </div>
        {% endif %}
<div class="section_ctas">
        {% if cta_text != blank and cta_enable %}
          <a onclick="buyNow(this);" href="{{ cta_link | default: 'javascript:void(0);' }}" class="section-left__cta content-cta content-cta__solid{% if page.template_suffix contains 'rainmaker-event-qr-lp' and  cta_link == blank %} add_1yr_membership_qr{%endif%}">
            {{ cta_text }}
          </a>
        {% endif %}
        {% if cta_text_two != blank and cta_enable %}
          <a href="{{ cta_link_two | default: 'javascript:void(0);' }}" class="section-left__cta cta_secondary ">
            
             <span class="anchor_hover arrow__text" style="--hover-clr:#fff;">{{ cta_text_two }}</span>
          </a>
        {% endif %}
      </div>
        {% if disclaimer != blank %}
          <div class="section-left__disclaimer">
            {{ disclaimer }}
          </div>
        {% endif %}
        
        {% if has_store_icon %}
          <div class="store_icons">
            {% if app_store_link != blank %}
              <a class="store_icon app_store" href="{{ app_store_link }}">
                {{
                  app_store_image
                  | image_url: width: 500
                  | image_tag:
                    class: 'store_icon',
                    alt: image_alt,
                    loading: block_loading,
                    fetchpriority: block_fetchpriority,
                    widths: '400,600,800,1200,1600,1800,2400',
                    sizes: '(max-width: 859px) 100vw, 100vw',
                    height: app_store_image.height,
                    width: app_store_image.width
                }}
              </a>
            {% endif %}
            {% if play_store_link_new != blank %}
              <a class="store_icon play_store" href="{{ play_store_link_new }}">
                {{-
                  play_store_image_new
                  | image_url: width: 500
                  | image_tag:
                    class: 'store_icon',
                    alt: image_alt,
                    loading: block_loading,
                    fetchpriority: block_fetchpriority,
                    widths: '400,600,800,1200,1600,1800,2400',
                    sizes: '(max-width: 859px) 100vw, 100vw',
                    height: play_store_image_new.height,
                    width: play_store_image_new.width
                -}}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="section-right">
      <div class="section-right__inner">
        {% if has_image and desktop_image != blank %}
          {% capture extra_class %}
            {% if image_full %} image_full{% endif %}
          {% endcapture %}

          {% assign image_class = 'image-fit lazyload' | append: extra_class | strip %}

          <picture>
            <source media="(min-width: 860px)" srcset="{{ desktop_image | image_url: width: 1800 }}">

            {% if deff_mobile_image %}
              <source media="(max-width: 861px)" srcset="{{ mobile_image | image_url: width: 800 }}">
            {% endif %}

            {{
              desktop_image
              | image_url: width: 1800
              | image_tag:
                class: image_class,
                alt: image_alt,
                loading: block_loading,
                fetchpriority: block_fetchpriority,
                widths: '400,600,800,1200,1600,1800,2400',
                sizes: '(max-width: 859px) 100vw, 100vw',
                height: desktop_image.height,
                width: desktop_image.width
            }}
          </picture>
        {% else %}
          {% assign video_url = video_src.sources[1].url | default: video_src.sources[0].url %}
          
          <div class="two-layout__video-wrapper">
            <video
              id="video-{{ block.id }}"
              class="preview-videod two-layout__video"
              autoplay
              loop
              muted
              playsinline
              src="{{ video_url }}"
            ></video>
            <button
              type="button"
              class="two-layout__video-toggle"
              aria-label="Pause video"
              aria-pressed="false"
              onclick="toggleTwoLayoutVideo(this, event)"
            >
              <svg class="pause-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="2" y="1" width="3" height="12" rx="1" fill="currentColor"/>
                <rect x="9" y="1" width="3" height="12" rx="1" fill="currentColor"/>
              </svg>
              <svg class="play-icon" style="display:none;" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M3.5 1.5L12 7L3.5 12.5V1.5Z" fill="currentColor"/>
              </svg>
            </button>
          </div>
        {% endif %}
      </div>
    </div>

    {% if section_layout %}
      </div>
    {% else %}
      </div>
    {% endif %}
  {% endfor %}

  {% if section_layout %}
    </div>
  {% endif %}
</div>

<style>
    {% if section.settings.sectionColor != blank %}
      .two-layout__section--{{section.id}} { background: {{section.settings.sectionColor}}; }
    {% endif %}

    .two-layout__section--{{ section.id }} .section-left__title { color: {{section.settings.heading_clr | default: '#fff' }} }

    {% if section.settings.layoutHeading != blank %}
      .two-layout__heading { color: #fff; margin-inline: auto; max-width: 990px; width: 100%; font-size: clamp(22px,3vw,48px); text-align: center; line-height: 105%; letter-spacing: -0.32px; margin-block: 0 clamp(20px,3.5vw,55px); padding-inline: 16px; }
      .two-layout__section:has(.two-layout__heading) { padding-block: clamp(30px,3.6vw,60px) 0; }
    {% endif %}
    
    {% if section.settings.section_pad %}
      .two-layout__section--{{section.id}}.two-layout__section--has-pad{padding-block:clamp(25px,5vw,50px);}
    {% endif %}
    .section-left__disclaimer *{ padding:0px; font-size:14px; color:#A1A3A9; line-height:1.5;}


    .price__strike-out-img {
