  <script>
// SLIDER SCRIPT START 

function sliderLogic() {
    const images = document.querySelectorAll('.am-main_slider-img .am-slide_item');
    const texts = document.querySelectorAll('.am-main_slider-text');
    const progressBars = document.querySelectorAll('.progress_bar-slider .blue');
    let currentSlide = 0;
    let slideInterval;

    // Dynamically generate IDs for each slide item
    images.forEach((img, index) => {
        img.id = `am-slide_item-${index + 1}`;
    });

    // Set the first slide as active by default
    if (images.length > 0) {
        images[0].classList.add('active');
    }
    if (texts.length > 0) {
        texts[0].classList.add('active');
    }

    function startProgressBar(index) {
        progressBars.forEach((bar, i) => {
            bar.style.transition = i === index ? 'width 5s linear' : 'none';
            bar.style.width = i === index ? '100%' : '0';
        });
    }

    function showSlide(index) {
        clearInterval(slideInterval);

        images.forEach((img, i) => img.classList.toggle('active', i === index));
        texts.forEach((txt, i) => txt.classList.toggle('active', i === index));

        startProgressBar(index);
        currentSlide = index;

        slideInterval = setTimeout(() => {
            const newIndex = (currentSlide + 1) % images.length;
            showSlide(newIndex);
        }, 5000);
    }

    function nextSlide() {
        const newIndex = (currentSlide + 1) % images.length;
        showSlide(newIndex);
    }

    function prevSlide() {
        const newIndex = (currentSlide - 1 + images.length) % images.length;
        showSlide(newIndex);
    }

    // Create dynamic next and previous buttons
    function createNavigationButtons() {
        // Get all containers with the class 'am_slider--btn'
        const btnContainers = document.querySelectorAll('.am_slider--btn');
        
        btnContainers.forEach((container) => {
            // Create the "Next" button
            const nextBtn = document.createElement('button');
            nextBtn.classList.add('am_btn--next');
            
            // Check for custom text or content from data attributes
            if (container.hasAttribute('data-next-text')) {
                nextBtn.textContent = container.getAttribute('data-next-text');
            }
            if (container.hasAttribute('data-next-img')) {
                const img = document.createElement('img');
                img.src = container.getAttribute('data-next-img');
                nextBtn.innerHTML = ''; // Clear text if image is set
                nextBtn.appendChild(img);
            }
            if (container.hasAttribute('data-next-svg')) {
                nextBtn.innerHTML = container.getAttribute('data-next-svg');
            }

            // Create the "Previous" button
            const prevBtn = document.createElement('button');
            prevBtn.classList.add('am_btn--prev');
            
            // Check for custom text or content from data attributes
            if (container.hasAttribute('data-prev-text')) {
                prevBtn.textContent = container.getAttribute('data-prev-text');
            }
            if (container.hasAttribute('data-prev-img')) {
                const img = document.createElement('img');
                img.src = container.getAttribute('data-prev-img');
                prevBtn.innerHTML = ''; // Clear text if image is set
                prevBtn.appendChild(img);
            }
            if (container.hasAttribute('data-prev-svg')) {
                prevBtn.innerHTML = container.getAttribute('data-prev-svg');
            }

            // Append buttons to the container
            container.appendChild(prevBtn);
            container.appendChild(nextBtn);

            // Add event listeners to the buttons
            nextBtn.addEventListener('click', nextSlide);
            prevBtn.addEventListener('click', prevSlide);
        });
    }

    // Initialize slider
    function initializeSlider() {
        showSlide(0);
        createNavigationButtons();  // Create the buttons after the slider is initialized
    }

    // Initialize the slider logic
    initializeSlider();

    // Attach event listeners for text clicks to jump to specific slides
    texts.forEach((text, i) => {
        text.addEventListener('click', () => {
            showSlide(i);
        });
    });
}

// Initialize the slider logic
sliderLogic();


</script>



  

                            
