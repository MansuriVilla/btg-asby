<section class="ready-to-join__{{ page.handle }}">
    <div class="ready-to-join__inner">
        <div class="ready-inner__content">
            <h2 class="ready__heading">Ready to Join THOUSANDS OF <br> <span class="fs__stroke">SATISFIED Golfers?</span></h2>
            <p>Shop our best-sellers and experience the hype for yourself.</p>
            <a class="cta ready__cta" href="/pages/all-products">SHOP NOW</a>
        </div>
    </div>
</section>



<style>
:is(h2, .font-heading) { --font-heading: clamp(24px, 4.8vw, 52px); font-size: var(--font-heading); line-height: var(--font-heading); text-transform: none; }
:is(h5, .font-subtitle) { --font-subtitle: clamp(16px, 2vw, 20px); font-size: var(--font-subtitle); line-height: calc(var(--font-subtitle) + clamp(4px, 0.5vw, 8px)); text-transform: none; }
/*-------------------------
  Ready To Join Styles
  ----------------*/

  .ready-to-join__inner {
  background: var(--new-black);
  padding: clamp(34px,4vw,80px) 25px clamp(25px, 4vw, 80px) ;
  color: #fff;
  text-align: center;
}
.ready-inner__content {
  display: flex;
  flex-direction: column;
  gap: 20px;
  justify-content: center;
  align-items: center;
}

.ready__cta {
  padding: 15px 50px;
  background: var(--new-blue);
  display: inline-flex;
  max-width: fit-content;
  width: 100%;
  border-radius: 50px;
  font-size: 14px;
  font-weight: 900;
  color: #fff;
}
.ready__cta:hover{
background:#fff;
color:var(--new-blue);
}

.ready-inner__content .ready__heading {
  font-weight: 900;
  
  max-width: clamp(300px, 75vw, 820px);
}

.ready-inner__content p {
  padding: 0;
  max-width: 435px;
  font-size: clamp(16px,2.2vw,20px);
  line-height: 28px;
}
  .fs__stroke{text-shadow: -1px -1px 0 #fff, 1px -1px 0 #fff, -1px 1px 0 #fff, 1px 1px 0 #fff; color: var(--new-black);}



  @media only screen and (max-width:860px){
    .ready-inner__content p{max-width:255px;}
    .ready-inner__content .ready__heading{ max-width: clamp(300px, 63vw, 800px);}
  }

</style>



{% schema %}

{
  "presets": [
    {
      "name": "Ready To Join"
    }
  ]
}


{% endschema %}