<div class="padding_box_bg">
  	<div class="change_way_title">
      {% if section.settings.top_icon != blank %}
          <div class="top-icon"><img src="{{ section.settings.top_icon | img_url: 'master' }}"></div>
      {% endif %}
      
      {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.sub_heading != blank %}
          <h3>{{ section.settings.sub_heading }}</h3>
      {% endif %}
      {% if section.settings.text != blank %}
          <p>{{ section.settings.text }}</p>
      {% endif %}
	</div>
</div>






{% schema %}
  {
    "name": "Home Top Headng",
    "settings": [
      {
        "type": "image_picker",
        "id": "top_icon",
        "label": "Icon"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
	  {
        "type": "richtext",
        "id": "sub_heading",
        "label": "Sub Heading"
      },
	  {
        "type": "text",
        "id": "text",
        "label": "Text"
      }
    ],    
    "presets": [
      {
        "name": "Home Top Headng",
        "category": "Text"
      }
    ]
  }
{% endschema %}