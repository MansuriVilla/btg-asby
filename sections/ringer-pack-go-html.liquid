    startCarousel();
  } else {
    $('.owl-carousel').addClass('off');
  }
});

$(window).resize(function() {
    if ( $(window).width() < 1081 ) {
      startCarousel();
    } else {
      stopCarousel();
    }
});

function startCarousel(){
  $(".ringer-slider").owlCarousel({
      navigation : true, // Show next and prev buttons
     slideSpeed : 500,
     margin:0,
     paginationSpeed : 400,
     autoplay:true,
     items : 1,
     itemsDesktop : false,
     itemsDesktopSmall : false,
     itemsTablet: false,
     itemsMobile : false,
     loop:true,
     dots:false,
     nav:true,
     navText: ["<img src='{{'left-ic.png' | asset_url}}'>","<img src='{{'right-ic.png' | asset_url}}'>"],
     responsive:{
            0:{
                items:1
            },
            500:{
                items:2
            },
            768:{
                items:3
            },
            992:{
                items:4
            }
        }
  });
}
function stopCarousel() {
  var owl = $('.owl-carousel');
  owl.trigger('destroy.owl.carousel');
  owl.addClass('off');
}
</script>