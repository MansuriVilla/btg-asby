{{ 'https://cdn.jsdelivr.net/gh/mansurivilla/horizonslider/prod/css/HorizonSlider.min.css' | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: clamp({{ section.settings.padding_top | times: 0.5 | round: 0 }}px, 5vw, {{ section.settings.padding_top }}px);
    padding-bottom: clamp({{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px, 5vw, {{ section.settings.padding_bottom }}px);
    background-color: #ffffff;
  }

  .perks-header {
    text-align:center;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: flex-start;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .perks-heading {

    font-size: clamp(26px, 3vw, 55px);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0;
    color: #111111;
  }

  .perks-description {
    width: 100%;

    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.6;
    color: #333333;
  }

  .perks-description p {
    margin-top: 0;
    margin-bottom: 1.5rem;
    padding: 0;
  text-wrap: inherit;
  }
  
  .perks-description p:last-child {
    margin-bottom: 0;
  }

  .perks-button-wrapper {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .perks-grid-wrapper {
    position: relative;
    padding: clamp(30px, 8vw, 100px) 0;
    overflow: hidden;
  }

  .perks-bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  /* Fallback color if no image */
  .perks-grid-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #e0e0e0;
    z-index: -1;
  }

  /* Only applied as grid on desktop */
  .perks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
    z-index: 1;
    position: relative;
  }

  @media screen and (min-width: 900px) {
    .perks-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    
  }
  
  .perks-card {
    background-color: #111111;
    border-radius: 8px;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 15px;
    min-height: clamp(180px,30vw,220px);

    transition: transform 0.3s ease;
  }

  .perks_slider .slider_navigation-area {
  justify-content: center !important;
}
  

  .perks-icon {
    color: #0066ff;
    --ratio:64px;
    width: var(--ratio);
    height: var(--ratio);
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }
  
  .perks-icon svg {
    width: 100%;
    height: 100%;
    /* fill: currentColor; */
  }

  .perks-card-text {
    color: #ffffff;
    font-size: clamp(16px, 1.2vw, 18px);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.3;
    margin: 0;
    font-family: "Blue Tees Headline italic";
    text-align: center;
  }

  /* Slider Tracker Alignment */
  .horizon-slider_container .horizon-tracker {
    margin-top: 2rem;
  }

    /* Prevent hover transforms when inside slider */
  @media screen and (min-width: 992px) {
    .perks-card:hover {
      transform: translateY(-5px);
    }
    .perks-header,
    .perks-card-text{text-align: left;}
    .perks-heading{max-width: clamp(300px,44vw,850px);}
    .perks-description{    max-width: clamp(300px,37vw,710px);}
  }

{%- endstyle -%}


<div class="perks-section section-{{ section.id }}-padding">
  <div class="new-page-width">
    <div class="perks-header">
      {%- if section.settings.title != blank -%}
        <h2 class="perks-heading">{{ section.settings.title }}</h2>
      {%- endif -%}
      
      {%- if section.settings.description != blank -%}
        <div class="perks-description-wrapper">
          <div class="perks-description">{{ section.settings.description }}</div>
          {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
            <div class="perks-button-wrapper">
              <a href="{{ section.settings.button_link }}" class="content-cta content-cta__solid">
                {{ section.settings.button_label | escape }}
              </a>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="perks-grid-wrapper">
    {%- if section.settings.bg_image != blank -%}
      {{ section.settings.bg_image | image_url: width: 2000 | image_tag: class: 'perks-bg-image', loading: 'lazy' }}
    {%- endif -%}
    
    <div class="new-page-width">
      <div id="perks-container-{{ section.id }}" class="perks_slider">
        <div id="perks-track-{{ section.id }}" class="perks-grid">
          {%- for block in section.blocks -%}
            <div class="perks-card" {{ block.shopify_attributes }}>
              <div class="perks-icon">
                 {%- if block.settings.custom_svg != blank -%}
                   {{ block.settings.custom_svg }}
                 {%- else -%}
                   <div style="width:24px;height:24px;background:currentColor;border-radius:4px;"></div>
                 {%- endif -%}
              </div>
              <div class="perks-card-text">
                {{ block.settings.title }}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    let lastWidth = window.innerWidth;
    
    function initMobileSlider() {
      if (window.innerWidth <= 991) {
        const container = document.getElementById('perks-container-{{ section.id }}');
        const track = document.getElementById('perks-track-{{ section.id }}');
        
        if (container && track && !container.dataset.sliderInit) {
          container.classList.add('horizon-slider_container');
          track.classList.remove('perks-grid');
          track.classList.add('horizon-slider_track');
          
          const cards = track.querySelectorAll('.perks-card');
          cards.forEach(card => card.classList.add('horizon-slide'));

          if (typeof horizonSlider !== 'undefined') {
            horizonSlider({
              [`#perks-container-{{ section.id }}`]: {
                loop: false,
                margin: 16,
                nav: true,
                dots:false,
                showTracker: false,
                drag: true,
                responsive: {
                  0: { items: 1 },
                  
                }
              }
            });
            container.dataset.sliderInit = 'true';
          }
        }
      }
    }

    // Initialize on load if mobile
    initMobileSlider();

    // Workaround for moving between responsive desktop/mobile states without destroy method
    window.addEventListener('resize', () => {
      const currentWidth = window.innerWidth;
      const wasMobile = lastWidth <= 991;
      const isMobile = currentWidth <= 991;
      
      if (wasMobile !== isMobile) {
        window.location.reload();
      }
      
      lastWidth = currentWidth;
    });
  });
</script>

{% schema %}
{
  "name": "Benefits Grid/Slider",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "html",
      "id": "title",
      "default": "LIFE'S BETTER WHEN YOU WORK IN GOLF.",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "default": "<p>We want you to do the best work of your career here - and feel supported while doing it. Our benefits reflect that commitment.</p><p>And of course... You get to work in golf - which never stops being awesome.</p>",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "info": "Leave blank to hide the button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image for Grid Area"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Card",
      "settings": [
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG Icon",
          "info": "Paste raw SVG code here"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Benefit Title",
          "label": "Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits Grid/Slider",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
