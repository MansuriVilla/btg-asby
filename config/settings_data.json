          },
          "38b438f9-ed46-4381-9e9e-c4b3eb2ea3f5": {
            "type": "Slide",
            "settings": {
              "title": "DESIGNED FOR",
              "sub_title": "ANY WEATHER",
              "text": "<p>Rule number 76: No excuses, play like a champion. Built to withstand rain and dew, so you can play in all weather conditions.</p>",
              "gall_image": "shopify://shop_images/Series2_Series2Pro-SidebySide-Water-3_0e23a0bd-8726-45f4-8c6e-c30d2116bb42.png"
            }
