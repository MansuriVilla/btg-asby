      "faq-ncaa-s2-pro": {
        "type": "faq-ncaa-s2-pro",
        "blocks": {
          "095cdb6c-3614-40bd-91e7-4d189ef6449a": {
            "type": "rich-text",
            "settings": {
              "title": "READY TO ORDER,",
              "text": "<p><em><strong>BUT HAVE QUESTIONS?</strong></em></p>",
              "align_text": "center"
            }
          },
          "fed2f7f0-e365-415f-9a9d-b83f6d427bae": {
            "type": "question",
            "settings": {
              "title": "Can I use Series 3 in Tournaments?",
              "text": "<p>Yes, the Series 3 comes equipped with the Active Slope Switch where you can toggle slope on or off to conform with USGA standards in tournaments.</p>"
            }
          },
          "00da3f3f-ec8a-48f6-9928-d3bb159bbf66": {
            "type": "question",
            "settings": {
              "title": "How many batteries come with Series 3 Max?",
              "text": "<p>The Series 3 only requires one CR-2 3V battery to operate but you will receive three batteries in the box. Chuck the two extra batteries in your bag so you never run out of juice on the course.</p>"
            }
          },
          "c9223f2d-7bee-41ca-ba73-ad310e813802": {
            "type": "question",
            "settings": {
              "title": "What comes in the box?",
              "text": "<p>In the box you will receive a Series 3 Max Rangefinder, premium leather carrying case, leather lanyard, premium mountaineering buckle, three (3) CR2-3V batteries, user manual, warranty card and a Blue Tees Golf sticker.</p>"
            }
          },
          "3e12364e-1afa-4856-90f1-9e5d29132a52": {
            "type": "question",
            "settings": {
              "title": "How many modes are on the Series 3?",
              "text": "<p>The Series comes equipped with two modes. Scan Mode & Golf Mode. The scan mode gives you the ability to hold the power button down and move your rangefinder around the course, the readings will automatically change as you scan the course. The golf mode will show you the beeline distance, adjusted slope distance, the angle value and will lock on the flag with a pulse vibration notification to show you your final distance.</p>"
            }
          }
        },
        "block_order": [
          "095cdb6c-3614-40bd-91e7-4d189ef6449a",
