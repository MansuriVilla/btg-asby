        "blocks": {
          "0513fa27-ed8f-4e28-99a9-cb3232d53894": {
            "type": "Slide",
            "settings": {
              "title": "ACCURACY FROM",
              "sub_title": "ANY DISTANCE",
              "text": "<p>Tour-level distance with pinpoint accuracy for an added edge to your game. Measure targets up to 800 yards away with an accuracy of +/- 1 yard.</p>",
              "gall_image": "shopify://shop_images/Repeat_Grid_1_c003d2ed-bb59-42c8-86b6-ac1488a8ea5b.png"
