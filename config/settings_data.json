      "faq-series-2": {
        "type": "faq-series-2",
        "blocks": {
          "622d4a3d-df7b-41f7-a5b6-ba2ae300d2a4": {
            "type": "rich-text",
            "settings": {
              "title": "READY TO ORDER,",
              "text": "<p><em><strong>BUT HAVE QUESTIONS?</strong></em></p>",
              "align_text": "center"
            }
          },
          "002a5cdf-4d90-49b3-b9c5-6e819f77fcdf": {
            "type": "question",
            "settings": {
              "title": "Can I use the the Series 2 in tournaments?",
              "text": "<p>(NON-SLOPE):No slope technology makes the Series 2 a USGA conforming Golf Laser Rangefinder for legal tournament play</p>"
            }
          },
          "e429a565-4a14-400a-9b40-9ad571655a4d": {
            "type": "question",
            "settings": {
              "title": "Does the Series 2 have a slope feature?",
              "text": "<p>The Series 2 does not come with the Slope function.</p>"
            }
          },
          "a83b9b44-7c81-4b11-a6dc-7ef09365a3bc": {
            "type": "question",
            "settings": {
              "title": "What’s included in the manufacturers warranty?",
              "text": "<p>The 2-year manufacturer warranty is available to all customers regardless of where the rangefinder was purchased. If you encounter a problem with your new rangefinder, please email our customer support team at <a href=\"mailto:support@blueteesgolf.com\">support@blueteesgolf.com</a>.</p><p><br/></p><p>We will do our best to troubleshoot any issues you’re having with your new rangefinder. If we can’t resolve the issue, we will send you a new rangefinder.</p>"
            }
          },
          "390a854f-8f31-4ab7-b1c0-ffb156972610": {
            "type": "question",
            "settings": {
              "title": "How many batteries come with Series 2?",
              "text": "<p>The Series 2 only requires one CR-2 3V battery to operate but you will receive three batteries in the box. Chuck the two extra batteries in your bag so you never run out of juice on the course.</p>"
            }
          }
        },
        "block_order": [
          "622d4a3d-df7b-41f7-a5b6-ba2ae300d2a4",
