            "settings": {
              "title": "HD OPTICAL",
              "sub_title": "DISPLAY",
              "text": "<p>Feel the course in your hands, equipped with adjustable EZ Optic Focus for an immersive HD viewing experience.</p>",
              "gall_image": "shopify://shop_images/Repeat_Grid_1_a29be76d-019c-4736-991e-20ebfbeb35be.png"
            }
          },
          "d378606f-fa87-44a5-8e54-255c477c7440": {
            "type": "Slide",
            "settings": {
              "title": "FLAG LOCK",
              "sub_title": "PULSE VIBRATION",
              "text": "<p>With absolute certainty, Series 2 emits short vibrating pulses to confirm it has locked onto your target, not what’s behind it.</p>",
              "gall_image": "shopify://shop_images/pulse_67a86d5d-4520-44e2-acf2-e4e5f0a03875.png"
