      "text-and-image": {
        "type": "text-and-image",
        "settings": {
          "image": "shopify://shop_images/TradeUp-Render-Desktop_1024x1024_81fa2a93-726c-4a3e-a680-e531fa939ccb.png",
          "image_width": 680,
          "text_top_img": "shopify://shop_images/TradeUp-logo-Desktop_2x_1024x1024_cddd6e2c-3c2d-40ec-b073-ef031b9f5ef8.png",
          "subtitle": "",
          "title": "",
          "text": "<p>All Blue Tees Customers are eligible to trade-in their Series 1, Series 2, or Series 2 Pro and receive up to 30% off your all-new Series3 Max*</p>",
          "button_label": "Learn More",
          "button_link": "shopify://pages/tradeup",
          "button_style": "primary",
