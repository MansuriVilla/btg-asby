{% comment %}
  Component: comp-table-icons
  Usage: {% render 'comp-table-icons', icon: 'check' %} or icon: 'cross' or icon: 'chevron'
{% endcomment %}

{% liquid
  assign icon_name = icon | default: 'check'
  assign icon_size = size | default: 18
%}

{% case icon_name %}
  {% when 'check' %}
    <span class="comp-table-icon comp-table-icon--check" style="--comp-t-icon-size: {{ icon_size }}px;" aria-label="Yes">
      <svg width="100%" height="100%" viewBox="0 0 20 20" fill="none">
        <circle cx="10" cy="10" r="10" fill="#22c55e"/>
        <path d="M6 10.2L8.7 13L14 7.5" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>

  {% when 'cross' %}
    <span class="comp-table-icon comp-table-icon--cross" style="--comp-t-icon-size: {{ icon_size }}px;" aria-label="No">
      <svg width="100%" height="100%" viewBox="0 0 20 20" fill="none">
        <circle cx="10" cy="10" r="10" fill="#334155"/>
        <path d="M7 10H13" stroke="#ffffff" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </span>

  {% when 'chevron' %}
    <span class="comp-table-icon comp-table-icon--chevron" style="--comp-t-icon-size: {{ icon_size }}px;" aria-hidden="true">
      <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </span>
{% endcase %}

<style>
  .comp-table-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--comp-t-icon-size, clamp(1rem, 0.9rem + 0.3vw, 1.25rem));
    height: var(--comp-t-icon-size, clamp(1rem, 0.9rem + 0.3vw, 1.25rem));
    flex-shrink: 0;
    vertical-align: middle;
  }

  .comp-table-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .comp-table-icon--chevron {
    color: #475569;
    transition: transform 0.25s ease;
  }

  .is-collapsed .comp-table-icon--chevron {
    transform: rotate(-90deg);
  }
</style>
