</svg>

        {{ block.settings.badge_1 }}
      </li>
    {% endif %}
    {% if block.settings.badge_2 != blank %}
      <li>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M14.625 2.25H12.9375V1.6875C12.9375 1.53832 12.8782 1.39524 12.7727 1.28975C12.6673 1.18426 12.5242 1.125 12.375 1.125C12.2258 1.125 12.0827 1.18426 11.9773 1.28975C11.8718 1.39524 11.8125 1.53832 11.8125 1.6875V2.25H6.1875V1.6875C6.1875 1.53832 6.12824 1.39524 6.02275 1.28975C5.91726 1.18426 5.77418 1.125 5.625 1.125C5.47582 1.125 5.33274 1.18426 5.22725 1.28975C5.12176 1.39524 5.0625 1.53832 5.0625 1.6875V2.25H3.375C3.07663 2.25 2.79048 2.36853 2.5795 2.5795C2.36853 2.79048 2.25 3.07663 2.25 3.375V14.625C2.25 14.9234 2.36853 15.2095 2.5795 15.4205C2.79048 15.6315 3.07663 15.75 3.375 15.75H14.625C14.9234 15.75 15.2095 15.6315 15.4205 15.4205C15.6315 15.2095 15.75 14.9234 15.75 14.625V3.375C15.75 3.07663 15.6315 2.79048 15.4205 2.5795C15.2095 2.36853 14.9234 2.25 14.625 2.25ZM11.9292 9.39797L8.55422 12.773C8.50198 12.8253 8.43994 12.8668 8.37165 12.8951C8.30337 12.9234 8.23017 12.9379 8.15625 12.9379C8.08233 12.9379 8.00913 12.9234 7.94085 12.8951C7.87256 12.8668 7.81052 12.8253 7.75828 12.773L6.07078 11.0855C5.96523 10.9799 5.90594 10.8368 5.90594 10.6875C5.90594 10.5382 5.96523 10.3951 6.07078 10.2895C6.17633 10.184 6.31948 10.1247 6.46875 10.1247C6.61802 10.1247 6.76117 10.184 6.86672 10.2895L8.15625 11.5798L11.1333 8.60203C11.1855 8.54977 11.2476 8.50831 11.3159 8.48003C11.3842 8.45174 11.4573 8.43719 11.5312 8.43719C11.6052 8.43719 11.6783 8.45174 11.7466 8.48003C11.8149 8.50831 11.877 8.54977 11.9292 8.60203C11.9815 8.65429 12.0229 8.71634 12.0512 8.78462C12.0795 8.8529 12.0941 8.92609 12.0941 9C12.0941 9.07391 12.0795 9.1471 12.0512 9.21538C12.0229 9.28366 11.9815 9.34571 11.9292 9.39797ZM3.375 5.625V3.375H5.0625V3.9375C5.0625 4.08668 5.12176 4.22976 5.22725 4.33525C5.33274 4.44074 5.47582 4.5 5.625 4.5C5.77418 4.5 5.91726 4.44074 6.02275 4.33525C6.12824 4.22976 6.1875 4.08668 6.1875 3.9375V3.375H11.8125V3.9375C11.8125 4.08668 11.8718 4.22976 11.9773 4.33525C12.0827 4.44074 12.2258 4.5 12.375 4.5C12.5242 4.5 12.6673 4.44074 12.7727 4.33525C12.8782 4.22976 12.9375 4.08668 12.9375 3.9375V3.375H14.625V5.625H3.375Z" fill="#7A8291"/>
</svg>

        {{ block.settings.badge_2 }}
      </li>
    {% endif %}
  </ul>
</div>

<style>
  .comp-pdp-cta {
    position: sticky;
    bottom: 0;
    z-index: 2;
    margin-top: 0;
    padding: clamp(16px, 1.6vw, 24px) clamp(20px, 2.2vw, 32px) clamp(16px, 1.6vw, 24px);
    background: #FFFFFF;
    border-top: 1px solid #D9D9D9;
    box-shadow: none;
    border-radius: 0 0 clamp(8px, 0.7vw, 10px) clamp(8px, 0.7vw, 10px);
    margin-bottom: calc(-1 * clamp(24px, 3vw, 40px));
  }
  .comp-pdp-cta .product-single__form,
  .comp-pdp-cta .product-single__form .product-single__form-inner {
    margin: 0;
    width: 100%;
  }
  .comp-pdp-cta .btn.btn--full.add-to-cart,
  .comp-pdp-cta button[type="submit"].btn,
  .comp-pdp-cta button.add-to-cart,
  .comp-pdp-cta a.btn.add-to-cart {
    width: 100%;
    height: clamp(46px, 3.8vw, 52px) !important;
    background: #0149E3;
    border-radius: 100px;
    border: none;
    font-family: 'Blue Tees Subhead', sans-serif;
    font-size: clamp(13px, 1vw, 14px);
    line-height: 1;
    letter-spacing: 0.1em;
    color: #FFFFFF;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: none;
    cursor: pointer;
    transition: opacity 0.2s ease, background 0.2s ease;
    margin: 0;
    text-decoration: none;
  }
  .comp-pdp-cta .btn.btn--full.add-to-cart span,
  .comp-pdp-cta button[type="submit"].btn span,
  .comp-pdp-cta a.btn.add-to-cart span {
    color: #FFFFFF;
    transition: opacity 0.2s ease;
  }
  .comp-pdp-cta .btn.btn--loading,
  .comp-pdp-cta button[type="submit"].btn.btn--loading,
  .comp-pdp-cta a.btn.add-to-cart.btn--loading {
    position: relative !important;
    color: transparent !important;
    pointer-events: none !important;
  }
  .comp-pdp-cta .btn.btn--loading span,
  .comp-pdp-cta button[type="submit"].btn.btn--loading span,
  .comp-pdp-cta a.btn.add-to-cart.btn--loading span {
    opacity: 0 !important;
    visibility: hidden !important;
  }
  .comp-pdp-cta .btn.btn--loading::before,
  .comp-pdp-cta button[type="submit"].btn.btn--loading::before,
  .comp-pdp-cta a.btn.add-to-cart.btn--loading::before {
    content: "" !important;
    display: block !important;
    position: absolute !important;
    left: 50% !important;
    top: 50% !important;
    width: 20px !important;
    height: 20px !important;
    margin-left: -10px !important;
    margin-top: -10px !important;
    border: 2px solid rgba(255, 255, 255, 0.3) !important;
    border-top-color: #FFFFFF !important;
    border-radius: 50% !important;
    animation: spin 0.8s linear infinite !important;
    box-sizing: border-box !important;
  }
  .comp-pdp-cta .btn.btn--full.add-to-cart:hover,
  .comp-pdp-cta button[type="submit"].btn:hover,
  .comp-pdp-cta a.btn.add-to-cart:hover {
    background: #013ec4;
    opacity: 0.95;
  }
  .comp-pdp-cta .btn.btn--full.add-to-cart:disabled,
  .comp-pdp-cta .btn.btn--full.add-to-cart.button_sold-out,
  .comp-pdp-cta .btn.btn--full.add-to-cart.disabled,
  .comp-pdp-cta button[type="submit"].btn:disabled,
  .comp-pdp-cta button.add-to-cart:disabled,
  .comp-pdp-cta .btn.button_sold-out {
    background: transparent;
    border: 2px solid var(--new-gray, #8C929C) !important;
    color: var(--new-gray, #8C929C);
    cursor: default;
    pointer-events: none;
    opacity: 1;
    box-shadow: none;
  }
  .comp-pdp-cta .btn.btn--full.add-to-cart:disabled span,
  .comp-pdp-cta .btn.btn--full.add-to-cart.button_sold-out span,
  .comp-pdp-cta .btn.btn--full.add-to-cart.disabled span,
  .comp-pdp-cta button[type="submit"].btn:disabled span,
  .comp-pdp-cta button.add-to-cart:disabled span,
  .comp-pdp-cta .btn.button_sold-out span {
    color: var(--new-gray, #8C929C);
  }
  .comp-pdp-cta__badges {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(14px, 1.8vw, 24px);
    margin: clamp(12px, 1.2vw, 16px) 0 0;
    padding: 0;
    list-style: none;
    width: 100%;
  }
  .comp-pdp-cta__badges li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Blue Tees Subhead', sans-serif;
    font-size: clamp(10px, 0.8vw, 12px);
    line-height: 1.5;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #7A8291;
    margin: 0;
  }
  /* .comp-pdp-cta__badges svg,
  .comp-pdp-cta__badges svg * {
    color: #7A8291;
    stroke: #7A8291;
    flex-shrink: 0;
  } */
  .comp-pdp-cta__badges svg {
    width: 16px;
    height: 16px;
  }

  /* Product Switcher */
  .comp-pdp-product-switcher {
    margin-bottom: 14px;
    width: 100%;
  }
  .comp-pdp-switcher__heading {
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 8px;
    color: #1b1e22;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .comp-pdp-switcher__options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 8px;
  }
  .comp-pdp-switcher__item {
    position: relative;
    cursor: pointer;
    margin: 0;
    display: block;
  }
  .comp-pdp-switcher__item input[type="radio"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }
  .comp-pdp-switcher__card {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border: 1.5px solid #E0E0E0;
    border-radius: 8px;
    background: #FAFAFA;
    transition: all 0.2s ease;
    height: 100%;
    box-sizing: border-box;
  }
  .comp-pdp-switcher__item:hover .comp-pdp-switcher__card {
    border-color: #8C929C;
  }
  .comp-pdp-switcher__item.is-selected .comp-pdp-switcher__card,
  .comp-pdp-switcher__item input[type="radio"]:checked + .comp-pdp-switcher__card {
    border-color: #0149E3;
    background: #F0F5FF;
    box-shadow: 0 0 0 1px #0149E3;
  }
  .comp-pdp-switcher__thumb {
    width: 36px;
    height: 36px;
    object-fit: contain;
    flex-shrink: 0;
    border-radius: 4px;
    background: #FFFFFF;
  }
  .comp-pdp-switcher__details {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
  }
  .comp-pdp-switcher__title {
    font-family: 'Blue Tees Subhead', sans-serif;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.2;
    color: #1B1E22;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .comp-pdp-switcher__price {
    font-family: 'Blue Tees Paragraph', sans-serif;
    font-size: 11px;
    color: #666666;
    margin-top: 2px;
  }

  @media (max-width: 991px) {
    .comp-pdp-panel .comp-pdp-cta {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      width: 100%;
      z-index: 6;
      margin: 0;
      border-radius: 0;
      border-top: 1px solid #D9D9D9;
      box-shadow: 0 -4px 18px rgba(0, 0, 0, 0.12);
      padding: 12px 16px max(12px, env(safe-area-inset-bottom));
      background: #FFFFFF;
      box-sizing: border-box;
    }
    .comp-pdp-panel .comp-pdp-cta .comp-pdp-cta__badges {
      margin-top: 8px;
      gap: 12px;
    }
    .comp-pdp-cta__badges li{ letter-spacing: 0;}
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var ctaWrap = document.querySelector('.comp-pdp-cta');
    var switcherItems = document.querySelectorAll('.comp-pdp-switcher__item');

    // Hidden bundle mode: keep Add to Cart in sync with the availability of the hidden products
    var hiddenBundle = document.querySelector('.comp-pdp-hidden-bundle');
    if (hiddenBundle) {
      var applyBundleState = function () {
        var atcBtn = document.querySelector('.comp-pdp-cta .btn[data-add-to-cart]');
        var atcText = atcBtn ? atcBtn.querySelector('[data-add-to-cart-text]') : null;
        if (!atcBtn) return;
        if (hiddenBundle.getAttribute('data-available') === 'true') {
          atcBtn.removeAttribute('disabled');
          atcBtn.classList.remove('button_sold-out');
          if (atcText) atcText.textContent = hiddenBundle.getAttribute('data-button-text') || 'ADD TO CART';
        } else {
          atcBtn.setAttribute('disabled', 'disabled');
          atcBtn.classList.add('button_sold-out');
          if (atcText) atcText.textContent = 'SOLD OUT';
        }
      };
      applyBundleState();
      window.addEventListener('load', applyBundleState);
      setTimeout(applyBundleState, 600);
      return;
    }

    if (!switcherItems.length) return;

    if (ctaWrap) {
      ctaWrap.classList.add('has-custom-product-enabled');
    }

    function syncAtcState(selectedRadio) {
      if (!selectedRadio) return;
      var atcBtn = document.querySelector('.comp-pdp-cta .btn[data-add-to-cart]');
      var atcText = atcBtn ? atcBtn.querySelector('[data-add-to-cart-text]') : null;
      var isAvail = selectedRadio.getAttribute('data-available') === 'true';

      if (atcBtn) {
        if (isAvail) {
          atcBtn.removeAttribute('disabled');
          atcBtn.classList.remove('button_sold-out');
          if (atcText) atcText.textContent = 'ADD TO CART';
        } else {
          atcBtn.setAttribute('disabled', 'disabled');
          atcBtn.classList.add('button_sold-out');
          if (atcText) atcText.textContent = 'SOLD OUT';
        }
      }
    }

    switcherItems.forEach(function (item) {
      var radio = item.querySelector('input[type="radio"]');
      if (!radio) return;

      radio.addEventListener('change', function () {
        switcherItems.forEach(function (el) {
          el.classList.remove('is-selected');
        });
        if (radio.checked) {
          item.classList.add('is-selected');
          syncAtcState(radio);
        }
      });
    });

    // Initial sync
    var initialRadio = document.querySelector('.comp-pdp-switcher__item.is-selected input[type="radio"]') || document.querySelector('.comp-pdp-switcher__item input[type="radio"]:checked');
    if (initialRadio) {
      syncAtcState(initialRadio);
    }
  });
</script>
