{% comment %}
  Component: comp-pdp-sticky-cta
  Add to cart (theme product-form) + trust badges, sticky to the bottom on mobile.
  Usage:
  {% render 'comp-pdp-sticky-cta', product: product, current_variant: current_variant, form_id: form_id, block: block %}
  Block settings: show_dynamic_checkout, pre_order, cta_note_text, badge_1, badge_2
{% endcomment %}

<div class="comp-pdp-cta" {{ block.shopify_attributes }}>
  {%- if block.settings.enable_product_selection -%}
    {%- liquid
      assign switch_p1 = block.settings.switch_product_1
      assign switch_p2 = block.settings.switch_product_2
      assign switch_p3 = block.settings.switch_product_3
      assign switch_p4 = block.settings.switch_product_4
    -%}
    {%- if block.settings.hide_product_switcher -%}
      {%- comment -%}
        Hidden bundle mode: nothing is shown to the customer. The variants below are
        added to the cart (instead of the main product) when Add to Cart is clicked.
      {%- endcomment -%}
      {%- assign bundle_ids = '' -%}
      {%- assign bundle_available = 'false' -%}
      {%- assign bundle_total = 0 -%}
      {%- assign bundle_compare_total = 0 -%}
      {%- assign bundle_keys = 'switch_product_1,switch_product_2,switch_product_3,switch_product_4' | split: ',' -%}
      {%- for key in bundle_keys -%}
        {%- assign bprod = block.settings[key] -%}
        {%- if bprod.title == blank and bprod != blank -%}
          {%- assign bprod = all_products[bprod] -%}
        {%- endif -%}
        {%- if bprod != blank -%}
          {%- assign bvar = bprod.selected_or_first_available_variant | default: bprod.variants.first -%}
          {%- if bvar != blank -%}
            {%- assign bundle_ids = bundle_ids | append: bvar.id | append: ',' -%}
            {%- assign bundle_total = bundle_total | plus: bvar.price -%}
            {%- if bvar.compare_at_price > bvar.price -%}
              {%- assign bundle_compare_total = bundle_compare_total | plus: bvar.compare_at_price -%}
            {%- else -%}
              {%- assign bundle_compare_total = bundle_compare_total | plus: bvar.price -%}
            {%- endif -%}
            {%- if bvar.available or bprod.available -%}
              {%- assign bundle_available = 'true' -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if bundle_ids != blank -%}
        <div
          class="comp-pdp-hidden-bundle"
          data-variant-ids="{{ bundle_ids }}"
          data-available="{{ bundle_available }}"
          data-button-text="{{ block.settings.hidden_bundle_button_text | escape }}"
          data-total-price="{{ bundle_total | money | strip_html | escape }}"
          data-total-compare="{% if bundle_compare_total > bundle_total %}{{ bundle_compare_total | money | strip_html | escape }}{% endif %}"
          hidden
          aria-hidden="true"
        ></div>
      {%- endif -%}
    {%- elsif switch_p1 != blank or switch_p2 != blank or switch_p3 != blank or switch_p4 != blank -%}
      <div class="comp-pdp-product-switcher">
        {%- if block.settings.product_selection_heading != blank -%}
          <div class="comp-pdp-switcher__heading custom_subHeading-text">
            {{ block.settings.product_selection_heading }}
          </div>
        {%- endif -%}
        <div class="comp-pdp-switcher__options">
          {%- comment -%} Option for Current Product {%- endcomment -%}
          {%- assign main_v = current_variant | default: product.selected_or_first_available_variant -%}
          <label class="comp-pdp-switcher__item is-selected">
            <input
              type="radio"
              name="comp-pdp-switch-product"
              value="{{ main_v.id }}"
              checked="checked"
              data-available="{{ main_v.available }}"
              data-price="{{ main_v.price | money_without_trailing_zeros }}"
              data-title="{{ product.title | escape }}"
            >
            <span class="comp-pdp-switcher__card">
              {%- if product.featured_image != blank -%}
                <img
                  src="{{ product.featured_image | image_url: width: 80 }}"
                  alt="{{ product.title | escape }}"
                  loading="lazy"
                  width="40"
                  height="40"
                  class="comp-pdp-switcher__thumb"
                >
              {%- endif -%}
              <span class="comp-pdp-switcher__details">
                <span class="comp-pdp-switcher__title">{{ product.title }}</span>
                <span class="comp-pdp-switcher__price">{{ main_v.price | money_without_trailing_zeros }}</span>
              </span>
            </span>
          </label>

          {%- assign extra_picks = 'switch_product_1,switch_product_2,switch_product_3,switch_product_4' | split: ',' -%}
          {%- for key in extra_picks -%}
            {%- assign prod = block.settings[key] -%}
            {%- if prod.title == blank and prod != blank -%}
              {%- assign prod = all_products[prod] -%}
            {%- endif -%}
            {%- if prod != blank and prod.id != product.id -%}
              {%- assign v = prod.selected_or_first_available_variant | default: prod.variants.first -%}
              {%- assign v_avail = v.available -%}
              {%- if v_avail == nil or v_avail == false -%}
                {%- if prod.available -%}
                  {%- assign v_avail = true -%}
                {%- endif -%}
              {%- endif -%}
              <label class="comp-pdp-switcher__item">
                <input
                  type="radio"
                  name="comp-pdp-switch-product"
                  value="{{ v.id }}"
                  data-available="{{ v_avail }}"
                  data-price="{{ v.price | money_without_trailing_zeros }}"
                  data-title="{{ prod.title | escape }}"
                >
                <span class="comp-pdp-switcher__card">
                  {%- if prod.featured_image != blank -%}
                    <img
                      src="{{ prod.featured_image | image_url: width: 80 }}"
                      alt="{{ prod.title | escape }}"
                      loading="lazy"
                      width="40"
                      height="40"
                      class="comp-pdp-switcher__thumb"
                    >
                  {%- endif -%}
                  <span class="comp-pdp-switcher__details">
                    <span class="comp-pdp-switcher__title">{{ prod.title }}</span>
                    <span class="comp-pdp-switcher__price">{{ v.price | money_without_trailing_zeros }}</span>
                  </span>
                </span>
              </label>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}

  {%- unless product.empty? -%}
    {%- render 'comp-product-form',
      form_id: form_id,
      product: product,
      show_dynamic_checkout: block.settings.show_dynamic_checkout,
      current_variant: current_variant,
      pre_order: block.settings.pre_order,
      cta_note_text: block.settings.cta_note_text
    -%}
  {%- endunless -%}

  <ul class="comp-pdp-cta__badges">
    {% if block.settings.badge_1 != blank %}
      <li>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
<g clip-path="url(#clip0_8771_2461)">
<path d="M17.9599 8.22656L16.9755 5.76562C16.892 5.5573 16.7478 5.37888 16.5616 5.2535C16.3754 5.12813 16.1559 5.06159 15.9314 5.0625H13.5V4.5C13.5 4.35082 13.4407 4.20774 13.3352 4.10225C13.2298 3.99676 13.0867 3.9375 12.9375 3.9375H2.25C1.95163 3.9375 1.66548 4.05603 1.4545 4.267C1.24353 4.47798 1.125 4.76413 1.125 5.0625V12.9375C1.125 13.2359 1.24353 13.522 1.4545 13.733C1.66548 13.944 1.95163 14.0625 2.25 14.0625H3.44531C3.56923 14.5465 3.85071 14.9755 4.24536 15.2818C4.64002 15.5881 5.1254 15.7544 5.625 15.7544C6.1246 15.7544 6.60998 15.5881 7.00464 15.2818C7.39929 14.9755 7.68077 14.5465 7.80469 14.0625H11.3203C11.4442 14.5465 11.7257 14.9755 12.1204 15.2818C12.515 15.5881 13.0004 15.7544 13.5 15.7544C13.9996 15.7544 14.485 15.5881 14.8796 15.2818C15.2743 14.9755 15.5558 14.5465 15.6797 14.0625H16.875C17.1734 14.0625 17.4595 13.944 17.6705 13.733C17.8815 13.522 18 13.2359 18 12.9375V8.4375C18.0001 8.36529 17.9865 8.29371 17.9599 8.22656ZM5.625 14.625C5.4025 14.625 5.18499 14.559 4.99998 14.4354C4.81498 14.3118 4.67078 14.1361 4.58564 13.9305C4.50049 13.725 4.47821 13.4988 4.52162 13.2805C4.56502 13.0623 4.67217 12.8618 4.8295 12.7045C4.98684 12.5472 5.18729 12.44 5.40552 12.3966C5.62375 12.3532 5.84995 12.3755 6.05552 12.4606C6.26109 12.5458 6.43679 12.69 6.5604 12.875C6.68402 13.06 6.75 13.2775 6.75 13.5C6.75 13.7984 6.63147 14.0845 6.4205 14.2955C6.20952 14.5065 5.92337 14.625 5.625 14.625ZM2.25 9.5625V5.0625H12.375V9.5625H2.25ZM13.5 14.625C13.2775 14.625 13.06 14.559 12.875 14.4354C12.69 14.3118 12.5458 14.1361 12.4606 13.9305C12.3755 13.725 12.3532 13.4988 12.3966 13.2805C12.44 13.0623 12.5472 12.8618 12.7045 12.7045C12.8618 12.5472 13.0623 12.44 13.2805 12.3966C13.4988 12.3532 13.725 12.3755 13.9305 12.4606C14.1361 12.5458 14.3118 12.69 14.4354 12.875C14.559 13.06 14.625 13.2775 14.625 13.5C14.625 13.7984 14.5065 14.0845 14.2955 14.2955C14.0845 14.5065 13.7984 14.625 13.5 14.625ZM13.5 7.875V6.1875H15.9314L16.6064 7.875H13.5Z" fill="#7A8291"/>
