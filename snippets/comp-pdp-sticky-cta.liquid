{% comment %}
  Component: comp-pdp-sticky-cta
  Add to cart (theme product-form) + trust badges, sticky to the bottom on mobile.
  Usage:
  {% render 'comp-pdp-sticky-cta', product: product, current_variant: current_variant, form_id: form_id, block: block %}
  Block settings: show_dynamic_checkout, pre_order, cta_note_text, badge_1, badge_2
{% endcomment %}

<div class="comp-pdp-cta" {{ block.shopify_attributes }}>
  {%- unless product.empty? -%}
    {%- render 'product-form',
      form_id: form_id,
      product: product,
      show_dynamic_checkout: block.settings.show_dynamic_checkout,
      current_variant: current_variant,
      pre_order: block.settings.pre_order,
      cta_note_text: block.settings.cta_note_text
    -%}
  {%- endunless -%}

  <ul class="comp-pdp-cta__badges">
    {% if block.settings.badge_1 != blank %}
      <li>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 3h15v13H1zM16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        {{ block.settings.badge_1 }}
      </li>
    {% endif %}
    {% if block.settings.badge_2 != blank %}
      <li>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
        {{ block.settings.badge_2 }}
      </li>
    {% endif %}
  </ul>
</div>

<style>
  .comp-pdp-cta {
    position: sticky;
    bottom: 0;
    z-index: 2;
    margin-top: 0;
    padding: clamp(16px, 1.6vw, 24px) clamp(20px, 2.2vw, 32px) clamp(16px, 1.6vw, 24px);
    background: #FFFFFF;
    border-top: 1px solid #D9D9D9;
    box-shadow: none;
    border-radius: 0 0 clamp(8px, 0.7vw, 10px) clamp(8px, 0.7vw, 10px);
    margin-bottom: calc(-1 * clamp(24px, 3vw, 40px));
  }
  .comp-pdp-cta .product-single__form,
  .comp-pdp-cta .product-single__form .product-single__form-inner {
    margin: 0;
    width: 100%;
  }
  .comp-pdp-cta .btn.btn--full.add-to-cart,
  .comp-pdp-cta button[type="submit"].btn,
  .comp-pdp-cta button.add-to-cart,
  .comp-pdp-cta a.btn.add-to-cart {
    width: 100%;
    height: clamp(46px, 3.8vw, 52px);
    background: #0149E3;
    border-radius: 100px;
    border: none;
    font-family: 'Blue Tees Subhead', sans-serif;
    font-size: clamp(13px, 1vw, 14px);
    line-height: 1;
    letter-spacing: 0.1em;
    color: #FFFFFF;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: none;
    cursor: pointer;
    transition: opacity 0.2s ease, background 0.2s ease;
    margin: 0;
    text-decoration: none;
  }
  .comp-pdp-cta .btn.btn--full.add-to-cart span,
  .comp-pdp-cta button[type="submit"].btn span,
  .comp-pdp-cta a.btn.add-to-cart span {
    color: #FFFFFF;
  }
  .comp-pdp-cta .btn.btn--full.add-to-cart:hover,
  .comp-pdp-cta button[type="submit"].btn:hover,
  .comp-pdp-cta a.btn.add-to-cart:hover {
    background: #013ec4;
    opacity: 0.95;
  }
  .comp-pdp-cta .btn.btn--full.add-to-cart:disabled,
  .comp-pdp-cta .btn.btn--full.add-to-cart.button_sold-out,
  .comp-pdp-cta .btn.btn--full.add-to-cart.disabled,
  .comp-pdp-cta button[type="submit"].btn:disabled,
  .comp-pdp-cta button.add-to-cart:disabled,
  .comp-pdp-cta .btn.button_sold-out {
    background: transparent;
    border: 2px solid var(--new-gray, #8C929C) !important;
    color: var(--new-gray, #8C929C);
    cursor: default;
    pointer-events: none;
    opacity: 1;
    box-shadow: none;
  }
  .comp-pdp-cta .btn.btn--full.add-to-cart:disabled span,
  .comp-pdp-cta .btn.btn--full.add-to-cart.button_sold-out span,
  .comp-pdp-cta .btn.btn--full.add-to-cart.disabled span,
  .comp-pdp-cta button[type="submit"].btn:disabled span,
  .comp-pdp-cta button.add-to-cart:disabled span,
  .comp-pdp-cta .btn.button_sold-out span {
    color: var(--new-gray, #8C929C);
  }
  .comp-pdp-cta__badges {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(14px, 1.8vw, 24px);
    margin: clamp(12px, 1.2vw, 16px) 0 0;
    padding: 0;
    list-style: none;
    width: 100%;
  }
  .comp-pdp-cta__badges li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Blue Tees Subhead', sans-serif;
    font-size: clamp(10px, 0.8vw, 12px);
    line-height: 1.5;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #7A8291;
    margin: 0;
  }
  .comp-pdp-cta__badges svg,
  .comp-pdp-cta__badges svg * {
    color: #7A8291;
    stroke: #7A8291;
    flex-shrink: 0;
  }
  .comp-pdp-cta__badges svg {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 991px) {
    .comp-pdp-panel .comp-pdp-cta {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      width: 100%;
      z-index: 9999;
      margin: 0;
      border-radius: 0;
      border-top: 1px solid #D9D9D9;
      box-shadow: 0 -4px 18px rgba(0, 0, 0, 0.12);
      padding: 12px 16px max(12px, env(safe-area-inset-bottom));
      background: #FFFFFF;
      box-sizing: border-box;
    }
    .comp-pdp-panel .comp-pdp-cta .comp-pdp-cta__badges {
      margin-top: 8px;
      gap: 12px;
    }
  }
</style>
