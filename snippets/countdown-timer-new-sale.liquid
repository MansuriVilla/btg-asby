{{ 'flipclock.css' | asset_url | stylesheet_tag }}

<script>
var clock;
$(document).ready(function() {
    // Initialize FlipClock
    clock = $('.clock').FlipClock({
        clockFace: 'DailyCounter',
        autoStart: false,
        callbacks: {
            stop: function() {
                $('.message').html('$50 GIFT CARD WITH PURCHASE OF $299 OR MORE');
            }
        }
    });

    // Countdown to June 15, 2025, 5:59 PM IST (Unix timestamp: 1752569340)
    var countdown = 1763276340 - (new Date().getTime() / 1000);
    countdown = Math.max(1, countdown); // Ensure countdown doesn't go negative
    clock.setTime(countdown);
    clock.setCountdown(true);
    clock.start();
});
</script>

