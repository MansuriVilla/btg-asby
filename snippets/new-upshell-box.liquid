<script>

  // FOR UPSHELL '40,000+' TEXT + POPUP '40K'


  // Render full number with + (e.g., 42,000+)
  function renderCourseCount(elementId, count) {
    const element = document.getElementById(elementId);
    if (element) {
      element.textContent = count.toLocaleString() + '+';
    } else {
      console.warn('Element not found:', elementId);
    }
  }

  // Render short version (e.g., 42K)
  function renderShortCourseCountByClass(className, count) {
    const shortCount = (count / 1000).toFixed(0) + 'K';
    const elements = document.getElementsByClassName(className);

    for (let i = 0; i < elements.length; i++) {
      elements[i].textContent = shortCount;
    }
  }

  // === NOW SAFE TO RUN ===
  renderCourseCount('course-count', 42000);


  //-------------------
  //  GRABING  NAME AND DURATION 
  //  FROM THE UPSHELL AND SHOWING IT TO FLOATING ADD TO CART SECTION
  //-------------

  document.addEventListener('DOMContentLoaded', () => {

    function nameDuration() {
      const offerContainers = document.querySelectorAll('.free-offer-info');

      const membershipShow = document.querySelector('.membership__show');

      if (membershipShow) {
        const visibleContainer = Array.from(offerContainers).find(container =>
          container.style.display !== 'none'
        );

        if (visibleContainer) {

          const membershipName = visibleContainer.querySelector('.membership__name')?.textContent.trim() || 'No Offer Name';
          const membershipDuration = visibleContainer.querySelector('.membership__duration')?.textContent.trim() || 'No Duration';


          membershipShow.classList.remove('skeleton-loader');
          membershipShow.textContent = `${membershipName} | ${membershipDuration} (Included)`;
        } else {
          membershipShow.classList.remove('skeleton-loader');
          {% comment %} membershipShow.textContent = 'Loading....'; {% endcomment %}
        }
      }
    }
    nameDuration();

  });

  // Accessibility: Handle Enter and Space keypress for close buttons with role="button"
  document.addEventListener('keydown', function(event) {
    if (event.key === 'Enter' || event.key === ' ') {
      const closeBtn = event.target.closest('.close[role="button"]');
      if (closeBtn) {
        event.preventDefault();
        closeBtn.click();
      }
    }
  });
</script>
