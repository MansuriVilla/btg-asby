      function handleCheckboxGroups(groupSelector) {
        const group = $(groupSelector);
        const checkbox = group.find('input[type="checkbox"]');

        checkbox.on('change', function () {
          if ($(this).is(':checked')) {
            group.addClass('active');
          } else {
            group.removeClass('active');
          }
        });
      }

      // Handle both groups independently
      handleCheckboxGroups('.group1');
      handleCheckboxGroups('.group2');
    });
  </script>
