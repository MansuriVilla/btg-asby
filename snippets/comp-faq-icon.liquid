{% comment %}
  Component: comp-faq-icon
  Usage: {% render 'comp-faq-icon', is_open: true, color: '#0f172a' %}
{% endcomment %}

{% liquid
  assign icon_color = color | default: 'currentColor'
  assign open_state = is_open | default: false
%}

<span class="comp-faq-icon {% if open_state %}is-open{% endif %} {{ class }}" style="--comp-icon-color: {{ icon_color }};" aria-hidden="true">
  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M8 16L8 9.53674e-07" stroke-width="2" stroke-linejoin="round" stroke="#101820"/>
<path d="M0 8.00098H16" stroke-width="2" stroke-linejoin="round" stroke="#101820"/>
</svg>

</span>
