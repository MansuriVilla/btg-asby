        </svg>
      </span>

      {%- endif -%}
    {%- endif -%}

    

    {%- liquid
      assign fixed_aspect_ratio = false
      unless settings.product_grid_image_size == 'natural'
        assign fixed_aspect_ratio = true
      endunless

      assign preview_image = product.featured_media.preview_image
      assign img_url = preview_image | img_url: '1x1' | replace: '_1x1.', '_{width}x.'
    -%}

    <a
      href="{{ product.url }}"
      data-shop-now-link
      class="grid-product__link"
      aria-label="View {{ product.title | escape }}"
      {% if settings.open_new_tab %}
        target="_blank" rel="noopener noreferrer"
      {% endif %}
    >
      <div class="grid-product__image-mask grid-product__image-mockup">
        {%- if quick_shop_enable -%}
          <div class="quick-product__btn quick-product__btn--not-ready js-modal-open-quick-modal-{{ product.id }} small--hide">
            <span class="quick-product__label">{{ settings.quick_shop_text }}</span>
          </div>
        {%- endif -%}
        {%- if fixed_aspect_ratio -%}
          <div
            class="grid-product__image grid__image-ratio grid__image-ratio--{{ settings.product_grid_image_size }}"
          >
            <img
              class="lazyload{% unless settings.product_grid_image_fill %} grid__image-contain{% endunless %}"
              data-src="{{ img_url }}"
              data-widths="[360, 540, 720, 900, 1080]"
              data-aspectratio="{{ preview_image.aspect_ratio }}"
              data-sizes="auto"
              alt="{{ preview_image.alt | escape }}"
            >
          </div>
          <div class="variant-loader active"></div>
        {%- else -%}
          <div
            class="image-wrap"
            style="height: 0; padding-bottom: {{ 100 | divided_by: preview_image.aspect_ratio }}%;"
          >
            <img
              class="grid-product__image lazyload"
              data-src="{{ img_url }}"
              data-widths="[360, 540, 720, 900, 1080]"
              data-aspectratio="{{ preview_image.aspect_ratio }}"
              data-sizes="auto"
              alt="{{ preview_image.alt | escape }}"
            >
            <noscript>
              <img
                class="grid-product__image lazyloaded"
                src="{{ preview_image | img_url: '400x' }}"
                alt="{{ preview_image.alt | escape }}"
              >
            </noscript>
            <div class="variant-loader active"></div>
          </div>
        {%- endif -%}

        {%- if settings.product_hover_image and product.media.size > 1 -%}
          {%- for media in product.media offset: 1 limit: 1 -%}
            {%- assign second_image = media.preview_image -%}
          {%- endfor -%}
          <div class="grid-product__secondary-image small--hide grid-product__secondary-image-new">
            {%- assign img_url = second_image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}
            <img
              class="lazyload"
              data-src="{{ img_url }}"
              data-widths="[360, 540, 720, 1000]"
              data-aspectratio="{{ second_image.aspect_ratio }}"
              data-sizes="auto"
              alt="{{ second_image.alt }}"
            >
          </div>
        {%- endif -%}

        {%- if settings.enable_swatches -%}
          {%- assign swatch_trigger = 'products.general.color_swatch_trigger' | t | downcase -%}
          {%- for option in product.options_with_values -%}
            {%- liquid
              assign option_name = option.name | downcase
              assign is_color = false
              if option_name contains swatch_trigger
                assign is_color = true
              elsif swatch_trigger == 'color' and option_name contains 'colour'
                assign is_color = true
              endif
            -%}
            {%- if is_color -%}
              {%- assign option_index = forloop.index0 -%}
              {%- assign values = '' -%}
              {%- for variant in product.variants -%}
                {%- assign value = variant.options[option_index] %}
                {%- unless values contains value -%}
                  {%- liquid
                    assign values = values | join: ',' | append: ',' | append: value | split: ','
                  -%}

                  {%- if variant.image -%}
                    <div
                      class="grid-product__color-image grid-product__color-image--{{ variant.id }} small--hide"
                    ></div>
                  {%- endif -%}
                  
                {%- endunless -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </a>

    <div class="grid-product__meta grid-product__meta-new">
      <div class="grid-product__top">
        <div class="grid-product__top-left">
          {% if product.metafields.custom.collection_title != blank %}
            <div class="grid-product__title grid-product__title--{{ settings.type_product_style }}">
              <h3>{{ product.metafields.custom.collection_title }}</h3>
            </div>
          {% else %}
            <div class="grid-product__title grid-product__title--{{ settings.type_product_style }}">
              <h3>{{ product.title | escape }}</h3>
            </div>
          {% endif %}
        </div>
        <div class="grid-product__top-right">
          <div class="grid-product__price">
            {%- if on_sale -%}
              <span class="visually-hidden">{{ 'products.general.regular_price' | t }}</span>
              <span class="grid-product__price--original">{{ product.compare_at_price | money }}</span>
              <span class="visually-hidden">{{ 'products.general.sale_price' | t }}</span>
            {%- endif -%}
            {%- if product.price_varies -%}
              {%- assign price = product.price_min | money -%}
              {% comment %} {{ 'products.general.from_text_html' | t: price: price }} {% endcomment %}
              {{ price }}
            {%- else -%}
              {{ product.price | money }}
            {%- endif -%}
            {%- if on_sale -%}
              {%- if settings.product_save_amount -%}
                {%- if settings.product_save_type == 'dollar' -%}
                  {%- capture saved_amount -%}{{ product.compare_at_price | minus: product.price | money }}{%- endcapture -%}
                {%- else -%}
                  {%- capture saved_amount -%}{{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}%{%- endcapture -%}
                {%- endif -%}
                <span class="grid-product__price--savings">
                  {{ 'products.general.save_html' | t: saved_amount: saved_amount }}
                </span>
              {%- endif -%}
            {%- endif -%}

            {%- assign product_variant = product.selected_or_first_available_variant -%}
            {%- if product_variant.unit_price_measurement -%}
              <div class="product__unit-price">
                {%- capture unit_price_base_unit -%}
                {%- if product_variant.unit_price_measurement -%}
                  {%- if product_variant.unit_price_measurement.reference_value != 1 -%}
                    {{ product_variant.unit_price_measurement.reference_value }}
                  {%- endif -%}
                  {{ product_variant.unit_price_measurement.reference_unit }}
                {%- endif -%}
              {%- endcapture -%}

                {{ product_variant.unit_price | money }}/{{ unit_price_base_unit }}
              </div>
            {%- endif -%}
          </div>
        </div>  
      </div>
      
      {% if product.metafields.custom.collection_description != blank %}
        <div class="grid-product__description">
          {{ product.metafields.custom.collection_description }}
        </div>
      {% else %}
        <div class="grid-product__description">
          {{ product.description | truncate: 160 }}
        </div>
      {% endif %}

      {%- if settings.vendor_enable -%}
        <div class="grid-product__vendor">{{ product.vendor }}</div>
      {%- endif -%}

      <div class="product-item__cta">
        {%- assign v = product.selected_or_first_available_variant -%}

        {%- assign is_amount_style_product = false -%}

        {%- if product.gift_card? -%}
          {%- assign is_amount_style_product = true -%}
        {%- else -%}
          {%- for option in product.options -%}
            {%- assign opt = option | downcase -%}
            {%- if opt contains 'price'
              or opt contains 'amount'
              or opt contains 'value'
              or opt contains 'denomination'
            -%}
              {%- assign is_amount_style_product = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if is_amount_style_product and product.variants.size > 1 -%}
          <div class="quick-add-variant-dropdown">
            <select id="quick_add_variant_{{ product.id }}" name="id" data-quick-add-select class="variant-select" aria-label="Select variant for {{ product.title | escape }}">
              {%- for variant in product.variants -%}
                <option
                  value="{{ variant.id }}"
                  {% if variant == v %}
                    selected
                  {% endif %}
                  {% unless variant.available %}
                    disabled
                  {% endunless %}
                  data-price="{{ variant.price | money_without_currency }}"
                  data-available="{{ variant.available }}"
                >
                  {% comment %} {{ variant.title }} —  {% endcomment %}
                  {{- variant.price | money }}
                  {%- unless variant.available -%}(Sold Out){%- endunless -%}
                </option>
              {%- endfor -%}
            </select>

            <form class="quick-add-form" data-quick-add-form>
              <input type="hidden" name="id" value="{{ v.id }}" data-quick-add-id>
              <button
                type="submit"
                class="content-cta content-cta__solid quick-add-btn item-cta__button {% unless v.available %}product-sold_cta{% endunless %}"
                {% unless v.available %}
                  disabled
                {% endunless %}
                data-adding-text="ADDING..."
                data-add-to-cart-text="ADD TO CART"
                data-sold-text="SOLD OUT"
                aria-label="{% if v.available %}Add {{ product.title | escape }} to cart{% else %}{{ product.title | escape }} - Sold Out{% endif %}"
              >
                {% if v.available %}ADD TO CART{% else %}SOLD OUT{% endif %}
              </button>
            </form>
          </div>

        {%- else -%}
          {%- if settings.enable_swatches and product.variants.size > 1 -%}
            {%- assign variant_limit = 4 -%}

            {%- assign available_count = 0 -%}
            {%- for vv in product.variants -%}
              {%- if vv.available -%}{%- assign available_count = available_count | plus: 1 -%}{%- endif -%}
            {%- endfor -%}

            <fieldset class="quick-add-swatches" data-quick-add-swatches data-product-id="{{ product.id }}" style="border: none; padding: 0; margin: 0; display: inline-flex; flex-wrap: wrap; gap: 8px;">
              <legend class="visually-hidden">Select color for {{ product.title | escape }}</legend>
              {%- for variant in product.variants -%}
                {%- if variant.available -%}
                  {%- assign swatch_image = variant.image | default: product.featured_media -%}
                  {% comment %} {%- assign img_url = swatch_image | image_url: width: 20 -%}   {% endcomment %}

                  {%- assign color_value = variant.option1 -%}
                  {%- if product.options[0] != 'Color' and product.options[1] == 'Color' -%}
                    {%- assign color_value = variant.option2 -%}
                  {%- elsif product.options[0] != 'Color' and product.options[2] == 'Color' -%}
                    {%- assign color_value = variant.option3 -%}
                  {%- endif -%}

                  <div
                    class="single-color{% if forloop.index > variant_limit %} swatch-hidden{% endif %}"
                    {% comment %} {% if forloop.index > variant_limit %}style="display:none;"{% endif %} {% endcomment %}
                    data-variant-id="{{ variant.id }}"
                    data-variant-image="{{ swatch_image | image_url: width: 800 }}"
                    data-variant-available="{{ variant.available }}"
                  >
                    <input
                      type="radio"
                      id="quick_add_color_{{ product.id }}_{{ variant.id }}"
                      name="quick_add_color_{{ product.id }}"
                      value="{{ variant.id }}"
                      {% if variant.id == product.selected_or_first_available_variant.id %}
                        checked
                      {% endif %}
                    >
                    <label
                      class="swatch color-{{color_value | downcase | handle}}"
                      {% if color_value contains 'Navy' or color_value == 'Black' or color_value == 'black' %}
                        style="background-color: {{ color_value | downcase | handle }};"
                      {% else %}
                        style="background-image: url('{{ img_url }}'); background-size: cover; background-position: center;"
                      {% endif %}
                      for="quick_add_color_{{ product.id }}_{{ variant.id }}"
                    >
                      <span class="variant-title sr-only">{{ variant.title }}</span>
                    </label>
                    {% comment %} <span class="">{{ variant.title }}</span>   {% endcomment %}
                  </div>
                {%- endif -%}
              {%- endfor -%}

              {%- if available_count > variant_limit -%}
                <div class="single-color more-trigger-wrapper">
                  <div class="swatch-more" role="button" aria-label="Show more colors">
                    +{{ available_count | minus: variant_limit }}
                  </div>
                </div>
              {%- endif -%}
            </fieldset>
          {%- endif -%}

          <a
            href="{{ product.url }}"
            class="content-cta content-cta__solid item-cta__button {% unless v.available or product.template_suffix == 'new-s3-max' %}product-sold_cta{% endunless %}"
            {% if settings.open_new_tab %}
              target="_blank" rel="noopener noreferrer"
            {% endif %}
            data-shop-now-link
            aria-label="{% if v.available or product.template_suffix == 'new-s3-max' %}Shop {{ product.title | escape }}{% else %}{{ product.title | escape }} - Sold Out{% endif %}"
          >
            {% if v.available or product.template_suffix == 'new-s3-max'%}
              SHOP NOW
            {% else %}
              SOLD OUT
            {% endif %}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if settings.enable_product_reviews -%}
    <span class="shopify-product-reviews-badge" data-id="{{ product.id }}"></span>
  {%- endif -%}

  {%- if quick_shop_enable -%}
    {%- render 'quick-shop-modal', product: product -%}
  {%- endif -%}
</div>
