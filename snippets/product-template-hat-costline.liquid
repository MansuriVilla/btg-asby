<style>
  .variant-wrapper.js { display: none; }
  .variant-wrapper.js .variant-input-wrap  label.active.color-swatch::before { border: 6px solid var(--new-black); }
</style>
<script>  

document.addEventListener('DOMContentLoaded', function () {
  function updateActiveClass() {
    var label1 = document.getElementById('swatch1');
    var label2 = document.getElementById('swatch2');
    var currentVariantSpan = document.querySelector('.current-variant');

    if (label1) {
      
      if (window.location.href.includes('?variant=44271238250693')) {
        label1.classList.remove('active');
        label1.classList.add('no_active');
        
        
        if (label2) {
          label2.classList.add('active');
          label2.classList.remove('no_active');
        }
      }
      
      else if (window.location.href.includes('/products/blue-tees-og-script-rope-hat')) {
        label1.classList.add('active');
        label1.classList.remove('no_active');
        
        
        if (label2) {
          label2.classList.remove('active');
          label2.classList.add('no_active');
        }
      } else {
        
        label1.classList.remove('active');
        label1.classList.add('no_active');
        
        if (label2) {
          label2.classList.remove('active');
          label2.classList.add('no_active');
        }
      }
    }

    
    if (label2 && label2.classList.contains('active')) {
      
      if (currentVariantSpan) {
        currentVariantSpan.textContent = 'white'; 
      }
    } else if (label1 && label1.classList.contains('active')) {
      
      if (currentVariantSpan) {
        currentVariantSpan.textContent = 'Black'; 
      }
    } else {
      
      if (currentVariantSpan) {
        currentVariantSpan.textContent = ''; 
      }
    }
  }

  
  updateActiveClass();
  
  document.addEventListener('variant:changed', function () {
    updateActiveClass();
  });
});



</script>
  

  
