      // Show the first tab and hide the rest
    $('#tabs-nav li:first-child').addClass('active');
    $('.tab-content').hide();
    $('.tab-content:first').show();

    // Click function
    $('#tabs-nav li').click(function(){
      $('#tabs-nav li').removeClass('active');
      $(this).addClass('active');
      $('.tab-content').hide();

      var activeTab = $(this).find('a').attr('href');
      $(activeTab).fadeIn();
      return false;
    });
  </script>

  
                                      
  <script type="text/javascript">
    $( document ).ready(function() {
    	$("input[name='offer-checkbox-rangefinder-three'][type='checkbox']").change(function(){	
         $("input[name='offer-checkbox-rangefinder-three'][type='checkbox']").prop("checked", $(this).prop("checked"));
        });
      
        $("input[name='player-pack-ultimate-bundle-bundle'][type='checkbox']").change(function(){	
          $("input[name='player-pack-ultimate-bundle-bundle'][type='checkbox']").prop("checked", $(this).prop("checked"));
          var is_checked = $(this).prop('checked');
          if(is_checked){
            var available = $(".ctm_id").attr('data-available'); 
            $('.ctm_select_id').attr('name','');
            $('.ctm_id').attr('name','id');
            if(available){
              $(this).closest('.product-single__meta').find('[data-add-to-cart] [data-add-to-cart-text]').text('ADD TO CART'); 
              $(this).closest('.product-single__meta').find('[data-add-to-cart]').removeAttr('disabled'); 
            }else{
              $(this).closest('.product-single__meta').find('[data-add-to-cart] [data-add-to-cart-text]').text('Sold Out');
              $(this).closest('.product-single__meta').find('[data-add-to-cart]').attr('disabled',true); 
            }
          }else{
            $('.ctm_select_id').attr('name','id');
            $('.ctm_id').attr('name','');
            var available = $(this).closest('.product-single__meta').find('.ctm_select_id option:selected').attr('data-available');
            
            if(available == true || available == "true"){
             $(this).closest('.product-single__meta').find('[data-add-to-cart] [data-add-to-cart-text]').text('ADD TO CART'); 
             $(this).closest('.product-single__meta').find('[data-add-to-cart]').removeAttr('disabled'); 
            }else{
             $(this).closest('.product-single__meta').find('[data-add-to-cart] [data-add-to-cart-text]').text('Sold Out');
             $(this).closest('.product-single__meta').find('[data-add-to-cart]').attr('disabled',true); 
            }
          }
        });
     });
  </script>
                                      
<script>
     document.querySelectorAll(".accordion-header").forEach((button) => {
        button.addEventListener("click", () => {
          const accordionContent = document.getElementById("player-pack-upgrade");

          button.classList.toggle("active");
          
          if (button.classList.contains("active")) {
            accordionContent.classList.add("active");
            accordionContent.style.maxHeight =
              accordionContent.scrollHeight + "px";
          } else {
            accordionContent.style.maxHeight = 0;
            accordionContent.classList.remove("active");
          }
        });
      });
   </script>   
                                      
