{% comment %}
  Component: comp-video-reel
  Usage: Displays responsive video reel player with creator handle, story thumbnails switcher, and sound toggle.
{% endcomment %}

{% liquid
  assign v_id = video_id | default: 'reel-player'
  assign active_video_src = default_video | default: 'https://cdn.shopify.com/videos/c/o/v/0fca515419e743d4a7ed6047598c316c.mp4'
  assign active_poster = default_poster
  assign active_handle = default_handle | default: '@ALLIE.GOLFS'
%}

<div class="comp-video-reel" id="comp-reel-{{ v_id }}">
  <div class="comp-video-reel__stage">
    
    <!-- Top Creator Overlay -->
    <div class="comp-video-reel__creator" id="comp-reel-creator-{{ v_id }}">
      <div class="comp-video-reel__avatar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
        </svg>
      </div>
      <span class="comp-video-reel__handle" id="comp-reel-handle-text-{{ v_id }}">{{ active_handle }}</span>
    </div>

    <!-- Active Video Element -->
    <video
      class="comp-video-reel__video"
      id="comp-reel-video-{{ v_id }}"
      src="{{ active_video_src }}"
      {% if active_poster != blank %}poster="{{ active_poster }}"{% endif %}
      loop
      muted
      playsinline
      webkit-playsinline
      preload="none"
    ></video>

    <!-- Bottom Controls Overlay -->
    <div class="comp-video-reel__overlay-bottom">
      
      <!-- Video Thumbnails / Stories Switcher -->
      <div class="comp-video-reel__thumbs" role="tablist" aria-label="Reel videos">
        {{ reel_thumbs }}
      </div>

      <!-- Mute / Unmute Button -->
      <button
        type="button"
        class="comp-video-reel__sound-btn"
        id="comp-reel-sound-{{ v_id }}"
        aria-label="Toggle mute"
      >
        <!-- Muted Icon -->
        <svg class="comp-video-reel__sound-icon comp-video-reel__sound-icon--muted" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M11 5L6 9H2v6h4l5 4V5z"/>
          <line x1="23" y1="9" x2="17" y2="15"/>
          <line x1="17" y1="9" x2="23" y2="15"/>
        </svg>
        <!-- Unmuted Icon -->
        <svg class="comp-video-reel__sound-icon comp-video-reel__sound-icon--unmuted" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
          <path d="M11 5L6 9H2v6h4l5 4V5z"/>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
        </svg>
      </button>

    </div>
  </div>
</div>

<style>
  .comp-video-reel {
    width: 100%;
    height: 100%;
    position: relative;
    box-sizing: border-box;
  }

  .comp-video-reel__stage {
    width: 100%;
    aspect-ratio: 9 / 13.5;
    {% comment %} border-radius: clamp(0.9rem, 0.7rem + 0.8vw, 1.4rem); {% endcomment %}
    overflow: hidden;
    position: relative;
    background-color: #0f172a;
    {% comment %} box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.25); {% endcomment %}
  }

  .comp-video-reel__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    cursor: pointer;
  }

  /* Creator Tag Pill */
  .comp-video-reel__creator {
    position: absolute;
    top: clamp(0.75rem, 0.5rem + 0.6vw, 1.25rem);
    left: clamp(0.75rem, 0.5rem + 0.6vw, 1.25rem);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: clamp(0.25rem, 0.2rem + 0.1vw, 0.35rem) clamp(0.55rem, 0.45rem + 0.3vw, 0.85rem);
    border-radius: 9999px;
    color: #ffffff;
    z-index: 10;
    pointer-events: none;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .comp-video-reel__avatar {
    width: 16px;
    height: 16px;
    background: #ffffff;
    color: #0f172a;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .comp-video-reel__handle {
    font-size: clamp(0.7rem, 0.65rem + 0.15vw, 0.8rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Bottom Controls Overlay */
  .comp-video-reel__overlay-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: clamp(1rem, 0.8rem + 0.8vw, 1.5rem) clamp(0.85rem, 0.6rem + 0.6vw, 1.25rem);
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0.35) 60%, transparent 100%);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    z-index: 10;
  }

  /* Thumbnails Switcher */
  .comp-video-reel__thumbs {
    display: flex;
    align-items: center;
    gap: clamp(0.4rem, 0.3rem + 0.2vw, 0.65rem);
  }

  .comp-video-reel__thumb-btn {
    width: clamp(2.5rem, 2.2rem + 1vw, 3.25rem);
    aspect-ratio: 9 / 13;
    border-radius: clamp(0.3rem, 0.25rem + 0.1vw, 0.45rem);
    border: 2px solid transparent;
    padding: 0;
    background: #1e293b;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease;
    outline: none;
  }

  .comp-video-reel__thumb-btn:hover {
    transform: scale(1.05);
  }

  .comp-video-reel__thumb-btn.is-active {
    border-color: #ffffff;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
  }

  .comp-video-reel__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .comp-video-reel__thumb-icon {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 20px;
    height: 20px;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.55);
    border-radius: 50%;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition: transform 0.15s ease, opacity 0.15s ease;
    pointer-events: none;
  }

  .comp-video-reel__thumb-icon svg {
    display: block;
    width: 9px;
    height: 9px;
    fill: currentColor;
  }

  .comp-video-reel__thumb-icon--play svg {
    margin-left: 1px; /* visual optical alignment for play triangle */
  }

  .comp-video-reel__thumb-btn.is-active .comp-video-reel__thumb-icon--play {
    display: none !important;
  }

  .comp-video-reel__thumb-btn.is-active .comp-video-reel__thumb-icon--pause {
    display: flex !important;
  }

  .comp-video-reel__thumb-btn:not(.is-active) .comp-video-reel__thumb-icon--pause {
    display: none !important;
  }

  .comp-video-reel__thumb-btn:not(.is-active) .comp-video-reel__thumb-icon--play {
    display: flex !important;
  }

  /* Sound Mute Button */
  .comp-video-reel__sound-btn {
    width: clamp(1.85rem, 1.6rem + 0.5vw, 2.25rem);
    height: clamp(1.85rem, 1.6rem + 0.5vw, 2.25rem);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: background-color 0.2s ease, transform 0.15s ease;
    flex-shrink: 0;
    outline: none;
  }

  .comp-video-reel__sound-btn:hover {
    background: rgba(0, 0, 0, 0.8);
    transform: scale(1.08);
  }
</style>

<script>
  (function() {
    function initVideoReel() {
      const container = document.getElementById('comp-reel-{{ v_id }}');
      if (!container) return;

      const video = container.querySelector('.comp-video-reel__video');
      const handleText = container.querySelector('#comp-reel-handle-text-{{ v_id }}');
      const soundBtn = container.querySelector('#comp-reel-sound-{{ v_id }}');
      const iconMuted = soundBtn ? soundBtn.querySelector('.comp-video-reel__sound-icon--muted') : null;
      const iconUnmuted = soundBtn ? soundBtn.querySelector('.comp-video-reel__sound-icon--unmuted') : null;
      const thumbBtns = container.querySelectorAll('.comp-video-reel__thumb-btn');

      if (!video) return;

      // Play / Pause on video click
      video.addEventListener('click', function() {
        if (video.paused) {
          video.play();
        } else {
          video.pause();
        }
      });

      // Sound toggle
      if (soundBtn) {
        soundBtn.addEventListener('click', function() {
          video.muted = !video.muted;
          if (iconMuted && iconUnmuted) {
            if (video.muted) {
              iconMuted.style.display = 'block';
              iconUnmuted.style.display = 'none';
            } else {
              iconMuted.style.display = 'none';
              iconUnmuted.style.display = 'block';
            }
          }
        });
      }

      // Thumbnail switching
      thumbBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          const videoSrc = this.getAttribute('data-video-src');
          const posterSrc = this.getAttribute('data-poster-src');
          const handle = this.getAttribute('data-creator-handle');

          if (!videoSrc) return;

          // If clicked active, toggle play / pause
          if (this.classList.contains('is-active')) {
            if (video.paused) {
              video.play();
            } else {
              video.pause();
            }
            return;
          }

          // Switch active class
          thumbBtns.forEach(b => b.classList.remove('is-active'));
          this.classList.add('is-active');

          // Smooth fade transition
          video.style.opacity = '0.3';
          setTimeout(function() {
            video.src = videoSrc;
            if (posterSrc) video.poster = posterSrc;
            if (handle && handleText) handleText.textContent = handle;
            video.load();
            video.play().catch(function() {});
            video.style.opacity = '1';
          }, 150);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVideoReel);
    } else {
      initVideoReel();
    }
  })();
</script>
