{%- liquid
  assign output_tab = true
  if title == blank and content == blank
    assign output_tab = false
  endif
-%}
{%- if output_tab -%}
  <div class="collapsibles-wrapper collapsibles-wrapper--border-bottom main-collapsibles-{{ product.handle }}">
    <button
      type="button"
      class="label collapsible-trigger collapsible-trigger-btn collapsible-trigger-btn--borders collapsible--auto-height{% if force_open %} is-open{% endif %}"
      aria-controls="Product-content-{{ id }}"
      {% if force_open %}
        aria-expanded="true"
      {% endif %}
    >
      {{ title }}
      {%- render 'collapsible-icons' -%}
      {% comment %} svg plus/minus icon {%- render 'collapsible-icons-tab' -%} {% endcomment %}
    </button>
    <div
      id="Product-content-{{ id }}"
      class="collapsible-content collapsible-content--all{% if force_open %} is-open{% endif %} content-collapsibles-box-of-{{ product.handle }}"
      {% if force_open %}
        style="height: auto;"
      {% endif %}
    >
      <div class="collapsible-content__inner rte">
        {{ content }}
      </div>
    </div>
  </div>
{%- endif -%}
