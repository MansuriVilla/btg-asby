{% if product.metafields.nok.enabled %}
{% case product.metafields.nok.with_logo %}
	{% when true %}
		{% assign nok_hiw_text = "how it works" %}
	{% else %}
		{% assign nok_hiw_text = "powered by nok" %}
{% endcase %}
<div class="try-with-nok__divider">
  OR
</div>
{% render "try-with-nok-button" %}
<a href="#" class="try-with-nok__powered-by" id="try-with-nok-powered-by">
  <span>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <g clip-path="url(#clip0)">
    <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" stroke="#111111" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M12 16V12" stroke="#111111" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M12 9H12.01" stroke="#111111" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </g>
    <defs>
    <clipPath id="clip0">
    <rect width="24" height="24" fill="white"/>
    </clipPath>
    </defs>
    </svg>
  </span>
  <span>
    {{ nok_hiw_text }}
  </span>
</a>
  {% if product.metafields.nok.accent_color %}
  <style>
    :root {
      --nok-accent-color: {{product.metafields.nok.accent_color}};
      --nok-color-text:  {{ settings.color_text }};
    }
  </style>
  {% endif %}
{% endif %}