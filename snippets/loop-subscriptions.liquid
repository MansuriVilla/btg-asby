{%- comment -%} Loop Subscription Snippet v6.6 {%- endcomment -%}
{% comment %}
	LOOP SUBSCRIPTIONS (https://apps.shopify.com/loop-subscriptions)

  DO NOT modify source code of this file because
	It is automatically generated from LOOP SUBSCRIPTIONS WIDGET DESIGN
	If you need to make change, please do it using our standard widget design settings or create a custom widget design in LOOP SUBSCRIPTIONS app.
{% endcomment %}

<div class="loop-display-none loop-skeleton-loader" style="width: 100%; height: 60px; background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%); background-size: 200% 100%; animation: loop-skeleton-loading 1.5s infinite; border-radius: 8px; margin-bottom: 20px;"></div>
<style>
@keyframes loop-skeleton-loading {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
}
</style>
{%- if type contains 'product-widget' -%}
	{%- if content_for_header contains 'loop_snippets' -%}
		{% render 'loop-widget-standard' type: 'product-widget', product: product %}
	{%- endif -%}
{%- elsif type == 'customer-portal-link' -%}
	{% assign locale = shop_locale.iso_code %}
	{% if locale == null %}
		{% assign locale = localization.language.iso_code %}
	{% endif %}
	{% if locale == null %}
		{% assign locale = request.locale.iso_code %}
	{% endif %}
	{% if routes.root_url == '/' %}
		{% assign locale = null %}  
	{% endif %}
	<a href="/a/loop_subscriptions/auth?customer_id={{customer.id}}&myshopify_domain={{shop.permanent_domain}}&locale={{ locale }}" id="loop-subscriptions-customer-portal-link">
		<button class="btn" style="padding: 10px 20px;margin:0 0 20px 0">My Subscriptions</button>
	</a>
{%- endif -%}
