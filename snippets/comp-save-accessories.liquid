{% comment %}
  Component: comp-save-accessories
  Usage:
  {% render 'comp-save-accessories', block: block %}
  Block settings: heading, product_1..4, sub_1..4 (optional subtitle overrides)
{% endcomment %}

{% liquid
  assign acc_heading = block.settings.heading | default: 'Save on Accessories'
  assign picks = 'product_1,product_2,product_3,product_4' | split: ','
%}

<div class="comp-save-accessories" data-comp-accessories {{ block.shopify_attributes }}>
  <h2 class="comp-save-accessories__heading">{{ acc_heading }}</h2>
  <div class="comp-save-accessories__list">
    {% for key in picks %}
      {% liquid
        assign p = block.settings[key]
        if p.title == blank and p != blank
          assign p = all_products[p]
        endif
        assign sub_key = key | replace: 'product_', 'sub_'
        assign sub_override = block.settings[sub_key]
        assign modal_key = key | replace: 'product_', 'enable_modal_'
        assign modal_enabled = block.settings[modal_key] | default: false
      %}
      {% if p != blank %}
        {% render 'comp-accessory-row', product: p, item: p, subtitle: sub_override, enable_modal: modal_enabled %}
      {% endif %}
    {% endfor %}
  </div>
</div>

<style>
  .comp-save-accessories {
    width: 100%;
    margin-top: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 1.1vw, 14px);
  }
  .comp-save-accessories__heading {
    margin: 0;
    font-family: 'Blue Tees Headline Italic', sans-serif;
    font-size: clamp(14px, 1.1vw, 16px);
    line-height: 1.5;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1B1E22;
  }
  .comp-save-accessories__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }
  .comp-accessory-row {
    position: relative;
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 0px 80px 0px 0px;
    gap: 10px;
    isolation: isolate;
    width: 100%;
    min-height: clamp(96px, 7.5vw, 108px);
    background: #FFFFFF;
    border: 1px solid #D9D9D9;
    border-radius: 10px;
    overflow: hidden;
  }
  .comp-accessory-row__thumb {
    flex: none;
    flex-shrink: 0;
    width: clamp(90px, 7vw, 103px);
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    z-index: 0;
  }
  .comp-accessory-row__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .comp-accessory-row__info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 14px 0px;
    gap: 8px;
    flex: 1;
    min-width: 0;
    z-index: 1;
  }
  .comp-accessory-row__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0px;
    gap: 4px;
    width: 100%;
  }
  .comp-accessory-row__title {
    font-family: 'Blue Tees Subhead', sans-serif;
    font-size: 16px;
    line-height: 1;
    color: #000000;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
  }
  .comp-accessory-row__price {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 0px;
    gap: 6px;
    line-height: 1;
  }
  .comp-accessory-row__price strong {
    font-family: 'Blue Tees Subhead', sans-serif;
    font-size: 14px;
    line-height: 1;
    display: flex;
    align-items: center;
    color: #000000;
  }
  .comp-accessory-row__price.is-on-sale strong {
    color: #CB0000;
  }
  .comp-accessory-row__price s.custom_body-text span.money {
    font-family: 'Blue Tees Paragraph';
  }
  .comp-accessory-row__price s {
    font-family: 'Blue Tees Paragraph', sans-serif;
    font-size: 14px;
    line-height: 1;
    display: flex;
    align-items: center;
    text-decoration-line: line-through;
    color: #9EA3B1;
  }
  .comp-accessory-row__sub {
    font-family: 'Blue Tees Paragraph', sans-serif;
    font-size: 12px;
    line-height: 1.5;
    color: #4F4F4F;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    width: 100%;
  }
  .comp-accessory-row__action {
    position: static;
  }
  .comp-accessory-row__add {
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 6px 10px;
    gap: 4px;
    position: absolute;
    width: auto;
    min-width: 68px;
    height: 32px;
    right: 9px;
    top: 9px;
    border: none;
    border-radius: 100px;
    background: transparent;
    cursor: pointer;
    z-index: 3;
    white-space: nowrap;
    transition: background 0.2s ease;
  }
  .comp-accessory-row__add-label {
    font-family: 'Blue Tees Subhead', sans-serif;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 1px;
    color: #4F4F4F !important;
    text-align: center;
    white-space: nowrap;
  }
  .comp-accessory-row__add-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 12px;
    height: 12px;
    color: #4F4F4F !important;
    flex-shrink: 0;
  }
  .comp-accessory-row__add-icon svg,
  .comp-accessory-row__add-icon svg path,
  .comp-accessory-row__add-icon svg * {
    color: #4F4F4F !important;
    stroke: #4F4F4F !important;
  }
  .comp-accessory-row__add:disabled .comp-accessory-row__add-icon {
    display: none;
  }
  .comp-accessory-row__add:hover:not(:disabled) {
    background: rgba(0, 0, 0, 0.05);
  }
  .comp-accessory-row__details {
    position: absolute;
    right: 21px;
    bottom: 20px;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: 'Blue Tees Paragraph', sans-serif;
    font-size: 12px;
    line-height: 1.5;
    text-decoration-line: underline;
    color: #0149E3;
    z-index: 2;
  }
</style>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling.previousElementSibling;
    if (!root || !root.hasAttribute('data-comp-accessories')) return;

    // Handle Details Button -> Open Modal
    var activeModalDockCtrl = null;

    function openModal(modalId) {
      var modal = document.getElementById(modalId);
      if (!modal) return;
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      var dockEl = modal.querySelector('[data-mac-dock]');
      var slides = Array.from(modal.querySelectorAll('[data-prod-modal-slide]'));
      var total = slides.length;
      var curIdx = 0;

      function goToSlide(idx) {
        if (idx < 0) idx = total - 1;
        if (idx >= total) idx = 0;
        curIdx = idx;
        slides.forEach(function (s, i) {
          s.classList.toggle('is-active', i === curIdx);
          var v = s.querySelector('video');
          if (v) {
            if (i === curIdx) {
              v.currentTime = 0;
              v.play().catch(function () {});
            } else {
              v.pause();
            }
          }
        });
      }

      if (dockEl && window.initMacDock) {
        if (activeModalDockCtrl) {
          activeModalDockCtrl.destroy();
          activeModalDockCtrl = null;
        }
        activeModalDockCtrl = window.initMacDock({
          dock: dockEl,
          initialIndex: 0,
          duration: 4.5,
          autoPlay: true,
          onSelect: function (i) { goToSlide(i); },
          onAutoAdvance: function (i) { goToSlide(i); }
        });
      }
      goToSlide(0);
    }

    function closeModal(modal) {
      if (!modal) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (activeModalDockCtrl) {
        activeModalDockCtrl.destroy();
        activeModalDockCtrl = null;
      }
      modal.querySelectorAll('video').forEach(function (v) { v.pause(); });
    }

    root.querySelectorAll('[data-comp-accessory-details]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        var targetId = btn.getAttribute('data-modal-target');
        if (targetId) openModal(targetId);
      });
    });

    document.querySelectorAll('[data-comp-prod-modal]').forEach(function (modal) {
      modal.querySelectorAll('[data-comp-prod-modal-close]').forEach(function (closeBtn) {
        closeBtn.addEventListener('click', function () {
          closeModal(modal);
        });
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        var openMod = document.querySelector('.comp-prod-modal.is-open');
        if (openMod) closeModal(openMod);
      }
    });

    // Handle Add to Cart in rows and modal
    document.querySelectorAll('[data-comp-accessory-add]').forEach(function (btn) {
      var label = btn.querySelector('[data-label]');
      var original = label ? label.textContent : 'ADD';

      function flash(text) {
        if (!label) return;
        label.textContent = text;
        setTimeout(function () { label.textContent = original; }, 2000);
      }

      btn.addEventListener('click', function (e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        var id = btn.getAttribute('data-variant-id');
        if (!id) return;
        btn.classList.add('is-loading');

        var savedScrollY = window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop || 0;

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ id: id, quantity: 1 })
        })
          .then(function (r) {
            if (!r.ok) throw new Error('add failed');
            return r.json();
          })
          .then(function (item) {
            flash('ADDED ✓');
            document.dispatchEvent(new CustomEvent('ajaxProduct:added', { detail: { product: item } }));
            
            // Keep page at current scroll position
            window.scrollTo({ top: savedScrollY, behavior: 'instant' });
            requestAnimationFrame(function () {
              window.scrollTo({ top: savedScrollY, behavior: 'instant' });
            });

            var openMod = document.querySelector('.comp-prod-modal.is-open');
            if (openMod) closeModal(openMod);
          })
          .catch(function () { flash('ERROR'); })
          .finally(function () { btn.classList.remove('is-loading'); });
      });
    });
  })();
</script>
