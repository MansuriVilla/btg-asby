{%- liquid
  assign current_variant = product.selected_or_first_available_variant

  unless thumbnail_position
    assign thumbnail_position = 'beside'
  endunless

  assign product_zoom_size = '1800x1800'
  assign product_image_size = '620x'

  case image_container_width
    when 'small'
      assign product_image_width = 'medium-up--two-fifths new-product__two-fifths'
      assign product_description_width = 'medium-up--three-fifths new-product__two-fifths'
      assign product_image_size = '480x'
    when 'medium'
      assign product_image_width = 'medium-up--one-half'
      assign product_description_width = 'medium-up--one-half'
      assign product_image_size = '620x'
    when 'large'
      assign product_image_width = 'medium-up--three-fifths new-product__two-fifths'
      assign product_description_width = 'medium-up--two-fifths new-product__two-fifths'
      assign product_image_size = '740x'
  endcase

  assign product_img_structure = product.featured_media | img_url: '1x1' | replace: '_1x1.', '_{width}x.'

  assign hide_upsell = true
  case product.handle
    when 'rainmaker-launch-monitor-remote-navy', 'blue-tees-golf-gift-card', 'gift'
      assign hide_upsell = false
  endcase
-%}
{% comment %}
  when blank
  assign hide_upsell = false
{% endcomment %}

<div
  id="ProductSection-{{ section_id }}-{{ product.id }}"
  class="product-section new-product__layout new-product__layout--{{ product.handle | handleize }}"
  data-section-id="{{ section_id }}"
  data-product-id="{{ product.id }}"
  data-section-type="product"
  data-product-handle="{{ product.handle }}"
  data-product-title="{{ product.title | escape }}"
  data-product-url="{{ product.url | within: collection }}"
  data-aspect-ratio="{{ 100 | divided_by: product.featured_media.aspect_ratio }}"
  data-img-url="{{ product_img_structure }}"
  {% unless isModal %}
    data-history="true"
  {% endunless %}
  data-modal="{{ isModal }}"
>
  {%- render 'product-template-variables', product: product, current_variant: current_variant -%}

  <div class="page-content page-content--product new-product-template {%if hide_upsell == false %} no_upsells{%endif %}">
    <div class="new-page-width">
      <div class="grid{% unless image_position == 'left' %} grid--product-images-right{% endunless %}{% if mobile_layout == 'partial' %} grid--product-images--partial{% endif %}">
        {%- if image_position == 'left' -%}
          <div class="grid__item {{ product_image_width }} product-single__sticky">
            {%- render 'product-images',
              section_id: section_id,
              product: product,
              isModal: isModal,
              image_position: image_position,
              product_zoom_enable: product_zoom_enable,
              product_zoom_size: product_zoom_size,
              product_image_size: product_image_size,
              thumbnail_arrows: thumbnail_arrows,
              thumbnail_position: thumbnail_position,
              video_looping: video_looping,
              video_style: video_style
            -%}

            {% render 'watch-button-pdp',
              must_watch: section.settings.must_watch,
              review_video: section.settings.review_video,
              display_review_button: section.settings.display_review_button
            %}
          </div>
        {%- endif -%}

        <div class="grid__item {{ product_description_width }}">
          <div class="product-single__meta">
            <div class="product-block product-block--header">
              {%- if settings.show_breadcrumbs and isModal != true -%}
                {%- render 'breadcrumbs' -%}
              {%- endif -%}

              {%- if settings.vendor_enable -%}
                <div class="product-single__vendor">
                  {%- assign vendor_handle = product.vendor | handleize -%}
                  {%- if collections[vendor_handle] != empty -%}
                    <a href="{{ routes.collections_url }}/{{ collections[vendor_handle].handle }}">
                      {{ collections[vendor_handle].title }}
                    </a>
                  {%- else -%}
                    {{ product.vendor | link_to_vendor }}
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if isModal -%}
                <p class="h2 product-single__title">
                  {{ product.title }}
                </p>
              {%- else -%}
                {% if product.title contains 'Rangefinder with slope' %}
                  <h1 class="h1 product-single__title">
                    {{
                      product.title
                      | replace: 'Golf Rangefinder with slope',
                        '<span id="test-series">Golf Rangefinder with slope</span>'
                    }}
                  </h1>
                {% else %}
                  {% if product.template_suffix == 'rainmaker' %}
                    {% comment %} {% render 'offer-bug' %} {% endcomment %}

                    <div style="color:var(--new-black);background:#CDFF07;line-height:1;border-radius:5px;padding:5px 10px;display: inline-flex;margin-bottom: 13px;font-family: Blue Tees Subhead;font-size: 12px;text-transform: uppercase;">
                      #1 NEW RELEASE
                    </div>
                  {% elsif product.template_suffix == 'player-pro' or product.handle contains 'captain' %}
                    <span class="coming_soon-label">
                      <span style="color:var(--new-black);background:#CDFF07;line-height:1;border-radius: 4px;padding: 4px 16px;display: inline-flex;justify-content: center;align-items: center;font-family: Blue Tees Subhead;font-size: 10px;text-transform: uppercase;">
                        NEW
                      </span>
                    </span>
                  {% endif %}
                  {% if product.template_suffix == 'player-gps-speaker' %}
                    {% render 'supercharged-ai-comp' %}
                  {% endif %}

                  {% if section.settings.show_label %}
                    <span class="coming_soon-label">
                      <svg width="56" height="20" viewBox="0 0 56 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect width="56" height="20" rx="5" fill="#CDFF07"/>
                        <path d="M15.8811 13V5.89062H17.8244L20.3049 9.87012C20.3895 10.0036 20.4725 10.1517 20.5539 10.3145C20.6385 10.4772 20.7004 10.6139 20.7395 10.7246H20.7883C20.7753 10.6074 20.7639 10.474 20.7541 10.3242C20.7476 10.1745 20.7443 10.0296 20.7443 9.88965V5.89062H22.2873V13H20.3L17.8 9.04492C17.7056 8.89844 17.6275 8.75195 17.5656 8.60547C17.5038 8.45898 17.4566 8.33366 17.424 8.22949H17.3752C17.3882 8.34342 17.398 8.46712 17.4045 8.60059C17.4143 8.73405 17.4191 8.8724 17.4191 9.01562V13H15.8811ZM24.1475 13V5.89062H29.6064V7.21875H25.9688V8.68848H29.123V9.99707H25.9688V11.6768H29.6602V13H24.1475ZM32.2039 13.0098L30.3387 5.89062H32.1941L33.3172 10.5586C33.3465 10.6725 33.3709 10.7832 33.3904 10.8906C33.4132 10.998 33.4295 11.1087 33.4393 11.2227H33.4783C33.4881 11.1087 33.4995 10.998 33.5125 10.8906C33.5255 10.7832 33.5467 10.6725 33.576 10.5586L34.6941 5.89062H36.7742L37.9314 10.5439C37.9607 10.6611 37.9803 10.7751 37.99 10.8857C38.0031 10.9932 38.0161 11.1038 38.0291 11.2178H38.0682C38.0779 11.1038 38.0893 10.9915 38.1023 10.8809C38.1186 10.7702 38.1398 10.6579 38.1658 10.5439L39.2645 5.89062H40.827L38.9422 13.0098H36.8475L35.7098 8.40527C35.6805 8.28809 35.6561 8.16927 35.6365 8.04883C35.617 7.92513 35.604 7.80632 35.5975 7.69238H35.5535C35.547 7.80632 35.534 7.9235 35.5145 8.04395C35.4982 8.16439 35.477 8.2832 35.451 8.40039L34.3035 13.0098H32.2039Z" fill="black"/>
                      </svg>
                    </span>
                  {% endif %}
                  {% if product.template_suffix == 'new-s3-max' %}
                    <span class="offer_bug">
                      <span style="color:#fff;background:var(--new-blue);line-height:1;border-radius: 3px;padding: 7px 16px;display: inline-flex;justify-content: center;align-items: center;font-family: Blue Tees Subhead;font-size: 12px;text-transform: uppercase;letter-spacing: 1px;">
                        BEST-SELLER
                      </span>
                    </span>
                    {% comment %} <small id="new-tag">NEW</small>  {% endcomment %}
                  {% endif %}
                  <h1 class="h1 product-single__title {% if product.title contains "Series 3 Max" %}editonlythis{% endif %}">
                    {{ product.title }}
                  </h1>
                {% endif %}
              {%- endif -%}

              {% unless product.template_suffix == 'player-pro' or product.template_suffix == 'rainmaker' %}
                <a
                  href="#looxReviews"
                  style="
                    width: fit-content;
                    display: flex;
                  "
                >
                  <div
                    class="loox-rating"
                    data-id="{{ product.id }}"
                    data-rating="{{ product.metafields.loox.avg_rating }}"
                    data-raters="{{ product.metafields.loox.num_reviews }}"
                  ></div>
                </a>
              {% endunless %}

              {%- if sku_enable -%}
                <p data-sku class="product-single__sku">
                  {%- if current_variant.sku -%}
                    {{ current_variant.sku }}
                  {%- endif -%}
                </p>
              {%- endif -%}
            </div>

            <div data-product-blocks class="product_single--meta">
              {%- capture form_id -%}AddToCartForm-{{ section_id }}-{{ product.id }}{%- endcapture -%}
              {%- for block in blocks -%}
                {%- case block.type -%}
                  {%- when '@app' -%}
                    {% render block %}
                  {%- when 'separator' -%}
                    <div class="product-block"><hr></div>
                  {%- when 'text' -%}
                    <div class="product-block" {{ block.shopify_attributes }}>
                      {{ block.settings.text }}
                    </div>

                    {% comment %}
                      {%- when 'tab' -%}

                      <div class="tab_area">
                        <div class="product-block product-block--tab" {{ block.shopify_attributes }}>
                          {% assign tab_id = block.id | append: product.id %}
                          {% capture tab_content %}
                          {{ block.settings.content }}
                          {{ block.settings.page.content }}
                        {% endcapture %}
                          {%- render 'tab', id: tab_id, title: block.settings.title, content: tab_content -%}
                        </div>
                      </div>
                    {% endcomment %}

                  {%- when 'contact' -%}
                    <div class="product-block product-block--tab" {{ block.shopify_attributes }}>
                      {% assign tab_id = block.id | append: product.id %}
                      {%- render 'tab-contact', id: tab_id, block: block -%}
                    </div>
                  {%- when 'description' -%}
                    <div
                      class="product-block product_block--description{% if block.settings.is_tab %} product-block--tab{% endif %}"
                      {{ block.shopify_attributes }}
                    >
                      {%- assign id = block.id | append: product.id -%}
                      {%- render 'product-description', id: id, product: product, is_tab: block.settings.is_tab -%}
                    </div>
                  {%- when 'price' -%}
                    <div class="product-block product-block--price" {{ block.shopify_attributes }}>
                      <div class="product__prices">
                        {%- assign hide_sale_price = true -%}
                        {%- if product.compare_at_price_max > product.price -%}
                          {%- if current_variant.compare_at_price > current_variant.price -%}
                            {%- assign hide_sale_price = false -%}
                          {%- endif -%}
                          <span
                            data-a11y-price
                            class="visually-hidden"
                            aria-hidden="{{ hide_sale_price }}"
                          >
                            {{ 'products.general.regular_price' | t }}
                          </span>
                          <span
                            data-product-price-wrap
                            class="{% if hide_sale_price %} hide{% endif %}"
                          >
                            <span data-compare-price class="product__price product__price--compare">
                              {%- if current_variant.compare_at_price > current_variant.price -%}
                                {{ current_variant.compare_at_price | money }}
                              {%- endif -%}
                            </span>
                          </span>
                          <span data-compare-price-a11y class="visually-hidden">
                            {{- 'products.general.sale_price' | t -}}
                          </span>
                        {%- else -%}
                          <span data-a11y-price class="visually-hidden">
                            {{- 'products.general.regular_price' | t -}}
                          </span>
                        {%- endif -%}
                        <div class="product__price--actual">
                          <span
                            data-product-price
                            class="product__price price-main{% if current_variant.compare_at_price > current_variant.price %} on-sale{% endif %}"
                          >
                            {%- unless product.empty? -%}
                              {{ current_variant.price | money }}
                            {%- else -%}
                              {{ 1999 | money }}
                            {%- endunless -%}
                            {% if product.template_suffix == 'player-pro' %}
                              {% render 'supercharged-ai-comp' %}
                            {% endif %}
                          </span>
                          {% unless product.handle contains 'extend' or product.handle contains 'gift' %}
                            {% assign offer_bug = 'https://cdn.shopify.com/s/files/1/0057/8958/1381/files/100_DAY_PDP_BUG.svg?v=1770276074' %}

                            {% case product.template_suffix %}
                              {% when 'rainmaker' %}
                                {% assign offer_bug = 'https://cdn.shopify.com/s/files/1/0057/8958/1381/files/rainmaker-callout_2.svg?v=1779375486' %}
                              {% when 'play-maker-plus' %}
                                {% assign offer_bug = 'https://cdn.shopify.com/s/files/1/0057/8958/1381/files/playmaker-dicount-bug.svg?v=1782411164' %}
                            {% endcase %}

                            <span
                              class="product__offer-bug{% if product.template_suffix == 'play-maker-plus' %} dicount_bug{%endif %}"
                              {% if product.template_suffix == 'play-maker-plus' %}
                                data-discount-code="Wtbt50"
                              {% endif %}
                              ><img
                                alt="100-Day Money Back +Free shipping"
                                src="{{ offer_bug }}"
                                loading="eager"
                                decoding="async"
                              >
                              {% if product.template_suffix == 'play-maker-plus' %}
                                <div id="discount-tooltip" class="discount-tooltip">Click to copy discount code</div>
                              {% endif %}
                            </span>
                          {% endunless %}
                        </div>
                      </div>
                      {%- if settings.product_save_amount -%}
                        {%- if settings.product_save_type == 'dollar' -%}
                          {%- capture saved_amount -%}{{ current_variant.compare_at_price | minus: current_variant.price | money }}{%- endcapture -%}
                        {%- else -%}
                          {%- capture saved_amount -%}{{ current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round }}%{%- endcapture -%}
                        {%- endif -%}
                        <span data-save-price class="product__price-savings{% if hide_sale_price %} hide{% endif %}">
                          {%- unless hide_sale_price -%}
                            {{ 'products.general.save_html' | t: saved_amount: saved_amount }}
                          {%- endunless -%}
                        </span>
                      {%- endif -%}

                      <div
                        data-unit-price-wrapper
                        class="product__unit-price product__unit-price--spacing {% unless current_variant.unit_price_measurement %} hide{% endunless %}"
                      >
                        {%- capture unit_price_base_unit -%}
                          <span data-unit-base>
                            {%- if current_variant.unit_price_measurement -%}
                              {%- if current_variant.unit_price_measurement.reference_value != 1 -%}
                                {{ current_variant.unit_price_measurement.reference_value }}
                              {%- endif -%}
                              {{ current_variant.unit_price_measurement.reference_unit }}
                            {%- endif -%}
                          </span>
                        {%- endcapture -%}

                        <span data-unit-price>{{ current_variant.unit_price | money }}</span>/{{ unit_price_base_unit }}
                      </div>

                      {%- if shop.taxes_included or shop.shipping_policy.body != blank -%}
                        <div class="product__policies rte small--text-center">
                          {%- if shop.taxes_included -%}
                            {{ 'products.product.include_taxes' | t }}
                          {%- endif -%}
                          {%- if shop.shipping_policy.body != blank -%}
                            {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    </div>
                    {% if hide_upsell %}
                      {% render 'bonus-pdp-upshell' %}
                    {% endif %}
                    {% if product.metafields.custom.discount_code != blank %}
                      <div class="discount-code">
                        Use code: {{ product.metafields.custom.discount_code | metafield_tag }}
                      </div>
                      <style>
                        .product-single__meta .discount-code
                         {   padding-bottom:15px; font-weight: bold; display:none;
                         }
                         .product__price.price-main
                         {   font-size: 28px; font-weight: 700; color: #2b50b2;
                         }
                      </style>
                    {% endif %}

                  {%- when 'quantity_selector' -%}
                    <div class="product-block" {{ block.shopify_attributes }}>
                      <div class="product__quantity">
                        {% assign qty_id = section_id | append: product.id %}
                        <label for="Quantity-{{ qty_id }}">{{ 'products.product.quantity' | t }}</label>
                        {%- render 'quantity-input', form_id: form_id, id: qty_id, qty: 1, min: 1 -%}
                      </div>
                    </div>
                  {%- when 'variant_picker' -%}
                    {% if product.template_suffix == 'player-gps-speaker' %}
                      <div
                        class="product-block {% if product.title contains 'Series 2 Pro+' %}same-height{% endif %}"
                        {{ block.shopify_attributes }}
                      >
                        <div class="product-variant-type">
                          <label class="variant__label">Color<span class="current-variant"></span></label>
                          <fieldset class="variant-input-wrap">
                            <div class="variant-input navy-variant" data-index="option1" data-value="Navy">
                              <a href="/products/player-gps-speaker?variant=42266534052037">
                                <label class="navy variant__button-label" style="background: #202A45;">
                                  <img
                                    src="//blueteesgolf.com/cdn/shop/files/PLAYER__NAVY_1_large.png?v=1713973589"
                                    alt="Navy"
                                    class="first-img"
                                  >
                                  <span></span>
                                </label>
                              </a>
                            </div>
                            <div class="variant-input black-variant" data-index="option1" data-value="Black">
                              <a href="/products/player-gps-speaker?variant=42266534019269">
                                <label class="black variant__button-label" style="background: #252525;">
                                  <img
                                    src="//blueteesgolf.com/cdn/shop/files/PLAYER__BLACK_1_large.png?v=1713973589"
                                    alt="Black"
                                    class="first-img"
                                  >
                                  <span></span>
                                </label>
                              </a>
                            </div>
                            <div class="variant-input tm-variant" data-index="option1" data-value="TM Edition">
                              <a href="/products/player-gps-speaker-travis-mathew">
                                <label
                                  class="tm variant__button-label"
                                  style="background:  url({{'tm-dark-bg.png' | asset_url}}) no-repeat center center / cover;"
                                >
                                  <img
                                    src="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/menu-tm-product.png?v=1727264922"
                                    alt="Player plus Travis Mathew Edition"
                                    class="first-img"
                                  >
                                  <span>TM Edition</span>
                                </label>
                              </a>
                            </div>
                          </fieldset>
                        </div>
                      </div>
                    {% else %}
                      <div
                        class="product-block {% if product.title contains 'Series 2 Pro+' %}same-height{% endif %}"
                        {{ block.shopify_attributes }}
                      >
                        {%- unless product.has_only_default_variant -%}
                          {%- for option in product.options_with_values -%}
                            {%- liquid
                              if block.settings.color_swatches
                                assign is_color = false
                                assign color_option_index = 0
                                assign swatch_trigger = 'products.general.color_swatch_trigger' | t | downcase
                                assign color_option_index = forloop.index0
                                assign downcased_option = option.name | downcase
                                if downcased_option contains swatch_trigger
                                  assign is_color = true
                                elsif swatch_trigger == 'color' and downcased_option contains 'colour'
                                  assign is_color = true
                                endif
                              endif
                            -%}

                            {%- if block.settings.picker_type == 'button' -%}
                              {%- render 'variant-button',
                                block: block,
                                product: product,
                                form_id: form_id,
                                section_id: section_id,
                                option: option,
                                forloop: forloop,
                                variant_labels: block.settings.variant_labels,
                                is_color: is_color,
                                color_option_index: color_option_index
                              -%}
                            {%- else -%}
                              {%- render 'variant-dropdown',
                                product: product,
                                form_id: form_id,
                                section_id: section_id,
                                option: option,
                                forloop: forloop,
                                variant_labels: block.settings.variant_labels
                              -%}
                            {%- endif -%}
                          {%- endfor -%}
                        {%- endunless -%}
                      </div>
                    {% endif %}
                    <div class="prod_options">
                      <div class="after-pay"></div>
                      <div class="options_extend-protection">
                        <span class="anchor_holder">
                          <a
                            href="/pages/extend-protection-plan"
                            class="anchor_hover"
                            style="--hover-clr:var(--new-gray);"
                          >
                            <span class="anchor_holder"> Extend Protection Plans </span>
                          </a>
                        </span>
                      </div>
                    </div>
                  {%- when 'buy_buttons' -%}
                    {% if hide_upsell %}
                      {% unless product.handle contains 'hat' %}
                        {% render 'new-upshell-box' %}
                      {% endunless %}
                    {% endif %}
                    <div class="product-block" {{ block.shopify_attributes }}>
                      {%- unless product.empty? -%}
                        <div class="product-block">
                          {%- render 'product-form',
                            form_id: form_id,
                            product: product,
                            show_dynamic_checkout: block.settings.show_dynamic_checkout,
                            current_variant: current_variant,
                            pre_order: block.settings.pre_order,
                            cta_note_text: block.settings.cta_note_text
                          -%}
                        </div>
                      {%- endunless -%}

                      {%- if block.settings.surface_pickup_enable -%}
                        <div
                          data-store-availability-holder
                          data-product-name="{{ product.title | escape }}"
                          data-base-url="{{ shop.url }}{{ routes.root_url }}"
                        ></div>
                      {%- endif -%}
                    </div>

                  {%- when 'icons_row' -%}
                    <div class="icons_row">
                      <div class="row_items">
                        <div class="row_items-item">
                          <div class="items_item-top">
                            <img
                              class="items_item-top-image"
                              src="{{block.settings.itemIcon | image_url}}"
                              alt="{{block.settings.itemText }}"
                              height="100%"
                              width="100%"
                              decoding="async"
                            >
                          </div>
                          <div class="items_item-bottom">
                            <span class="items_item-bottom-text">
                              {{ block.settings.itemText }}
                            </span>
                          </div>
                        </div>
                        <div class="row_items-item">
                          <div class="items_item-top">
                            <img
                              class="items_item-top-image"
                              src="{{block.settings.itemIconTwo | image_url}}"
                              alt="{{block.settings.itemTextTwo }}"
                              height="100%"
                              width="100%"
                              decoding="async"
                            >
                          </div>
                          <div class="items_item-bottom">
                            <span class="items_item-bottom-text">
                              {{ block.settings.itemTextTwo }}
                            </span>
                          </div>
                        </div>
                        <div class="row_items-item">
                          <div class="items_item-top">
                            <img
                              class="items_item-top-image"
                              src="{{block.settings.itemIconThree | image_url}}"
                              alt="{{block.settings.itemTextThree }}"
                              height="100%"
                              width="100%"
                              decoding="async"
                            >
                          </div>
                          <div class="items_item-bottom">
                            <span class="items_item-bottom-text">
                              {{ block.settings.itemTextThree }}
                            </span>
                          </div>
                        </div>
                        <div class="row_items-item">
                          <div class="items_item-top">
                            <img
                              class="items_item-top-image"
                              src="{{block.settings.itemIconFour | image_url}}"
                              alt="{{block.settings.itemTextFour }}"
                              height="100%"
                              width="100%"
