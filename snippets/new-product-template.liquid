                      <script>
                        document.addEventListener('DOMContentLoaded', () => {
                          const bug = document.querySelector('.dicount_bug');
                          const tooltip = document.getElementById('discount-tooltip');

                          if (!bug || !tooltip) return;

                          let timeoutId = null;

                          function showTooltip(message, isSuccess = false) {
                            tooltip.textContent = message;
                            tooltip.classList.remove('success');
                            if (isSuccess) tooltip.classList.add('success');
                            tooltip.classList.add('show');

                            // Auto hide after 2 seconds
                            if (timeoutId) clearTimeout(timeoutId);
                            timeoutId = setTimeout(() => {
                              tooltip.classList.remove('show');
                            }, 2000);
                          }

                          bug.addEventListener('click', async (e) => {
                            const code = bug.getAttribute('data-discount-code') || bug.dataset.discountCode;

                            if (!code) return;

                            try {
                              await navigator.clipboard.writeText(code);
                              showTooltip('✓ Copied!', true);
                            } catch (err) {
                              console.error('Failed to copy:', err);
                              showTooltip('Failed to copy', false);
                            }
                          });

                          // Optional: Show tooltip on hover
                          bug.addEventListener('mouseenter', () => {
                            if (!tooltip.classList.contains('show')) {
                              tooltip.textContent = 'Click to copy discount code';
                              tooltip.classList.remove('success');
                              tooltip.classList.add('show');
                            }
                          });

                          bug.addEventListener('mouseleave', () => {
                            if (!tooltip.classList.contains('success')) {
                              tooltip.classList.remove('show');
                            }
                          });
                        });
                      </script>
