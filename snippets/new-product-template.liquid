{% if product.template_suffix == 'play-maker-plus' %}
  <style>
    .dicount_bug {
      position: relative;
      cursor: pointer;
          display: flex;
    }

    .discount-tooltip {
      position: absolute;
      background: #fff;
      color: var(--new-black);
      padding: 5px 10px;
      border-radius: 26px;
      font-size: 12px;
      white-space: nowrap;
      pointer-events: none;
      opacity: 0;
      visibility: hidden;           /* Added */
      transition: opacity 0.25s ease, visibility 0.25s ease;
      z-index: 1000;
      bottom: 100%;
      left: 50%;
      transform: translateX(-50%);
      margin-bottom: 8px;
    }

    .discount-tooltip.show {
      opacity: 1;
      visibility: visible;
    }

    .discount-tooltip.success {
      background: #28a745;
      color: #fff;
    }
  </style>

  <!-- Tooltip Element -->
  <div id="discount-tooltip" class="discount-tooltip"></div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const bug = document.querySelector('.dicount_bug');
      const tooltip = document.getElementById('discount-tooltip');

      if (!bug || !tooltip) return;

      let timeoutId = null;

      function showTooltip(message, isSuccess = false) {
        tooltip.textContent = message;
        tooltip.classList.remove('success');
        if (isSuccess) tooltip.classList.add('success');
        tooltip.classList.add('show');

        if (timeoutId) clearTimeout(timeoutId);
        timeoutId = setTimeout(() => {
          tooltip.classList.remove('show');
        }, 2000);
      }

      // Click to copy
      bug.addEventListener('click', async (e) => {
        const code = bug.getAttribute('data-discount-code') || bug.dataset.discountCode;
        if (!code) return;

        try {
          await navigator.clipboard.writeText(code);
          showTooltip('✓ Copied!', true);
        } catch (err) {
          console.error('Failed to copy:', err);
          showTooltip('Failed to copy', false);
        }
      });

      // Hover effect
      bug.addEventListener('mouseenter', () => {
        if (!tooltip.classList.contains('show')) {
          tooltip.textContent = 'Click to copy discount code';
          tooltip.classList.remove('success');
          tooltip.classList.add('show');
        }
      });

      bug.addEventListener('mouseleave', () => {
        if (!tooltip.classList.contains('success')) {
          tooltip.classList.remove('show');
        }
      });
    });
  </script>
{% endif %}
