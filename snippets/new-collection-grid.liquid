<script>
  (function ($) {
    function getVariantId($card) {
      var $checked = $card.find('[data-quick-add-swatches] input[type="radio"]:checked');
      if ($checked.length) return $checked.val();

      var $select = $card.find('select[data-quick-add-select]');
      if ($select.length) return $select.val();

      var hiddenVal = $card.find('[data-quick-add-form] input[name="id"]').val();
      return hiddenVal || null;
    }

    // --- IMPORTANT: remove only our handlers, then re-add ---
    $(document).off('change.quickadd', '[data-quick-add-swatches] input[type="radio"]');
    $(document).off('change.quickadd', 'select[data-quick-add-select]');
    $(document).off('click.quickadd', '.quick-add-btn');

    $(document).on('change.quickadd', '[data-quick-add-swatches] input[type="radio"]', function () {
      var $card = $(this).closest('.product-grid-item, .grid-product, .product-card');
      var vid = $(this).val();
      $card.find('[data-quick-add-form] input[name="id"]').val(vid);
      $card.find('.quick-add-btn').prop('disabled', $(this).is(':disabled'));
    });

    $(document).on('change.quickadd', 'select[data-quick-add-select]', function () {
      var $select = $(this);
      var $card = $select.closest('.product-grid-item, .grid-product, .product-card');
      var vid = $select.val();

      $card.find('[data-quick-add-form] input[name="id"]').val(vid);

      var isDisabled = $select.find('option:selected').prop('disabled');
      $card.find('.quick-add-btn').prop('disabled', !!isDisabled);
    });

    $(document).on('click.quickadd', '.quick-add-btn', function (e) {
      // Stop other click handlers from also firing
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();

      var $btn = $(this);

      // In-flight guard: prevents double submit from fast clicks or duplicate events
      if ($btn.data('quickaddBusy')) return;

      var $card = $btn.closest('.product-grid-item, .grid-product, .product-card');
      var variantId = getVariantId($card);
      if (!variantId) {
        console.error('Quick add: missing variant id');
        return;
      }

      $btn.data('quickaddBusy', true);
      $btn.addClass('btn--loading').prop('disabled', true);

      $.ajax({
        type: 'POST',
        url: '/cart/add.js',
        dataType: 'json',
        contentType: 'application/json',
        data: JSON.stringify({ id: Number(variantId), quantity: 1 }),
        success: function () {
          document.dispatchEvent(new CustomEvent('ajaxProduct:added', { detail: {} }));
        },
        error: function (xhr) {
          console.error(xhr.responseJSON?.description || 'Add to cart failed');
        },
        complete: function () {
          $btn.data('quickaddBusy', false);
          $btn.removeClass('btn--loading is-loading').prop('disabled', false);
        },
      });
    });
  })(jQuery);
</script>
