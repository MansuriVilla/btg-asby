{%- assign has_h1 = false -%}
{%- if captured_content contains '<h1' or captured_content contains '<H1' -%}
  {%- assign has_h1 = true -%}
{%- endif -%}
{%- unless has_h1 -%}
  {%- if request.path contains 'pages' and page.metafields.custom.seo_title_h1_tag != blank -%}
    <h1 class="visually-hidden custom_h1_tag">{{ page.metafields.custom.seo_title_h1_tag }}</h1>
  {%- endif -%}
  {%- if request.path contains 'collections' and collection.metafields.custom.seo_title_h1 != blank -%}
    <h1 class="visually-hidden custom_h1_tag">{{ collection.metafields.custom.seo_title_h1 }}</h1>
  {%- endif -%}
  {%- if template.name == 'index' -%}
    <h1 class="visually-hidden custom_h1_tag">
      Smart Golf Technology — Rangefinders, GPS Speakers & More By Blue Tees Golf
    </h1>
  {%- endif -%}
{%- endunless -%}