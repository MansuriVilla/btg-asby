<div
  id="Sublinklist-hats"
  aria-labelledby="Sublabel-hats"
  class="mobile-nav__sublist collapsible-content collapsible-content--all">
    <div class="collapsible-content__inner">
        {%- for block in section.blocks -%}
             {%- if block.type == 'menudropdown' -%}
                      {% if block.settings.tab_7_title == 'HATS' %}                             
                            
                                <div class="three-product-list">
                                      	
                                      {% if block.settings.tb7_product_1_icon != blank %}
                                            <div class="single-product">
                                                {%- assign product_19 = all_products[block.settings.tb7_product_1] -%}

                                                <a href=" {{ product_19.url | within: collection }}">
                                                    {% if block.settings.tb7_product_1_icon != blank %}
                                                        <div class="icon"> <img src="{{ block.settings.tb7_product_1_icon | img_url: 'master' }}" alt="{{ block.settings.tb7_product_1_icon.alt | img_alt: 'master' }}"></div>
                                                    {% endif %}

                                                    {% if block.settings.tb7_product_1_title != blank %}
                                                        <h3>{{ block.settings.tb7_product_1_title }}</h3>
                                                    {% endif %}
                                                </a>


                                                {% if product_19 != blank %}                                            	
                                                    <div class="product-price">
                                                        <div class="main-price">
                                                            {{ product_19.price | money }}
                                                        </div>


                                                        {% if product_19.price < product_19.compare_at_price_max %}
                                                          <div class="old-price">
                                                              {{  product_19.compare_at_price_max | money }}
                                                          </div>
                                                        {% endif %}
                                                    </div>                                      			
                                                {% endif %}

                                                {% if product_19 != blank %}  
                                                  <div class="product-btn">
                                                    <div class="left-btn"><a href="{{ product_19.url | within: collection }}">Learn more</a></div>
                                                    <div class="right-btn"><a href="{{ product_19.url | within: collection }}">Buy now</a></div>
                                                  </div>
                                                {% endif %}

                                                 {% if block.settings.tb7_product_1_image != blank %}
                                                        <div class="bottom-image">
                                                            <a href="{{ product_19.url | within: collection }}">
                                                                <img src="{{ block.settings.tb7_product_1_image | img_url: 'master' }}" alt="{{ block.settings.tb7_product_1_image.alt | img_alt: 'master' }}">
                                                            </a>
                                                        </div>
                                                 {% endif %}	
                                            </div>
                                      	{% endif %}
                                      
                                      	{% if block.settings.tb7_product_2_icon != blank %}
                                            <div class="single-product">
                                                {%- assign product_20 = all_products[block.settings.tb7_product_2] -%}

                                                <a href=" {{ product_20.url | within: collection }}">
                                                    {% if block.settings.tb7_product_2_icon != blank %}
                                                        <div class="icon"> <img src="{{ block.settings.tb7_product_2_icon | img_url: 'master' }}" alt="{{ block.settings.tb7_product_2_icon.alt | img_alt: 'master' }}"></div>
                                                    {% endif %}

                                                    {% if block.settings.tb7_product_2_title != blank %}
                                                        <h3>{{ block.settings.tb7_product_2_title }}</h3>
                                                    {% endif %}
                                                </a>


                                                {% if product_20 != blank %}                                            	
                                                    <div class="product-price">
                                                        <div class="main-price">
                                                            {{ product_20.price | money }}
                                                        </div>


                                                        {% if product_20.price < product_20.compare_at_price_max %}
                                                          <div class="old-price">
                                                              {{  product_20.compare_at_price_max | money }}
                                                          </div>
                                                        {% endif %}
                                                    </div>                                      			
                                                {% endif %}

                                                {% if product_20 != blank %}  
                                                  <div class="product-btn">
                                                    <div class="left-btn"><a href="{{ product_20.url | within: collection }}">Learn more</a></div>
                                                    <div class="right-btn"><a href="{{ product_20.url | within: collection }}">Buy now</a></div>
                                                  </div>
                                                {% endif %}

                                                 {% if block.settings.tb7_product_2_image != blank %}
                                                        <div class="bottom-image">
                                                            <a href="{{ product_20.url | within: collection }}">
                                                                <img src="{{ block.settings.tb7_product_2_image | img_url: 'master' }}" alt="{{ block.settings.tb7_product_2_image.alt | img_alt: 'master' }}">
                                                            </a>
                                                        </div>
                                                 {% endif %}	
                                            </div>
                                      	{% endif %}	
                                      
                                      	{% if block.settings.tb7_product_3_icon != blank %}
                                            <div class="single-product">
                                                {%- assign product_21 = all_products[block.settings.tb7_product_3] -%}
                                            
                                                <a href=" {{ product_21.url | within: collection }}">
                                                    {% if block.settings.tb7_product_3_icon != blank %}
                                                        <div class="icon"> <img src="{{ block.settings.tb7_product_3_icon | img_url: 'master' }}" alt="{{ block.settings.tb7_product_3_icon.alt | img_alt: 'master' }}"></div>
                                                    {% endif %}

                                                    {% if block.settings.tb7_product_3_title != blank %}
                                                        <h3>{{ block.settings.tb7_product_3_title }}</h3>
                                                    {% endif %}
                                                </a>


                                                {% if product_21 != blank %}                                            	
                                                    <div class="product-price">
                                                        <div class="main-price">
                                                            {{ product_21.price | money }}
                                                        </div>


                                                        {% if product_21.price < product_21.compare_at_price_max %}
                                                          <div class="old-price">
                                                              {{  product_21.compare_at_price_max | money }}
                                                          </div>
                                                        {% endif %}
                                                    </div>                                      			
                                                {% endif %}

                                                {% if product_21 != blank %}  
                                                  <div class="product-btn">
                                                    <div class="left-btn"><a href="{{ product_21.url | within: collection }}">Learn more</a></div>
                                                    <div class="right-btn"><a href="{{ product_21.url | within: collection }}">Buy now</a></div>
                                                  </div>
                                                {% endif %}

                                                 {% if block.settings.tb7_product_3_image != blank %}
                                                        <div class="bottom-image">
                                                            <a href="{{ product_21.url | within: collection }}">
                                                                <img src="{{ block.settings.tb7_product_3_image | img_url: 'master' }}" alt="{{ block.settings.tb7_product_3_image.alt | img_alt: 'master' }}">
                                                            </a>
                                                        </div>
                                                 {% endif %}	
                                            </div>
                                      {% endif %}
                                  	</div>
                            
                        
                        {% endif %}
                 
            {%- endif -%}
        {%- endfor -%}
    </div>
</div>