.am-main_slider-img .am-slide_item { width: 100%; transition: 0.5s ease; object-fit: cover; opacity: 0; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: #000; }
.am-main_slider-img .am-slide_item.active { opacity: 1; z-index: 20; }
.progress_bar-slider svg>*, .progress_bar-slider svg { width: 100%; }
.am-slide_item .btn.extra_bright-cta { background-color: #CB0000; border-radius: 7px; color: #fff; letter-spacing: 1.6px; font-size: 18px; font-weight: 900; max-width: 271px; width: 100%; }
.am-slide_item .btn.extra_bright-cta:hover { background-color: #004DF5 !important; }
.am-main_slider-img .am-slide_item .am-slider_item-inner { display: flex; justify-content: space-between; align-items: center; width: 100%; height: 100%; max-width: 1660px; column-gap: clamp(20px, 3vw, 54px); }
.am-slider_item-left, .am-slider_item-right { flex: 67%; display: flex; justify-content: center; align-items: center; height: 100%; }
.am-main_slider-img .am-slide_item .am-slider_item-left .offer-tag_text { color: #ff002e; font-weight: 900; letter-spacing: 1.6px; }
.am-slider_item-left .offer-price_area-inner .offer-price-area-inner-left p:not(.Offer_Bug-Container) { padding: 0px; }
.am-main_slider-img .am-slide_item .slash-out_price { color: #fff; font-size: clamp(18px, 2.2vw, 38px); width: fit-content; margin: 0 0 0 auto; font-style: italic; opacity: 0.5; }
.am-main_slider-img .am-slide_item .offer-price-area-inner-right p { font-size: clamp(30px, 4.2vw, 62px); font-weight: 900; font-style: italic; line-height: 0.7; padding: 0; letter-spacing: -2px; color: #fff; }
.am-main_slider-img .am-slide_item .offer-price-area-inner-right p.has_stroke { -webkit-text-stroke-width: 1.21px; -webkit-text-stroke-color: #fff; }
.am-main_slider-img .am-slide_item .offer-price-area-inner-right p.extra_small-text { font-size: 11px; letter-spacing: 11.31px; font-style: inherit; }
