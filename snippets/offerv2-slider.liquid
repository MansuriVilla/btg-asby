/* SLIDER CSS START  */
   
.am-main_slider-container { position: relative; max-width: 100vw; height: clamp(700px, 50vw, 100vh) !important; max-height:990px; display: flex; align-items: center; justify-content: center; flex-direction: column; overflow: hidden; background: #fff; }
