<script type="text/javascript">
  $(document).ready(function() {

    $(document).on('click', '[data-add-to-cart-reminder]', function(e) {
      const atcButton = $(this);
      const form = atcButton.closest('form');

      if (form.data('skip-popup')) {
        return;
      }

      e.preventDefault();
      e.stopPropagation();

      const checkbox1mo       = $('#1month-membership-free');
      const checkbox6mo       = $('#6month-free-premium-product');
      const checkboxRainmaker = $('#rainmakerPreOrderUpsell');
      const caseCheckbox      = $('#playmaker-hard-new-case, #player-pro-hard-case-upsell');

      const knownMembershipIds = [46056795209925, 46056776990917, 45793869299909];
      const mainVariantId = form.find('input[name="id"]').val() || form.find('select[name="id"]').val();

      atcButton.addClass('btn--loading');

      $.getJSON('/cart.js?_=' + Date.now(), function(cart) {
        let currentProductMembershipId = null;
        if (checkbox1mo.length) {
          currentProductMembershipId = 46056795209925;
        } else if (checkbox6mo.length) {
          currentProductMembershipId = 46056776990917;
        } else if (checkboxRainmaker.length) {
          currentProductMembershipId = 45793869299909;
        }

        let hasCurrentMembershipInCart = false;
        if (cart && cart.items && cart.items.length && currentProductMembershipId) {
          hasCurrentMembershipInCart = cart.items.some(function(item) {
            return parseInt(item.variant_id) === parseInt(currentProductMembershipId);
          });
        }

        const isMembershipCheckboxChecked = (checkbox1mo.length && checkbox1mo.is(':checked')) ||
                                            (checkbox6mo.length && checkbox6mo.is(':checked')) ||
                                            (checkboxRainmaker.length && checkboxRainmaker.is(':checked'));

        if (hasCurrentMembershipInCart) {
          if (isMembershipCheckboxChecked) {
            // User explicitly checked the membership checkbox on page — trigger membership alert
            let mId = null;
            let mPlan = null;
            if (checkbox1mo.is(':checked')) {
              mId   = 46056795209925;
              mPlan = 7328694469;
            } else if (checkbox6mo.is(':checked')) {
              mId   = 46056776990917;
              mPlan = 7328661701;
            } else if (checkboxRainmaker.is(':checked')) {
              mId   = 45793869299909;
              mPlan = 6775537861;
            }

            addToCartWithMembership(
              mainVariantId,
              mId,
              mPlan,
              function() { atcButton.removeClass('btn--loading'); },
              function() { atcButton.removeClass('btn--loading'); }
            );
          } else {
            // Unchecked on page & current membership already in cart — silently bypass popup and add main product (+ case)
            addToCartWithMembership(
              mainVariantId,
              null,
              null,
              function() { atcButton.removeClass('btn--loading'); },
              function() { atcButton.removeClass('btn--loading'); }
            );
          }
          return;
        }

        if (checkbox1mo.length && !checkbox1mo.is(':checked')) {
          atcButton.removeClass('btn--loading');
          openReminderPopup('#one_month_popup', form, atcButton);
          return;
        }
        if (checkbox6mo.length && !checkbox6mo.is(':checked')) {
          atcButton.removeClass('btn--loading');
          openReminderPopup('#six_month_popup', form, atcButton);
          return;
        }
        if (checkboxRainmaker.length && !checkboxRainmaker.is(':checked')) {
          atcButton.removeClass('btn--loading');
          openReminderPopup('#one_year_popup', form, atcButton);
          return;
        }

        let membershipId = null;
        let membershipPlan = null;

        if (checkbox1mo.is(':checked')) {
          membershipId   = 46056795209925;
          membershipPlan = 7328694469;
        } else if (checkbox6mo.is(':checked')) {
          membershipId   = 46056776990917;
          membershipPlan = 7328661701;
        } else if (checkboxRainmaker.is(':checked')) {
          membershipId   = 45793869299909;
          membershipPlan = 6775537861;
        }

        addToCartWithMembership(
          mainVariantId,
          membershipId,
          membershipPlan,
          function() { atcButton.removeClass('btn--loading'); },
          function() { atcButton.removeClass('btn--loading'); }
        );
      }).fail(function() {
        atcButton.removeClass('btn--loading');
      });

      return false;
    });

    function openReminderPopup(popupId, form, atcButton) {
      const popup = $(popupId);
      popup.data('active-form', form);
      popup.data('active-button', atcButton);
      popup.css('display', 'flex').hide().fadeIn(300, function() {
        popup.attr('tabindex', '-1').trigger('focus');
        trapFocus(popup);
      });
    }

    function trapFocus(popup) {
      popup.off('keydown.trapFocus');
      popup.on('keydown.trapFocus', function(e) {
        if (e.key !== 'Tab') return;
        const focusableSelectors = 'a[href], area[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), button:not([disabled]), iframe, object, embed, [tabindex="0"], [contenteditable]';
        const focusableElements = popup.find(focusableSelectors).filter(':visible');
        if (!focusableElements.length) return;
        const firstElement = focusableElements.first();
        const lastElement = focusableElements.last();
        if (e.shiftKey) { // Shift + Tab
          if (document.activeElement === firstElement[0] || document.activeElement === popup[0]) {
            lastElement.focus();
            e.preventDefault();
          }
        } else { // Tab
          if (document.activeElement === lastElement[0]) {
            firstElement.focus();
            e.preventDefault();
          }
        }
      });
    }

    function untrapFocus(popup) {
      popup.off('keydown.trapFocus');
    }

    function addToCartWithMembership(mainVariantId, membershipId, membershipPlan, onSuccess, onError) {

      console.log('=== addToCartWithMembership ===');
      console.log('mainVariantId:', mainVariantId);
      console.log('membershipId:', membershipId);
      console.log('membershipPlan:', membershipPlan);

      $.getJSON('/cart.js?_=' + Date.now(), function(cart) {

        let membershipExists = false;
        if (membershipId) {
          membershipExists = cart.items.some(function(item) {
            return parseInt(item.variant_id) === parseInt(membershipId);
          });
        }

        if (membershipExists) {
          alert('Membership is already in the cart');
          // close the popup
          var $popup = $('.upsell_popup--new:visible');
          var atcButton = $popup.data('active-button');
          untrapFocus($popup);
          $popup.fadeOut(200, function() {
            $popup.css('display', 'none');
            $popup.removeData('active-form');
            $popup.removeData('active-button');
            if (atcButton) {
              atcButton.trigger('focus');
            }
          });
          if (onError) onError();
          return;
        }
        const items = [];

        if (mainVariantId) {
          items.push({ id: parseInt(mainVariantId), quantity: 1 });
        }

        if (membershipId) {
          items.push({
            id:           parseInt(membershipId),
            quantity:     1,
            selling_plan: parseInt(membershipPlan)
          });
        }

        // Helper function to send items to cart
        function sendCartRequest() {
          console.log('Items being sent to cart:', JSON.stringify(items));
          fetch('/cart/add.js', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ items: items })
          })
          .then(function(response) {
            if (!response.ok) {
              return response.json().then(function(err) {
                console.error('Cart error response:', err);
                throw new Error(err.description || 'Cart error');
              });
            }
            return response.json();
          })
          .then(function(data) {
            console.log('Successfully added to cart:', data);
            if (onSuccess) onSuccess();
            document.dispatchEvent(new CustomEvent('ajaxProduct:added', { detail: {} }));
          })
          .catch(function(error) {
            console.error('Error adding products:', error);
            alert('There was an issue adding to the cart: ' + error.message);
            if (onError) onError();
          });
        }

        // Check if secondary upsell checkbox (playmaker or player-pro hard case) is checked
        const checkedCaseCheckbox = $('#playmaker-hard-new-case, #player-pro-hard-case-upsell').filter(':checked');
        if (checkedCaseCheckbox.length) {
          let caseVariantId = checkedCaseCheckbox.val() || checkedCaseCheckbox.attr('data-variant-id');
          if (caseVariantId && !isNaN(parseInt(caseVariantId))) {
            items.push({ id: parseInt(caseVariantId), quantity: 1 });
            sendCartRequest();
          } else {
            // Dynamically fetch product JSON if variant ID was not rendered in Liquid
            const isPlayerProCase = checkedCaseCheckbox.attr('id') === 'player-pro-hard-case-upsell';
            const primaryUrl = isPlayerProCase ? '/products/player-hard-shell-carrying-case.js' : '/products/playmaker-watch-case-black.js';
            const fallbackUrl = isPlayerProCase ? '/products/player-hard-shell-carrying-case.js' : '/products/watch-hard-shell-carrying-case.js';

            fetch(primaryUrl)
              .then(function(res) {
                if (res.ok) return res.json();
                return fetch(fallbackUrl).then(function(r) { return r.json(); });
              })
              .then(function(pData) {
                if (pData && pData.variants && pData.variants.length) {
                  items.push({ id: parseInt(pData.variants[0].id), quantity: 1 });
                }
                sendCartRequest();
              })
              .catch(function(err) {
                console.error('Error fetching case product json:', err);
                sendCartRequest();
              });
            return;
          }
        } else {
          sendCartRequest();
        }
      });
    }

    function claimOfferAndSubmit(popupId, claimButton) {
      const popup = $(popupId);

      if (!popup.length) {
        console.error('Popup not found:', popupId);
        return;
      }

      const form = popup.data('active-form');
      const btn  = popup.find('.upshell-popup-button');

      btn.addClass('btn--loading');

      // PRIORITY 1: grab from the clicked button's data-product-id
      let mainVariantId = claimButton ? $(claimButton).data('product-id') : null;

      // PRIORITY 2: fall back to the popup's data-main-product-id attribute
      if (!mainVariantId) {
        mainVariantId = popup.attr('data-main-product-id');
      }

      // PRIORITY 3: fall back to the stored form
      if (!mainVariantId && form) {
        mainVariantId = form.find('input[name="id"]').val() || form.find('select[name="id"]').val();
      }

      console.log('Popup:', popupId);
      console.log('Main variant ID:', mainVariantId);

      let membershipId   = null;
      let membershipPlan = null;

      if (popupId === '#one_month_popup') {
        membershipId   = 46056795209925;
        membershipPlan = 7328694469;
      } else if (popupId === '#six_month_popup') {
        membershipId   = 46056776990917;
        membershipPlan = 7328661701;
      } else if (popupId === '#one_year_popup') {
        membershipId   = 45793869299909;
        membershipPlan = 6775537861;
      }

      addToCartWithMembership(
        mainVariantId,
        membershipId,
        membershipPlan,
        function() {
          btn.removeClass('btn--loading');
          const atcButton = popup.data('active-button');
          untrapFocus(popup);
          popup.fadeOut(200, function() {
            popup.css('display', 'none');
            popup.removeData('active-form');
            popup.removeData('active-button');
            if (atcButton) {
              atcButton.trigger('focus');
            }
          });
        },
        function() {
          btn.removeClass('btn--loading');
        }
      );
    }

    function closeReminderPopupAndSubmit(popupId, claim, claimButton) {
      if (claim) {
        claimOfferAndSubmit(popupId, claimButton);
        return;
      }

      const popup     = $(popupId);
      const form      = popup.data('active-form');
      const atcButton = popup.data('active-button');

      untrapFocus(popup);
      popup.removeData('active-form');
      popup.removeData('active-button');

      popup.fadeOut(200, function() {
        popup.css('display', 'none');
        if (atcButton) {
          atcButton.trigger('focus');
        }

        if (form && atcButton) {
          // Get main variant ID from the stored form
          const mainVariantId = form.find('input[name="id"]').val() || form.find('select[name="id"]').val();

          atcButton.addClass('btn--loading');

          // Add main product (+ case if checked) but NO membership
          addToCartWithMembership(
            mainVariantId,
            null,
            null,
            function() { atcButton.removeClass('btn--loading'); },
            function() { atcButton.removeClass('btn--loading'); }
          );
        }
      });
    }

    // Close / background click — ignore clicks from the claim button
    $(document).on('click', '.upsell_popup--new .close, .upsell_popup--new .closePop, .upsell_popup--new', function(e) {
      if ($(e.target).closest('.upshell-popup-button').length) return;
      if ($(this).hasClass('upsell_popup--new') && e.target !== this) return;
      e.preventDefault();
      const popupId = '#' + $(this).closest('.upsell_popup--new').attr('id');
      closeReminderPopupAndSubmit(popupId, false, null);
    });

    // Claim offer button inside popup — pass the button element through
    $(document).on('click', '.upsell_popup--new .upshell-popup-button', function(e) {
      e.preventDefault();
      const popupId = '#' + $(this).closest('.upsell_popup--new').attr('id');
      closeReminderPopupAndSubmit(popupId, true, this);
    });

  });
</script>