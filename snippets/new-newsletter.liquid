{%- form 'customer',
  id: 'newsletter-footer-second',
  class: 'contact-form newsletter-accessible-form'
-%}

  {%- if form.posted_successfully? -%}
    <div
      class="note note--success"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      {{ 'general.newsletter_form.newsletter_confirmation' | t }}
    </div>
  {%- endif -%}

  {%- if form.context == 'footer' and form.errors -%}
    <div
      class="note note--error"
      role="alert"
      aria-live="assertive"
      aria-atomic="true"
    >
      {{ form.errors | default_errors }}
    </div>
  {%- endif -%}


  <label
    for="Email-second"
    class="hidden-label"
  >
    {{ 'general.newsletter_form.newsletter_email' | t }}
  </label>


  <input
    type="hidden"
    name="contact[tags]"
    value="prospect,newsletter"
  >

  <input
    type="hidden"
    name="contact[context]"
    value="footer"
  >


  <div class="signup-form">

    <input
      type="email"
      value="{% if customer %}{{ customer.email | escape }}{% endif %}"
      placeholder="{{ 'general.newsletter_form.newsletter_email' | t }}"
      name="contact[email]"
      id="Email-second"
      class="footer-signup-input"
      autocorrect="off"
      autocapitalize="off"
      autocomplete="email"
      aria-describedby="newsletter-error-second"
      required
    >


    <button
      type="submit"
      class="signup-form-btn"
      name="commit"
      aria-label="{{ 'general.newsletter_form.submit' | t }}"
    >
      <span>
        SUBSCRIBE
      </span>
    </button>

  </div>


  <div
    id="newsletter-error-second"
    class="newsletter-client-error"
    role="alert"
    aria-live="assertive"
    aria-atomic="true"
    hidden 
  ></div>

{%- endform -%}