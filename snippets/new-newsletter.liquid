<div class="newsletter-signup">
  <form class="klaviyo-newsletter-form" novalidate>

    <label class="hidden-label">
      Email address
    </label>

    <input
      type="email"
      class="klaviyo-email"
      name="email"
      placeholder="Enter your email"
      autocomplete="email"
      required
      aria-required="true"
    >

    <button type="submit" class="klaviyo-submit">
      Subscribe
    </button>

    <div
      class="klaviyo-message"
      aria-live="polite"
      aria-atomic="true"
    ></div>

  </form>
</div>