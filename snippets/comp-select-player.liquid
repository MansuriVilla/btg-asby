{% comment %}
  Component: comp-select-player
  Product-picker cards. The card whose product matches the current PDP is selected;
  the others link to their own PDP.
  Usage:
  {% render 'comp-select-player', block: block, current_product: product %}
  Block settings: heading, product_1..3, sub_1..3 (optional subtitle overrides)
{% endcomment %}

{% liquid
  assign sp_heading = block.settings.heading | default: 'Select a Player'
  assign picks = 'product_1,product_2,product_3' | split: ','
%}

<div class="comp-select-player" {{ block.shopify_attributes }}>
  <h2 class="comp-select-player__heading">{{ sp_heading }}</h2>

  <div class="comp-select-player__list" role="list">
    {% for key in picks %}
      {% liquid
        assign p = block.settings[key]
        assign sub_key = key | replace: 'product_', 'sub_'
        assign sub_override = block.settings[sub_key]
      %}
      {% if p != blank %}
        {% liquid
          assign v = p.selected_or_first_available_variant
          assign is_current = false
          if p.id == current_product.id
            assign is_current = true
          endif
          assign sub_text = sub_override
          if sub_text == blank
            assign sub_text = p.description | strip_html | truncate: 48
          endif
          assign p_price = v.price | default: p.price
          assign p_compare = v.compare_at_price | default: p.compare_at_price
          assign is_sale = false
          if p_compare > p_price
            assign is_sale = true
          endif
        %}
        <a
          href="{{ p.url }}"
          class="comp-select-player__card{% if is_current %} is-selected{% endif %}"
          role="listitem"
          {% if is_current %}aria-current="page"{% endif %}
        >
          <span class="comp-select-player__thumb">
            {% if p.featured_image %}
              {{ p.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80,160', alt: p.title }}
            {% endif %}
          </span>
          <span class="comp-select-player__info">
            <span class="comp-select-player__name">{{ p.title }}</span>
            <span class="comp-select-player__sub">{{ sub_text }}</span>
            <span class="comp-select-player__price{% if is_sale %} is-on-sale{% endif %}">
              <strong>{{ p_price | money_without_trailing_zeros }}</strong>
              {% if is_sale %}
                <s class="custom_body-text">{{ p_compare | money_without_trailing_zeros }}</s>
              {% endif %}
            </span>
          </span>
          <span class="comp-select-player__check" aria-hidden="true">
            <svg width="12" height="9" viewBox="0 0 12 9" fill="none"><path d="M1.5 4.5L4.5 7.5L10.5 1.5" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

<style>
  .comp-select-player {
    width: 100%;
    margin-top: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 1.1vw, 14px);
  }
  .comp-select-player__heading {
    margin: 0;
    font-family: 'Blue Tees Headline Italic', sans-serif;
    font-size: clamp(14px, 1.1vw, 16px);
    line-height: 1.5;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1B1E22;
  }
  .comp-select-player__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }
  .comp-select-player__card {
    position: relative;
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
    padding: 0;
    width: 100%;
    min-height: clamp(84px, 6.5vw, 91px);
    border: 1px solid #D9D9D9;
    border-radius: 10px;
    background: #FFFFFF;
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .comp-select-player__card.is-selected {
    background: linear-gradient(0deg, rgba(1, 73, 227, 0.05), rgba(1, 73, 227, 0.05)), #FFFFFF;
    border: 1.5px solid #0149E3;
  }
  .comp-select-player__thumb {
    flex: none;
    flex-shrink: 0;
    width: clamp(80px, 6vw, 89px);
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .comp-select-player__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .comp-select-player__info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 14px 0px;
    padding-right: 42px;
    gap: 4px;
    flex: 1;
    min-width: 0;
  }
  .comp-select-player__name {
    font-family: 'Blue Tees Headline Italic', sans-serif;
    font-size: 14px;
    line-height: 1.1;
    text-transform: uppercase;
    color: #1B2029;
    opacity: 0.95;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
  }
  .comp-select-player__sub {
    font-family: 'Blue Tees Paragraph', sans-serif;
    font-size: 14px;
    line-height: 1.5;
    color: #4F4F4F;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
  }
  .comp-select-player__price {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    line-height: 1.5;
  }
  .comp-select-player__price strong {
    font-family: 'Blue Tees Subhead', sans-serif;
    font-size: 14px;
    line-height: 1.5;
    display: flex;
    align-items: center;
    color: #1B2029;
  }
  .comp-select-player__price.is-on-sale strong {
    color: #CB0000;
  }
  .comp-select-player__price s.custom_body-text span.money{ font-family: 'Blue Tees Paragraph';}
  .comp-select-player__price s {
    font-size: 14px;
    line-height: 1.5;
    display: flex;
    align-items: center;
    text-decoration-line: line-through;
    color: #9EA3B1;
  }
  .comp-select-player__check {
    box-sizing: border-box;
    position: absolute;
    width: 24px;
    height: 24px;
    right: 9px;
    top: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 100px;
    background: #FFFFFF;
    border: 1px solid #D9D9D9;
    flex: none;
    z-index: 2;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .comp-select-player__check svg {
    opacity: 0;
    width: 11px;
    height: 8px;
    transition: opacity 0.15s ease;
  }
  .comp-select-player__card.is-selected .comp-select-player__check {
    background: #0149E3;
    border: none;
  }
  .comp-select-player__card.is-selected .comp-select-player__check svg {
    opacity: 1;
  }
</style>
