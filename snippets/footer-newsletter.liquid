{%- form 'customer',
  id: 'newsletter-footer-first',
  class: 'contact-form newsletter-accessible-form'
-%}

  {%- if form.posted_successfully? -%}
    <div
      class="note note--success"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
      {{ 'general.newsletter_form.newsletter_confirmation' | t }}
    </div>
  {%- endif -%}


  {%- if form.context == 'footer' and form.errors -%}
    <div
      class="note note--error"
      role="alert"
      aria-live="assertive"
      aria-atomic="true"
    >
      {{ form.errors | default_errors }}
    </div>
  {%- endif -%}


  <label
    for="Email-first"
    class="hidden-label"
  >
    {{ 'general.newsletter_form.newsletter_email' | t }}
  </label>


  <input
    type="hidden"
    name="contact[tags]"
    value="prospect,newsletter"
  >

  <input
    type="hidden"
    name="contact[context]"
    value="footer"
  >


  <div class="signup-form">

    <input
      type="email"
      value="{% if customer %}{{ customer.email | escape }}{% endif %}"
      placeholder="{{ 'general.newsletter_form.newsletter_email' | t }}"
      name="contact[email]"
      id="Email-first"
      class="footer-signup-input"
      autocorrect="off"
      autocapitalize="off"
      autocomplete="email"
      aria-describedby="newsletter-error-first"
      required
    >


    <button
      type="submit"
      class="signup-form-btn"
      name="commit"
      aria-label="{{ 'general.newsletter_form.submit' | t }}"
    >
      <span>
        {{ 'general.newsletter_form.submit' | t }}
      </span>
    </button>

  </div>


  <div
    id="newsletter-error-first"
    class="newsletter-client-error"
    role="alert"
    aria-live="assertive"
    aria-atomic="true"
    hidden
  ></div>


{%- endform -%}


<style>
  .newsletter-client-error {
    margin-top: 8px;
  }

  .newsletter-client-error[hidden] {
    display: none;
  }
</style>


<script>
(function () {

  document.addEventListener('submit', function (event) {

    var form = event.target;

    // Only validate newsletter forms
    if (
      !form ||
      !form.classList.contains('newsletter-accessible-form')
    ) {
      return;
    }

    var email = form.querySelector(
      'input[name="contact[email]"]'
    );

    var error = form.querySelector(
      '.newsletter-client-error'
    );

    if (!email || !error) {
      return;
    }

    var emailValue = email.value.trim();


    // -----------------------------
    // EMPTY EMAIL
    // -----------------------------

    if (emailValue === '') {

      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();

      email.setAttribute(
        'aria-invalid',
        'true'
      );

      // Reset error so screen readers
      // announce it again if necessary
      error.hidden = true;
      error.textContent = '';

      requestAnimationFrame(function () {

        error.textContent = "Email can't be blank.";
        error.hidden = false;

        email.focus();

      });

      return false;
    }


    // -----------------------------
    // INVALID EMAIL FORMAT
    // -----------------------------

    if (!email.validity.valid) {

      event.preventDefault();
      event.stopPropagation();
      event.stopImmediatePropagation();

      email.setAttribute(
        'aria-invalid',
        'true'
      );

      error.hidden = true;
      error.textContent = '';

      requestAnimationFrame(function () {

        error.textContent =
          'Please enter a valid email address.';

        error.hidden = false;

        email.focus();

      });

      return false;
    }


    // -----------------------------
    // VALID EMAIL
    // -----------------------------

    email.removeAttribute(
      'aria-invalid'
    );

    error.textContent = '';
    error.hidden = true;

    // Do NOT preventDefault here.
    // Allow Shopify to submit valid email.

  }, true);



  // ---------------------------------
  // CLEAR ERROR WHEN USER FIXES EMAIL
  // ---------------------------------

  document.addEventListener('input', function (event) {

    var email = event.target;

    if (
      !email.matches(
        '.newsletter-accessible-form input[name="contact[email]"]'
      )
    ) {
      return;
    }

    var form = email.closest(
      '.newsletter-accessible-form'
    );

    if (!form) {
      return;
    }

    var error = form.querySelector(
      '.newsletter-client-error'
    );

    if (!error) {
      return;
    }


    if (
      email.value.trim() !== '' &&
      email.validity.valid
    ) {

      email.removeAttribute(
        'aria-invalid'
      );

      error.textContent = '';
      error.hidden = true;

    }

  });

})();
</script>