
<div class="newsletter-signup">
  <form class="klaviyo-newsletter-form" novalidate>

    <label class="hidden-label">
      Email address
    </label>

    <input
      type="email"
      class="klaviyo-email"
      name="email"
      placeholder="Enter your email"
      autocomplete="email"
      required
      aria-required="true"
    >

    <button type="submit" class="klaviyo-submit">
      Subscribe
    </button>

    <div
      class="klaviyo-message"
      aria-live="polite"
      aria-atomic="true"
    ></div>

  </form>
</div>


<script>
document.addEventListener("DOMContentLoaded", function () {

  const KLAVIYO_COMPANY_ID = "LuhztW";
  const KLAVIYO_LIST_ID = "N4w9n8";

  async function subscribeToKlaviyo(email) {

    const response = await fetch(
      `https://a.klaviyo.com/client/subscriptions?company_id=${KLAVIYO_COMPANY_ID}`,
      {
        method: "POST",

        headers: {
          "Content-Type": "application/vnd.api+json",
          "revision": "2025-07-15"
        },

        body: JSON.stringify({
          data: {
            type: "subscription",

            attributes: {
              profile: {
                data: {
                  type: "profile",

                  attributes: {
                    email: email,

                    subscriptions: {
                      email: {
                        marketing: {
                          consent: "SUBSCRIBED"
                        }
                      }
                    }
                  }
                }
              }
            },

            relationships: {
              list: {
                data: {
                  type: "list",
                  id: KLAVIYO_LIST_ID
                }
              }
            }
          }
        })
      }
    );


    if (response.status !== 202) {

      let errorDetails = "";

      try {
        errorDetails = await response.text();
      } catch (error) {}

      console.error(
        "Klaviyo subscription failed:",
        response.status,
        errorDetails
      );

      throw new Error("Klaviyo subscription failed");
    }

    return true;
  }


  const forms = document.querySelectorAll(
    ".klaviyo-newsletter-form"
  );


  forms.forEach(function (form, index) {

    const emailInput = form.querySelector(
      ".klaviyo-email"
    );

    const submitButton = form.querySelector(
      ".klaviyo-submit"
    );

    const message = form.querySelector(
      ".klaviyo-message"
    );


    const emailId = "klaviyo-email-" + index;
    const messageId = "klaviyo-message-" + index;

    emailInput.id = emailId;
    message.id = messageId;

    emailInput.setAttribute(
      "aria-describedby",
      messageId
    );

    const label = form.querySelector("label");

    if (label) {
      label.setAttribute("for", emailId);
    }


    form.addEventListener(
      "submit",
      async function (event) {

        event.preventDefault();


        message.textContent = "";
        message.removeAttribute("role");

        emailInput.removeAttribute(
          "aria-invalid"
        );


        const email = emailInput.value.trim();

        if (!email) {

          emailInput.setAttribute(
            "aria-invalid",
            "true"
          );

          message.setAttribute(
            "role",
            "alert"
          );

          message.textContent =
            "Please enter your email address.";

          emailInput.focus();

          return;
        }


        if (!emailInput.validity.valid) {

          emailInput.setAttribute(
            "aria-invalid",
            "true"
          );

          message.setAttribute(
            "role",
            "alert"
          );

          message.textContent =
            "Please enter a valid email address.";

          emailInput.focus();

          return;
        }


        emailInput.removeAttribute(
          "aria-invalid"
        );

        submitButton.disabled = true;

        const originalButtonText =
          submitButton.textContent;

        submitButton.textContent =
          "Subscribing...";


        try {

          await subscribeToKlaviyo(email);


          message.setAttribute(
            "role",
            "status"
          );

          message.textContent =
            "Thanks for subscribing!";

          form.reset();


        } catch (error) {


          console.error(error);

          emailInput.setAttribute(
            "aria-invalid",
            "true"
          );

          message.setAttribute(
            "role",
            "alert"
          );

          message.textContent =
            "Unable to subscribe right now. Please try again.";

        } finally {

          submitButton.disabled = false;

          submitButton.textContent =
            originalButtonText;
        }

      }
    );

  });

});
</script>