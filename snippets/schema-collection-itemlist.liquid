{%- comment -%}
  Collection ItemList Schema Markup
{%- endcomment -%}

{%- liquid
  assign current_coll = target_collection | default: collection
  assign prod_list = target_products | default: current_coll.products
  assign start_pos = starting_position | default: 1
  assign id_suffix = schema_id_suffix | default: ''
  assign list_name = custom_title | default: current_coll.title
  if list_name == blank
    assign list_name = current_coll.title
  endif
-%}

{%- if current_coll != blank and prod_list.size > 0 -%}
  {%- liquid
    assign schema_total = current_coll.products_count | default: prod_list.size
    if id_suffix != blank
      assign schema_itemlist_id = canonical_url | append: '#' | append: id_suffix
    else
      assign schema_itemlist_id = canonical_url
    endif
  -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": {{ schema_itemlist_id | json }},
  "name": {{ list_name | json }},
  "description": {{ current_coll.description | default: page_description | default: current_coll.title | strip_html | strip | json }},
  "url": {{ canonical_url | json }},
  "numberOfItems": {{ schema_total }},
  "itemListElement": [
    {%- for product in prod_list -%}
      {%- assign selected_variant = product.selected_or_first_available_variant | default: product.variants.first -%}
      {%- assign item_position = start_pos | plus: forloop.index0 -%}
      {
        "@type": "ListItem",
        "position": {{ item_position }},
        "item": {
          "@type": "Product",
          "@id": {{ product.url | prepend: shop.url | json }},
          "url": {{ product.url | prepend: shop.url | json }},
          "name": {{ product.title | json }},
          "description": {{ product.description | strip_html | truncatewords: 60 | strip | json }},
          "image": {{ product.featured_image | image_url: width: 1800 | prepend: 'https:' | json }},
          "sku": {{ selected_variant.sku | default: product.id | json }},
          "brand": {
            "@type": "Brand",
            "name": {{ product.vendor | default: shop.name | json }}
          },
          "offers": {
            "@type": "Offer",
            "url": {{ product.url | prepend: shop.url | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "price": {{ selected_variant.price | divided_by: 100.00 | json }},
            "availability": {% if selected_variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
            "itemCondition": "https://schema.org/NewCondition",
            "seller": {
              "@type": "Organization",
              "@id": {{ shop.url | append: '/#organization' | json }}
            }
          }{%- if product.metafields.loox.num_reviews and product.metafields.loox.num_reviews != '0' and product.metafields.loox.num_reviews != 0 -%},
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": {{ product.metafields.loox.avg_rating | json }},
            "reviewCount": {{ product.metafields.loox.num_reviews | json }}
          }
          {%- endif -%}
        }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
