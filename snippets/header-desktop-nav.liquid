        <li
          class="site_header-link{% if product.handle contains gps_handle %} active{% endif %}"
          style="border-bottom: 0px;">
          <a href="/products/{{ gps_handle }}" class="nav_link nav_offer--link">GPS OFFER</a>
        </li>
        <li
          class="site_header-link{% if product.handle contains laser_handle %} active{% endif %}"
          style="border-bottom: 0px;">
          <a href="/products/{{ laser_handle }}" class="nav_link nav_offer--link">LASER OFFER</a>
        </li>
        {% if is_v2 == false %}
          <li
            class="site_header-link"
            style="border-bottom: 0px;">
            <span class="cta_pluse-pdp cta_pluse" style="--ripple-clr: #CB000080">
              <a
                href="/products/{{ special_link }}"
                class="nav_link nav_offer--link special__link "
                style="z-index:1; position:relative;"
                >3 BIGGER BUNDLES</a>
            </span>
          </li>
