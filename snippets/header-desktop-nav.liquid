{% if hover_effect %}
  <style>
    .project-hover-reveal {
      --ratio:100%;
      width: var(--ratio);
      height: var(--ratio);
      pointer-events: none;
      opacity: 0;
      z-index: 10;
      overflow: hidden;
      border-radius: 10px;
      visibility: hidden;
      will-change: transform, opacity;
      position: absolute;
      background:#E1E3E5;
    }

    .project-hover-reveal__inner {
      width: 100%;
      height: 100%;
      overflow: hidden;
      position: relative;
    }

    .project-hover-reveal__img {
      width: 100%;
      height: 100%;
      background-size: contain;
      background-repeat: no-repeat;
      background-position: center;
      transition: all 0.5s ease;
    }
    .project-list__mobile-img { display: none; }

    @media only screen and (max-width:991px){
      .project-list__mobile-img { display: flex; aspect-ratio: 1/0.9; height: 100%;  width: 100%; padding:12px; object-fit: cover; object-position: center center; background: #E1E3E5; border-radius: 12px;}

       .project-hover-reveal {
        display: none;
      }
    }
  </style>

  <script>
    function initProjectListAnimation() {
      // Only run on screens wider than 991px
      if (window.innerWidth <= 991) return;

      const projectList = document.querySelector('.hover_enable');
      const reveal = document.querySelector('.project-hover-reveal');
      const revealImg = document.querySelector('.project-hover-reveal__img');
      const items = document.querySelectorAll('.hover_enable--item');
      const banner = document.querySelector('.promo_banner_prod_render');
      

      if (!projectList || !reveal || !revealImg || items.length === 0) return;

      // Initial state for reveal
      {% comment %} gsap.set(reveal, { xPercent: 50, yPercent: -30 }); {% endcomment %}

      // Hint browser for performance
      reveal.style.willChange = 'transform, opacity';

      {% comment %} let xTo, yTo;

      if (gsap.quickTo) {
        xTo = gsap.quickTo(reveal, 'x', { duration: 0.5, ease: 'power2.out' });
        yTo = gsap.quickTo(reveal, 'y', { duration: 0.5, ease: 'power2.out' });
      } {% endcomment %}

      {% comment %} const moveReveal = (e) => {
        // Respect reduced motion preference
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        if (xTo && yTo) {
          xTo(e.clientX);
          yTo(e.clientY);
        } else {
          gsap.to(reveal, {
            x: e.clientX,
            y: e.clientY,
            duration: 0.5,
            ease: 'power2.out',
            overwrite: 'auto',
          });
        }
      }; {% endcomment %}

      {% comment %} projectList.addEventListener('mousemove', moveReveal); {% endcomment %}

      items.forEach((item) => {
        item.addEventListener('mouseenter', (e) => {
          const imgPath = item.getAttribute('data-img');
          
          banner.classList.add("hover_item")
          if (imgPath) {
            revealImg.style.backgroundImage = `url(${imgPath})`;
          }

          gsap.to(reveal, {
            autoAlpha: 1,
            {% comment %} scale: 1, {% endcomment %}
            duration: 0.3,
            ease: 'power2.out',
            overwrite: 'auto',
          });

          {% comment %} gsap.fromTo(revealImg, { scale: 1.2 }, { scale: 1, duration: 0.5, ease: 'power2.out', overwrite: true }); {% endcomment %}
        });

        item.addEventListener('mouseleave', () => {
          banner.classList.remove("hover_item")
          gsap.to(reveal, {
            autoAlpha: 0,
            {% comment %} scale: 0.8, {% endcomment %}
            duration: 0.3,
            ease: 'power2.out',
          });
        });
      });
    }
    initProjectListAnimation();
  </script>
{% endif %}
