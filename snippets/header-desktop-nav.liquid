<div class="site_flex site_header-content nav_left">
  <div class="menu-toggle" id="menuToggle">
    <img
      class="isMenu_close"
      src="{{ 'menu_icon-new-header.png' | asset_url }}"
      alt=" Menu icon ">
    <img
      class="isMenu_open"
      src="{{ 'menu_icon-new-header_close.png' | asset_url }}"
      alt=" Menu icon ">
  </div>
  <div class="site_header-left">
    <div class="header_logo">
      <a href="/" aria-label="Blue Tees logo Homepage">
        <picture>
          <source
            srcset="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/bluetees-logo-full-new.svg?v=1767964501"
            media="(min-width:992px)">
          <source
            srcset="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/bluetees-logo-full-new.svg?v=1767964501"
            media="(max-width:991px)">
          <img
            src="https://cdn.shopify.com/s/files/1/0057/8958/1381/files/bluetees-logo-full-new.svg?v=1767964501"
            alt="Blue Tees logo Homepage"
            height="100%"
            width="100%">
        </picture>
      </a>
    </div>
  </div>
  <span class="site_header__border"></span>
  <nav class="site_header-center menu_custom" data-lenis-prevent>
    {% if product.handle == 'speaker-bundle'
