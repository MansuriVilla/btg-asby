      or product.handle == 'ringer-gps-handheld-bundle-v2'
      or product.handle == 'series-4-ultra-bundle-v2'
    %}
      <ul class="site_header-links header__nav-offer">
        <li
          class="site_header-link{% if product.handle contains speaker_handle %} active{% endif %}"
          style="border-bottom: 0px;">
          <a href="/products/{{ speaker_handle }}" class="nav_link nav_offer--link">SPEAKER BUNDLE</a>
