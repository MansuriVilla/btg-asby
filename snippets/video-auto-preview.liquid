{% comment %} <div class="video_block video-preview video-preview__{{ page.handle }}" data-video-url="https://cdn.shopify.com/videos/c/o/v/a7076c30d83b4a36bb57f7920e982093.mp4" >
  <div class="loader" id="loader-1"></div>
  <video id="preview-video-1" class="preview-video" autoplay loop muted playsinline ></video>
  <div class="video_overlay-content play-button" id="play-button-1">
    <img id="video_block-icon-desktop" class="touch-screen_logo" src="{{'white-play-icon.png' | asset_url}}" alt="white-play-icon" />
  </div>
</div>

<div class="dialog-video-popup dialog-video-popup__{{ page.handle }}" id="dialog-video__1">
  <div class="popup-content" id="dialog-content__1">
    <button class="close-button" id="dialog-close__btn-1">
      <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" >
        <path d="M15 9L9 15M9 9L15 15M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <video class="full-video" id="dialog-full__video-1" controls preload="auto" data-video-behavior="restart"></video>
  </div>
</div> {% endcomment %}

{% comment %} 
{% comment %} Assigning unique index using timestamp and random number for uniqueness {% endcomment %}
{% assign timestamp = 'now' | date: '%s' %}
{% assign random = timestamp | modulo: 10000 | append: '' | split: '' | join: '' %}
{% assign video_index = 'video-' | append: timestamp | append: '-' | append: random %}

{% comment %} HTML structure for video preview and popup {% endcomment %}
<div class="video_block video-preview video-preview__{{ page.handle }}" data-video-url="{{ video_url }}" data-video-index="{{ video_index }}">
  <div class="loader" id="loader-{{ video_index }}"></div>
  <video id="preview-video-{{ video_index }}" class="preview-video" autoplay loop muted playsinline preload="auto"></video>
  <div class="video_overlay-content play-button" id="play-button-{{ video_index }}" data-video-index="{{ video_index }}">
    <img id="video_block-icon-desktop" class="touch-screen_logo" src="{{ 'white-play-icon.png' | asset_url }}" alt="white-play-icon" />
  </div>
</div>

<div class="dialog-video-popup dialog-video-popup__{{ page.handle }}" id="dialog-video__{{ video_index }}">
  <div class="popup-content" id="dialog-content__{{ video_index }}">
    <button class="close-button" id="dialog-close__btn-{{ video_index }}">
      <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M15 9L9 15M9 9L15 15M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <video class="full-video" id="dialog-full__video-{{ video_index }}" controls preload="auto" data-video-behavior="{{ video_behavior | default: 'restart' }}"></video>
  </div>
</div> {% endcomment %}