{%- if settings.cart_type == 'drawer' -%}
  <div id="CartDrawer" class="drawer drawer--right" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle">
    <form
      id="CartDrawerForm"
      action="{{ routes.cart_url }}"
      method="post"
      novalidate
      class="drawer__contents"
      data-lenis-prevent
    >
      <div class="drawer__fixed-header">
        <div class="drawer__header appear-animation appear-delay-1 cart_drawer_header">
          <h2 id="CartDrawerTitle" class="h2 drawer__title" tabindex="-1">
            {{ 'cart.general.title' | t -}}
            <img class="cart-icon" src="{{'cart-icon.png' | asset_url}}" alt="" aria-hidden="true">
          </h2>
          <div class="drawer__clear-cart">
            <button type="button" class="clear-all-cart">
              Clear all
              {% comment %} <span><svg fill="var(--new-red)" height="200px" width="200px" version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 458.5 458.5" xml:space="preserve" stroke="var(--new-red)"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g> <g> <g> <path d="M382.078,57.069h-89.78C289.128,25.075,262.064,0,229.249,0S169.37,25.075,166.2,57.069H76.421 c-26.938,0-48.854,21.916-48.854,48.854c0,26.125,20.613,47.524,46.429,48.793V399.5c0,32.533,26.467,59,59,59h192.508 c32.533,0,59-26.467,59-59V154.717c25.816-1.269,46.429-22.668,46.429-48.793C430.933,78.985,409.017,57.069,382.078,57.069z M229.249,30c16.244,0,29.807,11.673,32.76,27.069h-65.52C199.442,41.673,213.005,30,229.249,30z M354.503,399.501 c0,15.991-13.009,29-29,29H132.995c-15.991,0-29-13.009-29-29V154.778c12.244,0,240.932,0,250.508,0V399.501z M382.078,124.778 c-3.127,0-302.998,0-305.657,0c-10.396,0-18.854-8.458-18.854-18.854S66.025,87.07,76.421,87.07h305.657 c10.396,0,18.854,8.458,18.854,18.854S392.475,124.778,382.078,124.778z"></path> <path d="M229.249,392.323c8.284,0,15-6.716,15-15V203.618c0-8.284-6.715-15-15-15c-8.284,0-15,6.716-15,15v173.705 C214.249,385.607,220.965,392.323,229.249,392.323z"></path> <path d="M306.671,392.323c8.284,0,15-6.716,15-15V203.618c0-8.284-6.716-15-15-15s-15,6.716-15,15v173.705 C291.671,385.607,298.387,392.323,306.671,392.323z"></path> <path d="M151.828,392.323c8.284,0,15-6.716,15-15V203.618c0-8.284-6.716-15-15-15c-8.284,0-15,6.716-15,15v173.705 C136.828,385.607,143.544,392.323,151.828,392.323z"></path> </g> </g> </g> </g></svg></span> {% endcomment %}
            </button>
          </div>
          
          <div class="drawer__close">
            <button type="button" class="drawer__close-button js-drawer-close" aria-label="{{ 'cart.general.close_cart' | t }}">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64">
                <path d="M19 17.61l27.12 27.13m0-27.12L19 44.74"/>
              </svg>
              <span class="icon__fallback-text">{{ 'cart.general.close_cart' | t }}</span>
            </button>
          </div>
        </div>
      </div>

      {% assign limit = settings.limit | times: 100.0 %}
      {% assign diff_val = limit | minus: cart.total_price | money %}
      {% comment %} 
      <div class="discount-amout" data-limit="{{ settings.limit | times: 100 }}" data-text="{{ settings.limit_text }}" data-success-text="{{ settings.reached_text }}">
        <div class="ctm_offer_wall">
          <div class="ctm_offer_main_wrapper">
            <div class="offers" {% if cart.total_price >= limit %}style="display:none;"{% endif %}>{{ settings.limit_text | replace: '[amount]', diff_val | replace: '<span class=money>', '' | replace: '</span>', '' }}</div>
            <div class="ctm_success_message" {% if cart.total_price < limit %}style="display:none;"{% endif %}>
              <div class="cart_buttons">
              {{ settings.reached_text }}
              <div class="offer-icon" >
                <img src="{{'info-circle.svg' | asset_url}}" alt="" aria-hidden="true">
              </div>
            </div>
            </div>
            <div class="offers_wrapper">
              <div class="bg_progress_bar">
                <div
                  class="progress"
                  style="{% if limit > cart.total_price %}width: {{ cart.total_price | divided_by: limit | times: 100.0  }}%{% else %}width:100%;{% endif %};display:block;"
                ></div>
              </div>
            </div>
          </div>

        </div>
            </div> 
            {% endcomment %}

      <div class="drawer__inner">
        <div class="drawer__scrollable">
          <div data-products class="appear-animation appear-delay-2"></div>

          {% if settings.cart_notes_enable %}
            <div class="appear-animation appear-delay-3">
              <label for="CartNoteDrawer">{{ 'cart.general.note' | t }}</label>
              <textarea name="note" class="input-full cart-notes" id="CartNoteDrawer">{{ cart.note }}</textarea>
            </div>
          {% endif %}
          {%- if page.handle == 'ringer-funnel' -%}
            <div class="upshell-exclusive">
              <div class="exclusive__inner">
                <div class="exclusive__left">
                  <img src="{{ 'hard-case-image-cart.png' | asset_url }}" alt="Ringer Hardshell Carrying case">
                </div>
                <div class="exclusive__center">
                  <span>EXCLUSIVE OFFER</span>
                  <p>Ringer HARDSHELL Carrying case</p>
                  <span>Premium leather with suede microfiber interior</span>
                  <div class="center_bottom">
                    <p class="slash-out_price price_current" style="display: block !important;">
                      {% comment %} {{ all_products['ringer-hard-shell-carrying-case'].price | money }} {% endcomment %}
                      $19.99
                    </p>
                    <p class="price__cutoff">
                      {% comment %} {{ all_products['ringer-hard-shell-carrying-case'].compare_at_price_max | money }} {% endcomment %}
                      $29.99
                    </p>
                  </div>
                </div>
                <div class="exclusive__right">
                  <a class="multiple-prod__incart add__rghc" href="javascript:void(0);">ADD TO CART</a>
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>

        <div class="drawer__footer appear-animation appear-delay-4">
          {% if settings.upsell_product_list != blank %}
            <div class="ctm_upsell_product">
              <div class="ctm_upsell_product_title">You may also like:</div>

              {% assign has_player_pro = false %}
              {% assign has_rainmaker = false %}

              {% assign player_pro = all_products['player-pro'] %}
              {% assign captain_pro = all_products['captain-pro'] %}

              {% assign cart_handles = '' %}

              {% for item in cart.items %}
                {% assign cart_handles = cart_handles | append: item.product.handle | append: ',' %}

                {% case item.product.handle %}
                  {% when 'player-pro' %}
                    {% assign has_player_pro = true %}
                  {% when 'rainmaker' %}
                    {% assign has_rainmaker = true %}
                {% endcase %}
              {% endfor %}

              <div class="ctm_upsell_product_list">

              {% if has_player_pro %}

                {% assign priority = 'player-hard-shell-carrying-case,rainmaker' | split: ',' %}

                {% for handle in priority %}
                  {% for product in settings.upsell_product_list %}
                    {% if product.handle == handle %}
                      {% unless cart_handles contains product.handle %}
                        <div data-main-id data-prod-id="{{ product.id }}">
                          {% render 'product-grid-item-cart-drower',
                            product: product,
                            new_class: 'grid__item grid-product small--one-whole medium-up--one-whole'
                          %}
                        </div>
                      {% endunless %}
                    {% endif %}
                  {% endfor %}
                {% endfor %}

                {% for product in settings.upsell_product_list %}
                  {% unless priority contains product.handle %}
                    {% unless cart_handles contains product.handle %}
                      <div data-main-id data-prod-id="{{ product.id }}">
                        {% render 'product-grid-item-cart-drower',
                          product: product,
                          new_class: 'grid__item grid-product small--one-whole medium-up--one-whole'
                        %}
                      </div>
                    {% endunless %}
                  {% endunless %}
                {% endfor %}

              {% elsif has_rainmaker %}

                {% unless cart_handles contains 'player-pro' %}
                  <div data-main-id data-prod-id="{{ player_pro.id }}">
                    {% render 'product-grid-item-cart-drower',
                      product: player_pro,
                      new_class: 'grid__item grid-product small--one-whole medium-up--one-whole'
                    %}
                  </div>
                {% endunless %}

                {% unless cart_handles contains 'captain-pro' %}
                  <div data-main-id data-prod-id="{{ captain_pro.id }}">
                    {% render 'product-grid-item-cart-drower',
                      product: captain_pro,
                      new_class: 'grid__item grid-product small--one-whole medium-up--one-whole'
                    %}
                  </div>
                {% endunless %}

                {% assign priority = 'series-3-max-golf-rangefinder-with-slope,player-hard-shell-carrying-case,player-soft-drawstring-carrying-case,ringer' | split: ',' %}

                {% for handle in priority %}
                  {% for product in settings.upsell_product_list %}
                    {% if product.handle == handle %}
                      {% unless cart_handles contains product.handle %}
                        <div data-main-id data-prod-id="{{ product.id }}">
                          {% render 'product-grid-item-cart-drower',
                            product: product,
                            new_class: 'grid__item grid-product small--one-whole medium-up--one-whole'
                          %}
                        </div>
                      {% endunless %}
                    {% endif %}
                  {% endfor %}
                {% endfor %}

              {% else %}

                {% for product in settings.upsell_product_list %}
                  {% unless cart_handles contains product.handle %}
                    <div data-main-id data-prod-id="{{ product.id }}">
                      {% render 'product-grid-item-cart-drower',
                        product: product,
                        new_class: 'grid__item grid-product small--one-whole medium-up--one-whole'
                      %}
                    </div>
                  {% endunless %}
                {% endfor %}

              {% endif %}

              </div>
              


              {% comment %} <!--div class="ctm_upsell_product_list">
                {% for upsell_prods in settings.upsell_product_list %}
                  <div data-main-id data-prod-id="{{ upsell_prods.id }}">
                    {% render 'product-grid-item-cart-drower',
                      product: upsell_prods,
                      new_class: 'grid__item grid-product small--one-whole medium-up--one-whole',     
                    %}
                  </div>
                {% endfor %}
              </div --> {% endcomment %}

              
            </div>
          {% endif %}

          <div data-discounts>
            {% if cart.cart_level_discount_applications != blank %}
              <div class="cart__discounts cart__item-sub cart__item-row">
                <div>{{ 'cart.general.discounts' | t }}</div>
                <div class="text-right">
                  {% for cart_discount in cart.cart_level_discount_applications %}
                    <div class="cart__discount">
                      {{ cart_discount.title }} (-{{ cart_discount.total_allocated_amount | money }})
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% endif %}
          </div>
          {% if settings.cart_terms_conditions_enable %}
            <div class="cart__item-row cart__terms">
              <input type="checkbox" id="CartTermsDrawer" class="cart__terms-checkbox">
              <label for="CartTermsDrawer">
                {% if settings.cart_terms_conditions_page != blank %}
                  {{ 'cart.general.terms_html' | t: url: settings.cart_terms_conditions_page.url }}
                {% else %}
                  {{ 'cart.general.terms' | t }}
                {% endif %}
              </label>
            </div>
          {% endif %}

          <div class="cart__checkout-wrapper">
            <div class="cart__item-sub cart__item-row">
              <div class="ajaxcart__subtotal">{{ 'cart.general.subtotal' | t }}</div>
              <div data-subtotal aria-live="polite">{{ cart.total_price | money }}</div>
            </div>

            <div class="cart__item-row text-center">
              <small>
                {{ 'cart.general.shipping_at_checkout' | t -}}
                <br>
              </small>
            </div>
            <div class="cart_buttons cart_description">
              <button
                type="submit"
                name="checkout"
                data-terms-required="{{ settings.cart_terms_conditions_enable }}"
                class="btn cart__checkout"
              >
                {{ 'cart.general.checkout' | t }}
              </button>
              <span id="myButton" class="offer-icon">
                <img src="//blueteesgolf.com/cdn/shop/t/131/assets/info-circle.svg?v=129942993901051656861776669239" alt="" aria-hidden="true">
              </span>
            </div>
            {% if additional_checkout_buttons and settings.cart_additional_buttons %}
              <div class="additional-checkout-buttons additional-checkout-buttons--vertical">
                {{ content_for_additional_checkout_buttons }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="drawer__cart-empty appear-animation appear-delay-2">
        <div class="drawer__scrollable">
          {% comment %} {{ 'cart.general.empty' | t }} {% endcomment %}
           <div class="empty-state">
            <div class="empty-state__icon">
              {% comment %} <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
              </svg> {% endcomment %}
                  <svg
           width="60" height="60"
            viewBox="0 0 33 27"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
