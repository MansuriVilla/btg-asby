              fill="var(--new-gray)"
            />
          </svg>
            </div>
            <h2 class="empty-state__title">Your cart is empty</h2>
            <p class="empty-state__description">Looks like you haven't added anything yet. Start exploring our collection to find your favorites.</p>
            <a href="{{ collections['all-products'].url }}" class="content-cta content-cta__solid empty-state__btn">CONTINUE SHOPPING</a>
            {% if settings.new_empty_cart_collection != blank %}
            <div class="ctm_upsell_product">
              <div class="ctm_upsell_product_title">
                Our Popular Products
              </div>
              <div class="ctm_upsell_product_list">
                {% for upsell_prods in settings.new_empty_cart_collection %}
                  <div data-main-id data-prod-id="{{ upsell_prods.id }}">
                    
                    {% render 'empty-cart-product-item',
                      product: upsell_prods,
                      new_class: 'grid__item grid-product small--one-whole medium-up--one-whole empty-cart-item'
                    %}
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}
          </div>

        </div>
      </div>
    </form>
  </div>
{%- endif -%}

<style>

    .cart_drawer_header{display: flex; justify-content: space-between; align-items: center;}
  .cart_drawer_header .drawer__close {width: 100%; max-width: fit-content; }

.cart_drawer_header:has(.drawer__clear-cart) .h2.drawer__title{width:fit-content;}
.cart_drawer_header:has(.drawer__clear-cart) .drawer__close{width:auto;}
.cart_drawer_header:has(.drawer__clear-cart){display: flex;
  justify-content: space-between;
  align-items: center;}
.drawer__contents.is-empty .drawer__clear-cart,
#CartDrawer.is-empty .drawer__clear-cart {
  display: none !important;
}
.drawer__clear-cart {
  display: flex;
  flex: 1;
  justify-content: flex-end;
}

  .drawer__clear-cart button svg {
  max-width: 20px;
  display: flex;
  height: fit-content;
}
.drawer__clear-cart button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  font-size: 12px;
  text-transform: uppercase;
  color: var(--new-red);
  background: #F0000040;
  padding: 5px 10px;
  border-radius: 20px;
}
.drawer__clear-cart button:hover {
text-decoration:underline;
}

    
  .upshell-exclusive { border-radius: 10px; border: 1px solid var(--new-black); padding: 15px 20px; margin-top:50px; }
  .exclusive__inner { display: flex; justify-content: space-between; gap: 15px; }
  .exclusive__inner p { padding: 0;}
  .center_bottom { display: flex; }
  .exclusive__left { border-radius: 5px; background: #EFEFEF; display: flex; }
  .exclusive__left img { object-fit: contain; }
