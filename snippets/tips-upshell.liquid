
  



{% if product.handle contains 'transit-travel-kit-black' %}

  
<div class="tips_upshell upshell_for{{ product.handle }}">
  <h2 class="upshell_tip-title">upgrade YOUR CARRY</h2>

  <div class="upshell-box">
    <div class="upshell-box_inner">
      <div class="upshell_box-left">
        <div class="upshell_box-left-inner">
          <img src="{{ 'upshell-product-img-1.png' | asset_url }}" alt="" />
        </div>
      </div>
      <div class="upshell_box-right">
        <div class="upshell_box-right-inner">
          <h3>The travel kit</h3>
          <p>
            Minimalist Travel, <br />
            Maximum Organization
          </p>
          <p class="upshell_price">$39</p>
        </div>
      </div>
      <div class="upshell_box-floating">
        <input type="checkbox" id="customCheckbox" />
        <label for="customCheckbox" class="media-style"></label>
      </div>
    </div>
  </div>
</div>

{% endif %}

