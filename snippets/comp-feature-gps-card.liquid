{% comment %}
  Component: comp-feature-gps-card  (dark "FCB GPS Distances and Hazards" card)
  Usage:
  {% render 'comp-feature-gps-card', block: block %}
  Block settings: title, badge, subtitle, image, feature_1..3_icon / feature_1..3_label
{% endcomment %}

{% liquid
  assign g_title = block.settings.title | default: 'FCB GPS Distances<br>and Hazards'
  assign g_badge = block.settings.badge | default: 'Included'
  assign g_sub = block.settings.subtitle | default: 'Free for life | No subscription required'
  assign slots = '1,2,3' | split: ','
%}

{% render 'comp-feature-card-base' %}

<div class="pdp_component">
<div class="comp-feature-card comp-feature-card--gps" {{ block.shopify_attributes }}>
  <div class="comp-feature-card__top">
    <h2 class="comp-feature-card__title">{{ g_title }}</h2>
    <span class="comp-feature-card__badge">
      {{ g_badge }}
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 6.5l2.5 2.5L10 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </div>

  {% if g_sub != blank %}
    <p class="comp-feature-card__sub">{{ g_sub }}</p>
  {% endif %}

  {% liquid
    assign gps_img = block.settings.image
  %}
  {% if gps_img != blank %}
    <div class="comp-feature-card__media">
      {% assign gps_alt = block.settings.title | default: 'FCB GPS Distances' | strip_html | escape %}
      {{ gps_img | image_url: width: 900 | image_tag: loading: 'eager', class: 'comp-feature-card__img', alt: gps_alt, widths: '450,700,900,1200' }}
    </div>
  {% endif %}

  <ul class="comp-feature-card__icons">
    {% for n in slots %}
      {% liquid
        assign icon_key = 'feature_' | append: n | append: '_icon'
        assign label_key = 'feature_' | append: n | append: '_label'
        assign f_icon = block.settings[icon_key]
        assign f_label = block.settings[label_key]
      %}
      {% if f_label != blank %}
        <li class="comp-feature-card__icon-item">
          {% if f_icon != blank %}
            {{ f_icon | image_url: width: 120 | image_tag: loading: 'lazy', class: 'comp-feature-card__icon', alt: '' }}
          {% endif %}
          <span>{{ f_label }}</span>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</div>
</div>
<style>
  .comp-feature-card--gps {
    background: linear-gradient(180deg, #1B1E22 0%, #000000 100%), #101820;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 16px;
    box-sizing: border-box;
    width: 100%;
  }
  .comp-feature-card--gps .comp-feature-card__title {
    font-family: 'Blue Tees Headline Italic', sans-serif;
    font-size: 20px;
    line-height: 1.1;
    text-transform: uppercase;
    color: #FFFFFF !important;
    letter-spacing: -0.01em;
  }
  .comp-feature-card--gps .comp-feature-card__badge {
    font-family: 'Blue Tees Subhead', sans-serif;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #FFFFFF !important;
  }
  .comp-feature-card--gps .comp-feature-card__sub {
    font-family: 'Blue Tees Subhead', sans-serif;
    font-size: 11px;
    line-height: 1;
    text-transform: uppercase;
    color: #CDFF07 !important;
    margin: 0;
  }
  .comp-feature-card__media {
    position: relative;
    width: 100%;
    min-height: 173px;
    height: auto;
    border-radius: 8px;
    overflow: hidden;
    background: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .comp-feature-card__media img,
  .comp-feature-card__img {
    display: block !important;
    width: 100% !important;
    min-height: 173px !important;
    height: 100% !important;
    max-height: 220px;
    object-fit: cover;
    border-radius: 8px;
  }
  .comp-feature-card__icons {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    width: 100%;
  }
  .comp-feature-card__icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
    text-align: center;
    font-family: 'Blue Tees Subhead', sans-serif;
    font-size: 12px;
    line-height: 1.15;
    text-transform: uppercase;
    color: #FFFFFF !important;
  }
  .comp-feature-card__icon-item span {
    color: #FFFFFF !important;
  }
  .comp-feature-card__icon {
    width: 34px;
    height: 26px;
    object-fit: contain;
    display: block;
  }
</style>
