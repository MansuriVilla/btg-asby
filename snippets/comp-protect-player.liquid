{% comment %}
  Component: comp-protect-player
  "PROTECT YOUR PLAYER" add-on product card with top product header and 2x2 checklist grid.
  Usage:
  {% render 'comp-protect-player', block: block %}
  Block settings: heading, product_1..3, features_1..3 (multiline text)
{% endcomment %}

{% liquid
  assign pp_heading = block.settings.heading | default: 'PROTECT YOUR PLAYER'
  assign picks = 'product_1,product_2,product_3' | split: ','
%}

<div class="comp-protect-player" {{ block.shopify_attributes }}>
  <h2 class="comp-protect-player__heading custom_heading">{{ pp_heading }}</h2>

  <div class="comp-protect-player__list">
    {% for key in picks %}
      {% liquid
        assign p = block.settings[key]
        assign feat_key = key | replace: 'product_', 'features_'
        assign feat_text = block.settings[feat_key]
      %}
      {% if p != blank %}
        {% liquid
          assign v = p.selected_or_first_available_variant
          assign on_sale = false
          if v.compare_at_price > v.price
            assign on_sale = true
          endif
        %}
        <div class="comp-protect-card" data-variant-id="{{ v.id }}">
          <!-- Top Row: Thumb + Title/Price + Pill ADD Button -->
          <div class="comp-protect-card__top">
            <div class="comp-protect-card__thumb">
              {% if p.featured_image %}
                {{ p.featured_image | image_url: width: 140 | image_tag: loading: 'lazy', alt: p.title }}
              {% endif %}
            </div>

            <div class="comp-protect-card__info">
              <span class="comp-protect-card__title">{{ p.title }}</span>
              <div class="comp-protect-card__price{% if on_sale %} is-on-sale{% endif %}">
                <strong class="comp-protect-card__price-val">{{ v.price | money_without_trailing_zeros }}</strong>
                {% if on_sale %}
                  <s class="comp-protect-card__price-compare custom_body-text">{{ v.compare_at_price | money_without_trailing_zeros }}</s>
                {% endif %}
              </div>
            </div>

            <button
              type="button"
              class="comp-protect-card__add"
              data-comp-accessory-add
              data-variant-id="{{ v.id }}"
              aria-label="Add {{ p.title | escape }} to cart"
              {% unless v.available %}disabled{% endunless %}
            >
              <span class="comp-protect-card__add-label" data-label>{% if v.available %}ADD{% else %}SOLD OUT{% endif %}</span>
              <span class="comp-protect-card__add-icon" aria-hidden="true">
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                  <path d="M5 1v8M1 5h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </span>
            </button>
          </div>

          <!-- Bottom: 2-Column Features Grid Table -->
          {% if feat_text != blank %}
            <div class="comp-protect-card__features-grid">
              {% assign feat_lines = feat_text | newline_to_br | split: '<br />' %}
              {% for line in feat_lines %}
                {% assign line_clean = line | strip %}
                {% if line_clean != blank %}
                  <div class="comp-protect-card__feature-cell">
                    <span class="comp-protect-card__check-circle" aria-hidden="true">
                      <svg width="9" height="7" viewBox="0 0 9 7" fill="none">
                        <path d="M1 3.5L3.5 6L8 1" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span class="comp-protect-card__feature-text custom_body-text">{{ line_clean }}</span>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<style>
  .comp-protect-player {
    width: 100%;
    margin-top: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 1.1vw, 14px);
  }
  .comp-protect-player__heading {
    margin: 0;
    font-family: 'Blue Tees Headline Italic', sans-serif;
    font-size: clamp(14px, 1.1vw, 16px);
    line-height: 1.5;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #1B1E22;
  }
  .comp-protect-player__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  /* White Card Container (matches Image 1) */
  .comp-protect-card {
    position: relative;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    width: 100%;
    background: #FFFFFF;
    border: 1px solid #D9D9D9;
    border-radius: 10px;
    padding: 16px 18px 14px;
    box-sizing: border-box;
  }

  /* Top Section */
  .comp-protect-card__top {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding-bottom: 14px;
  }
  .comp-protect-card__thumb {
    width: 58px;
    height: 58px;
    flex-shrink: 0;
    border-radius: 10px;
    overflow: hidden;
    background: #1B2029;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .comp-protect-card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .comp-protect-card__info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    flex: 1;
    min-width: 0;
  }
  .comp-protect-card__title {
    font-family: 'Blue Tees Headline Italic', sans-serif;
    font-size: 15px;
    line-height: 1.2;
    text-transform: uppercase;
    color: #1B1E22;
    letter-spacing: -0.01em;
  }
  .comp-protect-card__price {
    display: flex;
    align-items: center;
    gap: 6px;
    line-height: 1;
  }
  .comp-protect-card__price-val {
    font-family: 'Blue Tees Subhead', sans-serif;
    font-size: 15px;
    color: #000000;
  }
  .comp-protect-card__price.is-on-sale .comp-protect-card__price-val {
    color: #CB0000;
  }
  .comp-protect-card__price-compare {
    font-family: 'Blue Tees Paragraph', sans-serif;
    font-size: 14px;
    color: #9EA3B1;
    text-decoration: line-through;
  }

  /* ADD Pill Button (matches Image 1) */
  .comp-protect-card__add {
    box-sizing: border-box;
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 7px 14px;
    gap: 5px;
    height: 32px;
    border: none;
    border-radius: 100px;
    background: #F1F2F4;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s ease, transform 0.15s ease;
    flex-shrink: 0;
  }
  .comp-protect-card__add:hover:not(:disabled) {
    background: #E5E7EB;
  }
  .comp-protect-card__add-label {
    font-family: 'Blue Tees Subhead', sans-serif;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.5px;
    color: #1B2029;
    text-align: center;
  }
  .comp-protect-card__add-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 10px;
    height: 10px;
    color: #1B2029;
  }
  .comp-protect-card__add-icon svg path {
    stroke: #1B2029;
  }
  .comp-protect-card__add:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .comp-protect-card__add:disabled .comp-protect-card__add-icon {
    display: none;
  }

  /* 2-Column Features Grid Table with thin borders */
  .comp-protect-card__features-grid {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    border-top: 1px solid #ECECEC;
  }
  .comp-protect-card__feature-cell {
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    gap: 8px;
    border-bottom: 1px solid #ECECEC;
  }
  .comp-protect-card__feature-cell:nth-child(odd) {
    border-right: 1px solid #ECECEC;
    padding-left: 0;
  }
  .comp-protect-card__feature-cell:nth-child(even) {
    padding-right: 0;
    padding-left: 14px;
  }
  .comp-protect-card__check-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: #1B1E22;
    flex-shrink: 0;
  }
  .comp-protect-card__feature-text {
    font-family: 'Blue Tees Paragraph', sans-serif;
    font-size: 13px;
    line-height: 1.35;
    color: #1B2029;
    letter-spacing: 0.01em;
  }

  @media (max-width: 640px) {
    .comp-protect-card {
      padding: 14px;
    }
    .comp-protect-card__features-grid {
      grid-template-columns: 1fr;
    }
    .comp-protect-card__feature-cell:nth-child(odd) {
      border-right: none;
      padding-left: 0;
    }
    .comp-protect-card__feature-cell:nth-child(even) {
      padding-left: 0;
    }
  }
</style>
