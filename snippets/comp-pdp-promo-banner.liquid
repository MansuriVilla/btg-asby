{% comment %}
  Component: comp-pdp-promo-banner
  Usage:
  {% render 'comp-pdp-promo-banner',
    text: 'LABOR DAY SALE: $20 OFF',
    subtitle: 'With Purchase of $199.99 or more',
    link: '/collections/all',
    bg_color: '#0b1220',
    text_color: '#ffffff',
    bg_image: section.settings.promo_bg_image
  %}
{% endcomment %}

{% liquid
  assign promo_title = text | default: ''
  assign promo_sub = subtitle | default: ''
  assign promo_bg = bg_color | default: '#0b1220'
  assign promo_fg = text_color | default: '#ffffff'
  assign promo_img = bg_image
  assign show_offer_bug = enable_offer_bug | default: false
  assign bug_text = offer_bug_text | default: 'BLACK FRIDAY EXCLUSIVE'
  assign bug_bg = offer_bug_bg | default: '#FF0000'
  assign bug_color = offer_bug_color | default: '#FFFFFF'
  assign btn_label = button_text | default: 'Shop Now'
%}

{% if promo_title != blank %}
  <div
    class="comp-pdp-promo{% if promo_img != blank %} has-bg-image{% endif %}"
    style="--promo-bg: {{ promo_bg }}; --promo-fg: {{ promo_fg }};{% if promo_img != blank %} --promo-img: url('{{ promo_img | image_url: width: 1200 }}');{% endif %}"
    data-comp-promo
  >
    <div class="comp-pdp-promo__content">
      <div class="comp-pdp-promo__content-top">
        {% if show_offer_bug and bug_text != blank %}
          <span
            class="comp-pdp-promo__offer-bug custom_subHeading-text"
            style="--bug-bg: {{ bug_bg }}; --bug-color: {{ bug_color }};"
          >
            {{ bug_text }}
          </span>
        {% endif %}

       
      </div>
     
        <div class="comp-pdp-promo__content-bottom">

        <div class="comp-pdp-promo__content-bottom--left">
           {% if link != blank %}
          <a href="{{ link }}" class="comp-pdp-promo__title">{{ promo_title }}</a>
        {% else %}
          <span class="comp-pdp-promo__title">{{ promo_title }}</span>
        {% endif %}

        {% if promo_sub != blank %}
          <span class="comp-pdp-promo__sub custom_body-text">{{ promo_sub }}</span>
        {% endif %}
      </div>
         {% if link != blank %}
          <div class="comp-pdp-promo__btn-wrap">
            {% render 'cta-button',
              text: btn_label,
              url: link,
              type: 'link',
              variant: 'outline_trans',
              class: 'comp-pdp-promo__cta'
            %}
          </div>
          {% endif %}
        </div>
      

      <button type="button" class="comp-pdp-promo__close" aria-label="Close banner" data-comp-promo-close>
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
          <path d="M1.5 1.5l7 7M8.5 1.5l-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
    <style>
      .comp-pdp-promo__content-top {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.comp-pdp-promo__content-bottom {
  display: flex;
  width: 100%;
  justify-content: space-between;
  align-items: center;
}

.comp-pdp-promo__content-bottom--left {
  display: flex;
  flex-direction: column;
  gap: 5px;
}
      .comp-pdp-promo {
        position: relative;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: flex-start;
        padding: clamp(12px, 1.2vw, 16px);
        gap: 6px;
        isolation: isolate;
        width: 100%;
        min-height: clamp(80px, 7vw, 100px);
        background-color: var(--promo-bg);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        color: var(--promo-fg);
        border-radius: clamp(8px, 0.7vw, 10px);
        box-shadow: 0px 20px 24px -10px rgba(0, 0, 0, 0.35);
        overflow: hidden;
        margin-bottom: clamp(12px, 1.2vw, 16px);
      }
      .comp-pdp-promo.has-bg-image {
        background-image: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.55) 100%), var(--promo-img);
      }
      .comp-pdp-promo__content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
        width: 100%;
        padding-right: clamp(55px, 5.6vw, 100px);
      }
      .comp-pdp-promo__offer-bug {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: var(--bug-bg, #FF0000);
        color: var(--bug-color, #FFFFFF);
        padding: 3px 10px;
        border-radius: 4px;
        font-size: 10px;
        line-height: 1.3;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 2px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
      }
      .comp-pdp-promo__title {
        margin: 0;
        color: var(--promo-fg);
        font-family: 'Blue Tees Headline Italic', sans-serif;
        font-size: clamp(12px, 1.1vw, 16px);
        line-height: 1.3;
        letter-spacing: -0.01em;
        text-transform: uppercase;
        text-decoration: none;
        display: inline-block;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
      }
      .comp-pdp-promo__sub {
        color: var(--promo-fg);
        font-size: clamp(11px, 0.85vw, 12px);
        line-height: 1.4;
        opacity: 0.95;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
      }
      .comp-pdp-promo__btn-wrap {
        margin-top: 4px;
      }
      .comp-pdp-promo__cta {
        padding: 6px 14px !important;
        border: 1px solid rgba(255, 255, 255, 0.9) !important;
        color: #FFFFFF !important;
        background: transparent !important;
      }
      .comp-pdp-promo__cta .content-cta__text {
        color: #FFFFFF !important;
        transition: color 0.4s ease;
      }
      .comp-pdp-promo__cta.content-cta--fill-hover .content-cta__bg-fill {
        background-color: #FFFFFF !important;
      }
      .comp-pdp-promo__cta:hover {
        background: #FFFFFF !important;
        border-color: #FFFFFF !important;
        color: #000000 !important;
      }
      .comp-pdp-promo__cta:hover .content-cta__text {
        color: #000000 !important;
      }
      .comp-pdp-promo__close {
        position: absolute;

        right: 0;
        top: 0;
      
        z-index: 2;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
        width: clamp(26px, 2.2vw, 30px);
        height: clamp(26px, 2.2vw, 30px);
        padding: 0;
        border: 1px solid #474646;
        border-radius: 100px;
        background: rgba(27, 30, 34, 0.5);
        color: #FFFFFF;
        cursor: pointer;
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        transition: background 0.2s ease, transform 0.15s ease;
      }
      .comp-pdp-promo__close:hover {
        background: rgba(27, 30, 34, 0.8);
        transform: scale(1.05);
      }
      .comp-pdp-promo__close svg {
        width: 10px;
        height: 10px;
        stroke: #FFFFFF;
      }
      .comp-pdp-promo.is-hidden { display: none; }

      @media (max-width: 991px) {
        .comp-pdp-promo {
          position: fixed !important;
          bottom: 12px !important;
        }
        /* Sits directly above the sticky CTA once the CTA is pinned */
        body.comp-pdp-cta-stuck .comp-pdp-promo {
          bottom: 110px !important;
        }
        .comp-pdp-promo {
          left: 12px !important;
          right: 12px !important;
          width: calc(100% - 24px) !important;
          max-width: 100% !important;
          z-index: 6 !important;
          margin: 0 !important;
          box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.35) !important;
        }
      }
      @media (max-width: 575px) {
        .comp-pdp-promo__offer-bug{ font-size: 8px; padding: 3px 6px; }
        {% if link != blank %}
        .comp-pdp-promo__content-bottom{margin-top: 33px;}
        .comp-pdp-promo__content-top{position: absolute;}
        .comp-pdp-promo__content-bottom .content-cta.content-cta--fill-hover {font-size: 11px; padding: 4px 7px !important;}
        .comp-pdp-promo__close{right: 0px; top: -3px;}
        .comp-pdp-promo__content{padding-right: 0;}
        {% endif %}
      }
    </style>

    <script>
      (function () {
        var banner = document.currentScript.previousElementSibling.previousElementSibling;
        if (!banner || !banner.hasAttribute('data-comp-promo')) return;
        var btn = banner.querySelector('[data-comp-promo-close]');
        if (btn)
          btn.addEventListener('click', function () {
            banner.classList.add('is-hidden');
          });
      })();
    </script>
{% endif %}
