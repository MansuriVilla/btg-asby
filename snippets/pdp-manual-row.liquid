{%- comment -%}
  Single manual download row item.
  Parameters:
  - title: Manual label (required)
  - url: PDF link (required)
{%- endcomment -%}

{% capture dl_icon %}
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
    <polyline points="7 10 12 15 17 10"></polyline>
    <line x1="12" y1="15" x2="12" y2="3"></line>
  </svg>
{% endcapture %}

<div class="pdp-manuals-row">
  <span class="pdp-manuals-row__title custom_body-text">{{ title }}</span>
  {% render 'cta-button',
    text: 'DOWNLOAD',
    url: url,
    type: 'link',
    target_blank: true,
    attributes: 'download',
    icon: dl_icon,
    icon_position: 'right',
    class: 'pdp-manuals-btn'
  %}
</div>
