<div class="site_flex site_header-content nav_left">
  <div class="menu-toggle" id="menuToggle">
    <img
      class="isMenu_close"
      src="{{ 'tips-open-menu.png' | asset_url }}"
      alt=" Menu icon "
    />
    <img
      class="isMenu_open"
      src="{{ 'tips-close-menu.png' | asset_url }}"
      alt=" Menu icon "
      
    />
  </div>
  <div class="site_header-left">
    <div class="header_logo">
           {%  if page.handle == 'golf-trip-bundle-black-friday'%}

             <a href="/">
        <img
          src="{{ 'LOGO-TIPS-1.png' | asset_url }}"
          alt="Company Logo"
        />
      </a>
    {% else  %}
       <a href="/">
        <img
          src="{{ 'LOGO-TIPS.png' | asset_url }}"
          alt="Company Logo"
        />
      </a>
      {% endif %}
    </div>
  </div>
  <span class="site_header__border"></span>
  <nav class="site_header-center menu_custom">
    <ul class="site_header-links">
      <li
        class="site_header-link site_headerContains__megaMenu"
        data-disable-menu="false"
        data-menu="products"
      >
        <a href="#" class="nav_link item_has--dropdown">SHOP</a>
        <div class="site__megaMenu_container">
          <div class="site__megaMenu_content page-width">
            <div class="menu_top-site-mobile">
              <span class="site_megaMenu__item site_megaMenu__Title"> TRANSIT COLLECTION </span> 
              <button class="back-button">Back</button>
            </div>
            <ul class="site__megaMenu_content__inner">
              <li class="site__megaMenu_left">
                <div class="site_megaMenu_left-inner">
                  <ul class="site_megaMenu_left-ul">
                    <div class="site_megaMenu_ul-inner">
                      
                      <div class="site__megaMenu_left-top">
                        <li class="site_megaMenu__item">
                          <a
                            class="site_megaMenu_Link"
                            href="/products/transit-backpack-medium-black"
                            ><span class="site_megaMenu_linkText">
                              Medium Backpack</span
                            ></a
                          >
                        </li>
                        <li class="site_megaMenu__item">
                          <a
                            class="site_megaMenu_Link"
                            href="/products/transit-cinch-sack-black"
                            ><span class="site_megaMenu_linkText"
                              >Commuter Sling</span
                            ></a
                          >
                        </li>
                        <li class="site_megaMenu__item">
                          <a
                            class="site_megaMenu_Link"
                            href="/products/transit-shoe-bag-black"
                            ><span class="site_megaMenu_linkText"
                              >Shoe Pod</span
                            ></a
                          >
                        </li>
                        <li class="site_megaMenu__item">
                          <a
                            class="site_megaMenu_Link"
                            href="/products/transit-travel-kit-black"
                            ><span class="site_megaMenu_linkText"
                              >Travel Kit</span
                            ></a
                          >
                        </li>
                        <li class="site_megaMenu__item">
                          <a
                            class="site_megaMenu_Link"
                            href="/products/transit-valuables-pouch-black"
                            ><span class="site_megaMenu_linkText"
                              >Valuables Pouch</span
                            ></a
                          >
                        </li>
                      </div>
                    </div>
                    
                  </ul>
                
                </div>
              </li>
              
            </ul>
          </div>
        </div>
      </li>
      <li
        class="site_header-link"
        data-disable-menu="false"
        data-menu="apps"
      >
        <a href="#" class="nav_link">ABOUT</a>
        
      </li>
      <li
        class="site_header-link"
        data-disable-menu="false"
        data-menu="community"
      >
        <a href="#" class="nav_link ">WHOLESALE</a>
   
      </li>
      <li
        class="site_header-link"
        data-menu="support"
      >
        <a href="#" class="nav_link ">CONTACT</a>
       
      </li>
      
      
    </ul>
    <span class="megaMenu_backface"></span>
  </nav>
  <div class="site_header-right">
    <a class="site__header-profileIcon" href="/account/login">
      <img
        src="{{ 'profile-icon-neew-header-tips.svg' | asset_url }}"
        alt="Profile Icon"
      />
    </a>
