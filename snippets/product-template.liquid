    .btn.btn--full.add-to-cart.above__fold-cart-cta:hover{color:#fff;}
    .variant-input-wrap label.disabled::after{display:none;}

    .site_header-link.active .nav_offer--link::before { opacity: 1 !important; }
    .site_header-link.active .nav_offer--link { font-weight: 900; }

    @media only screen and (max-width:991px){
    .header__nav-offer .nav_link.nav_offer--link{width: fit-content;}
    .ringer-funnel__ticker.active { position: relative; z-index: -2;}
    .header__nav-offer .site_header-link{padding: clamp(15px,2vw,30px) 0;}

    .site_header-center{top:60px;}
    .site_header-center .nav_link:hover::before, .site_header-center .nav_link.site_megaMenu__Active::before { height: 4px; }
    }
  </style>
{% endif %}

