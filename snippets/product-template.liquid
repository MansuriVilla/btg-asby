{% if product.handle == 'speaker-bundle'
  or product.handle == 'gps-offer'
  or product.handle == 'laser-offer'
  or product.handle == 'player-gps-speaker-bundle-v2'
  or product.handle == 'ringer-gps-handheld-bundle-v2'
  or product.handle == 'series-4-ultra-bundle-v2'
%}
  <script>
    // Watch for class changes on .site-header
    const observer = new MutationObserver(() => {
      const ticker = document.querySelector('.ringer-funnel__ticker');
      const isHeaderActive = document.querySelector('.site-header')?.classList.contains('active');

      if (ticker) {
        if (isHeaderActive) {
          ticker.classList.add('active');
        } else {
          ticker.classList.remove('active');
        }
      }
    });

    // Start observing the header
    const header = document.querySelector('.site-header');
    if (header) {
      observer.observe(header, {
        attributes: true,
        attributeFilter: ['class'],
      });
    }

    // Also run once on load (in case active is already there)
    if (header?.classList.contains('active')) {
      document.querySelector('.ringer-funnel__ticker')?.classList.add('active');
    }
  </script>
