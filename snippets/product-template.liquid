    renderCourseCount('course-count', 42000); {% endcomment %}

    // FOR POPUP'S '40K' TEXT
    function renderShortCourseCountByClass(className, count) {
      let shortCount = (count / 1000).toFixed(0) + 'K';
      let elements = document.getElementsByClassName(className);

      // Iterate over all matching elements and set their text
      for (let i = 0; i < elements.length; i++) {
        elements[i].textContent = shortCount;
      }
    }

    // Call the function
    renderShortCourseCountByClass('course-count-short', 42000);
  }
  courseCount();
</script>

