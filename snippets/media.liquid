{%- liquid
  assign is_featured = false
  if featured_media == media
    assign is_featured = true
  endif
  assign has_video = false
  assign video_type = ''
  assign video_modal = false
  assign image_set = false
  assign image_set_group = ''
  if media.alt contains '#'
    assign image_set_full = media.alt | split: '#' | last
    if image_set_full contains '_'
      assign image_set = true
      assign image_set_group = image_set_full | split: '_' | first
    endif
  endif
  case media.media_type
    when 'external_video'
      assign has_video = true
      assign video_type = media.host
      if media.host contains 'youtube'
        assign video_id = media.external_id
      endif
    when 'video'
      assign has_video = true
      assign video_type = 'mp4'
  endcase
  if has_video and video_style == 'unmuted'
    assign video_modal = true
  endif
  assign media_aspect_ratio = media.aspect_ratio
  assign media_width = media.width
  assign media_height = media.height
  if media.media_type != 'image'
    assign media_width = media.preview_image.width
    assign media_height = media.preview_image.height
  endif
-%}

<div
  class="product-main-slide {% if is_featured %}starting-slide{% else %}secondary-slide{% endif %}"
  data-index="{{ loopIndex0 }}"
  {% if image_set %}
    data-set-name="{{image_set_group}}"
    data-group="{{image_set_full}}"
  {% endif %}>

  <div data-product-image-main class="product-image-main">

    {%- if media.media_type == 'model' -%}
      {%- liquid
        if media.preview_image.aspect_ratio
          assign media_aspect_ratio = media.preview_image.aspect_ratio
        endif
      -%}
      <div
        class="image-wrap" 
        style="height: 0; padding-bottom: {{ 100 | divided_by: media_aspect_ratio }}%;"
        data-product-media-type-model
        data-media-id="{{ section_id }}-{{ media.id }}"
        role="img"
        aria-label="{{ media.alt | default: product.title | escape }}">
        {{ media | model_viewer_tag: image_size: product_zoom_size, reveal: 'interaction', toggleable: true, data-model-id: media.id }}
      </div>
      <button class="hide btn btn--circle btn--static product-single__close-media">
        <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64"><path d="M19 17.61l27.12 27.13m0-27.12L19 44.74"/></svg>
      </button>

    {%- else -%}
      {%- liquid
        if has_video
          if featured_media.preview_image.aspect_ratio
            assign media_aspect_ratio = featured_media.preview_image.aspect_ratio
          elsif featured_media.aspect_ratio
            assign media_aspect_ratio = featured_media.aspect_ratio
          elsif media.preview_image.aspect_ratio
            assign media_aspect_ratio = media.preview_image.aspect_ratio
          endif
        elsif media.preview_image.aspect_ratio
          assign media_aspect_ratio = media.preview_image.aspect_ratio
        endif
      -%}
      {%- if has_video and video_type == 'mp4' -%}
        {%- liquid
          if featured_media.preview_image.aspect_ratio
            assign media_aspect_ratio = featured_media.preview_image.aspect_ratio
          elsif featured_media.aspect_ratio
            assign media_aspect_ratio = featured_media.aspect_ratio
          elsif media.preview_image.aspect_ratio
            assign media_aspect_ratio = media.preview_image.aspect_ratio
          endif
        -%}
        <div class="image-wrap image-wrap--video-slide" style="height: 0; padding-bottom: {{ 100 | divided_by: media_aspect_ratio }}%;">
          {% assign mp4_url = media.sources[1].url | default: media.sources[0].url %}
          {% assign vid_title = media.alt | default: product.title %}
          {% render 'comp-video-player',
            video_url: mp4_url,
            is_active: false,
            title: vid_title,
            controls_variant: 'centerplay'
          %}
        </div>
      {%- else -%}
        <div class="image-wrap{% if has_video %} image-wrap--video-slide{% endif %}" style="height: 0; padding-bottom: {{ 100 | divided_by: media_aspect_ratio }}%;">
          {%- liquid
            assign img_url = media | img_url: '1x1' | replace: '_1x1.', '_{width}x.'
            assign zoom_img_url = media.preview_image | img_url: product_zoom_size
          -%}
          <img class="{% if product_zoom_enable and media.media_type == 'image' %}photoswipe__image{% endif %}{% if is_featured %} lazyloaded{% else %} lazyload{% endif %}"
            {% if is_featured %}
              src="{{ media | img_url: '720x' }}"
              srcset="
                {{ media | img_url: '360x' }} 360w,
                {{ media | img_url: '540x' }} 540w,
                {{ media | img_url: '720x' }} 720w,
                {{ media | img_url: '900x' }} 900w,
                {{ media | img_url: '1080x' }} 1080w
              "
              sizes="(max-width: 768px) 100vw, 50vw"
            {% endif %}
            data-photoswipe-src="{{ zoom_img_url }}"
            data-photoswipe-width="{{ media_width }}"
            data-photoswipe-height="{{ media_height }}"
            data-index="{{ loopIndex }}"
            data-src="{{ img_url }}"
            data-widths="[360, 540, 720, 900, 1080]"
            data-aspectratio="{{ media_aspect_ratio }}"
            data-sizes="auto"
            alt="{{ media.alt | default: product.title | escape }}"
            {% if is_featured %}
              loading="eager"
              fetchpriority="high"
            {% else %}
              loading="lazy"
            {% endif %}>

          <noscript>
            <img class="lazyloaded"
              src="{{ media | img_url: '1400x' }}"
              alt="{{ media.alt | default: product.title | escape }}">
          </noscript>

          {%- if product_zoom_enable and media.media_type == 'image' -%}
            <button 
              type="button" 
              class="btn btn--body btn--circle js-photoswipe__zoom product__photo-zoom"
              aria-label="Zoom image: {{ media.alt | default: product.title | escape }}">
              <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-search" viewBox="0 0 64 64"><path d="M47.16 28.58A18.58 18.58 0 1 1 28.58 10a18.58 18.58 0 0 1 18.58 18.58zM54 54L41.94 42"/></svg>
              <span class="icon__fallback-text">{{ 'general.accessibility.zoom_image' | t }}</span>
            </button>
          {%- endif -%}
        </div>

        {%- if has_video and video_type == 'youtube' -%}
          <div class="product-video-inline-wrapper" data-inline-video-wrapper>
            <button 
              type="button" 
              class="product-video-play-btn product-video-play-btn--inline"
              data-inline-play-btn
              aria-label="Play YouTube video: {{ media.alt | default: product.title | escape }}">
              <span class="product-video-play-btn__icon">
                <svg aria-hidden="true" focusable="false" role="presentation" viewBox="0 0 24 24"><polygon points="8,5 19,12 8,19" fill="#ffffff"/></svg>
              </span>
              <span class="product-video-play-btn__text">PLAY</span>
            </button>
            <iframe
              class="product-video-inline-frame hide"
              data-inline-iframe
              data-src="https://www.youtube.com/embed/{{ media.external_id }}?enablejsapi=1&autoplay=1&rel=0&playsinline=1"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        {%- endif -%}
      {%- endif -%}

    {%- endif -%}

  </div>
</div>