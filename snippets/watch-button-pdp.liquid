{% comment %} {% if product.handle == 'speaker-bundle'
  or product.handle == 'gps-offer'
  or product.handle == 'laser-offer'
  or product.handle == 'player-gps-speaker-bundle-v2'
  or product.handle == 'ringer-gps-handheld-bundle-v2'
  or product.handle == 'series-4-ultra-bundle-v2'
%}
  <div class="bottom-buttons">
    <ul>
      <li class="commercial new_photo pdp_video_button">
        <a href="#">
          <span><img src="{{ 'photo-icon.png' | asset_url }}"></span>
          PHOTOS
        </a>
      </li>
      <li class="commercial new_commercial pdp_video_button">
        <a
          href="javascript:void(0);"
          class="videopopup_link"
          data-video-id="{%if product.handle == 'speaker-bundle' or product.handle == 'player-gps-speaker-bundle-v2' %}1132441995{%elsif product.handle == 'gps-offer' or product.handle == 'ringer-gps-handheld-bundle-v2'%}920149279{%elsif product.handle == 'laser-offer' or product.handle == 'series-4-ultra-bundle-v2'%}995524601{%endif %}"
        >
          <span><img src="https://blueteesgolf.com/cdn/shop/t/84/assets/commercial-icon-h.png"></span>
          MUST WATCH
        </a>
      </li>
      <li class="review new_review pdp_video_button">
        <a
          href="javascript:void(0);"
          class="videopopup_link"
          data-video-id="{%if product.handle == 'speaker-bundle' or product.handle == 'player-gps-speaker-bundle-v2' %}920141462{%elsif product.handle == 'gps-offer' or product.handle == 'ringer-gps-handheld-bundle-v2'%}920147864{%elsif product.handle == 'laser-offer' or product.handle == 'series-4-ultra-bundle-v2'%}995631368{%endif %}"
        >
          <span><img src="https://blueteesgolf.com/cdn/shop/t/84/assets/commercial-icon-h.png"></span>
          SEE REVIEW
        </a>
      </li>
    </ul>
  </div>

{% else %}
  {% assign must_watch_video = must_watch %}
  {% assign review_watch_video = review_video %}
  {% assign show_review_watch_btn = false %}

  {% if display_review_button %}
    {% assign show_review_watch_btn = true %}
  {% endif %}
  {% if must_watch_video != blank %}
    <div class="bottom-buttons bottom-buttons__new bottom-buttons__{{ template.suffix | handleize }} bottom-buttons__{{ product.title | handleize }}">
      <ul>
        <li class="commercial new_commercial pdp_video_button">
          <a href="javascript:void(0);" class="videopopup_link" data-video-id="{{must_watch_video}}">
            <span><img src="https://blueteesgolf.com/cdn/shop/t/84/assets/commercial-icon-h.png"></span>
            {% comment %}
              {% if product.template_suffix == 'player-pro' %}
                WATCH WHAT'S NEW
              {% else %}
                MUST WATCH
              {% endif %}
            {% endcomment %}
            WATCH WHAT'S NEW
          </a>
        </li>
        {% if show_review_watch_btn %}
          <li class="review new_review pdp_video_button">
            <a href="javascript:void(0);" class="videopopup_link" data-video-id="{{review_watch_video}}">
              <span><img src="https://blueteesgolf.com/cdn/shop/t/84/assets/commercial-icon-h.png"></span>
              SEE REVIEW
            </a>
          </li>
        {% endif %}
      </ul>
    </div>
  {% endif %}
{% endif %} {% endcomment %}

{% if product.handle == 'speaker-bundle'
  or product.handle == 'gps-offer'
  or product.handle == 'laser-offer'
  or product.handle == 'player-gps-speaker-bundle-v2'
  or product.handle == 'ringer-gps-handheld-bundle-v2'
  or product.handle == 'series-4-ultra-bundle-v2'
%}
  <div class="bottom-buttons">
    <ul>
      <li class="commercial new_photo pdp_video_button">
        <a href="#" aria-label="View product photos gallery">
          <span>
            <img 
              src="{{ 'photo-icon.png' | asset_url }}" 
              alt="Photos icon" 
              aria-hidden="true">
          </span>
          PHOTOS
        </a>
      </li>
      <li class="commercial new_commercial pdp_video_button">
        <a
          href="javascript:void(0);"
          class="videopopup_link"
          data-video-id="{%if product.handle == 'speaker-bundle' or product.handle == 'player-gps-speaker-bundle-v2' %}1132441995{%elsif product.handle == 'gps-offer' or product.handle == 'ringer-gps-handheld-bundle-v2'%}920149279{%elsif product.handle == 'laser-offer' or product.handle == 'series-4-ultra-bundle-v2'%}995524601{%endif %}"
          aria-label="Play promotional video - Must Watch"
        >
          <span>
            <img 
              src="https://blueteesgolf.com/cdn/shop/t/84/assets/commercial-icon-h.png" 
              alt="Video icon" 
              aria-hidden="true">
          </span>
          MUST WATCH
        </a>
      </li>
      <li class="review new_review pdp_video_button">
        <a
          href="javascript:void(0);"
          class="videopopup_link"
          data-video-id="{%if product.handle == 'speaker-bundle' or product.handle == 'player-gps-speaker-bundle-v2' %}920141462{%elsif product.handle == 'gps-offer' or product.handle == 'ringer-gps-handheld-bundle-v2'%}920147864{%elsif product.handle == 'laser-offer' or product.handle == 'series-4-ultra-bundle-v2'%}995631368{%endif %}"
          aria-label="Play customer review video"
        >
          <span>
            <img 
              src="https://blueteesgolf.com/cdn/shop/t/84/assets/commercial-icon-h.png" 
              alt="Review video icon" 
              aria-hidden="true">
          </span>
          SEE REVIEW
        </a>
      </li>
    </ul>
  </div>

{% else %}
  {% assign must_watch_video = must_watch %}
  {% assign review_watch_video = review_video %}
  {% assign show_review_watch_btn = false %}
  
  {% if display_review_button %}
    {% assign show_review_watch_btn = true %}
  {% endif %}

  {% if must_watch_video != blank %}
    <div class="bottom-buttons bottom-buttons__new bottom-buttons__{{ template.suffix | handleize }} bottom-buttons__{{ product.title | handleize }}">
      <ul>
        <li class="commercial new_commercial pdp_video_button">
          <a 
            href="javascript:void(0);" 
            class="videopopup_link" 
            data-video-id="{{ must_watch_video }}"
            aria-label="Play promotional video - Watch What's New In {{ product.title }}"
          >
            <span>
              <img 
                src="https://blueteesgolf.com/cdn/shop/t/84/assets/commercial-icon-h.png" 
                alt="Video icon" 
                aria-hidden="true">
            </span>
            WATCH WHAT'S NEW
          </a>
        </li>
        
        {% if show_review_watch_btn %}
          <li class="review new_review pdp_video_button">
            <a 
              href="javascript:void(0);" 
              class="videopopup_link" 
              data-video-id="{{ review_watch_video }}"
              aria-label="Play customer review video for {{ product.title }}"
            >
              <span>
                <img 
                  src="https://blueteesgolf.com/cdn/shop/t/84/assets/commercial-icon-h.png" 
                  alt="Review video icon" 
                  aria-hidden="true">
              </span>
              SEE REVIEW
            </a>
          </li>
        {% endif %}
      </ul>
    </div>
  {% endif %}
{% endif %}