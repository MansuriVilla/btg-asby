   jQuery(document).ready(function() {
    var clock;

    // -------------------------------------------------
    // 1. Target UNIX timestamp (seconds) for 2025-11-22 12:00 PM ET
    // -------------------------------------------------
    // 12:00 PM ET = 16:00 UTC  (ET = UTC-4 during standard time)
    // Date.UTC(2025,10,22,16,0,0) → month is 0-based → 10 = November
    var targetUnix = Math.floor(Date.UTC(2025, 10, 22, 16, 0, 0) / 1000);
    // → 1765713600

    // -------------------------------------------------
    // 2. Current UNIX timestamp (seconds)
    // -------------------------------------------------
    var nowUnix = Math.floor(Date.now() / 1000);

    // -------------------------------------------------
    // 3. Seconds remaining (never negative)
    // -------------------------------------------------
    var secondsLeft = Math.max(1, targetUnix - nowUnix);
    // → ~ 6 days 23 h 49 min from 2025-11-15 11:11 AM IST

    clock = $('.clock').FlipClock({
        clockFace: 'DailyCounter',
        autoStart: false,
        callbacks: {
            stop: function() {
                $('.message').html('$50 GIFT CARD WITH PURCHASE OF $299 OR MORE');
            }
        }
    });

    clock.setTime(secondsLeft);
    clock.setCountdown(true);
    clock.start();
});
</script> 
