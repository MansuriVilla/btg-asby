{% comment %} 
<script>
var clock;
var defaultDuration = 1 * 1 * 1 * 60;  

$(document).ready(function() {

    
    function calculateCountdown() {
        const startDate = new Date("2025-01-12T00:00:00");  
        const currentDate = new Date();
        const timeDifference = currentDate - startDate;
        const daysElapsed = Math.floor(timeDifference / (1000 * 60 * 60 * 24)); 

        const nextCountdownDay = Math.floor(daysElapsed / 2) * 2 + 2; 
        const nextCountdownDate = new Date(startDate.getTime() + nextCountdownDay * 24 * 60 * 60 * 1000); 

        const remainingTime = nextCountdownDate - currentDate; 

        
        const remainingDays = Math.floor(remainingTime / (1000 * 60 * 60 * 24)); 
        const remainingHours = Math.floor((remainingTime % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const remainingMinutes = Math.floor((remainingTime % (1000 * 60 * 60)) / (1000 * 60));
        const remainingSeconds = Math.floor((remainingTime % (1000 * 60)) / 1000);

        
        const remainingTotalSeconds = remainingDays * 24 * 60 * 60 + remainingHours * 60 * 60 + remainingMinutes * 60 + remainingSeconds;

        
        clock.setTime(remainingTotalSeconds);  
        clock.setCountdown(true);  
        clock.start();  
    }

    
    clock = $('.clock').FlipClock({
        clockFace: 'DailyCounter',
        countdown: true,
        autoStart: false 
    });

    
    setInterval(calculateCountdown, 1000);
});
</script> {% endcomment %}




