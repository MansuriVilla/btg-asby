   jQuery(document).ready(function() {
    var clock;

    // -------------------------------------------------
    // 1. Target UNIX timestamp (seconds) for 2026-11-29 11:59 PM PST
    // -------------------------------------------------
    // 11:59 PM PST = 07:59 UTC on November 30
    // Date.UTC(year, monthIndex, day, hour, min, sec) → month is 0-based (10 = November)
    var targetUnix = Math.floor(Date.UTC(2026, 10, 30, 7, 59, 0) / 1000);
    // → 1796025540

    // -------------------------------------------------
    // 2. Current UNIX timestamp (seconds)
    // -------------------------------------------------
    var nowUnix = Math.floor(Date.now() / 1000);

    // -------------------------------------------------
    // 3. Seconds remaining (never negative)
    // -------------------------------------------------
    var secondsLeft = Math.max(1, targetUnix - nowUnix);

    clock = $('.clock').FlipClock({
        clockFace: 'DailyCounter',
        autoStart: false,
        callbacks: {
            stop: function() {
                $('.message').html('$50 GIFT CARD WITH PURCHASE OF $299 OR MORE');
            }
        }
    });

    clock.setTime(secondsLeft);
    clock.setCountdown(true);
    clock.start();
});
</script> 
