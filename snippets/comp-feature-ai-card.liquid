    left: 0;
    bottom: 0;
    background: linear-gradient(90deg, rgba(0, 161, 255, 0) 0%, #00A1FF 32.21%, #7C51FF 61.54%, rgba(124, 81, 255, 0) 100%), #D9D9D9;
    z-index: 3;
  }

  .comp-ai-modal__table-body {
    width: 100%;
    display: flex;
    flex-direction: column;
  }
  .comp-ai-modal__table-row {
    box-sizing: border-box;
