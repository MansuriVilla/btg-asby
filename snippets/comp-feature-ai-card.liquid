      <div class="comp-ai-modal__loader" data-ai-modal-loader aria-label="Loading video">
        <div class="comp-ai-modal__spinner"></div>
      </div>
      <div class="comp-ai-modal__slides" data-ai-modal-slides>
        {% if video_src != blank %}
          <div class="comp-ai-modal__slide is-active" data-ai-modal-slide data-index="0" data-type="video">
            {% render 'comp-video-player',
              video_url: video_src,
              is_active: false,
              title: 'Game AI Presentation Video',
              video_class: 'comp-ai-modal__slide-media comp-ai-modal__slide-video',
              controls_variant: 'buttonsonly'
              show_mute: false
