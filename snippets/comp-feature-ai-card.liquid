  @media screen and (max-width: 640px) {
    .comp-ai-modal__dialog {
      height: 90vh;
      border-radius: 14px;
    }
    .comp-ai-modal__media-viewport {
      min-height: 220px;
      height: 220px;
    }
    .comp-ai-modal__body {
      padding: 20px 16px;
    }
    .comp-ai-modal__col-cell--right {
      padding-left: 10px;
    }
    .comp-ai-modal__col-cell:first-child {
      padding-right: 6px;
    }
    .comp-ai-modal__sticky-footer {
      padding: 16px 16px;
    }
  }
</style>

<script>
  (function () {
    var card = document.querySelector('[data-comp-ai-media]');
    var modal = document.getElementById('CompAiModal-{{ block.id }}');
    if (!card || !modal) return;

    var trigger = card.querySelector('[data-comp-ai-modal-trigger]');
    var closeButtons = modal.querySelectorAll('[data-comp-ai-modal-close]');
    var slides = Array.from(modal.querySelectorAll('[data-ai-modal-slide]'));
    var currentIndex = 0;
    var total = slides.length;
    var dockEl = modal.querySelector('[data-mac-dock]');
    var dockCtrl = null;

    function positionAiModal() {
      var dialog = modal.querySelector('.comp-ai-modal__dialog');
      if (!dialog) return;

      if (window.innerWidth <= 991) {
        modal.style.justifyContent = 'center';
        modal.style.alignItems = 'center';
        modal.style.padding = '12px';
        dialog.style.width = '100%';
        dialog.style.maxWidth = '100%';
        dialog.style.marginLeft = '0px';
        dialog.style.marginRight = '0px';
        return;
      }

      var panel = document.querySelector('.comp-pdp-panel') || document.querySelector('.product-single__meta');
      if (panel) {
        var rect = panel.getBoundingClientRect();
        modal.style.justifyContent = 'flex-start';
        modal.style.alignItems = 'center';
        modal.style.padding = '16px';
        dialog.style.marginLeft = Math.max(16, Math.round(rect.left)) + 'px';
        dialog.style.width = Math.min(620, Math.round(rect.width)) + 'px';
        dialog.style.maxWidth = Math.round(rect.width) + 'px';
      }
    }

    function initModalDock() {
      if (dockCtrl || !dockEl || !window.initMacDock) return;
      dockCtrl = window.initMacDock({
        dock: dockEl,
        initialIndex: currentIndex,
        duration: 4.5,
        autoPlay: true,
        onSelect: function (idx) {
          goToSlide(idx, false);
        },
        onAutoAdvance: function (idx) {
          goToSlide(idx, false);
        }
      });
    }

    var viewport = modal.querySelector('[data-ai-modal-viewport]');
    var modalVideo = modal.querySelector('video');

    function setVideoLoading(loading) {
      if (viewport) {
        viewport.classList.toggle('is-loading', !!loading);
      }
      var playBtn = modal.querySelector('[data-video-btn-play]');
      if (playBtn && modalVideo) {
        if (loading) {
          playBtn.classList.remove('is-playing');
        } else if (!modalVideo.paused) {
          playBtn.classList.add('is-playing');
        } else {
          playBtn.classList.remove('is-playing');
        }
      }
    }

    if (modalVideo) {
      modalVideo.addEventListener('loadstart', function () {
        if (modal.classList.contains('is-open')) setVideoLoading(true);
      });
      modalVideo.addEventListener('waiting', function () {
        if (modal.classList.contains('is-open')) setVideoLoading(true);
      });
      modalVideo.addEventListener('seeking', function () {
        if (modal.classList.contains('is-open')) setVideoLoading(true);
      });
      modalVideo.addEventListener('canplay', function () {
        setVideoLoading(false);
      });
      modalVideo.addEventListener('playing', function () {
        setVideoLoading(false);
      });
      modalVideo.addEventListener('error', function () {
        setVideoLoading(false);
      });
    }

    function openModal() {
      positionAiModal();
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      initModalDock();

      if (modalVideo) {
        var vSrc = modalVideo.getAttribute('data-src');
        if (vSrc && (!modalVideo.currentSrc && !modalVideo.src)) {
          setVideoLoading(true);
          modalVideo.src = vSrc;
          modalVideo.load();
        } else if (modalVideo.readyState < 3) {
          setVideoLoading(true);
        } else {
          setVideoLoading(false);
        }

        modalVideo.currentTime = 0;
        var playPromise = modalVideo.play();
        if (playPromise !== undefined) {
          playPromise.then(function () {
            setVideoLoading(false);
          }).catch(function () {
            if (!modalVideo.muted) {
              modalVideo.muted = true;
              modalVideo.play().then(function() {
                setVideoLoading(false);
              }).catch(function() {
                setVideoLoading(false);
              });
            } else {
              setVideoLoading(false);
            }
          });
        }
      }

      if (dockCtrl) {
        dockCtrl.select(0);
        dockCtrl.resume();
      } else {
        goToSlide(0, true);
      }
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (dockCtrl) {
        dockCtrl.pause();
      }
      // Pause any playing videos
      slides.forEach(function (slide) {
        var v = slide.querySelector('video');
        if (v) v.pause();
      });
    }

    function goToSlide(index, updateDock) {
      if (index < 0) index = total - 1;
      if (index >= total) index = 0;
      currentIndex = index;

      slides.forEach(function (slide, i) {
        var isActive = (i === currentIndex);
        slide.classList.toggle('is-active', isActive);
        var v = slide.querySelector('video');
        if (v) {
          if (isActive) {
            v.currentTime = 0;
            v.play().catch(function(){});
          } else {
            v.pause();
          }
        }
      });

      if (updateDock && dockCtrl) {
        dockCtrl.select(currentIndex);
      }
    }

    if (trigger) trigger.addEventListener('click', openModal);
    closeButtons.forEach(function (b) { b.addEventListener('click', closeModal); });

    window.addEventListener('resize', function () {
      if (modal.classList.contains('is-open')) {
        positionAiModal();
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) {
        closeModal();
      }
    });

    // 5-second preview loop for card video
    var previewVideo = card.querySelector('[data-comp-ai-preview-video]');
    if (previewVideo) {
      var previewCutoff = 5;

      if ('IntersectionObserver' in window) {
        var cardObs = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              if (!previewVideo.getAttribute('src')) {
                var dSrc = previewVideo.getAttribute('data-src');
                if (dSrc) {
                  previewVideo.src = dSrc;
                  previewVideo.load();
                }
              }
              if (previewVideo.paused) {
                previewVideo.play().catch(function() {});
              }
            } else {
              if (!previewVideo.paused) {
                previewVideo.pause();
              }
            }
          });
        }, { rootMargin: '200px' });
        cardObs.observe(card);
      } else {
        if (!previewVideo.getAttribute('src')) {
          var dSrc = previewVideo.getAttribute('data-src');
          if (dSrc) previewVideo.src = dSrc;
        }
      }

      previewVideo.addEventListener('loadedmetadata', function () {
        previewVideo.currentTime = 0;
        previewVideo.muted = true;
        previewVideo.play().catch(function () {});
      });

      previewVideo.addEventListener('timeupdate', function () {
        if (previewVideo.currentTime >= previewCutoff) {
          previewVideo.currentTime = 0;
        }
      });
    }
  })();
</script>
