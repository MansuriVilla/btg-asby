    line-height: 1.5;
    text-align: center;
    letter-spacing: 0.02em;
    color: #4F4F4F;
    max-width: 556px;
  }

  /* Comparison Table */
  .comp-ai-modal__table {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 0;
    width: 100%;
    max-width: 556px;
    background: #FFFFFF;
    margin-top: 8px;
  }
  .comp-ai-modal__table-header {
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    width: 100%;
    height: 43px;
    position: relative;
  }
  .comp-ai-modal__col-head {
    box-sizing: border-box;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 50%;
    height: 43px;
    font-size: 12px;
    line-height: 1.5;
    text-transform: uppercase;
    color: #1B1E22;
  }
  .comp-ai-modal__col-head--left,  .comp-ai-modal__col-head--right {
    border-bottom: 1px solid #D9D9D9;
  }
  .comp-ai-modal__col-head--right {
    position: relative;
    isolation: isolate;
  }
  .comp-ai-modal__col-head-text {
    position: relative;
    z-index: 4;
    text-align: center;
  }
  .comp-ai-modal__glow-1 {
    position: absolute;
    width: 162px;
    height: 29px;
    right: 15px;
    top: 15px;
    background: #7C51FF;
    filter: blur(12px);
    z-index: 0;
    pointer-events: none;
    opacity: 0.75;
  }
  .comp-ai-modal__glow-2 {
    position: absolute;
    width: 172px;
    height: 28px;
    left: 10px;
    top: 15px;
    background: #00A1FF;
    filter: blur(12px);
    z-index: 1;
    pointer-events: none;
    opacity: 0.75;
  }
  .comp-ai-modal__glow-3 {
    position: absolute;
    inset: 0;
    background: #FFFFFF;
    filter: blur(12px);
    z-index: 2;
    pointer-events: none;
