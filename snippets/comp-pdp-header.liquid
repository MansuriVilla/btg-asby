</svg>

          {{ gift_text }}
        </span>
      {% endif %}
      {% if show_rating %}
        <a href="#reviews" class="comp-pdp-header__reviews">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
<rect x="4" y="4" width="10" height="10" fill="#282C35"/>
<path d="M15.8808 7.22953C15.6157 6.9525 15.3415 6.66703 15.2381 6.41602C15.1425 6.18609 15.1369 5.805 15.1312 5.43586C15.1207 4.74961 15.1095 3.97195 14.5687 3.43125C14.028 2.89055 13.2504 2.8793 12.5641 2.86875C12.195 2.86312 11.8139 2.8575 11.584 2.76187C11.3337 2.65852 11.0475 2.3843 10.7705 2.11922C10.2853 1.65305 9.73406 1.125 9 1.125C8.26594 1.125 7.71539 1.65305 7.22953 2.11922C6.9525 2.3843 6.66703 2.65852 6.41602 2.76187C6.1875 2.8575 5.805 2.86312 5.43586 2.86875C4.74961 2.8793 3.97195 2.89055 3.43125 3.43125C2.89055 3.97195 2.88281 4.74961 2.86875 5.43586C2.86312 5.805 2.8575 6.18609 2.76187 6.41602C2.65852 6.66633 2.3843 6.9525 2.11922 7.22953C1.65305 7.71469 1.125 8.26594 1.125 9C1.125 9.73406 1.65305 10.2846 2.11922 10.7705C2.3843 11.0475 2.65852 11.333 2.76187 11.584C2.8575 11.8139 2.86312 12.195 2.86875 12.5641C2.89055 13.2504 2.89055 14.028 3.43125 14.5687C3.97195 15.1095 4.74961 15.1207 5.43586 15.1312C5.805 15.1369 6.18609 15.1425 6.41602 15.2381C6.66633 15.3415 6.9525 15.6157 7.22953 15.8808C7.71469 16.347 8.26594 16.875 9 16.875C9.73406 16.875 10.2846 16.347 10.7705 15.8808C11.0475 15.6157 11.333 15.3415 11.584 15.2381C11.8139 15.1425 12.195 15.1369 12.5641 15.1312C13.2504 15.1207 14.028 15.1095 14.5687 14.5687C15.1095 14.028 15.1207 13.2504 15.1312 12.5641C15.1369 12.195 15.1425 11.8139 15.2381 11.584C15.3415 11.3337 15.6157 11.0475 15.8808 10.7705C16.347 10.2853 16.875 9.73406 16.875 9C16.875 8.26594 16.347 7.71539 15.8808 7.22953ZM12.2105 7.71047L8.27297 11.648C8.22073 11.7003 8.15869 11.7418 8.0904 11.7701C8.02212 11.7984 7.94892 11.8129 7.875 11.8129C7.80108 11.8129 7.72788 11.7984 7.6596 11.7701C7.59131 11.7418 7.52927 11.7003 7.47703 11.648L5.78953 9.96047C5.68398 9.85492 5.62469 9.71177 5.62469 9.5625C5.62469 9.41323 5.68398 9.27008 5.78953 9.16453C5.89508 9.05898 6.03823 8.99969 6.1875 8.99969C6.33677 8.99969 6.47992 9.05898 6.58547 9.16453L7.875 10.4548L11.4145 6.91453C11.4668 6.86227 11.5288 6.82081 11.5971 6.79253C11.6654 6.76424 11