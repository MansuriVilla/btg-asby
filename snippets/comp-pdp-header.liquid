{% comment %}
  Component: comp-pdp-header
  Price row + reviews + free gift line. Keeps the data-* hooks the theme variant JS updates.
  Usage:
  {% render 'comp-pdp-header', product: product, current_variant: current_variant, show_title: false, gift_text: 'Includes Free Gift', show_rating: true, isModal: false %}
{% endcomment %}

{% liquid
  assign cv = current_variant | default: product.selected_or_first_available_variant
  assign on_sale = false
  if cv.compare_at_price > cv.price
    assign on_sale = true
  endif

  assign now_year = 'now' | date: '%Y' | plus: 0
  assign start_ts = now_year | append: '-11-01 00:00:00' | date: '%s' | plus: 0
  assign now_ts = 'now' | date: '%s' | plus: 0
  assign diff_seconds = now_ts | minus: start_ts
  if diff_seconds >= 0
    assign days_elapsed = diff_seconds | divided_by: 86400
    assign dynamic_stock_percent = days_elapsed | times: 3
    if dynamic_stock_percent > 100
      assign dynamic_stock_percent = 100
    endif
  else
    assign dynamic_stock_percent = 0
  endif
%}

<div class="comp-pdp-header">
  {%- if enable_limited_stock -%}
    <div class="comp-pdp-stock-block" data-stock-auto>
      <div class="comp-pdp-stock-block__header">
        <span class="comp-pdp-stock-block__badge">{{ stock_badge | default: 'LIMITED STOCK' }}</span>
        <span class="comp-pdp-stock-block__dot"></span>
        <span class="comp-pdp-stock-block__avail">{{ stock_available | default: 'Only 300 Bundles Available' }}</span>
      </div>
      <div class="comp-pdp-stock-block__bar">
        <div class="comp-pdp-stock-block__progress" data-stock-progress style="width: {{ dynamic_stock_percent }}%;"></div>
      </div>
      <div class="comp-pdp-stock-block__claimed" data-stock-claimed>
        {{ dynamic_stock_percent }}% Claimed
      </div>
    </div>
    <script>
      (function () {
        var block = document.currentScript.previousElementSibling;
        if (!block || !block.hasAttribute('data-stock-auto')) return;
        var now = new Date();
        var start = new Date(now.getFullYear(), 10, 1); // Nov 1 (month is 0-indexed)
        var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        var diffDays = Math.floor((today - start) / 86400000);
        var pct = diffDays > 0 ? Math.min(100, diffDays * 3) : 0;
        var bar = block.querySelector('[data-stock-progress]');
        var label = block.querySelector('[data-stock-claimed]');
        if (bar) bar.style.width = pct + '%';
        if (label) label.textContent = pct + '% Claimed';
      })();
    </script>
  {%- endif -%}

  {% if show_title %}
    {% if isModal %}
      <p class="comp-pdp-header__title product-single__title">{{ product.title }}</p>
    {% else %}
      <h1 class="comp-pdp-header__title product-single__title">{{ product.title }}</h1>
    {% endif %}
  {% else %}
    <h1 class="visually-hidden">{{ product.title }}</h1>
  {% endif %}

  <div class="comp-pdp-header__row">
    <div class="comp-pdp-header__price-group">
      <div class="comp-pdp-header__price product__prices">
        <span data-product-price class="comp-pdp-header__price-main product__price price-main{% if on_sale %} on-sale{% endif %}">
          {{ cv.price | money_without_trailing_zeros }}
        </span>
        <span data-product-price-wrap class="comp-pdp-header__compare-wrap{% unless on_sale %} hide{% endunless %}">
          <span data-compare-price class="comp-pdp-header__price-compare custom_heading product__price--compare">
            {%- if on_sale -%}{{ cv.compare_at_price | money_without_trailing_zeros }}{%- endif -%}
          </span>
        </span>
      </div>

      <div class="comp-pdp-header__divider">
        <span class="comp-pdp-header__divider-line"></span>
        <span class="comp-pdp-header__divider-text">or</span>
        <span class="comp-pdp-header__divider-line"></span>
      </div>

      <div class="comp-pdp-header__afterpay-inline after-pay"></div>
    </div>

    {%- if enable_savings_line -%}
      <div class="comp-pdp-header__savings-line">
        {{ savings_text | default: 'Save $600 vs. buying separately. Shipping 11/15.' }}
      </div>
    {%- endif -%}

    <div class="comp-pdp-header__meta">
      {% if gift_text != blank %}
        <span class="comp-pdp-header__gift">
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
