</svg>

          <span class="comp-pdp-header__reviews-label">Customer Reviews</span>
        </a>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .comp-pdp-header {
    display: flex;
    flex-direction: column;
    gap: clamp(6px, 0.6vw, 10px);
    width: 100%;
  }
  .comp-pdp-header__title,
  h1.comp-pdp-header__title,
  p.comp-pdp-header__title,
  .comp-pdp-header .product-single__title {
    margin: 0;
    font-family: 'Blue Tees Headline Italic', sans-serif;
    font-size: clamp(28px, 2.6vw, 38px);
    line-height: clamp(34px, 3.2vw, 48px);
    color: #1B2029 !important;
    opacity: 0.95;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .comp-pdp-header__row {
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 1vw, 14px);
    width: 100%;
  }
  .comp-pdp-header__price-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(10px, 1vw, 14px);
  }
  .product-single__meta .comp-pdp-header__price.product__prices {
    display: flex;
    align-items: baseline;
    gap: clamp(4px, 0.4vw, 6px);
    margin-top: 0;
    flex-direction: row;
  }
  .comp-pdp-header__price-main,
  .comp-pdp-header .product__price.price-main,
  .comp-pdp-header__price-main *,
  .comp-pdp-header .product__price.price-main * {
    font-family: 'Blue Tees Headline Italic', sans-serif;
    font-size: clamp(24px, 2vw, 29px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: #1B2029;
    fill: #1B2029;
    opacity: 0.95;
    margin: 0;
  padding: 0;
  }
  .comp-pdp-header__price-main.on-sale,
  .comp-pdp-header .product__price.price-main.on-sale,
  .comp-pdp-header__price-main.on-sale *,
  .comp-pdp-header .product__price.price-main.on-sale * {
    color: #CB0000;
    fill: #CB0000;
  }
  .comp-pdp-header__price-compare,
  .comp-pdp-header__price-compare .money,
  .comp-pdp-header .product__price--compare,
  .comp-pdp-header__price-compare *,
  .comp-pdp-header .product__price--compare * {
    font-family: 'Blue Tees Paragraph Italic';
    font-size: clamp(15px, 1.3vw, 18.5px);
    line-height: 1;
    letter-spacing: -0.04em;
    padding: 0;
  }
  .comp-pdp-header__divider {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 3px;
    height: 24px;
    margin: 0 4px;
    flex-shrink: 0;
  }
  .comp-pdp-header__divider-line {
    width: 1px;
    height: 6px;
    background: #B4B4B4;
  }
  .comp-pdp-header__divider-text {
    font-family: 'Blue Tees Subhead', sans-serif;
    font-size: 10px;
    line-height: 1;
    text-align: center;
    letter-spacing: 0.02em;
    color: #B4B4B4;
  }
  .comp-pdp-header__afterpay-inline,
  .comp-pdp-header__afterpay-inline.after-pay {
    display: none;
    flex-direction: row !important;
    align-items: center !important;
    flex-wrap: wrap !important;
    gap: 4px;
    font-family: 'Blue Tees Paragraph', sans-serif;
    font-size: 11px;
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: #101820 !important;
  }
  .comp-pdp-header__price-group afterpay-placement,
  .comp-pdp-header__price-group .afterpay-placement {
    display: inline-flex !important;
    align-items: center !important;
    margin: 0 !important;
  }
  .comp-pdp-header__price-group .afterpay-paragraph,
  .comp-pdp-header__price-group .afterpay-paragraph-desktop {
    margin: 0 !important;
    padding: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    flex-wrap: wrap !important;
    gap: 4px !important;
    font-family: 'Blue Tees Paragraph', sans-serif !important;
    font-size: 11px !important;
    line-height: 1.3 !important;
    letter-spacing: 0.01em !important;
    color: #101820 !important;
    max-width: none !important;
  }
  .comp-pdp-header__price-group .after-pay *,
  .comp-pdp-header__price-group .afterpay-paragraph *,
  .comp-pdp-header__price-group .afterpay-placement *,
  .comp-pdp-header__price-group .afterpay-text,
  .comp-pdp-header__price-group afterpay-placement * {
    font-family: 'Blue Tees Paragraph', sans-serif !important;
    font-size: 11px !important;
    line-height: 1.3 !important;
    letter-spacing: 0.01em !important;
    color: #101820 !important;
  }
  .comp-pdp-header__price-group .afterpay-paragraph strong,
  .comp-pdp-header__price-group .afterpay-paragraph .afterpay-instalments,
  .comp-pdp-header__price-group .after-pay strong {
    font-family: 'Blue Tees Subhead', sans-serif !important;
    font-weight: 700 !important;
    color: #101820 !important;
  }
  .comp-pdp-header__price-group .afterpay-paragraph .afterpay-logo,
  .comp-pdp-header__price-group .after-pay .afterpay-logo,
  .comp-pdp-header__price-group .afterpay-logo-link {
    display: inline-block !important;
    vertical-align: middle !important;
    height: 14px !important;
    width: auto !important;
    margin: 0 2px !important;
  }
  .comp-pdp-header__price-group .afterpay-paragraph .afterpay-link,
  .comp-pdp-header__price-group .afterpay-paragraph .afterpay-link-inner,
  .comp-pdp-header__price-group .after-pay .afterpay-link {
    display: inline-flex !important;
    align-items: center !important;
    font-size: 10px !important;
    color: #101820 !important;
    text-decoration: none !important;
    cursor: pointer !important;
  }
  .comp-pdp-header__afterpay-badge {
    font-family: 'Blue Tees Subhead', sans-serif;
  }
  .comp-pdp-header__afterpay-info {
    font-size: 9px;
    color: #7A8291;
    cursor: pointer;
  }
  .comp-pdp-header__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(12px, 1.2vw, 16px);
  }
  .comp-pdp-header__gift {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: 'Blue Tees Paragraph', sans-serif;
    font-size: clamp(11px, 0.8vw, 12px);
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: #4F4F4F;
  }
  .comp-pdp-header__reviews, a.comp-pdp-header__reviews[href="#looxReviews"] {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: 'Blue Tees Paragraph', sans-serif;
    font-size: clamp(11px, 0.8vw, 12px);
    line-height: 1.5;
    letter-spacing: 0.02em;
    text-decoration: underline;
    color: #4F4F4F;
  }
  .comp-pdp-header__gift-icon,
  .comp-pdp-header__seal-icon {
    flex-shrink: 0;
  }
  .comp-pdp-header__savings-line {
    width: 100%;
    font-family: 'Roboto Flex', 'Blue Tees Paragraph', sans-serif;
    font-size: 12px;
    line-height: 150%;
    letter-spacing: 0.02em;
    color: #004AE3;
    font-stretch: 130%;
  }
  .comp-pdp-header__savings-line p {
    margin: 0;
    line-height: inherit;
    color: inherit;
    font-size: inherit;
    font-family: inherit;
  }
  .comp-pdp-header__savings-line a {
    color: inherit;
    text-decoration: underline;
  }

  /* Limited Stock Block */
  .comp-pdp-stock-block {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 14px 16px;
    gap: 8px;
    width: 100%;
    max-width: 100%;
    background: linear-gradient(180deg, #1B1E22 0%, #000000 100%), #101820;
    border-radius: 10px;
    margin-bottom: 2px;
  }
  .comp-pdp-stock-block__header {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 0px;
    gap: 8px;
    width: 100%;
  }
  .comp-pdp-stock-block__badge {
    font-family: 'Roboto Flex', 'Blue Tees Subhead', sans-serif;
    font-weight: 900;
    font-size: 11px;
    line-height: 100%;
    display: flex;
    align-items: center;
    text-transform: uppercase;
    color: #FF0000;
    letter-spacing: 0.04em;
    font-stretch: 130%;
    white-space: nowrap;
  }
  .comp-pdp-stock-block__dot {
    width: 3px;
    height: 3px;
    background: #D9D9D9;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .comp-pdp-stock-block__avail {
    font-family: 'Roboto Flex', 'Blue Tees Paragraph', sans-serif;
    font-weight: 900;
    font-size: 11px;
    line-height: 100%;
    display: flex;
    align-items: center;
    color: #FFFFFF;
    font-stretch: 130%;
    white-space: nowrap;
  }
  .comp-pdp-stock-block__bar {
    position: relative;
    width: 100%;
    height: 6px;
    background: #555555;
    border-radius: 999px;
    overflow: hidden;
  }
  .comp-pdp-stock-block__progress {
    position: absolute;
    height: 6px;
    left: 0px;
    top: 0px;
    background: #FF0000;
    border-radius: 999px;
  }
  .comp-pdp-stock-block__claimed {
    font-family: 'Roboto Flex', 'Blue Tees Paragraph', sans-serif;
    font-weight: 700;
    font-size: 10px;
    line-height: 100%;
    display: flex;
    align-items: center;
    text-transform: capitalize;
    color: rgba(255, 255, 255, 0.5);
    font-stretch: 130%;
  }

  @media only screen and (max-width:991px){
    .comp-pdp-header__afterpay-inline { flex-direction: row !important; }
    .comp-pdp-header__price-group .afterpay-paragraph { max-width: none !important; }
    .product-single__meta .comp-pdp-header__price.product__prices{flex-direction: column;}
  }
</style>
